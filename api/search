-listogram-colors","content":"Custom Listogram Colors"},"6156":{"id":"/components/filter-list-24","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#custom-value-rendering","content":"Custom Value Rendering"},"6157":{"id":"/components/filter-list-25","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#listogram-display-modes","content":"Listogram Display Modes"},"6158":{"id":"/components/filter-list-26","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#limiting-visible-items","content":"Limiting Visible Items"},"6159":{"id":"/components/filter-list-27","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#collapsible-panel","content":"Collapsible Panel"},"6160":{"id":"/components/filter-list-28","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#drag-and-drop-sorting","content":"Drag-and-Drop Sorting"},"6161":{"id":"/components/filter-list-29","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#exclude-toggle","content":"Exclude Toggle"},"6162":{"id":"/components/filter-list-30","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#styling","content":"Styling"},"6163":{"id":"/components/filter-list-31","page_id":"/components/filter-list","type":"heading","tags":[],"url":"/components/filter-list#best-practices","content":"Best Practices"},"6164":{"id":"/components/filter-list-32","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#prerequisites","content":"Before using FilterList, make sure you have completed the library setup described in Prerequisites, including:"},"6165":{"id":"/components/filter-list-33","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#prerequisites","content":"Installing the required dependencies"},"6166":{"id":"/components/filter-list-34","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#prerequisites","content":"Wrapping your app with `OsdkProvider`"},"6167":{"id":"/components/filter-list-35","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#prerequisites","content":"Adding the CSS imports"},"6168":{"id":"/components/filter-list-36","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#basic-usage","content":"[!NOTE]\n`@my-app/sdk` is a placeholder for your generated SDK package. `./client` is the file in your app where you exported the OSDK client returned by `createClient(...)`. Replace both with the actual paths in your project."},"6169":{"id":"/components/filter-list-37","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#basic-usage","content":"The simplest way to use FilterList is with an objectSet and a few filter definitions:"},"6170":{"id":"/components/filter-list-38","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"Type parameters: `Q extends ObjectTypeDefinition`"},"6171":{"id":"/components/filter-list-39","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name         | Type | Description                                                                                                                            |\n| ------------ | ---- | -------------------------------------------------------------------------------------------------------------------------------------- |\n| `objectType` | `Q`  | **Required.** The object type definition for the objects being filtered. Used for metadata resolution (property types, display names). |","table":"table-0"},"6172":{"id":"/components/filter-list-40","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name        | Type           | Description                                                                                                                                                                              |\n| ----------- | -------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `objectSet` | `ObjectSet<Q>` | Optional object set to scope aggregation queries. When omitted, aggregations run against the full object type.<br /><br />Required for `HAS_LINK` and `LINKED_PROPERTY` filters to work. |","table":"table-0"},"6173":{"id":"/components/filter-list-41","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                | Type                              | Description                                                                                                            |\n| ------------------- | --------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `filterDefinitions` | `Array<FilterDefinitionUnion<Q>>` | The definition for all supported filter items in the list If not supplied, all filterable properties will be available |","table":"table-0"},"6174":{"id":"/components/filter-list-42","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                  | Type                       | Description                                                                                                                                                                                                                                                                                                                                                     |\n| --------------------- | -------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `defaultFilterStates` | `Map<string, FilterState>` | Seeds filter states from external storage, keyed by `getFilterKey`. Applied over the per-definition `defaultFilterState` seeds on mount, and FilterList owns the states from then on. Also the state the reset button restores to. Use `onFilterStateChanged` to persist changes back out. Defaults to `undefined (filters seed from their definitions alone)`. |","table":"table-0"},"6175":{"id":"/components/filter-list-43","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                  | Type                       | Description                                       |\n| --------------------- | -------------------------- | ------------------------------------------------- |\n| `initialFilterStates` | `Map<string, FilterState>` | **Deprecated** — Rename to `defaultFilterStates`. |","table":"table-0"},"6176":{"id":"/components/filter-list-44","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                  | Type                                    | Description                                          |\n| --------------------- | --------------------------------------- | ---------------------------------------------------- |\n| `onFilterListChanged` | `(event: FilterChangeEvent<Q>) => void` | Called on filter init and when filter state changes. |","table":"table-0"},"6177":{"id":"/components/filter-list-45","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                    | Type                                  | Description                                                                                                                                                                                                                                                                                                                                                                                       |\n| ----------------------- | ------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `onFilterClauseChanged` | `(newClause: WhereClause<Q>) => void` | **Deprecated** — Use `onFilterListChanged`, whose `snapshot` reports the clause alongside the filtered `ObjectSet`. Called whenever the filter clause changes. FilterList owns filter state; this is how you read it out, e.g. to feed an `ObjectTable`'s `filter`.<br /><br />`HAS_LINK` and `LINKED_PROPERTY` filters are not represented in the clause — use `onEffectiveObjectSet` for those. |","table":"table-0"},"6178":{"id":"/components/filter-list-46","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                   | Type                                                                    | Description                                                                                                                                                   |\n| ---------------------- | ----------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `onFilterStateChanged` | `(definition: FilterDefinitionUnion<Q>, newState: FilterState) => void` | **Deprecated** — Use `onFilterListChanged`, which reports every set / clear / reset with an `event` describing what changed. Called when filter state changes |","table":"table-0"},"6179":{"id":"/components/filter-list-47","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                   | Type                                | Description                                                                                                                                                                                                                                                                                                                 |\n| ---------------------- | ----------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `onEffectiveObjectSet` | `(objectSet: ObjectSet<Q>) => void` | **Deprecated** — Use `onFilterListChanged`, whose `snapshot.filteredObjectSet` reports the same filtered set alongside the clause. Called with the filtered `ObjectSet` whenever filters change. Requires `objectSet` to be set. `HAS_LINK` and `LINKED_PROPERTY` filters apply only here, never through the filter clause. |","table":"table-0"},"6180":{"id":"/components/filter-list-48","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name            | Type                             | Description                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |\n| --------------- | -------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `addFilterMode` | `\"controlled\" \\| \"uncontrolled\"` | **Deprecated** — Going away; visibility will always be managed internally. Seed it with `isVisible` on each `filterDefinitions` entry and observe changes with `onFilterVisibilityChange`. Controls how filter visibility (add/remove) is managed.<br /><br />- `\"uncontrolled\"` (default): FilterList manages visibility internally. An \"Add filter\" popover is rendered for filters with `isVisible: false`, and each visible filter shows a remove button. - `\"controlled\"`: The consumer manages which filters are visible via `filterDefinitions`. Filters with `isVisible: false` are excluded from the rendered list. Defaults to `\"uncontrolled\"`. |","table":"table-0"},"6181":{"id":"/components/filter-list-49","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                    | Type                    | Description                                                                                                                                                            |\n| ----------------------- | ----------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `renderAddFilterButton` | `() => React.ReactNode` | Custom render function for the \"Add filter\" button. Customizes the trigger element for the built-in add-filter popover; the popover behavior is handled automatically. |","table":"table-0"},"6182":{"id":"/components/filter-list-50","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name            | Type                                                                           | Description                                                            |\n| --------------- | ------------------------------------------------------------------------------ | ---------------------------------------------------------------------- |\n| `onFilterAdded` | `(filterKey: string, newDefinitions: Array<FilterDefinitionUnion<Q>>) => void` | Called after a filter is shown from the built-in \"Add filter\" popover. |","table":"table-0"},"6183":{"id":"/components/filter-list-51","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name              | Type                          | Description                                                                                        |\n| ----------------- | ----------------------------- | -------------------------------------------------------------------------------------------------- |\n| `onFilterRemoved` | `(filterKey: string) => void` | Called after a filter's remove button is clicked, once the filter is hidden and its state cleared. |","table":"table-0"},"6184":{"id":"/components/filter-list-52","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name            | Type      | Description                                                                                                                                                                                                                                              |\n| --------------- | --------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `enableSorting` | `boolean` | Enable drag-and-drop reordering of filters. When `true`, drag handles are rendered and filters can be reordered.<br /><br />Reorder state is managed internally; persist `onFilterVisibilityChange` to track order across remounts. Defaults to `false`. |","table":"table-0"},"6185":{"id":"/components/filter-list-53","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                       | Type                                                                     | Description                                                                                                                                                                                                                                                                                                                                                               |\n| -------------------------- | ------------------------------------------------------------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `onFilterVisibilityChange` | `(newStates: Array<{ filterKey: string; isVisible: boolean; }>) => void` | Called when filter visibility or ordering changes, i.e. when filters are reordered, added or removed via the built-in show/remove controls, or reset.<br /><br />Visible filters come first, in display order, followed by the hidden ones. Persist this array and feed it back as the order and `isVisible` of `filterDefinitions` to make reordering survive a remount. |","table":"table-0"},"6186":{"id":"/components/filter-list-54","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name             | Type      | Description                                                                                                                                                                                         |\n| ---------------- | --------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `enableCollapse` | `boolean` | Whether the collapse/expand control is available. When `false` the panel is always expanded, no collapse control is rendered, and `collapsed` / `defaultCollapsed` are ignored. Defaults to `true`. |","table":"table-0"},"6187":{"id":"/components/filter-list-55","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name        | Type      | Description                                                                                                                                                                                                                                                                                                                                               |\n| ----------- | --------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `collapsed` | `boolean` | Controlled mode. When supplied, this prop is the source of truth for whether the panel is collapsed and the component keeps no internal state; re-render with a new value in response to `onCollapsedChange`.<br /><br />If both `collapsed` and `defaultCollapsed` are provided, `collapsed` takes precedence. Ignored when `enableCollapse` is `false`. |","table":"table-0"},"6188":{"id":"/components/filter-list-56","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name               | Type      | Description                                                                                                                                                                                                                                                                                                                      |\n| ------------------ | --------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `defaultCollapsed` | `boolean` | Uncontrolled mode. Seeds the panel's internal collapsed state; the component continues to own the state after mount, so later changes to this prop are ignored.<br /><br />If both `collapsed` and `defaultCollapsed` are provided, `collapsed` takes precedence. Ignored when `enableCollapse` is `false`. Defaults to `false`. |","table":"table-0"},"6189":{"id":"/components/filter-list-57","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                | Type                           | Description                                  |\n| ------------------- | ------------------------------ | -------------------------------------------- |\n| `onCollapsedChange` | `(collapsed: boolean) => void` | Called whenever the collapsed state changes. |","table":"table-0"},"6190":{"id":"/components/filter-list-58","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name              | Type      | Description                         |\n| ----------------- | --------- | ----------------------------------- |\n| `showResetButton` | `boolean` | Show reset filters button in header |","table":"table-0"},"6191":{"id":"/components/filter-list-59","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name      | Type         | Description                         |\n| --------- | ------------ | ----------------------------------- |\n| `onReset` | `() => void` | Called when reset button is clicked |","table":"table-0"},"6192":{"id":"/components/filter-list-60","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name    | Type        | Description                                         |\n| ------- | ----------- | --------------------------------------------------- |\n| `title` | `ReactNode` | Optional title to display in the filter list header |","table":"table-0"},"6193":{"id":"/components/filter-list-61","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name        | Type              | Description                                |\n| ----------- | ----------------- | ------------------------------------------ |\n| `titleIcon` | `React.ReactNode` | Optional icon to display next to the title |","table":"table-0"},"6194":{"id":"/components/filter-list-62","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                    | Type      | Description                            |\n| ----------------------- | --------- | -------------------------------------- |\n| `showActiveFilterCount` | `boolean` | Show count of active filters in header |","table":"table-0"},"6195":{"id":"/components/filter-list-63","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name                    | Type      | Description                                                                                                                                             |\n| ----------------------- | --------- | ------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `showFilteredOutValues` | `boolean` | When `true`, facets render greyed-out count=0 rows for values present in the unfiltered data but excluded by other active filters. Defaults to `false`. |","table":"table-0"},"6196":{"id":"/components/filter-list-64","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#props-reference","content":"| Name        | Type     | Description               |\n| ----------- | -------- | ------------------------- |\n| `className` | `string` | Additional CSS class name |","table":"table-0"},"6197":{"id":"/components/filter-list-65","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"| Type       | Description                                    |\n| ---------- | ---------------------------------------------- |\n| `PROPERTY` | Filter on a direct property of the object type |","table":"table-1"},"6198":{"id":"/components/filter-list-66","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"| Type             | Description                             |\n| ---------------- | --------------------------------------- |\n| `KEYWORD_SEARCH` | Full-text keyword search across objects |","table":"table-1"},"6199":{"id":"/components/filter-list-67","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"| Type     | Description                                      |\n| -------- | ------------------------------------------------ |\n| `CUSTOM` | Custom filter with user-provided render function |","table":"table-1"},"6200":{"id":"/components/filter-list-68","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"| Type       | Description                             |\n| ---------- | --------------------------------------- |\n| `HAS_LINK` | Toggle filter for whether a link exists |","table":"table-1"},"6201":{"id":"/components/filter-list-69","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"| Type              | Description                                  |\n| ----------------- | -------------------------------------------- |\n| `LINKED_PROPERTY` | Filter on a property of a linked object type |","table":"table-1"},"6202":{"id":"/components/filter-list-70","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"| Type            | Description                                         |\n| --------------- | --------------------------------------------------- |\n| `STATIC_VALUES` | Filter on a fixed list of values (no OSDK fetching) |","table":"table-1"},"6203":{"id":"/components/filter-list-71","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#filter-definition-types","content":"Each filter definition type's fields are documented below."},"6204":{"id":"/components/filter-list-72","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"When using `type: \"PROPERTY\"`, the definition supports:"},"6205":{"id":"/components/filter-list-73","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"Type parameters: `Q extends ObjectTypeDefinition`, `K extends PropertyKeys<Q> = PropertyKeys<Q>`, `C extends ValidComponentsForPropertyType<PropertyTypeFromKey<Q, K>> = ValidComponentsForPropertyType<PropertyTypeFromKey<Q, K>>`"},"6206":{"id":"/components/filter-list-74","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name          | Type      | Description                                                                                                                                                                                                                        |\n| ------------- | --------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `searchField` | `boolean` | When `false`, the header monocle (search-values icon) is hidden even for filter components that ordinarily support in-filter search. Useful for `MULTI_SELECT`, which already has its own inline search field. Defaults to `true`. |","table":"table-2"},"6207":{"id":"/components/filter-list-75","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name | Type     | Description                                                                                                                                                                                                                                                                                                                                                       |\n| ---- | -------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `id` | `string` | Optional unique identifier for stable keying across filter reorders. Set it explicitly when that derived value would collide, e.g. two filters on the same property.<br /><br />This is the key used in `defaultFilterStates`; `getFilterKey(definition)` returns it. Defaults to a value derived from the definition (its `key`, or its link and property names) |","table":"table-2"},"6208":{"id":"/components/filter-list-76","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name        | Type      | Description                                                                                                                |\n| ----------- | --------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `isVisible` | `boolean` | Controls whether this filter is rendered. When false, the filter is hidden but its state is preserved. Defaults to `true`. |","table":"table-2"},"6209":{"id":"/components/filter-list-77","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name   | Type         | Description                                            |\n| ------ | ------------ | ------------------------------------------------------ |\n| `type` | `\"PROPERTY\"` | **Required.** Discriminator for filter definition type |","table":"table-2"},"6210":{"id":"/components/filter-list-78","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name  | Type | Description                                 |\n| ----- | ---- | ------------------------------------------- |\n| `key` | `K`  | **Required.** The property key to filter on |","table":"table-2"},"6211":{"id":"/components/filter-list-79","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name    | Type     | Description                  |\n| ------- | -------- | ---------------------------- |\n| `label` | `string` | Display label for the filter |","table":"table-2"},"6212":{"id":"/components/filter-list-80","page_id":"/components/filter-list","tags":[],"type":"text","url":"/components/filter-list#property-filter-definition","content":"| Name              | Type | Description                                                                                                                                          |\n| ----------------- | ---- | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `filterComponent` | `C`  | **Required.** The filter component type to render Must be compatible with the property type derived from the 