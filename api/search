------------------------ | -------------------------- | ---------------- | ------ |\n| `CbacBanners.get(client, { markingIds, preview })` | `GET /v2/admin/cbacBanner` | `api:admin-read` | Beta   |","table":"table-4"},"2675":{"id":"/platform/users-and-groups-73","page_id":"/platform/users-and-groups","tags":[],"type":"text","url":"/platform/users-and-groups#reference","content":"The package also covers creating and deleting users and groups, organizations, roles, enrollments, and authentication providers. Browse the exports of `@osdk/foundry.admin` in your editor for the full list."},"2676":{"id":"/react/actions","page_id":"/react/actions","type":"page","content":"Apply actions","breadcrumbs":["OSDK TypeScript","React","Write data"],"tags":[],"url":"/react/actions"},"2677":{"id":"/react/actions-0","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions","content":"Apply and validate ontology actions from React with useOsdkAction, including error handling, debounced validation, and batch application."},"2678":{"id":"/react/actions-1","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#apply-an-action","content":"Apply an action"},"2679":{"id":"/react/actions-2","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#return-value","content":"Return value"},"2680":{"id":"/react/actions-3","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#read-the-result","content":"Read the result"},"2681":{"id":"/react/actions-4","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#handle-errors","content":"Handle errors"},"2682":{"id":"/react/actions-5","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#validate-before-submitting","content":"Validate before submitting"},"2683":{"id":"/react/actions-6","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#apply-an-action-in-a-batch","content":"Apply an action in a batch"},"2684":{"id":"/react/actions-7","page_id":"/react/actions","type":"heading","tags":[],"url":"/react/actions#apply-an-action-with-the-client","content":"Apply an action with the client"},"2685":{"id":"/react/actions-8","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions","content":"Use `useOsdkAction` to apply an action, validate its parameters before submitting, and track pending and error state. When an action succeeds, the cache refetches every object it edited, so components that show those objects update without extra code."},"2686":{"id":"/react/actions-9","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action","content":"Pass the action from your generated SDK, then call `applyAction` with its parameters:"},"2687":{"id":"/react/actions-10","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action","content":"`applyAction` rethrows every failure after it records it in `error`. Always `await` it inside `try`/`catch`, or attach `.catch`, or the failure becomes an unhandled promise rejection."},"2688":{"id":"/react/actions-11","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action","content":"Parameters are typed from the action's definition. Object parameters accept an object instance or its primary key."},"2689":{"id":"/react/actions-12","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field         | Type                                                           | Description                                                                                                                                                   |\n| ------------- | -------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `applyAction` | `(args \\| args[]) => Promise<ActionEditResponse \\| undefined>` | Applies the action. Pass one parameter object, or an array to apply it in a batch. Each parameter object can include `$optimisticUpdate`. Rejects on failure. |","table":"table-0"},"2690":{"id":"/react/actions-13","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field       | Type      | Description                            |\n| ----------- | --------- | -------------------------------------- |\n| `isPending` | `boolean` | `true` while `applyAction` is running. |","table":"table-0"},"2691":{"id":"/react/actions-14","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field  | Type                              | Description                                     |\n| ------ | --------------------------------- | ----------------------------------------------- |\n| `data` | `ActionEditResponse \\| undefined` | The edits from the last successful application. |","table":"table-0"},"2692":{"id":"/react/actions-15","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field   | Type                                                                           | Description                                                                                   |\n| ------- | ------------------------------------------------------------------------------ | --------------------------------------------------------------------------------------------- |\n| `error` | `{ actionValidation?: ActionValidationError; unknown?: unknown } \\| undefined` | The last failure from `applyAction` or `validateAction`. Cleared when either is called again. |","table":"table-0"},"2693":{"id":"/react/actions-16","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field            | Type                                                       | Description                                                                              |\n| ---------------- | ---------------------------------------------------------- | ---------------------------------------------------------------------------------------- |\n| `validateAction` | `(args) => Promise<ActionValidationResponse \\| undefined>` | Checks parameters on the server without applying the action. Rejects on request failure. |","table":"table-0"},"2694":{"id":"/react/actions-17","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field          | Type      | Description                               |\n| -------------- | --------- | ----------------------------------------- |\n| `isValidating` | `boolean` | `true` while `validateAction` is running. |","table":"table-0"},"2695":{"id":"/react/actions-18","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"| Field              | Type                                    | Description                                  |\n| ------------------ | --------------------------------------- | -------------------------------------------- |\n| `validationResult` | `ActionValidationResponse \\| undefined` | The result of the last completed validation. |","table":"table-0"},"2696":{"id":"/react/actions-19","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#return-value","content":"The hook takes no options. `$optimisticUpdate` is covered in Optimistic updates."},"2697":{"id":"/react/actions-20","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"`data` is an `ActionEditResponse`: a summary of what the action changed, not a value returned by the action's logic."},"2698":{"id":"/react/actions-21","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field  | Type                           | Description                                                                                                        |\n| ------ | ------------------------------ | ------------------------------------------------------------------------------------------------------------------ |\n| `type` | `\"edits\" \\| \"largeScaleEdits\"` | `\"largeScaleEdits\"` when the action edited too many objects to list. Only `editedObjectTypes` is set in that case. |","table":"table-1"},"2699":{"id":"/react/actions-22","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field          | Type                                | Description                 |\n| -------------- | ----------------------------------- | --------------------------- |\n| `addedObjects` | `Array<{ objectType, primaryKey }>` | Objects the action created. |","table":"table-1"},"2700":{"id":"/react/actions-23","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field             | Type                                | Description                 |\n| ----------------- | ----------------------------------- | --------------------------- |\n| `modifiedObjects` | `Array<{ objectType, primaryKey }>` | Objects the action changed. |","table":"table-1"},"2701":{"id":"/react/actions-24","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field            | Type                                | Description                 |\n| ---------------- | ----------------------------------- | --------------------------- |\n| `deletedObjects` | `Array<{ objectType, primaryKey }>` | Objects the action deleted. |","table":"table-1"},"2702":{"id":"/react/actions-25","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field                         | Type                   | Description                                                            |\n| ----------------------------- | ---------------------- | ---------------------------------------------------------------------- |\n| `addedLinks` / `deletedLinks` | `Array<LinkReference>` | Links created or removed, with both sides and the link type API names. |","table":"table-1"},"2703":{"id":"/react/actions-26","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field                                       | Type     | Description          |\n| ------------------------------------------- | -------- | -------------------- |\n| `deletedObjectsCount` / `deletedLinksCount` | `number` | Counts of deletions. |","table":"table-1"},"2704":{"id":"/react/actions-27","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"| Field               | Type            | Description                                        |\n| ------------------- | --------------- | -------------------------------------------------- |\n| `editedObjectTypes` | `Array<string>` | API names of every object type the action touched. |","table":"table-1"},"2705":{"id":"/react/actions-28","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#read-the-result","content":"`applyAction` resolves to the same value, which is the simplest way to act on a new object's primary key:"},"2706":{"id":"/react/actions-29","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#handle-errors","content":"`error` separates validation failures from everything else:"},"2707":{"id":"/react/actions-30","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#handle-errors","content":"`error.actionValidation` is an `ActionValidationError`. The server rejected the parameters, for example because a submission criterion failed or a value is out of range."},"2708":{"id":"/react/actions-31","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#handle-errors","content":"`error.unknown` holds any other failure: network errors, permission errors, or a `PalantirApiError` from Foundry."},"2709":{"id":"/react/actions-32","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#handle-errors","content":"Do not show `error.actionValidation.message` to users. It is `\"Validation Error: \"` followed by the raw validation response as JSON. Read the structured response from `error.actionValidation.validation` instead. This helper turns either a validation error or a `validationResult` into messages:"},"2710":{"id":"/react/actions-33","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#handle-errors","content":"Use it with the hook's `error`:"},"2711":{"id":"/react/actions-34","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#handle-errors","content":"`submissionCriteria[].configuredFailureMessage` is the message the action's author configured in Foundry, so prefer it when it is present."},"2712":{"id":"/react/actions-35","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"`validateAction` asks the server whether a set of parameters would pass, without applying the action. An `INVALID` result is not an error: it resolves normally and sets `validationResult`. `validateAction` rejects only when the request itself fails, so it needs a `catch` like `applyAction`."},"2713":{"id":"/react/actions-36","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"Validating on every keystroke sends a request per keystroke. Wrap the call in `useDebouncedCallback`, exported from `@osdk/react`, so it runs once the user pauses:"},"2714":{"id":"/react/actions-37","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"How validation and application interact:"},"2715":{"id":"/react/actions-38","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"A new `validateAction` call supersedes one still in flight. The earlier result is discarded and resolves to `undefined`."},"2716":{"id":"/react/actions-39","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"`validateAction` does nothing and resolves to `undefined` while `applyAction` is running."},"2717":{"id":"/react/actions-40","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"`applyAction` discards any validation in flight."},"2718":{"id":"/react/actions-41","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"`validationResult` keeps the last completed result until the next validation finishes, so it can describe older input. Gate submission on `isValidating` as well, as the example does."},"2719":{"id":"/react/actions-42","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#validate-before-submitting","content":"The debounced function also has `cancel()`, which drops a pending call, and `flush()`, which runs it immediately. A pending call is dropped when the component unmounts."},"2720":{"id":"/react/actions-43","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-in-a-batch","content":"Pass an array to apply the same action to several parameter sets in one request:"},"2721":{"id":"/react/actions-44","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-in-a-batch","content":"A batch is applied with the batch apply endpoint, so it differs from a single call:"},"2722":{"id":"/react/actions-45","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-in-a-batch","content":"A batch that the server rejects reports the failure in `error.unknown`. `error.actionValidation` is set only for single applications."},"2723":{"id":"/react/actions-46","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-in-a-batch","content":"`validateAction` takes one parameter object, not an array."},"2724":{"id":"/react/actions-47","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-in-a-batch","content":"Each item can carry its own `$optimisticUpdate`. They are combined into one optimistic layer."},"2725":{"id":"/react/actions-48","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-with-the-client","content":"You can also apply an action with the `Client` from `useOsdkClient`. This bypasses the cache: components do not update until you invalidate the affected data yourself (see Invalidate the cache). Prefer `useOsdkAction` in components."},"2726":{"id":"/react/actions-49","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-with-the-client","content":"| Option         | Type      | Default | Description                                                                            |\n| -------------- | --------- | ------- | -------------------------------------------------------------------------------------- |\n| `$returnEdits` | `boolean` | `false` | Resolve to an `ActionEditResponse`. Without it, `applyAction` resolves to `undefined`. |","table":"table-2"},"2727":{"id":"/react/actions-50","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-with-the-client","content":"| Option          | Type      | Default | Description                                                                                                       |\n| --------------- | --------- | ------- | ----------------------------------------------------------------------------------------------------------------- |\n| `$validateOnly` | `boolean` | `false` | Validate without applying, and resolve to the `ActionValidationResponse`. Cannot be combined with `$returnEdits`. |","table":"table-2"},"2728":{"id":"/react/actions-51","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-with-the-client","content":"A single `applyAction` call on the client throws an `ActionValidationError` when validation fails. For several parameter sets, call `client(modifyEmployee).batchApplyAction([...], { $returnEdits: true })`. It accepts `$returnEdits` but not `$validateOnly`."},"2729":{"id":"/react/actions-52","page_id":"/react/actions","tags":[],"type":"text","url":"/react/actions#apply-an-action-with-the-client","content":"For a generated form with fields for every parameter, see the ActionForm component."},"2730":{"id":"/react/aggregations","page_id":"/react/aggregations","type":"page","content":"Aggregate objects","breadcrumbs":["OSDK TypeScript","React","Read data"],"tags":[],"url":"/react/aggregations"},"2731":{"id":"/react/aggregations-0","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations","content":"Count, sum, average, and group objects on the server with useOsdkAggregation, without loading the objects into the browser."},"2732":{"id":"/react/aggregations-1","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#count-and-summarize","content":"Count and summarize"},"2733":{"id":"/react/aggregations-2","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#metrics","content":"Metrics"},"2734":{"id":"/react/aggregations-3","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#filter-before-aggregating","content":"Filter before aggregating"},"2735":{"id":"/react/aggregations-4","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#group-results","content":"Group results"},"2736":{"id":"/react/aggregations-5","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#grouping-strategies","content":"Grouping strategies"},"2737":{"id":"/react/aggregations-6","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#aggregate-an-object-set","content":"Aggregate an object set"},"2738":{"id":"/react/aggregations-7","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#refresh-and-disable","content":"Refresh and disable"},"2739":{"id":"/react/aggregations-8","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#reference","content":"Reference"},"2740":{"id":"/react/aggregations-9","page_id":"/react/aggregations","type":"heading","tags":[],"url":"/react/aggregations#useosdkaggregationtype-options","content":"`useOsdkAggregation(type, options)`"},"2741":{"id":"/react/aggregations-10","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations","content":"`useOsdkAggregation` asks the server for counts, sums, averages, and other metrics over a set of objects, optionally grouped by property values. Only the results come back, so a total over a million objects costs one small response."},"2742":{"id":"/react/aggregations-11","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#count-and-summarize","content":"Pass an object type and an `aggregate` with a `$select`. Each key in `$select` is a metric to compute:"},"2743":{"id":"/react/aggregations-12","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#count-and-summarize","content":"`$count` is read as `data.$count`. A `\"property:metric\"` key is read as `data.property.metric`, so `\"salary:avg\"` becomes `data.salary.avg`. The result is fully typed from the keys you pass."},"2744":{"id":"/react/aggregations-13","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#metrics","content":"| Key      | Property types | Result   |\n| -------- | -------------- | -------- |\n| `$count` |                | `number` |","table":"table-0"},"2745":{"id":"/react/aggregations-14","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#metrics","content":"| Key                                | Property types | Result                                              |\n| ---------------------------------- | -------------- | --------------------------------------------------- |\n| `\"property:sum\"`, `\"property:avg\"` | Numeric        | `number`, or `undefined` when no object has a value |","table":"table-0"},"2746":{"id":"/react/aggregations-15","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#metrics","content":"| Key                                | Property types           | Result                                    |\n| ---------------------------------- | ------------------------ | ----------------------------------------- |\n| `\"property:min\"`, `\"property:max\"` | Numeric, date, timestamp | Same type as the property, or `undefined` |","table":"table-0"},"2747":{"id":"/react/aggregations-16","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#metrics","content":"| Key                        | Property types | Result                      |\n| -------------------------- | -------------- | --------------------------- |\n| `\"property:exactDistinct\"` | All            | `number` of distinct values |","table":"table-0"},"2748":{"id":"/react/aggregations-17","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#metrics","content":"| Key                              | Property types | Result                                                               |\n| -------------------------------- | -------------- | -------------------------------------------------------------------- |\n| `\"property:approximateDistinct\"` | All            | Estimated `number` of distinct values. Faster on large object types. |","table":"table-0"},"2749":{"id":"/react/aggregations-18","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#metrics","content":"TypeScript rejects a metric that does not fit the property, such as `avg` on a string."},"2750":{"id":"/react/aggregations-19","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#filter-before-aggregating","content":"`where` takes the same clause as `useOsdkObjects`. `intersectWith` adds clauses that every object must also match."},"2751":{"id":"/react/aggregations-20","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#filter-before-aggregating","content":"`withProperties` defines derived properties that `where` can filter on."},"2752":{"id":"/react/aggregations-21","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#group-results","content":"Add `$groupBy` to get one row per group. `data` is then an array; each row has a `$group` object with the group's values, plus the metrics from `$select`."},"2753":{"id":"/react/aggregations-22","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#group-results","content":"The value of each `$select` key sets the order of the rows: `\"asc\"` or `\"desc\"` sorts by that metric, and `\"unordered\"` leaves it to the server. Above, departments come back largest first."},"2754":{"id":"/react/aggregations-23","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy  | Property types | Groups by            |\n| --------- | -------------- | -------------------- |\n| `\"exact\"` | All            | Each distinct value. |","table":"table-1"},"2755":{"id":"/react/aggregations-24","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy                 | Property types | Groups by                                |\n| ------------------------ | -------------- | ---------------------------------------- |\n| `{ $exactWithLimit: n }` | All            | Each distinct value, at most `n` groups. |","table":"table-1"},"2756":{"id":"/react/aggregations-25","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy                                           | Property types | Groups by                                                                                |\n| -------------------------------------------------- | -------------- | ---------------------------------------------------------------------------------------- |\n| `{ $exact: { $limit?, $includeNullValue: true } }` | All            | Each distinct value, plus a group for missing values. `$group` values are then nullable. |","table":"table-1"},"2757":{"id":"/react/aggregations-26","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy                                      | Property types | Groups by                                                           |\n| --------------------------------------------- | -------------- | ------------------------------------------------------------------- |\n| `{ $exact: { $limit?, $defaultValue: \"…\" } }` | All            | Each distinct value, with missing values grouped under the default. |","table":"table-1"},"2758":{"id":"/react/aggregations-27","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy             | Property types | Groups by             |\n| -------------------- | -------------- | --------------------- |\n| `{ $fixedWidth: n }` | Numeric        | Buckets of width `n`. |","table":"table-1"},"2759":{"id":"/react/aggregations-28","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy                         | Property types           | Groups by                                                       |\n| -------------------------------- | ------------------------ | --------------------------------------------------------------- |\n| `{ $ranges: [[start, end], …] }` | Numeric, date, timestamp | The ranges you list. `$group` holds `{ startValue, endValue }`. |","table":"table-1"},"2760":{"id":"/react/aggregations-29","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"| Strategy                   | Property types  | Groups by                                                                                                                                  |\n| -------------------------- | --------------- | ------------------------------------------------------------------------------------------------------------------------------------------ |\n| `{ $duration: [n, unit] }` | Date, timestamp | Time buckets, such as `[1, \"years\"]` or `[1, \"month\"]`. Dates accept day units and up; timestamps also accept seconds, minutes, and hours. |","table":"table-1"},"2761":{"id":"/react/aggregations-30","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"Group by several properties to get one row per combination:"},"2762":{"id":"/react/aggregations-31","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#grouping-strategies","content":"The hook infers `aggregate` as a constant, which makes the tuples in `$ranges` and `$duration` read-only. TypeScript then loses the result type and `row.$group` has no properties. Assert the tuple type to keep it: `{ $ranges: [[0, 50000], [50000, 100000]] as [number, number][] }` or `{ $duration: [1, \"years\"] as [1, \"years\"] }`."},"2763":{"id":"/react/aggregations-32","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#aggregate-an-object-set","content":"To aggregate a set that a type and a `where` cannot express, such as a pivot or a union, pass it as `objectSet`. The first argument must be the type of that set. `where`, `intersectWith`, and `withProperties` still apply on top of it."},"2764":{"id":"/react/aggregations-33","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#aggregate-an-object-set","content":"`objectSet` must be an `ObjectSet`, not `undefined`, and works with object types only. The `objectSet` field returned by `useOsdkObjects` and `useObjectSet` is `undefined` until their first page loads, so build the set with the client as above when you need it on the first render. See Work with object sets for union, intersect, and subtract."},"2765":{"id":"/react/aggregations-34","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#refresh-and-disable","content":"Aggregations recompute when an action changes the object type, like other queries. `refetch` invalidates the object type, which refetches every cached query for that type."},"2766":{"id":"/react/aggregations-35","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#refresh-and-disable","content":"With `enabled: false`, the hook does not fetch and returns `data: undefined`, `isLoading: false`, and `error: undefined`. `refetch` does nothing while disabled."},"2767":{"id":"/react/aggregations-36","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option      | Type                     | Default  | Description                                       |\n| ----------- | ------------------------ | -------- | ------------------------------------------------- |\n| `aggregate` | `{ $select, $groupBy? }` | Required | The metrics to compute and the optional grouping. |","table":"table-2"},"2768":{"id":"/react/aggregations-37","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option              | Type                                           | Default  | Description                                                                       |\n| ------------------- | ---------------------------------------------- | -------- | --------------------------------------------------------------------------------- |\n| `aggregate.$select` | `{ [metric]: \"unordered\" \\| \"asc\" \\| \"desc\" }` | Required | Metric keys, such as `$count` or `\"salary:avg\"`, and how to order groups by them. |","table":"table-2"},"2769":{"id":"/react/aggregations-38","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option               | Type                       | Default | Description                                         |\n| -------------------- | -------------------------- | ------- | --------------------------------------------------- |\n| `aggregate.$groupBy` | `{ [property]: strategy }` |         | Group by these properties. See Grouping strategies. |","table":"table-2"},"2770":{"id":"/react/aggregations-39","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option  | Type             | Default | Description               |\n| ------- | ---------------- | ------- | ------------------------- |\n| `where` | `WhereClause<T>` |         | Filter the objects first. |","table":"table-2"},"2771":{"id":"/react/aggregations-40","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option          | Type                               | Default | Description                                           |\n| --------------- | ---------------------------------- | ------- | ----------------------------------------------------- |\n| `intersectWith` | `Array<{ where: WhereClause<T> }>` |         | Additional filters that every object must also match. |","table":"table-2"},"2772":{"id":"/react/aggregations-41","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option           | Type                     | Default | Description                                    |\n| ---------------- | ------------------------ | ------- | ---------------------------------------------- |\n| `withProperties` | `DerivedProperty.Clause` |         | Derived properties that `where` can reference. |","table":"table-2"},"2773":{"id":"/react/aggregations-42","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option      | Type           | Default | Description                                                              |\n| ----------- | -------------- | ------- | ------------------------------------------------------------------------ |\n| `objectSet` | `ObjectSet<T>` |         | Aggregate this set instead of every object of `type`. Object types only. |","table":"table-2"},"2774":{"id":"/react/aggregations-43","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option    | Type      | Default | Description                       |\n| --------- | --------- | ------- | --------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made. |","table":"table-2"},"2775":{"id":"/react/aggregations-44","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Option             | Type     | Default | Description                                                  |\n| ------------------ | -------- | ------- | ------------------------------------------------------------ |\n| `dedupeIntervalMs` | `number` | `2000`  | Identical aggregations within this window share one request. |","table":"table-2"},"2776":{"id":"/react/aggregations-45","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Return | Type                                         | Description                                                                                  |\n| ------ | -------------------------------------------- | -------------------------------------------------------------------------------------------- |\n| `data` | Result object, array of rows, or `undefined` | An object of metrics without `$groupBy`; an array of rows with `$group` and metrics with it. |","table":"table-3"},"2777":{"id":"/react/aggregations-46","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Return      | Type      | Description                          |\n| ----------- | --------- | ------------------------------------ |\n| `isLoading` | `boolean` | `true` while a request is in flight. |","table":"table-3"},"2778":{"id":"/react/aggregations-47","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Return  | Type                 | Description                                |\n| ------- | -------------------- | ------------------------------------------ |\n| `error` | `Error \\| undefined` | The last error, if the aggregation failed. |","table":"table-3"},"2779":{"id":"/react/aggregations-48","page_id":"/react/aggregations","tags":[],"type":"text","url":"/react/aggregations#useosdkaggregationtype-options","content":"| Return    | Type                  | Description                                                     |\n| --------- | --------------------- | --------------------------------------------------------------- |\n| `refetch` | `() => Promise<void>` | Invalidate the object type and recompute. No-op while disabled. |","table":"table-3"},"2780":{"id":"/react/cache-invalidation","page_id":"/react/cache-invalidation","type":"page","content":"Invalidate the cache","breadcrumbs":["OSDK TypeScript","React","Cache"],"tags":[],"url":"/react/cache-invalidation"},"2781":{"id":"/react/cache-invalidation-0","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation","content":"Refetch cached objects, lists, and function results with useObservableClient when data changes outside OSDK actions."},"2782":{"id":"/react/cache-invalidation-1","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#when-the-cache-updates-itself","content":"When the cache updates itself"},"2783":{"id":"/react/cache-invalidation-2","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#when-to-invalidate","content":"When to invalidate"},"2784":{"id":"/react/cache-invalidation-3","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#get-the-observable-client","content":"Get the observable client"},"2785":{"id":"/react/cache-invalidation-4","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#invalidation-methods","content":"Invalidation methods"},"2786":{"id":"/react/cache-invalidation-5","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#examples","content":"Examples"},"2787":{"id":"/react/cache-invalidation-6","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#after-an-external-write","content":"After an external write"},"2788":{"id":"/react/cache-invalidation-7","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#after-a-direct-client-call","content":"After a direct client call"},"2789":{"id":"/react/cache-invalidation-8","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#refresh-a-function","content":"Refresh a function"},"2790":{"id":"/react/cache-invalidation-9","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#refresh-when-another-service-notifies-you","content":"Refresh when another service notifies you"},"2791":{"id":"/react/cache-invalidation-10","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#best-practices","content":"Best practices"},"2792":{"id":"/react/cache-invalidation-11","page_id":"/react/cache-invalidation","type":"heading","tags":[],"url":"/react/cache-invalidation#debug-the-cache","content":"Debug the cache"},"2793":{"id":"/react/cache-invalidation-12","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation","content":"Invalidating cached data makes every component that shows it refetch. Most apps rarely need it: the cache updates itself after actions. This page covers the cases it cannot see and the methods that handle them. For how the cache stores and shares data, see Caching."},"2794":{"id":"/react/cache-invalidation-13","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-the-cache-updates-itself","content":"You do not need to invalidate after:"},"2795":{"id":"/react/cache-invalidation-14","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-the-cache-updates-itself","content":"**Actions applied with `useOsdkAction`.** The server reports which objects the action added, modified, and deleted. The cache refetches those objects, and every list, link, aggregation, and function that depends on their types re-evaluates."},"2796":{"id":"/react/cache-invalidation-15","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-the-cache-updates-itself","content":"**Optimistic updates.** They are removed when the action finishes. See Optimistic updates."},"2797":{"id":"/react/cache-invalidation-16","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-the-cache-updates-itself","content":"**Lists with `streamUpdates: true`.** The server pushes changes over a WebSocket."},"2798":{"id":"/react/cache-invalidation-17","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-the-cache-updates-itself","content":"**Functions with `dependsOn` or `dependsOnObjects`.** They rerun after actions edit what they declare. See Call functions."},"2799":{"id":"/react/cache-invalidation-18","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-to-invalidate","content":"The cache only learns about changes that pass through it. Invalidate when data changes some other way:"},"2800":{"id":"/react/cache-invalidation-19","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-to-invalidate","content":"A pipeline, schedule, or external system writes to the ontology."},"2801":{"id":"/react/cache-invalidation-20","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-to-invalidate","content":"Your code applies an action with the `Client` directly, as in `client(modifyEmployee).applyAction(...)`, instead of through `useOsdkAction`."},"2802":{"id":"/react/cache-invalidation-21","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-to-invalidate","content":"Another service tells your app, for example over its own WebSocket, that records changed."},"2803":{"id":"/react/cache-invalidation-22","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#when-to-invalidate","content":"A function reads data the cache cannot track, and you did not declare `dependsOn`."},"2804":{"id":"/react/cache-invalidation-23","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#get-the-observable-client","content":"`useObservableClient` returns the `ObservableClient` that `OsdkProvider` created. Call it in a component or hook below the provider, and call the invalidation methods from an event handler or effect:"},"2805":{"id":"/react/cache-invalidation-24","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#invalidation-methods","content":"| Method                       | Refetches                                                                                                                                                                                                                          | Use it when                             |\n| ---------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------------------------------- |\n| `invalidateObjects(objects)` | The given object or array of objects, in every variant cached for them. Also reruns functions that list one of them in `dependsOnObjects`, and refreshes links from or to their type. An object that is not cached yet is fetched. | You know exactly which objects changed. |","table":"table-0"},"2806":{"id":"/react/cache-invalidation-25","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#invalidation-methods","content":"| Method                       | Refetches                                                                                                                                                                                                                  | Use it when                                                 |\n| ---------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------- |\n| `invalidateObjectType(type)` | Every cached query that reads the type: its objects, lists and object sets over it, aggregations over it, links from or to it, and functions that declare it in `dependsOn`. Takes the type from your SDK or its API name. | Many objects of one type changed, or you do not know which. |","table":"table-0"},"2807":{"id":"/react/cache-invalidation-26","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#invalidation-methods","content":"| Method                            | Refetches                                                                                                                                                        | Use it when                                    |\n| --------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------- |\n| `invalidateFunction(fn, params?)` | With `params`, the one cached call with exactly those parameters. Without, every cached call of that function. Takes the function from your SDK or its API name. | A function's inputs changed outside the cache. |","table":"table-0"},"2808":{"id":"/react/cache-invalidation-27","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#invalidation-methods","content":"| Method                                             | Refetches                                              | Use it when                                                  |\n| -------------------------------------------------- | ------------------------------------------------------ | ------------------------------------------------------------ |\n| `invalidateFunctionsByObject(apiName, primaryKey)` | Functions that list that object in `dependsOnObjects`. | One object changed and you only want its functions to rerun. |","table":"table-0"},"2809":{"id":"/react/cache-invalidation-28","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#invalidation-methods","content":"| Method            | Refetches                | Use it when                                     |\n| ----------------- | ------------------------ | ----------------------------------------------- |\n| `invalidateAll()` | Everything in the cache. | Last resort, when you cannot tell what changed. |","table":"table-0"},"2810":{"id":"/react/cache-invalidation-29","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#invalidation-methods","content":"All methods return a promise that resolves when the refetches have settled. The promise does not reject: a failed refetch shows up as `error` on the hooks that read the data. While a refetch runs, those hooks keep their current data and report `isLoading: true`."},"2811":{"id":"/react/cache-invalidation-30","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#after-an-external-write","content":"A component that starts a server-side job, then refreshes the type the job writes to once it finishes:"},"2812":{"id":"/react/cache-invalidation-31","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#after-a-direct-client-call","content":"When you apply an action with the `Client`, invalidate what it edited. Ask for the edits with `$returnEdits` and invalidate by type:"},"2813":{"id":"/react/cache-invalidation-32","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#after-a-direct-client-call","content":"`useOsdkAction` does this for you, and more precisely, so prefer it. See Apply actions."},"2814":{"id":"/react/cache-invalidation-33","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#refresh-a-function","content":"For a single call site, `refetch` from `useOsdkFunction` does the same as `invalidateFunction` with that call's parameters."},"2815":{"id":"/react/cache-invalidation-34","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#refresh-when-another-service-notifies-you","content":"Subscribe in an effect and invalidate when a message arrives. `invalidateObjects` needs an object instance, so with only a primary key, invalidate the type, and rerun the functions bound to that one object with `invalidateFunctionsByObject`:"},"2816":{"id":"/react/cache-invalidation-35","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#best-practices","content":"**Let actions drive updates.** If a change comes from `useOsdkAction`, do not invalidate afterward. It refetches data that is already fresh."},"2817":{"id":"/react/cache-invalidation-36","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#best-practices","content":"**Invalidate the narrowest thing you can.** `invalidateObjects` is cheaper than `invalidateObjectType`, which is cheaper than `invalidateAll`."},"2818":{"id":"/react/cache-invalidation-37","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#best-practices","content":"**Declare function dependencies.** `dependsOn` and `dependsOnObjects` let the cache rerun functions after actions, so you do not invalidate them by hand."},"2819":{"id":"/react/cache-invalidation-38","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#best-practices","content":"**Do not invalidate on mount.** Calling `invalidateAll` or `invalidateObjectType` in a mount effect refetches on every navigation and defeats the cache."},"2820":{"id":"/react/cache-invalidation-39","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#best-practices","content":"**Keep OSDK data in the cache.** Copying it into component state, Redux, or another query library creates a second copy that invalidation and optimistic updates do not reach."},"2821":{"id":"/react/cache-invalidation-40","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#debug-the-cache","content":"The `devMode` prop on `OsdkProvider` turns on logging in development builds. It has no effect in production builds."},"2822":{"id":"/react/cache-invalidation-41","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#debug-the-cache","content":"| Option     | Type                                                           | Default   | Description                                                            |\n| ---------- | -------------------------------------------------------------- | --------- | ---------------------------------------------------------------------- |\n| `logLevel` | `\"trace\" \\| \"debug\" \\| \"info\" \\| \"warn\" \\| \"error\" \\| \"fatal\"` | `\"error\"` | Log level for the observable client. Set `\"debug\"` to see its tracing. |","table":"table-1"},"2823":{"id":"/react/cache-invalidation-42","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#debug-the-cache","content":"| Option            | Type      | Default | Description                                                                                                                               |\n| ----------------- | --------- | ------- | ----------------------------------------------------------------------------------------------------------------------------------------- |\n| `debug.refCounts` | `boolean` | `false` | Logs when cache entries are created, referenced, and cleaned up, and shortens how long unused entries are kept so cleanup happens sooner. |","table":"table-1"},"2824":{"id":"/react/cache-invalidation-43","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#debug-the-cache","content":"| Option            | Type      | Default | Description                                                  |\n| ----------------- | --------- | ------- | ------------------------------------------------------------ |\n| `debug.cacheKeys` | `boolean` | `false` | Logs cache-key lookups and whether each key already existed. |","table":"table-1"},"2825":{"id":"/react/cache-invalidation-44","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#debug-the-cache","content":"| Option          | Type     | Default | Description                                                          |\n| --------------- | -------- | ------- | -------------------------------------------------------------------- |\n| `actionDelayMs` | `number` | `1000`  | Delay before optimistic updates are removed. See Optimistic updates. |","table":"table-1"},"2826":{"id":"/react/cache-invalidation-45","page_id":"/react/cache-invalidation","tags":[],"type":"text","url":"/react/cache-invalidation#debug-the-cache","content":"To browse cache entries in the running app instead, use OSDK Devtools."},"2827":{"id":"/devtools/cache","page_id":"/devtools/cache","type":"page","content":"Cache","breadcrumbs":["OSDK TypeScript","React","Devtools"],"tags":[],"url":"/devtools/cache"},"2828":{"id":"/devtools/cache-0","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache","content":"Use the Cache tab in OSDK Devtools to inspect and invalidate observable cache entries and review recent cache hits and misses."},"2829":{"id":"/devtools/cache-1","page_id":"/devtools/cache","type":"heading","tags":[],"url":"/devtools/cache#cache-inspector","content":"Cache inspector"},"2830":{"id":"/devtools/cache-2","page_id":"/devtools/cache","type":"heading","tags":[],"url":"/devtools/cache#cache-history","content":"Cache history"},"2831":{"id":"/devtools/cache-3","page_id":"/devtools/cache","type":"heading","tags":[],"url":"/devtools/cache#related-metrics","content":"Related metrics"},"2832":{"id":"/devtools/cache-4","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache","content":"The Cache tab shows the entries in the `@osdk/react` observable cache and a timeline of recent cache hits and misses. Use it to confirm that a repeated read came from the cache, or to see when a read went to the network. For how the cache works, see Caching."},"2833":{"id":"/devtools/cache-5","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-inspector","content":"The summary shows the number of entries and their estimated total size. **Search cache** matches cache keys, object types, and entry types."},"2834":{"id":"/devtools/cache-6","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-inspector","content":"Each entry header shows its status (`init`, `loading`, `loaded`, or `error`), age, and estimated size. Expand an entry to see its cache key, current value, and query details."},"2835":{"id":"/devtools/cache-7","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-inspector","content":"| Control     | Effect                                                    |\n| ----------- | --------------------------------------------------------- |\n| **Refresh** | Reloads the inspector snapshot. It does not refetch data. |","table":"table-0"},"2836":{"id":"/devtools/cache-8","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-inspector","content":"| Control                         | Effect                   |\n| ------------------------------- | ------------------------ |\n| Refresh icon on an object entry | Invalidates that object. |","table":"table-0"},"2837":{"id":"/devtools/cache-9","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-inspector","content":"| Control                                           | Effect                                        |\n| ------------------------------------------------- | --------------------------------------------- |\n| Refresh icon on a list, link, or object set entry | Invalidates every entry for that object type. |","table":"table-0"},"2838":{"id":"/devtools/cache-10","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-inspector","content":"| Control         | Effect                                                                  |\n| --------------- | ----------------------------------------------------------------------- |\n| **Clear cache** | After you confirm, invalidates the whole cache. Active queries refetch. |","table":"table-0"},"2839":{"id":"/devtools/cache-11","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#cache-history","content":"Cache history lists recent cache hits and misses in time order. Each row shows the query or object signature, the time, and the response time when one was recorded."},"2840":{"id":"/devtools/cache-12","page_id":"/devtools/cache","tags":[],"type":"text","url":"/devtools/cache#related-metrics","content":"Requests saved, Cache hit rate, and Avg response time on Overview summarize the same operations. Select **View in Cache** under Cache hit rate to move from the metric to the entries behind it."},"2841":{"id":"/devtools/components","page_id":"/devtools/components","type":"page","content":"Components","breadcrumbs":["OSDK TypeScript","React","Devtools"],"tags":[],"url":"/devtools/components"},"2842":{"id":"/devtools/components-0","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components","content":"Use the Components tab in OSDK Devtools to find which React components call OSDK hooks and what objects, actions, and properties they use."},"2843":{"id":"/devtools/components-1","page_id":"/devtools/components","type":"heading","tags":[],"url":"/devtools/components#what-appears","content":"What appears"},"2844":{"id":"/devtools/components-2","page_id":"/devtools/components","type":"heading","tags":[],"url":"/devtools/components#find-a-component","content":"Find a component"},"2845":{"id":"/devtools/components-3","page_id":"/devtools/components","type":"heading","tags":[],"url":"/devtools/components#component-cards","content":"Component cards"},"2846":{"id":"/devtools/components-4","page_id":"/devtools/components","type":"heading","tags":[],"url":"/devtools/components#health-badge","content":"Health badge"},"2847":{"id":"/devtools/components-5","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components","content":"The Components tab maps `@osdk/react` hooks to the React components that mounted them. Use it to find the component that owns a query, compare components that read the same object type, or trace an overfetching recommendation back to its source."},"2848":{"id":"/devtools/components-6","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#what-appears","content":"Only components that call an `@osdk/react` hook, such as `useOsdkObject` or `useOsdkObjects`, appear. A component that only renders an OSDK-aware child like `ObjectTable`, or receives objects through props, does not appear; look for the child that owns the hook instead. Data loaded with raw network calls or another state library is not tracked."},"2849":{"id":"/devtools/components-7","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#what-appears","content":"Component attribution relies on the Fiber hook that the Vite plugin installs before React loads. If the panel shows a notice that component inspection is unavailable, see Troubleshooting."},"2850":{"id":"/devtools/components-8","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#find-a-component","content":"**Search ontology** matches component names and the object types and actions they use."},"2851":{"id":"/devtools/components-9","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#find-a-component","content":"The summary line counts mounted components, object types, and action types."},"2852":{"id":"/devtools/components-10","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#find-a-component","content":"The filter chips narrow the list to one object type or action. Select **All** to clear the filter."},"2853":{"id":"/devtools/components-11","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#component-cards","content":"Each card groups what the monitor observed for one component:"},"2854":{"id":"/devtools/components-12","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#component-cards","content":"| Section         | Contents                                             |\n| --------------- | ---------------------------------------------------- |\n| Related objects | Object types the component loads, with primary keys. |","table":"table-0"},"2855":{"id":"/devtools/components-13","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#component-cards","content":"| Section         | Contents                                             |\n| --------------- | ---------------------------------------------------- |\n| Related actions | Actions the component applies through `@osdk/react`. |","table":"table-0"},"2856":{"id":"/devtools/components-14","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#component-cards","content":"| Section            | Contents                                      |\n| ------------------ | --------------------------------------------- |\n| Related properties | Fields that the component's descendants read. |","table":"table-0"},"2857":{"id":"/devtools/components-15","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#component-cards","content":"| Section     | Contents                                   |\n| ----------- | ------------------------------------------ |\n| React props | Props captured from the mounted component. |","table":"table-0"},"2858":{"id":"/devtools/components-16","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#health-badge","content":"A card shows **Healthy** unless the monitor detects a problem. After a component has rendered more than five times, the monitor flags:"},"2859":{"id":"/devtools/components-17","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#health-badge","content":"Wasted renders: renders in which the component read no tracked property."},"2860":{"id":"/devtools/components-18","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#health-badge","content":"Properties the component accessed in fewer than 10% of its renders."},"2861":{"id":"/devtools/components-19","page_id":"/devtools/components","tags":[],"type":"text","url":"/devtools/components#health-badge","content":"An unhealthy card replaces the badge with a summary of what it found."},"2862":{"id":"/devtools/console","page_id":"/devtools/console","type":"page","content":"Console","breadcrumbs":["OSDK TypeScript","React","Devtools"],"tags":[],"url":"/devtools/console"},"2863":{"id":"/devtools/console-0","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console","content":"Use the Console tab in OSDK Devtools to search and filter browser console output captured while your OSDK React app runs."},"2864":{"id":"/devtools/console-1","page_id":"/devtools/console","type":"heading","tags":[],"url":"/devtools/console#search-and-filter","content":"Search and filter"},"2865":{"id":"/devtools/console-2","page_id":"/devtools/console","type":"heading","tags":[],"url":"/devtools/console#log-entries","content":"Log entries"},"2866":{"id":"/devtools/console-3","page_id":"/devtools/console","type":"heading","tags":[],"url":"/devtools/console#limits","content":"Limits"},"2867":{"id":"/devtools/console-4","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console","content":"The Console tab captures browser console output while the panel is active and keeps it as you navigate within the app. Use it to match an Errors & warnings count on Overview to the original message, or to keep a brief warning visible after the page changes."},"2868":{"id":"/devtools/console-5","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#search-and-filter","content":"**Filter logs** searches the serialized arguments of each entry."},"2869":{"id":"/devtools/console-6","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#search-and-filter","content":"The level menu shows all entries, or only `log`, `info`, `warn`, `error`, or `debug`."},"2870":{"id":"/devtools/console-7","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#search-and-filter","content":"**Clear logs**, in the same menu, empties the feed. It does not reset the other devtools metrics."},"2871":{"id":"/devtools/console-8","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#search-and-filter","content":"The toolbar shows counts for errors, warnings, and other entries. When a search or level filter hides entries, it also shows how many are hidden."},"2872":{"id":"/devtools/console-9","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#log-entries","content":"Each entry shows its level, timestamp, arguments, and source location when the browser provides one. Objects and errors are serialized with depth and size limits, so a large payload cannot take over the panel."},"2873":{"id":"/devtools/console-10","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#limits","content":"| Limit          | Value             |\n| -------------- | ----------------- |\n| Entries stored | 1,000 most recent |","table":"table-0"},"2874":{"id":"/devtools/console-11","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#limits","content":"| Limit            | Value                                                   |\n| ---------------- | ------------------------------------------------------- |\n| Entries rendered | 200 most recent that match the current search and level |","table":"table-0"},"2875":{"id":"/devtools/console-12","page_id":"/devtools/console","tags":[],"type":"text","url":"/devtools/console#limits","content":"Narrow the search or level filter to bring an older matching entry back into the rendered list."},"2876":{"id":"/devtools","page_id":"/devtools","type":"page","content":"OSDK Devtools","breadcrumbs":["OSDK TypeScript","React","Devtools"],"tags":[],"url":"/devtools"},"2877":{"id":"/devtools-0","page_id":"/devtools","tags":[],"type":"text","url":"/devtools","content":"Add an in-app panel that shows Ontology usage, hook owners, console output, and the observable cache of a running OSDK React app."},"2878":{"id":"/devtools-1","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#set-up-the-panel","content":"Set up the panel"},"2879":{"id":"/devtools-2","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#install-the-package","content":"Install the package"},"2880":{"id":"/devtools-3","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#add-the-vite-plugin","content":"Add the Vite plugin"},"2881":{"id":"/devtools-4","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#keep-your-existing-provider","content":"Keep your existing provider"},"2882":{"id":"/devtools-5","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#start-the-dev-server","content":"Start the dev server"},"2883":{"id":"/devtools-6","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#plugin-options","content":"Plugin options"},"2884":{"id":"/devtools-7","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#open-and-arrange-the-panel","content":"Open and arrange the panel"},"2885":{"id":"/devtools-8","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#tabs","content":"Tabs"},"2886":{"id":"/devtools-9","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#how-collection-works","content":"How collection works"},"2887":{"id":"/devtools-10","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#production-builds","content":"Production builds"},"2888":{"id":"/devtools-11","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#compatibility","content":"Compatibility"},"2889":{"id":"/devtools-12","page_id":"/devtools","type":"heading","tags":[],"url":"/devtools#troubleshooting","content":"Troubleshooting"},"2890":{"id":"/devtools-13","page_id":"/devtools","tags":[],"type":"text","url":"/devtools","content":"`@osdk/react-devtools` adds a panel to your `@osdk/react` app during development. Use it to see which components own OSDK hooks, how often reads hit the cache, and what your app logs to the console."},"2891":{"id":"/devtools-14","page_id":"/devtools","tags":[],"type":"text","url":"/devtools","content":"`@osdk/react-devtools` is experimental. Its panels and metrics can change between minor versions."},"2892":{"id":"/devtools-15","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#install-the-package","content":"Add `@osdk/react-devtools` as a dev dependency:"},"2893":{"id":"/devtools-16","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#install-the-package","content":"The package has peer dependencies on `@osdk/api`, `@osdk/client`, `@osdk/react`, `react`, `react-dom`, `@types/react`, and `vite` 5, 6, or 7. An OSDK React app created with `@osdk/create-app` already has them."},"2894":{"id":"/devtools-17","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#add-the-vite-plugin","content":"Import `osdkDevTools` from `@osdk/react-devtools/vite` and add it to `plugins`:"},"2895":{"id":"/devtools-18","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#add-the-vite-plugin","content":"`osdkDevTools` is also the default export of `@osdk/react-devtools/vite`."},"2896":{"id":"/devtools-19","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#keep-your-existing-provider","content":"You do not add any JSX. During `vite dev`, the plugin injects two scripts into `index.html`: one that installs a React Fiber hook, and one that imports the panel:"},"2897":{"id":"/devtools-20","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#keep-your-existing-provider","content":"The import registers the devtools with `@osdk/react`. Your existing `OsdkProvider` then wraps its client with the monitor and renders the panel:"},"2898":{"id":"/devtools-21","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#start-the-dev-server","content":"Run your dev script, for example `npm run dev`. The panel opens in the top right corner of the page on the Overview tab."},"2899":{"id":"/devtools-22","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#plugin-options","content":"All options are optional."},"2900":{"id":"/devtools-23","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#plugin-options","content":"| Option    | Type      | Default                                    | Description                                                                   |\n| --------- | --------- | ------------------------------------------ | ----------------------------------------------------------------------------- |\n| `enabled` | `boolean` | `true` unless `NODE_ENV` is `\"production\"` | Set to `false` to keep the plugin in your config without injecting the panel. |","table":"table-0"},"2901":{"id":"/devtools-24","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#plugin-options","content":"| Option    | Type      | Default | Description                                                                             |\n| --------- | --------- | ------- | --------------------------------------------------------------------------------------- |\n| `verbose` | `boolean` | `false` | Logs plugin diagnostics, including whether the scripts were injected into `index.html`. |","table":"table-0"},"2902":{"id":"/devtools-25","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"Select **Minimize** in the panel header to collapse it to a `</>` launcher in the bottom right corner. Select the launcher to reopen the panel."},"2903":{"id":"/devtools-26","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"The header controls apply to every tab:"},"2904":{"id":"/devtools-27","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"| Control | What it does                                                                           |\n| ------- | -------------------------------------------------------------------------------------- |\n| Theme   | Cycles through dark (the default), light, and auto, which follows your system setting. |","table":"table-1"},"2905":{"id":"/devtools-28","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"| Control   | What it does                                                            |\n| --------- | ----------------------------------------------------------------------- |\n| Dock mode | Cycles through floating, docked to the bottom, and docked to the right. |","table":"table-1"},"2906":{"id":"/devtools-29","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"| Control       | What it does                                                                            |\n| ------------- | --------------------------------------------------------------------------------------- |\n| Reset metrics | Clears the metrics collected in this session. It does not change app data or the cache. |","table":"table-1"},"2907":{"id":"/devtools-30","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"| Control  | What it does                               |\n| -------- | ------------------------------------------ |\n| Minimize | Collapses the panel to the `</>` launcher. |","table":"table-1"},"2908":{"id":"/devtools-31","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#open-and-arrange-the-panel","content":"Drag the header to move a floating panel, and drag an edge or corner to resize it. The panel saves its position, size, theme, dock mode, and collapsed state in `localStorage`, so they survive reloads."},"2909":{"id":"/devtools-32","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#tabs","content":"| Tab      | Use it to                                                                                                           |\n| -------- | ------------------------------------------------------------------------------------------------------------------- |\n| Overview | See Ontology usage, requests saved, cache hit rate, optimistic coverage, errors, overfetching, and recommendations. |","table":"table-2"},"2910":{"id":"/devtools-33","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#tabs","content":"| Tab        | Use it to                                                                                             |\n| ---------- | ----------------------------------------------------------------------------------------------------- |\n| Components | Find which React components call OSDK hooks and which object types, actions, and properties they use. |","table":"table-2"},"2911":{"id":"/devtools-34","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#tabs","content":"| Tab     | Use it to                                           |\n| ------- | --------------------------------------------------- |\n| Console | Search and filter captured console output by level. |","table":"table-2"},"2912":{"id":"/devtools-35","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#tabs","content":"| Tab   | Use it to                                                                        |\n| ----- | -------------------------------------------------------------------------------- |\n| Cache | Inspect cache entries, invalidate them, and review recent cache hits and misses. |","table":"table-2"},"2913":{"id":"/devtools-36","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#how-collection-works","content":"The panel observes the app you already run. It does not send its own requests."},"2914":{"id":"/devtools-37","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#how-collection-works","content":"**Requests and cache.** The devtools wrap the observable client that `OsdkProvider` creates and record the cache reads, network requests, and actions that pass through it. Data you load with raw `fetch`, `axios`, or another state library does not appear."},"2915":{"id":"/devtools-38","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#how-collection-works","content":"**Components.** The injected Fiber hook attributes each `@osdk/react` hook to the component that mounted it. The hook must install before React loads. If React loads first, the panel still works but shows a notice that component inspection is unavailable."},"2916":{"id":"/devtools-39","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#how-collection-works","content":"**Console.** The monitor captures `console` calls made while the page is open."},"2917":{"id":"/devtools-40","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#how-collection-works","content":"Open the panel before you exercise the flow you want to inspect, and use **Reset metrics** to start from zero."},"2918":{"id":"/devtools-41","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#production-builds","content":"The plugin applies only to `vite dev` and `vite serve`. It does nothing during `vite build`, in `production` mode, or under Vitest, so the panel does not ship to users. To turn it off during development, do one of the following:"},"2919":{"id":"/devtools-42","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#production-builds","content":"Pass `osdkDevTools({ enabled: false })`."},"2920":{"id":"/devtools-43","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#production-builds","content":"Remove `osdkDevTools()` from `plugins`."},"2921":{"id":"/devtools-44","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#production-builds","content":"Uninstall `@osdk/react-devtools`."},"2922":{"id":"/devtools-45","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#compatibility","content":"Use compatible versions of `@osdk/react-devtools` and your other `@osdk/*` packages. Mismatched versions can behave unexpectedly. See Installation for how to keep OSDK packages in sync."},"2923":{"id":"/devtools-46","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#troubleshooting","content":"| Symptom                    | Check                                                                                                                                                                                                                             |\n| -------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| The panel does not appear. | Confirm `osdkDevTools()` is in `plugins`, `enabled` is not `false`, and you run `vite dev`. Set `verbose: true` and look for `Injected devtools into HTML` in the terminal. Your `index.html` needs a `</head>` or `</body>` tag. |","table":"table-3"},"2924":{"id":"/devtools-47","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#troubleshooting","content":"| Symptom                              | Check                                                                                         |\n| ------------------------------------ | --------------------------------------------------------------------------------------------- |\n| The panel appears but shows no data. | Confirm the app renders `OsdkProvider` and the screen reads data through `@osdk/react` hooks. |","table":"table-3"},"2925":{"id":"/devtools-48","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#troubleshooting","content":"| Symptom                              | Check                                                                                                                            |\n| ------------------------------------ | -------------------------------------------------------------------------------------------------------------------------------- |\n| Component inspection is unavailable. | Something loaded React before the injected script. Remove manual imports or scripts in `index.html` that load React ahead of it. |","table":"table-3"},"2926":{"id":"/devtools-49","page_id":"/devtools","tags":[],"type":"text","url":"/devtools#troubleshooting","content":"| Symptom                                | Check                                                                                                    |\n| -------------------------------------- | -------------------------------------------------------------------------------------------------------- |\n| The panel appears in a deployed build. | Look for code that imports `@osdk/react-devtools` directly, or a stale development bundle on the server. |","table":"table-3"},"2927":{"id":"/devtools/overview","page_id":"/devtools/overview","type":"page","content":"Overview","breadcrumbs":["OSDK TypeScript","React","Devtools"],"tags":[],"url":"/devtools/overview"},"2928":{"id":"/devtools/overview-0","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview","content":"Read the Overview tab in OSDK Devtools to check Ontology usage, cache hit rate, optimistic coverage, errors, overfetching, and recommendations."},"2929":{"id":"/devtools/overview-1","page_id":"/devtools/overview","type":"heading","tags":[],"url":"/devtools/overview#ontology","content":"Ontology"},"2930":{"id":"/devtools/overview-2","page_id":"/devtools/overview","type":"heading","tags":[],"url":"/devtools/overview#metrics","content":"Metrics"},"2931":{"id":"/devtools/overview-3","page_id":"/devtools/overview","type":"heading","tags":[],"url":"/devtools/overview#recommendations","content":"Recommendations"},"2932":{"id":"/devtools/overview-4","page_id":"/devtools/overview","type":"heading","tags":[],"url":"/devtools/overview#measure-one-flow","content":"Measure one flow"},"2933":{"id":"/devtools/overview-5","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview","content":"The Overview tab is the first tab the panel shows. It summarizes how the mounted components use the Ontology and how the client has performed since the page loaded or since you last selected **Reset metrics**."},"2934":{"id":"/devtools/overview-6","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#ontology","content":"Counts the distinct object types, action types, and links that mounted components use. If no component uses the Ontology yet, the section says so and links to these docs."},"2935":{"id":"/devtools/overview-7","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric         | What it measures                                                                                      | Highlighted when |\n| -------------- | ----------------------------------------------------------------------------------------------------- | ---------------- |\n| Requests saved | Reads served from the cache, revalidations, and deduplicated requests that did not reach the network. | Never            |","table":"table-0"},"2936":{"id":"/devtools/overview-8","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric              | What it measures                                                                          | Highlighted when |\n| ------------------- | ----------------------------------------------------------------------------------------- | ---------------- |\n| Optimistic coverage | Share of actions that updated the UI before the server responded. See Optimistic updates. | Never            |","table":"table-0"},"2937":{"id":"/devtools/overview-9","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric         | What it measures                                                                                          | Highlighted when                                      |\n| -------------- | --------------------------------------------------------------------------------------------------------- | ----------------------------------------------------- |\n| Cache hit rate | Share of object reads served from the cache instead of the network. Blank until the session has 20 reads. | Green above 70%, amber from 40% to 70%, red below 40% |","table":"table-0"},"2938":{"id":"/devtools/overview-10","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric            | What it measures                                                                                                        | Highlighted when |\n| ----------------- | ----------------------------------------------------------------------------------------------------------------------- | ---------------- |\n| Avg response time | Average response time across cache and network reads. Cache reads typically take under 1 ms, so network reads dominate. | Never            |","table":"table-0"},"2939":{"id":"/devtools/overview-11","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric            | What it measures                                                  | Highlighted when |\n| ----------------- | ----------------------------------------------------------------- | ---------------- |\n| Errors & warnings | `console.error` and `console.warn` entries captured this session. | Red when above 0 |","table":"table-0"},"2940":{"id":"/devtools/overview-12","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric       | What it measures                                                                                                                              | Highlighted when |\n| ------------ | --------------------------------------------------------------------------------------------------------------------------------------------- | ---------------- |\n| Overfetching | Components whose queries fetch fields their descendants never read. A query counts when descendants read less than 70% of the fetched fields. | Red when above 0 |","table":"table-0"},"2941":{"id":"/devtools/overview-13","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"Select the help icon on a metric for its definition and thresholds. Three metrics link to the tab with the detail behind them:"},"2942":{"id":"/devtools/overview-14","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric         | Link              | Opens |\n| -------------- | ----------------- | ----- |\n| Cache hit rate | **View in Cache** | Cache |","table":"table-1"},"2943":{"id":"/devtools/overview-15","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric            | Link                | Opens   |\n| ----------------- | ------------------- | ------- |\n| Errors & warnings | **View in Console** | Console |","table":"table-1"},"2944":{"id":"/devtools/overview-16","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#metrics","content":"| Metric       | Link                   | Opens      |\n| ------------ | ---------------------- | ---------- |\n| Overfetching | **View in Components** | Components |","table":"table-1"},"2945":{"id":"/devtools/overview-17","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#recommendations","content":"Recommendations turn the metrics and component observations into specific fixes, such as a query that fetches unused fields. Some include a copyable prompt you can paste into a coding assistant. With nothing to suggest, the section reads `No recommendations right now.`"},"2946":{"id":"/devtools/overview-18","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#measure-one-flow","content":"Select **Reset metrics** in the panel header. This clears the collected metrics without touching app data or the cache."},"2947":{"id":"/devtools/overview-19","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#measure-one-flow","content":"Run the flow you want to measure in your app."},"2948":{"id":"/devtools/overview-20","page_id":"/devtools/overview","tags":[],"type":"text","url":"/devtools/overview#measure-one-flow","content":"Read the metrics and recommendations for that flow alone."},"2949":{"id":"/react/functions","page_id":"/react/functions","type":"page","content":"Call functions","breadcrumbs":["OSDK TypeScript","React","Write data"],"tags":[],"url":"/react/functions"},"2950":{"id":"/react/functions-0","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions","content":"Run Foundry functions from React with useOsdkFunction and useOsdkFunctions, with caching, dependency-based refetching, and error handling."},"2951":{"id":"/react/functions-1","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#call-a-function","content":"Call a function"},"2952":{"id":"/react/functions-2","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#options","content":"Options"},"2953":{"id":"/react/functions-3","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#return-value","content":"Return value"},"2954":{"id":"/react/functions-4","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#how-results-are-cached","content":"How results are cached"},"2955":{"id":"/react/functions-5","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#refetch-when-objects-change","content":"Refetch when objects change"},"2956":{"id":"/react/functions-6","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#refetch-when-specific-objects-change","content":"Refetch when specific objects change"},"2957":{"id":"/react/functions-7","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#wait-for-inputs","content":"Wait for inputs"},"2958":{"id":"/react/functions-8","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#handle-errors","content":"Handle errors"},"2959":{"id":"/react/functions-9","page_id":"/react/functions","type":"heading","tags":[],"url":"/react/functions#call-several-functions","content":"Call several functions"},"2960":{"id":"/react/functions-10","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions","content":"Use `useOsdkFunction` to call a Foundry function (an ontology query) and render its result. The result is cached and shared across components, and you can tell the cache which objects the function reads so it reruns after actions change them."},"2961":{"id":"/react/functions-11","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-a-function","content":"Pass the function from your generated SDK and its parameters:"},"2962":{"id":"/react/functions-12","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-a-function","content":"`params` is typed from the function's signature. Required parameters must be present, and optional ones can be left out. A function with no parameters takes no options:"},"2963":{"id":"/react/functions-13","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#options","content":"| Option   | Type                | Default     | Description                                                        |\n| -------- | ------------------- | ----------- | ------------------------------------------------------------------ |\n| `params` | Function parameters | `undefined` | Arguments for the function. Omit for functions without parameters. |","table":"table-0"},"2964":{"id":"/react/functions-14","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#options","content":"| Option      | Type                                    | Default     | Description                                                                                                                       |\n| ----------- | --------------------------------------- | ----------- | --------------------------------------------------------------------------------------------------------------------------------- |\n| `dependsOn` | `Array<ObjectTypeDefinition \\| string>` | `undefined` | Object types the function reads. A change to any object of these types refetches it. Pass the type from your SDK or its API name. |","table":"table-0"},"2965":{"id":"/react/functions-15","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#options","content":"| Option             | Type                                | Default     | Description                                                                                     |\n| ------------------ | ----------------------------------- | ----------- | ----------------------------------------------------------------------------------------------- |\n| `dependsOnObjects` | `Array<Osdk.Instance \\| ObjectSet>` | `undefined` | Specific objects, or object sets, the function reads. See Refetch when specific objects change. |","table":"table-0"},"2966":{"id":"/react/functions-16","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#options","content":"| Option             | Type     | Default | Description                                                                                                                       |\n| ------------------ | -------- | ------- | --------------------------------------------------------------------------------------------------------------------------------- |\n| `dedupeIntervalMs` | `number` | `2000`  | Within this many milliseconds of the last fetch, a new subscriber reuses the cached result instead of calling the function again. |","table":"table-0"},"2967":{"id":"/react/functions-17","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#options","content":"| Option    | Type      | Default | Description                                                            |\n| --------- | --------- | ------- | ---------------------------------------------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, the function is not called and `data` stays `undefined`. |","table":"table-0"},"2968":{"id":"/react/functions-18","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#return-value","content":"| Field  | Type                                | Description                                                                 |\n| ------ | ----------------------------------- | --------------------------------------------------------------------------- |\n| `data` | Function return type `\\| undefined` | The result. `undefined` before the first result arrives and after an error. |","table":"table-1"},"2969":{"id":"/react/functions-19","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#return-value","content":"| Field       | Type      | Description                                                                                                    |\n| ----------- | --------- | -------------------------------------------------------------------------------------------------------------- |\n| `isLoading` | `boolean` | `true` while a call is in flight, including refetches. The previous `data` stays available while it refetches. |","table":"table-1"},"2970":{"id":"/react/functions-20","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#return-value","content":"| Field   | Type                 | Description                    |\n| ------- | -------------------- | ------------------------------ |\n| `error` | `Error \\| undefined` | Set when the last call failed. |","table":"table-1"},"2971":{"id":"/react/functions-21","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#return-value","content":"| Field         | Type     | Description                                                                                     |\n| ------------- | -------- | ----------------------------------------------------------------------------------------------- |\n| `lastUpdated` | `number` | Time of the last successful call, in milliseconds since the epoch. `0` before the first result. |","table":"table-1"},"2972":{"id":"/react/functions-22","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#return-value","content":"| Field     | Type                  | Description                                                                     |\n| --------- | --------------------- | ------------------------------------------------------------------------------- |\n| `refetch` | `() => Promise<void>` | Calls the function again with the same parameters, ignoring `dedupeIntervalMs`. |","table":"table-1"},"2973":{"id":"/react/functions-23","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#how-results-are-cached","content":"Each result is cached under the function's API name, its version, and its parameters. Parameters are compared by value, so two components that call `getEmployeeMetrics` with `{ department: \"Sales\" }` share one cache entry and one network request. A different `department` is a separate entry."},"2974":{"id":"/react/functions-24","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#how-results-are-cached","content":"A cached result does not expire on a timer. It is refetched when:"},"2975":{"id":"/react/functions-25","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#how-results-are-cached","content":"you call `refetch`, or invalidate it through the observable client (see Invalidate the cache),"},"2976":{"id":"/react/functions-26","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#how-results-are-cached","content":"an action edits an object the function depends on (`dependsOn` or `dependsOnObjects`), or"},"2977":{"id":"/react/functions-27","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#how-results-are-cached","content":"a component subscribes after `dedupeIntervalMs` has passed since the last call."},"2978":{"id":"/react/functions-28","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#how-results-are-cached","content":"Without `dependsOn` or `dependsOnObjects`, actions never refetch the function, because the cache cannot know what it reads. For the full cache model, see Caching."},"2979":{"id":"/react/functions-29","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#refetch-when-objects-change","content":"Declare the object types your function reads with `dependsOn`. After an action adds, modifies, or deletes an object of one of those types, the function runs again:"},"2980":{"id":"/react/functions-30","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#refetch-when-objects-change","content":"`dependsOn` also accepts API name strings, such as `dependsOn: [\"Employee\"]`, which is useful when you do not import the type."},"2981":{"id":"/react/functions-31","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#refetch-when-specific-objects-change","content":"`dependsOnObjects` narrows the trigger. Pass object instances, and the function reruns only when one of those exact objects (matched by type and primary key) is edited:"},"2982":{"id":"/react/functions-32","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#refetch-when-specific-objects-change","content":"`dependsOnObjects` also accepts object sets. The cache looks up the set's object type in the background and then treats it like `dependsOn` for that type: a change to any object of that type refetches the function, not only changes to objects in the set. Because the result is the same, pass the type to `dependsOn` instead. It takes effect immediately and avoids a type error, since a typed object set such as `Employee.ObjectSet` is not assignable to the option's `ObjectSet<ObjectTypeDefinition>` type."},"2983":{"id":"/react/functions-33","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#refetch-when-specific-objects-change","content":"The first component to subscribe to a function and parameter combination sets its dependencies. A later component that passes different `dependsOn` or `dependsOnObjects` for the same parameters shares the existing entry and its dependencies. Pass the same dependency options everywhere you call a function with the same parameters."},"2984":{"id":"/react/functions-34","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#wait-for-inputs","content":"Hooks cannot be called conditionally. To hold a call until its inputs exist, set `enabled`:"},"2985":{"id":"/react/functions-35","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#wait-for-inputs","content":"While `enabled` is `false`, `isLoading` is `false` and `data` is `undefined`."},"2986":{"id":"/react/functions-36","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#handle-errors","content":"When a call fails, `error` holds the `Error` and `data` becomes `undefined`. The error stays until a later call succeeds, so render it next to the rest of the component rather than in place of it. `refetch` doubles as a retry:"},"2987":{"id":"/react/functions-37","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#handle-errors","content":"Errors from Foundry are `PalantirApiError` instances, exported from `@osdk/client`, which carry `errorName`, `errorCode`, and `errorInstanceId`. See Loading and errors for patterns that apply to every hook."},"2988":{"id":"/react/functions-38","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-several-functions","content":"`useOsdkFunctions` runs a list of function calls and returns one result per call, in the same order. Each result has the same shape as the `useOsdkFunction` return value."},"2989":{"id":"/react/functions-39","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-several-functions","content":"Each call is cached exactly as if it came from `useOsdkFunction`, so a call that another component already made is served from the cache. Because the list can mix functions, `queries` is typed for any function and does not accept a specific function's `params` as written. The `functionCall` helper above checks `params` against each function, then widens the entry. Narrow or cast each result's `data` before use."},"2990":{"id":"/react/functions-40","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-several-functions","content":"| Option    | Type                                   | Default  | Description                                                                                                                                                        |\n| --------- | -------------------------------------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `queries` | `Array<{ queryDefinition, options? }>` | Required | The calls to make. `options` takes the same fields as the `useOsdkFunction` options: `params`, `dependsOn`, `dependsOnObjects`, `dedupeIntervalMs`, and `enabled`. |","table":"table-2"},"2991":{"id":"/react/functions-41","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-several-functions","content":"| Option    | Type      | Default | Description                                                                                      |\n| --------- | --------- | ------- | ------------------------------------------------------------------------------------------------ |\n| `enabled` | `boolean` | `true`  | When `false`, no call runs. A call whose own `options.enabled` is `false` is skipped either way. |","table":"table-2"},"2992":{"id":"/react/functions-42","page_id":"/react/functions","tags":[],"type":"text","url":"/react/functions#call-several-functions","content":"| Option          | Type     | Default     | Description                                                                                                                                                                                                 |\n| --------------- | -------- | ----------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `maxConcurrent` | `number` | `undefined` | Limit on calls in flight at once. The next call starts when a running one finishes, successfully or not. Use it for functions that are slow or return large payloads. Without it, all calls start together. |","table":"table-2"},"2993":{"id":"/react","page_id":"/react","type":"page","content":"React SDK","breadcrumbs":["OSDK TypeScript","React"],"tags":[],"url":"/react"},"2994":{"id":"/react-0","page_id":"/react","tags":[],"type":"text","url":"/react","content":"Build reactive Foundry apps with @osdk/react hooks backed by one shared, normalized cache."},"2995":{"id":"/react-1","page_id":"/react","type":"heading","tags":[],"url":"/react#hooks","content":"Hooks"},"2996":{"id":"/react-2","page_id":"/react","type":"heading","tags":[],"url":"/react#how-data-flows","content":"How data flows"},"2997":{"id":"/react-3","page_id":"/react","tags":[],"type":"text","url":"/react","content":"`@osdk/react` wraps the OSDK client in hooks. Every hook reads from one normalized cache, so a list, a detail view, and a link panel that show the same object stay in sync, and an action updates them all without manual refetching."},"2998":{"id":"/react-4","page_id":"/react","tags":[],"type":"text","url":"/react","content":"New to OSDK? Start with the Quickstart, then create a client and add OsdkProvider."},"2999":{"id":"/react-5","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook             | Use it to                                                | Guide         |\n| ---------------- | -------------------------------------------------------- | ------------- |\n| `useOsdkObjects` | Load a list of objects with filters, sorting, and paging | Query objects |","table":"table-0"},"3000":{"id":"/react-6","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook            | Use it to                      | Guide         |\n| --------------- | ------------------------------ | ------------- |\n| `useOsdkObject` | Load one object by primary key | Query objects |","table":"table-0"},"3001":{"id":"/react-7","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook       | Use it to                            | Guide        |\n| ---------- | ------------------------------------ | ------------ |\n| `useLinks` | Load the objects linked to an object | Follow links |","table":"table-0"},"3002":{"id":"/react-8","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook           | Use it to                                          | Guide                 |\n| -------------- | -------------------------------------------------- | --------------------- |\n| `useObjectSet` | Combine, intersect, subtract, or pivot object sets | Work with object sets |","table":"table-0"},"3003":{"id":"/react-9","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook                 | Use it to                                              | Guide                 |\n| -------------------- | ------------------------------------------------------ | --------------------- |\n| `useStableObjectSet` | Keep an object set referentially stable across renders | Work with object sets |","table":"table-0"},"3004":{"id":"/react-10","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook                 | Use it to                                    | Guide          |\n| -------------------- | -------------------------------------------- | -------------- |\n| `useOsdkAggregation` | Count, sum, average, and group on the server | Aggregate data |","table":"table-0"},"3005":{"id":"/react-11","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook            | Use it to                  | Guide         |\n| --------------- | -------------------------- | ------------- |\n| `useOsdkAction` | Apply and validate actions | Apply actions |","table":"table-0"},"3006":{"id":"/react-12","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook                   | Use it to                              | Guide         |\n| ---------------------- | -------------------------------------- | ------------- |\n| `useDebouncedCallback` | Debounce validation while a user types | Apply actions |","table":"table-0"},"3007":{"id":"/react-13","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook                                  | Use it to                            | Guide          |\n| ------------------------------------- | ------------------------------------ | -------------- |\n| `useOsdkFunction`, `useOsdkFunctions` | Call Ontology functions with caching | Call functions |","table":"table-0"},"3008":{"id":"/react-14","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook                  | Use it to                      | Guide                |\n| --------------------- | ------------------------------ | -------------------- |\n| `useObservableClient` | Invalidate cached data by hand | Invalidate the cache |","table":"table-0"},"3009":{"id":"/react-15","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook            | Use it to                                    | Guide           |\n| --------------- | -------------------------------------------- | --------------- |\n| `useOsdkClient` | Get the client for one-off, imperative calls | Create a client |","table":"table-0"},"3010":{"id":"/react-16","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"| Hook              | Use it to                            | Guide     |\n| ----------------- | ------------------------------------ | --------- |\n| `useOsdkMetadata` | Read object and action type metadata | Reference |","table":"table-0"},"3011":{"id":"/react-17","page_id":"/react","tags":[],"type":"text","url":"/react#hooks","content":"User, group, and marking hooks live in `@osdk/react/platform-apis`; see Users and markings. Test utilities live in `@osdk/react/testing`; see Test your app."},"3012":{"id":"/react-18","page_id":"/react","tags":[],"type":"text","url":"/react#how-data-flows","content":"<Card title=\"Caching and reactivity\" href=\"/concepts/caching\">How hooks share one cache and stay current.</Card>"},"3013":{"id":"/react-19","page_id":"/react","tags":[],"type":"text","url":"/react#how-data-flows","content":"<Card title=\"Loading and errors\" href=\"/concepts/loading-and-errors\">Render without flashing while data refreshes.</Card>"},"3014":{"id":"/react-20","page_id":"/react","tags":[],"type":"text","url":"/react#how-data-flows","content":"<Card title=\"Optimistic updates\" href=\"/react/optimistic-updates\">Show the result of an action before the server confirms it.</Card>"},"3015":{"id":"/react-21","page_id":"/react","tags":[],"type":"text","url":"/react#how-data-flows","content":"<Card title=\"Devtools\" href=\"/devtools\">Inspect the cache, queries, and actions in your running app.</Card>"},"3016":{"id":"/react/links","page_id":"/react/links","type":"page","content":"Follow links","breadcrumbs":["OSDK TypeScript","React","Read data"],"tags":[],"url":"/react/links"},"3017":{"id":"/react/links-0","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"Load the objects linked to one or more source objects with useLinks, or pivot a whole query to a linked type with pivotTo."},"3018":{"id":"/react/links-1","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#load-linked-objects","content":"Load linked objects"},"3019":{"id":"/react/links-2","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#links-to-one-object","content":"Links to one object"},"3020":{"id":"/react/links-3","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#filter-sort-and-paginate-links","content":"Filter, sort, and paginate links"},"3021":{"id":"/react/links-4","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#wait-for-the-source-object","content":"Wait for the source object"},"3022":{"id":"/react/links-5","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#load-links-from-many-objects","content":"Load links from many objects"},"3023":{"id":"/react/links-6","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#control-refetching","content":"Control refetching"},"3024":{"id":"/react/links-7","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#pivot-with-pivotto","content":"Pivot with `pivotTo`"},"3025":{"id":"/react/links-8","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#choose-an-approach","content":"Choose an approach"},"3026":{"id":"/react/links-9","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#reference","content":"Reference"},"3027":{"id":"/react/links-10","page_id":"/react/links","type":"heading","tags":[],"url":"/react/links#uselinksobjects-linkname-options","content":"`useLinks(objects, linkName, options?)`"},"3028":{"id":"/react/links-11","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"Links connect objects of one type to objects of another, such as an employee to their office or a manager to their reports. Use `useLinks` to load the linked objects of objects you already have, and `pivotTo` to turn a query for one type into a query for the linked type."},"3029":{"id":"/react/links-12","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"The samples on this page use these links from the example SDK:"},"3030":{"id":"/react/links-13","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"| Link   | From       | To         | Cardinality |\n| ------ | ---------- | ---------- | ----------- |\n| `lead` | `Employee` | `Employee` | One         |","table":"table-0"},"3031":{"id":"/react/links-14","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"| Link      | From       | To         | Cardinality |\n| --------- | ---------- | ---------- | ----------- |\n| `reports` | `Employee` | `Employee` | Many        |","table":"table-0"},"3032":{"id":"/react/links-15","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"| Link     | From       | To       | Cardinality |\n| -------- | ---------- | -------- | ----------- |\n| `office` | `Employee` | `Office` | One         |","table":"table-0"},"3033":{"id":"/react/links-16","page_id":"/react/links","tags":[],"type":"text","url":"/react/links","content":"| Link        | From     | To         | Cardinality |\n| ----------- | -------- | ---------- | ----------- |\n| `occupants` | `Office` | `Employee` | Many        |","table":"table-0"},"3034":{"id":"/react/links-17","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#load-linked-objects","content":"Pass a source object and a link name. `links` holds the linked objects:"},"3035":{"id":"/react/links-18","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#load-linked-objects","content":"TypeScript checks the link name against the source type and types `links` as the linked object type."},"3036":{"id":"/react/links-19","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#links-to-one-object","content":"A link to a single object uses the same hook. `links` is an array with at most one element:"},"3037":{"id":"/react/links-20","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#filter-sort-and-paginate-links","content":"`useLinks` accepts `where`, `orderBy`, `$select`, and `pageSize` for the linked type. They work as they do in `useOsdkObjects`. `fetchMore` loads the next page and is `undefined` when there are no more."},"3038":{"id":"/react/links-21","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#wait-for-the-source-object","content":"The source can be `undefined`, which lets you chain `useLinks` after a hook that is still loading. Set `enabled` so it does not query until the source arrives:"},"3039":{"id":"/react/links-22","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#load-links-from-many-objects","content":"Pass an array of source objects to load their links in one hook. `links` is the combined list. `linkedObjectsBySourcePrimaryKey` maps each source's primary key to its own linked objects, so you can group them:"},"3040":{"id":"/react/links-23","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#control-refetching","content":"Two `useLinks` calls with the same source and options share one request if the second starts within `dedupeIntervalMs` (2 seconds by default). Raise it to refetch less often on remount, or set it to `Infinity` to refetch only when the cache is invalidated, for example by an action:"},"3041":{"id":"/react/links-24","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#control-refetching","content":"`mode` overrides the cache policy for one call:"},"3042":{"id":"/react/links-25","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#control-refetching","content":"| `mode`                | Behavior                                |\n| --------------------- | --------------------------------------- |\n| `undefined` (default) | Fetch unless a recent result is cached. |","table":"table-1"},"3043":{"id":"/react/links-26","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#control-refetching","content":"| `mode`    | Behavior      |\n| --------- | ------------- |\n| `\"force\"` | Always fetch. |","table":"table-1"},"3044":{"id":"/react/links-27","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#control-refetching","content":"| `mode`      | Behavior                                   |\n| ----------- | ------------------------------------------ |\n| `\"offline\"` | Read the cache only; never make a request. |","table":"table-1"},"3045":{"id":"/react/links-28","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#pivot-with-pivotto","content":"`useLinks` starts from objects you already hold. When you want the linked objects of every object that matches a filter, pivot the query instead. `useOsdkObjects` takes a `pivotTo` option: `where` filters the source objects, and `data` contains the linked objects."},"3046":{"id":"/react/links-29","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#pivot-with-pivotto","content":"The pivot runs on the server, so the result is one deduplicated list of offices, however many employees share one."},"3047":{"id":"/react/links-30","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#pivot-with-pivotto","content":"With `useObjectSet`, call `pivotTo` on the object set you pass in. The result is then typed as the linked type, which the hook's own `pivotTo` option does not do:"},"3048":{"id":"/react/links-31","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#pivot-with-pivotto","content":"Pivoted queries do not receive real-time updates. See Stream real-time updates."},"3049":{"id":"/react/links-32","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"| You have             | You want           | Use                       |\n| -------------------- | ------------------ | ------------------------- |\n| One object, or a few | Its linked objects | `useLinks(objects, link)` |","table":"table-2"},"3050":{"id":"/react/links-33","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"| You have        | You want                         | Use                                                             |\n| --------------- | -------------------------------- | --------------------------------------------------------------- |\n| Several objects | Linked objects grouped by source | `useLinks(objects, link)` and `linkedObjectsBySourcePrimaryKey` |","table":"table-2"},"3051":{"id":"/react/links-34","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"| You have                    | You want                         | Use                                        |\n| --------------------------- | -------------------------------- | ------------------------------------------ |\n| A filter on the source type | All linked objects, deduplicated | `useOsdkObjects(type, { where, pivotTo })` |","table":"table-2"},"3052":{"id":"/react/links-35","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"| You have                          | You want           | Use                                     |\n| --------------------------------- | ------------------ | --------------------------------------- |\n| An object set from set operations | All linked objects | `useObjectSet(objectSet.pivotTo(link))` |","table":"table-2"},"3053":{"id":"/react/links-36","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"| You have          | You want                                                            | Use                                      |\n| ----------------- | ------------------------------------------------------------------- | ---------------------------------------- |\n| A list of objects | One value from a linked object on each row, such as the lead's name | A derived property with `selectProperty` |","table":"table-2"},"3054":{"id":"/react/links-37","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"| You have          | You want                             | Use                                 |\n| ----------------- | ------------------------------------ | ----------------------------------- |\n| A list of objects | A count or sum over each row's links | A derived property with `aggregate` |","table":"table-2"},"3055":{"id":"/react/links-38","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#choose-an-approach","content":"Derived properties avoid one `useLinks` call per row: the server computes the value and returns it on each object."},"3056":{"id":"/react/links-39","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"`objects` is one `Osdk.Instance`, an array of them, or `undefined`."},"3057":{"id":"/react/links-40","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option  | Type             | Default | Description                |\n| ------- | ---------------- | ------- | -------------------------- |\n| `where` | `WhereClause<L>` |         | Filter the linked objects. |","table":"table-3"},"3058":{"id":"/react/links-41","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option    | Type                               | Default | Description              |\n| --------- | ---------------------------------- | ------- | ------------------------ |\n| `orderBy` | `{ [property]?: \"asc\" \\| \"desc\" }` |         | Sort the linked objects. |","table":"table-3"},"3059":{"id":"/react/links-42","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option    | Type                | Default            | Description                                |\n| --------- | ------------------- | ------------------ | ------------------------------------------ |\n| `$select` | `PropertyKeys<L>[]` | Server default set | Properties to load for each linked object. |","table":"table-3"},"3060":{"id":"/react/links-43","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option     | Type     | Default        | Description                 |\n| ---------- | -------- | -------------- | --------------------------- |\n| `pageSize` | `number` | Server default | Linked objects per request. |","table":"table-3"},"3061":{"id":"/react/links-44","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option    | Type      | Default | Description                                                  |\n| --------- | --------- | ------- | ------------------------------------------------------------ |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made and `links` is `undefined`. |","table":"table-3"},"3062":{"id":"/react/links-45","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option | Type                   | Default | Description                                    |\n| ------ | ---------------------- | ------- | ---------------------------------------------- |\n| `mode` | `\"force\" \\| \"offline\"` |         | Cache policy override. See Control refetching. |","table":"table-3"},"3063":{"id":"/react/links-46","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option             | Type     | Default | Description                                           |\n| ------------------ | -------- | ------- | ----------------------------------------------------- |\n| `dedupeIntervalMs` | `number` | `2000`  | Identical calls within this window share one request. |","table":"table-3"},"3064":{"id":"/react/links-47","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option                            | Type      | Default | Description                                                                       |\n| --------------------------------- | --------- | ------- | --------------------------------------------------------------------------------- |\n| `$includeAllBaseObjectProperties` | `boolean` | `false` | When the link targets an interface, also load the implementing type's properties. |","table":"table-3"},"3065":{"id":"/react/links-48","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Option                | Type      | Default | Description                                                                    |\n| --------------------- | --------- | ------- | ------------------------------------------------------------------------------ |\n| `resolveToObjectType` | `boolean` | `false` | When the link targets an interface, return implementing object type instances. |","table":"table-3"},"3066":{"id":"/react/links-49","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return  | Type                              | Description                      |\n| ------- | --------------------------------- | -------------------------------- |\n| `links` | `Osdk.Instance<L>[] \\| undefined` | Linked objects from all sources. |","table":"table-4"},"3067":{"id":"/react/links-50","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return                            | Type                                                         | Description                                                     |\n| --------------------------------- | ------------------------------------------------------------ | --------------------------------------------------------------- |\n| `linkedObjectsBySourcePrimaryKey` | `ReadonlyMap<string \\| number, readonly Osdk.Instance<L>[]>` | Linked objects keyed by source primary key. Empty until loaded. |","table":"table-4"},"3068":{"id":"/react/links-51","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return      | Type      | Description                          |\n| ----------- | --------- | ------------------------------------ |\n| `isLoading` | `boolean` | `true` while a request is in flight. |","table":"table-4"},"3069":{"id":"/react/links-52","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return  | Type                 | Description                         |\n| ------- | -------------------- | ----------------------------------- |\n| `error` | `Error \\| undefined` | The last error, if the load failed. |","table":"table-4"},"3070":{"id":"/react/links-53","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return         | Type      | Description                                               |\n| -------------- | --------- | --------------------------------------------------------- |\n| `isOptimistic` | `boolean` | Whether the links include unconfirmed optimistic changes. |","table":"table-4"},"3071":{"id":"/react/links-54","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return      | Type                                    | Description                                                   |\n| ----------- | --------------------------------------- | ------------------------------------------------------------- |\n| `fetchMore` | `(() => Promise<unknown>) \\| undefined` | Load the next page. `undefined` when there are no more pages. |","table":"table-4"},"3072":{"id":"/react/links-55","page_id":"/react/links","tags":[],"type":"text","url":"/react/links#uselinksobjects-linkname-options","content":"| Return    | Type      | Description               |\n| --------- | --------- | ------------------------- |\n| `hasMore` | `boolean` | Whether more pages exist. |","table":"table-4"},"3073":{"id":"/react/object-sets","page_id":"/react/object-sets","type":"page","content":"Work with object sets","breadcrumbs":["OSDK TypeScript","React","Read data"],"tags":[],"url":"/react/object-sets"},"3074":{"id":"/react/object-sets-0","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets","content":"Observe composed object sets with useObjectSet, combine them with union, intersect, and subtract, and compute derived properties on the server."},"3075":{"id":"/react/object-sets-1","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#when-to-use-useobjectset","content":"When to use `useObjectSet`"},"3076":{"id":"/react/object-sets-2","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#build-an-object-set","content":"Build an object set"},"3077":{"id":"/react/object-sets-3","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#combine-object-sets","content":"Combine object sets"},"3078":{"id":"/react/object-sets-4","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#keep-object-sets-stable","content":"Keep object sets stable"},"3079":{"id":"/react/object-sets-5","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#add-derived-properties","content":"Add derived properties"},"3080":{"id":"/react/object-sets-6","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#the-builder","content":"The builder"},"3081":{"id":"/react/object-sets-7","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#filter-on-a-derived-property","content":"Filter on a derived property"},"3082":{"id":"/react/object-sets-8","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#reference","content":"Reference"},"3083":{"id":"/react/object-sets-9","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#useobjectsetobjectset-options","content":"`useObjectSet(objectSet, options?)`"},"3084":{"id":"/react/object-sets-10","page_id":"/react/object-sets","type":"heading","tags":[],"url":"/react/object-sets#usestableobjectsetobjectset","content":"`useStableObjectSet(objectSet)`"},"3085":{"id":"/react/object-sets-11","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets","content":"An object set describes a group of objects as a query: a type, filters, set operations, and link traversals. `useObjectSet` observes any object set you build with the client, and `withProperties` adds values that the server computes for each object."},"3086":{"id":"/react/object-sets-12","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#when-to-use-useobjectset","content":"Start with `useOsdkObjects`. It covers filtering, sorting, pagination, pivots, derived properties, and streaming from an object type. Reach for `useObjectSet` when you already have an `ObjectSet`:"},"3087":{"id":"/react/object-sets-13","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#when-to-use-useobjectset","content":"You combined sets with `union`, `intersect`, or `subtract`."},"3088":{"id":"/react/object-sets-14","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#when-to-use-useobjectset","content":"You pivoted across several links."},"3089":{"id":"/react/object-sets-15","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#when-to-use-useobjectset","content":"Another hook or component handed you one, such as `objectSet` from a `useOsdkObjects` result."},"3090":{"id":"/react/object-sets-16","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#build-an-object-set","content":"Get the client with `useOsdkClient` inside the component, and call it with an object type. The result is an `ObjectSet` that you can refine with `where`, `pivotTo`, and the set operations. Building it does not send a request; the hook does."},"3091":{"id":"/react/object-sets-17","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#build-an-object-set","content":"Use the client from `useOsdkClient` rather than importing one from a module, so the object set runs against the same client and cache as `OsdkProvider`. `where`, `orderBy`, `pageSize`, `$select`, `autoFetchMore`, `enabled`, and `streamUpdates` behave as they do in `useOsdkObjects`. `useObjectSet` also accepts `undefined`, which disables the query until you have a set."},"3092":{"id":"/react/object-sets-18","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#build-an-object-set","content":"When the options change, `useObjectSet` keeps returning the previous `data` while the new query loads, with `isLoading` set to `true`. Changing to an object set of a different type clears it."},"3093":{"id":"/react/object-sets-19","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#combine-object-sets","content":"`union`, `intersect`, and `subtract` are methods on every object set. Each takes one or more sets of the same type and returns a new set:"},"3094":{"id":"/react/object-sets-20","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#combine-object-sets","content":"| Method          | Result                      |\n| --------------- | --------------------------- |\n| `a.union(b, c)` | Objects in any of the sets. |","table":"table-0"},"3095":{"id":"/react/object-sets-21","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#combine-object-sets","content":"| Method              | Result                |\n| ------------------- | --------------------- |\n| `a.intersect(b, c)` | Objects in every set. |","table":"table-0"},"3096":{"id":"/react/object-sets-22","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#combine-object-sets","content":"| Method             | Result                                         |\n| ------------------ | ---------------------------------------------- |\n| `a.subtract(b, c)` | Objects in `a` that are in none of the others. |","table":"table-0"},"3097":{"id":"/react/object-sets-23","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#combine-object-sets","content":"The same operations are available as `useObjectSet` options, each an array of object sets. `useObjectSet(highEarners, { union: [recentHires], subtract: [leadership] })` is equivalent to the set above."},"3098":{"id":"/react/object-sets-24","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#combine-object-sets","content":"`useOsdkObjects` and `useOsdkAggregation` take an `intersectWith` option instead: an array of `{ where }` clauses on the same type. Use it when every set you would intersect is a filter on that type, and `useObjectSet` when the sets come from elsewhere, such as a pivot."},"3099":{"id":"/react/object-sets-25","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#keep-object-sets-stable","content":"`useObjectSet` and `useOsdkAggregation` compare object sets by their definition, not by reference. An object set rebuilt on every render with the same filters does not trigger a new request."},"3100":{"id":"/react/object-sets-26","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#keep-object-sets-stable","content":"Your own code may still compare by reference: a `useMemo` or `useEffect` dependency array, or a memoized child component that takes the set as a prop, such as `ObjectTable`. `useStableObjectSet` returns the same `ObjectSet` instance until its definition changes, including any `where`, set operation, or pivot composed onto it:"},"3101":{"id":"/react/object-sets-27","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#keep-object-sets-stable","content":"The effect clears the selection only when `department` changes. Without `useStableObjectSet`, `employees` would be a new instance on every render, and the effect would run on every render. It also saves you from listing every input to the set in a `useMemo` dependency array."},"3102":{"id":"/react/object-sets-28","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#add-derived-properties","content":"`withProperties` defines properties that the server computes for each object and returns alongside its regular properties. Pass it to `useOsdkObjects` or `useObjectSet`. Each entry is a function that receives a builder for the object and returns a definition:"},"3103":{"id":"/react/object-sets-29","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#add-derived-properties","content":"Each derived property is typed on the returned objects. Define them in the hook's `withProperties` option: if you call `.withProperties()` on the object set you pass to `useObjectSet` instead, the server still computes them but the returned objects are not typed with them."},"3104":{"id":"/react/object-sets-30","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Method          | Returns                       | Description                                                            |\n| --------------- | ----------------------------- | ---------------------------------------------------------------------- |\n| `pivotTo(link)` | A builder for the linked type | Follow a link. After a link to many objects, you can only `aggregate`. |","table":"table-1"},"3105":{"id":"/react/object-sets-31","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Method          | Returns                    | Description                                        |\n| --------------- | -------------------------- | -------------------------------------------------- |\n| `where(clause)` | The same builder, filtered | Narrow the objects before you select or aggregate. |","table":"table-1"},"3106":{"id":"/react/object-sets-32","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Method                     | Returns      | Description                                                                                |\n| -------------------------- | ------------ | ------------------------------------------------------------------------------------------ |\n| `selectProperty(property)` | A definition | The value of one property. Available on the starting object and after links to one object. |","table":"table-1"},"3107":{"id":"/react/object-sets-33","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Method                        | Returns      | Description                        |\n| ----------------------------- | ------------ | ---------------------------------- |\n| `aggregate(specifier, opts?)` | A definition | A value computed over the objects. |","table":"table-1"},"3108":{"id":"/react/object-sets-34","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"`aggregate` takes `\"$count\"` or a `\"property:metric\"` string:"},"3109":{"id":"/react/object-sets-35","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Metric   | Property types | Value    | `opts` |\n| -------- | -------------- | -------- | ------ |\n| `$count` |                | `number` |        |","table":"table-2"},"3110":{"id":"/react/object-sets-36","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Metric       | Property types | Value                 | `opts` |\n| ------------ | -------------- | --------------------- | ------ |\n| `sum`, `avg` | Numeric        | `number \\| undefined` |        |","table":"table-2"},"3111":{"id":"/react/object-sets-37","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Metric       | Property types           | Value                                | `opts` |\n| ------------ | ------------------------ | ------------------------------------ | ------ |\n| `min`, `max` | Numeric, date, timestamp | Same as the property, or `undefined` |        |","table":"table-2"},"3112":{"id":"/react/object-sets-38","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Metric                                 | Property types | Value    | `opts` |\n| -------------------------------------- | -------------- | -------- | ------ |\n| `approximateDistinct`, `exactDistinct` | All            | `number` |        |","table":"table-2"},"3113":{"id":"/react/object-sets-39","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Metric                  | Property types | Value                 | `opts`                   |\n| ----------------------- | -------------- | --------------------- | ------------------------ |\n| `approximatePercentile` | Numeric        | `number \\| undefined` | `{ percentile: number }` |","table":"table-2"},"3114":{"id":"/react/object-sets-40","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"| Metric                      | Property types                                                  | Value                                        | `opts`              |\n| --------------------------- | --------------------------------------------------------------- | -------------------------------------------- | ------------------- |\n| `collectList`, `collectSet` | Strings, numbers, dates, timestamps, booleans, geo, attachments | Array of the property's type, or `undefined` | `{ limit: number }` |","table":"table-2"},"3115":{"id":"/react/object-sets-41","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"`sum`, `avg`, `min`, and `max` over no objects have no value, so render a fallback for them. `$count` is `0`."},"3116":{"id":"/react/object-sets-42","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#the-builder","content":"Numeric definitions chain `add`, `subtract`, `multiply`, `divide`, `min`, `max`, `abs`, and `negate`, which take a number or another numeric definition. Date and timestamp definitions chain `min`, `max`, and `extractPart(\"DAYS\" | \"MONTHS\" | \"QUARTERS\" | \"YEARS\")`."},"3117":{"id":"/react/object-sets-43","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#filter-on-a-derived-property","content":"`where` can reference derived properties defined in the same options. For TypeScript to infer them, annotate the builder parameter with `DerivedProperty.Builder` from `@osdk/client`:"},"3118":{"id":"/react/object-sets-44","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#filter-on-a-derived-property","content":"The `false` type argument says that the builder has not yet followed a link to many objects. `orderBy` accepts only the type's own properties, so you cannot sort by a derived property."},"3119":{"id":"/react/object-sets-45","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#filter-on-a-derived-property","content":"Queries with derived properties do not receive real-time updates. See Stream real-time updates."},"3120":{"id":"/react/object-sets-46","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"`objectSet` is an `ObjectSet` or `undefined`. When it is `undefined`, the hook does not query."},"3121":{"id":"/react/object-sets-47","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option  | Type             | Default | Description                                                           |\n| ------- | ---------------- | ------- | --------------------------------------------------------------------- |\n| `where` | `WhereClause<T>` |         | Filter the set. Can reference properties defined in `withProperties`. |","table":"table-3"},"3122":{"id":"/react/object-sets-48","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option           | Type                     | Default | Description                                              |\n| ---------------- | ------------------------ | ------- | -------------------------------------------------------- |\n| `withProperties` | `DerivedProperty.Clause` |         | Properties computed on the server, typed on the results. |","table":"table-3"},"3123":{"id":"/react/object-sets-49","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option  | Type             | Default | Description                    |\n| ------- | ---------------- | ------- | ------------------------------ |\n| `union` | `ObjectSet<T>[]` |         | Add the objects in these sets. |","table":"table-3"},"3124":{"id":"/react/object-sets-50","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option      | Type             | Default | Description                                    |\n| ----------- | ---------------- | ------- | ---------------------------------------------- |\n| `intersect` | `ObjectSet<T>[]` |         | Keep only objects that are also in these sets. |","table":"table-3"},"3125":{"id":"/react/object-sets-51","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option     | Type             | Default | Description                       |\n| ---------- | ---------------- | ------- | --------------------------------- |\n| `subtract` | `ObjectSet<T>[]` |         | Remove the objects in these sets. |","table":"table-3"},"3126":{"id":"/react/object-sets-52","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option    | Type      | Default | Description                                                                                            |\n| --------- | --------- | ------- | ------------------------------------------------------------------------------------------------------ |\n| `pivotTo` | Link name |         | Follow a link. Prefer calling `pivotTo` on the object set, which types the results as the linked type. |","table":"table-3"},"3127":{"id":"/react/object-sets-53","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option    | Type                               | Default | Description               |\n| --------- | ---------------------------------- | ------- | ------------------------- |\n| `orderBy` | `{ [property]?: \"asc\" \\| \"desc\" }` |         | Sort order, in key order. |","table":"table-3"},"3128":{"id":"/react/object-sets-54","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option     | Type     | Default        | Description          |\n| ---------- | -------- | -------------- | -------------------- |\n| `pageSize` | `number` | Server default | Objects per request. |","table":"table-3"},"3129":{"id":"/react/object-sets-55","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option          | Type                | Default | Description                                                                |\n| --------------- | ------------------- | ------- | -------------------------------------------------------------------------- |\n| `autoFetchMore` | `boolean \\| number` |         | Load pages automatically: `true` for all, a number for at least that many. |","table":"table-3"},"3130":{"id":"/react/object-sets-56","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option    | Type                | Default            | Description                                            |\n| --------- | ------------------- | ------------------ | ------------------------------------------------------ |\n| `$select` | `PropertyKeys<T>[]` | Server default set | Properties to load. Does not narrow the returned type. |","table":"table-3"},"3131":{"id":"/react/object-sets-57","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option          | Type      | Default | Description                                                        |\n| --------------- | --------- | ------- | ------------------------------------------------------------------ |\n| `streamUpdates` | `boolean` | `false` | Subscribe to live changes. Not with `pivotTo` or `withProperties`. |","table":"table-3"},"3132":{"id":"/react/object-sets-58","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option    | Type      | Default | Description                                                 |\n| --------- | --------- | ------- | ----------------------------------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made and `data` is `undefined`. |","table":"table-3"},"3133":{"id":"/react/object-sets-59","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Option             | Type     | Default | Description                                             |\n| ------------------ | -------- | ------- | ------------------------------------------------------- |\n| `dedupeIntervalMs` | `number` | `2000`  | Identical queries within this window share one request. |","table":"table-3"},"3134":{"id":"/react/object-sets-60","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return | Type                              | Description                                                                                     |\n| ------ | --------------------------------- | ----------------------------------------------------------------------------------------------- |\n| `data` | `Osdk.Instance<T>[] \\| undefined` | Loaded objects, with derived properties. Keeps the previous result while a changed query loads. |","table":"table-4"},"3135":{"id":"/react/object-sets-61","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return      | Type      | Description                                          |\n| ----------- | --------- | ---------------------------------------------------- |\n| `isLoading` | `boolean` | `true` until the current query has loaded or failed. |","table":"table-4"},"3136":{"id":"/react/object-sets-62","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return  | Type                 | Description                          |\n| ------- | -------------------- | ------------------------------------ |\n| `error` | `Error \\| undefined` | The last error, if the query failed. |","table":"table-4"},"3137":{"id":"/react/object-sets-63","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return         | Type      | Description                                               |\n| -------------- | --------- | --------------------------------------------------------- |\n| `isOptimistic` | `boolean` | Whether the list includes unconfirmed optimistic changes. |","table":"table-4"},"3138":{"id":"/react/object-sets-64","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return      | Type                                 | Description                                                   |\n| ----------- | ------------------------------------ | ------------------------------------------------------------- |\n| `fetchMore` | `(() => Promise<void>) \\| undefined` | Load the next page. `undefined` when there are no more pages. |","table":"table-4"},"3139":{"id":"/react/object-sets-65","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return    | Type      | Description               |\n| --------- | --------- | ------------------------- |\n| `hasMore` | `boolean` | Whether more pages exist. |","table":"table-4"},"3140":{"id":"/react/object-sets-66","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return       | Type                  | Description                                         |\n| ------------ | --------------------- | --------------------------------------------------- |\n| `totalCount` | `string \\| undefined` | Total matching objects, when the server reports it. |","table":"table-4"},"3141":{"id":"/react/object-sets-67","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return      | Type                        | Description                                         |\n| ----------- | --------------------------- | --------------------------------------------------- |\n| `objectSet` | `ObjectSet<T> \\| undefined` | The final object set after all options are applied. |","table":"table-4"},"3142":{"id":"/react/object-sets-68","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#useobjectsetobjectset-options","content":"| Return    | Type                  | Description                             |\n| --------- | --------------------- | --------------------------------------- |\n| `refetch` | `() => Promise<void>` | Invalidate the object type and refetch. |","table":"table-4"},"3143":{"id":"/react/object-sets-69","page_id":"/react/object-sets","tags":[],"type":"text","url":"/react/object-sets#usestableobjectsetobjectset","content":"Returns `objectSet`, or the instance returned on an earlier render if the definition is unchanged. Accepts and returns `ObjectSet | undefined`."},"3144":{"id":"/react/objects","page_id":"/react/objects","type":"page","content":"Query objects","breadcrumbs":["OSDK TypeScript","React","Read data"],"tags":[],"url":"/react/objects"},"3145":{"id":"/react/objects-0","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects","content":"Load, filter, sort, paginate, and stream lists of objects with useOsdkObjects, and load a single object with useOsdkObject."},"3146":{"id":"/react/objects-1","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#list-objects","content":"List objects"},"3147":{"id":"/react/objects-2","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#filter-with-where","content":"Filter with `where`"},"3148":{"id":"/react/objects-3","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#combine-conditions","content":"Combine conditions"},"3149":{"id":"/react/objects-4","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#search-text","content":"Search text"},"3150":{"id":"/react/objects-5","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#load-specific-objects-by-rid","content":"Load specific objects by RID"},"3151":{"id":"/react/objects-6","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#sort-with-orderby","content":"Sort with `orderBy`"},"3152":{"id":"/react/objects-7","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#select-properties","content":"Select properties"},"3153":{"id":"/react/objects-8","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#query-an-interface","content":"Query an interface"},"3154":{"id":"/react/objects-9","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#paginate","content":"Paginate"},"3155":{"id":"/react/objects-10","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#stream-real-time-updates","content":"Stream real-time updates"},"3156":{"id":"/react/objects-11","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#fetch-conditionally","content":"Fetch conditionally"},"3157":{"id":"/react/objects-12","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#load-one-object","content":"Load one object"},"3158":{"id":"/react/objects-13","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#track-an-instance-you-already-have","content":"Track an instance you already have"},"3159":{"id":"/react/objects-14","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#refresh-data","content":"Refresh data"},"3160":{"id":"/react/objects-15","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#reference","content":"Reference"},"3161":{"id":"/react/objects-16","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#useosdkobjectstype-options","content":"`useOsdkObjects(type, options?)`"},"3162":{"id":"/react/objects-17","page_id":"/react/objects","type":"heading","tags":[],"url":"/react/objects#useosdkobject","content":"`useOsdkObject`"},"3163":{"id":"/react/objects-18","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects","content":"`useOsdkObjects` loads a list of objects of one type, and `useOsdkObject` loads a single object. Both read from the shared cache that `OsdkProvider` sets up, so every component that shows the same object re-renders when it changes."},"3164":{"id":"/react/objects-19","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#list-objects","content":"Pass an object type from your generated SDK. The hook fetches the first page and returns it as `data`."},"3165":{"id":"/react/objects-20","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#list-objects","content":"`data` is `undefined` until the first page arrives. After that, `isLoading` can be `true` while `data` still holds the previous result, for example while the hook revalidates after an action. Keep rendering `data` during those refreshes instead of replacing the list with a spinner. Loading and errors covers the pattern in depth."},"3166":{"id":"/react/objects-21","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#list-objects","content":"`isOptimistic` is `true` when the order or membership of the list reflects an optimistic update that the server has not confirmed yet. It only describes the list of primary keys. To check whether one object's contents are optimistic, pass that object to `useOsdkObject`."},"3167":{"id":"/react/objects-22","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"`where` takes the same clause as `ObjectSet.where` in `@osdk/client`. A bare value on a property means equality:"},"3168":{"id":"/react/objects-23","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"For anything else, give the property an object with one operator:"},"3169":{"id":"/react/objects-24","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"Several properties in the same clause must all match. The operators each property accepts depend on its type:"},"3170":{"id":"/react/objects-25","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator     | Property types                                | Matches                                                                                 |\n| ------------ | --------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `$eq`, `$ne` | Strings, numbers, booleans, dates, timestamps | Equal to, or not equal to, the value. `{ department: \"Sales\" }` is shorthand for `$eq`. |","table":"table-0"},"3171":{"id":"/react/objects-26","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator | Property types                                | Matches                   |\n| -------- | --------------------------------------------- | ------------------------- |\n| `$in`    | Strings, numbers, booleans, dates, timestamps | Any of the listed values. |","table":"table-0"},"3172":{"id":"/react/objects-27","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator  | Property types | Matches                                              |\n| --------- | -------------- | ---------------------------------------------------- |\n| `$isNull` | All            | `true` for missing values, `false` for present ones. |","table":"table-0"},"3173":{"id":"/react/objects-28","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator                     | Property types                      | Matches                                                                     |\n| ---------------------------- | ----------------------------------- | --------------------------------------------------------------------------- |\n| `$gt`, `$gte`, `$lt`, `$lte` | Numbers, dates, timestamps, strings | Greater or less than the value. Dates and timestamps take ISO 8601 strings. |","table":"table-0"},"3174":{"id":"/react/objects-29","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator                                                                           | Property types | Matches                       |\n| ---------------------------------------------------------------------------------- | -------------- | ----------------------------- |\n| `$startsWith`, `$containsAnyTerm`, `$containsAllTerms`, `$containsAllTermsInOrder` | Strings        | Text search. See Search text. |","table":"table-0"},"3175":{"id":"/react/objects-30","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator        | Property types | Matches                     |\n| --------------- | -------------- | --------------------------- |\n| `$matchesRegex` | Strings        | A regular expression. Beta. |","table":"table-0"},"3176":{"id":"/react/objects-31","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator    | Property types | Matches                        |\n| ----------- | -------------- | ------------------------------ |\n| `$contains` | Arrays         | Arrays that contain the value. |","table":"table-0"},"3177":{"id":"/react/objects-32","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"| Operator                 | Property types       | Matches                               |\n| ------------------------ | -------------------- | ------------------------------------- |\n| `$within`, `$intersects` | Geopoints, geoshapes | A distance, bounding box, or polygon. |","table":"table-0"},"3178":{"id":"/react/objects-33","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"You can also filter on `$primaryKey`, for example `{ $primaryKey: { $in: [101, 102] } }`, without knowing the name of the primary key property."},"3179":{"id":"/react/objects-34","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#filter-with-where","content":"`$in` with an empty array matches every object. If the list comes from user input, set `enabled: false` (see Fetch conditionally) or leave the filter out when the list is empty."},"3180":{"id":"/react/objects-35","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#combine-conditions","content":"Each property takes exactly one operator, so a range on one property needs `$and`:"},"3181":{"id":"/react/objects-36","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#combine-conditions","content":"`$or` matches any of its clauses, and `$not` negates one clause. They nest:"},"3182":{"id":"/react/objects-37","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#combine-conditions","content":"To intersect several independent filters, you can also pass `intersectWith`, an array of `{ where }` clauses. The result contains only objects that match `where` and every entry."},"3183":{"id":"/react/objects-38","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"String properties support four search operators. `$containsAnyTerm` and `$containsAllTerms` also accept `{ term, fuzzySearch: true }` to tolerate small typos. All four accept `{ term, phoneticSearch: true }`, which matches similarly pronounced terms, such as `Jon` and `John`, on properties with phonetic search enabled. A filter cannot set both `fuzzySearch` and `phoneticSearch`; combine the two with `$or`."},"3184":{"id":"/react/objects-39","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"| Operator      | Matches                           | Fuzzy | Phonetic | Example value | Matches `\"Senior Software Engineer\"` |\n| ------------- | --------------------------------- | ----- | -------- | ------------- | ------------------------------------ |\n| `$startsWith` | Values that begin with the prefix | No    | Yes      | `\"Senior\"`    | Yes                                  |","table":"table-1"},"3185":{"id":"/react/objects-40","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"| Operator           | Matches                                              | Fuzzy | Phonetic | Example value         | Matches `\"Senior Software Engineer\"` |\n| ------------------ | ---------------------------------------------------- | ----- | -------- | --------------------- | ------------------------------------ |\n| `$containsAnyTerm` | Values that contain any of the space-separated terms | Yes   | Yes      | `\"designer engineer\"` | Yes                                  |","table":"table-1"},"3186":{"id":"/react/objects-41","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"| Operator            | Matches                                      | Fuzzy | Phonetic | Example value       | Matches `\"Senior Software Engineer\"` |\n| ------------------- | -------------------------------------------- | ----- | -------- | ------------------- | ------------------------------------ |\n| `$containsAllTerms` | Values that contain every term, in any order | Yes   | Yes      | `\"engineer senior\"` | Yes                                  |","table":"table-1"},"3187":{"id":"/react/objects-42","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"| Operator                   | Matches                                       | Fuzzy | Phonetic | Example value       | Matches `\"Senior Software Engineer\"` |\n| -------------------------- | --------------------------------------------- | ----- | -------- | ------------------- | ------------------------------------ |\n| `$containsAllTermsInOrder` | Values that contain every term, in this order | No    | Yes      | `\"engineer senior\"` | No                                   |","table":"table-1"},"3188":{"id":"/react/objects-43","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"A search box that waits for two characters before it queries:"},"3189":{"id":"/react/objects-44","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#search-text","content":"To send fewer requests while the user types, debounce the state update with `useDebouncedCallback` from `@osdk/react`."},"3190":{"id":"/react/objects-45","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#load-specific-objects-by-rid","content":"`rids` starts from a fixed set of objects instead of every object of the type. `where` and `orderBy` then filter and sort that set. Objects loaded this way have `$rid` set."},"3191":{"id":"/react/objects-46","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#sort-with-orderby","content":"`orderBy` maps property names to `\"asc\"` or `\"desc\"`. List several properties to break ties, in priority order:"},"3192":{"id":"/react/objects-47","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#sort-with-orderby","content":"`orderBy` accepts the object type's own properties. To sort by a value computed from linked objects, see derived properties."},"3193":{"id":"/react/objects-48","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#select-properties","content":"Without `$select`, the server returns its default property set for each object. Pass `$select` with only the properties the component reads; the primary key is always included."},"3194":{"id":"/react/objects-49","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#select-properties","content":"Loading unused properties costs bandwidth and slows down the query, and filtering them out after the fact does not get that cost back. Unlike `fetchPage` in `@osdk/client`, `useOsdkObjects` does not narrow the returned type to the selected properties. Reading a property you did not select still type-checks but is `undefined` at runtime, so keep `$select` in sync with what you render."},"3195":{"id":"/react/objects-50","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#query-an-interface","content":"When you pass an interface instead of an object type, each object only exposes the interface's properties. Two options change that:"},"3196":{"id":"/react/objects-51","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#query-an-interface","content":"| Option                                  | Effect                                                                  |\n| --------------------------------------- | ----------------------------------------------------------------------- |\n| `$includeAllBaseObjectProperties: true` | The server also returns every property of the implementing object type. |","table":"table-2"},"3197":{"id":"/react/objects-52","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#query-an-interface","content":"| Option                      | Effect                                                                                                                                                                                                         |\n| --------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `resolveToObjectType: true` | The hook returns instances of the implementing object type instead of interface views, so properties such as `$title` and properties that are not on the interface are available. Only allowed for interfaces. |","table":"table-2"},"3198":{"id":"/react/objects-53","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"`pageSize` sets how many objects each request loads. It is not a limit on the total. Call `fetchMore` to load the next page; it is `undefined` once there are no more pages, and `hasMore` is `false`."},"3199":{"id":"/react/objects-54","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"`totalCount` is a string because the count can exceed `Number.MAX_SAFE_INTEGER`. It is `undefined` when the server does not report it."},"3200":{"id":"/react/objects-55","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"To load more pages without a button, set `autoFetchMore`:"},"3201":{"id":"/react/objects-56","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"| Value                 | Behavior                  |\n| --------------------- | ------------------------- |\n| `undefined` (default) | Load the first page only. |","table":"table-3"},"3202":{"id":"/react/objects-57","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"| Value                   | Behavior                                                                      |\n| ----------------------- | ----------------------------------------------------------------------------- |\n| A number, such as `200` | Keep loading pages until the list has at least that many objects or runs out. |","table":"table-3"},"3203":{"id":"/react/objects-58","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"| Value  | Behavior         |\n| ------ | ---------------- |\n| `true` | Load every page. |","table":"table-3"},"3204":{"id":"/react/objects-59","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"`autoFetchMore: true` on a large object type can take a long time and hold every object in memory. Prefer a number, or `fetchMore` on demand. For counts, sums, and group-bys, use `useOsdkAggregation` instead of loading objects."},"3205":{"id":"/react/objects-60","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#paginate","content":"Pages load without a snapshot. If objects are added, removed, or edited between page requests, later pages can repeat or skip objects. When you need every object from one consistent view, call `asyncIter()` on the client from `useOsdkClient` in an event handler or effect."},"3206":{"id":"/react/objects-61","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#stream-real-time-updates","content":"Set `streamUpdates: true` to subscribe to changes over a WebSocket. The list then updates when matching objects are created, edited so that they start or stop matching `where`, or deleted, without waiting for a refetch."},"3207":{"id":"/react/objects-62","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#stream-real-time-updates","content":"The server has no WebSocket subscriptions for link traversals or derived properties. TypeScript rejects `streamUpdates` together with `pivotTo`. With `withProperties`, the code compiles, but the hook ignores `streamUpdates` and logs a warning in development. Both kinds of query still load data normally; they refresh when the cache is invalidated instead of in real time. The same applies to `useObjectSet`."},"3208":{"id":"/react/objects-63","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#fetch-conditionally","content":"Hooks cannot be called inside a condition, so use `enabled` instead. While `enabled` is `false`, the hook makes no request and returns `data: undefined` and `isLoading: false`. Setting it back to `true` starts the query."},"3209":{"id":"/react/objects-64","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#load-one-object","content":"`useOsdkObject` takes an object type and a primary key, and returns `object`:"},"3210":{"id":"/react/objects-65","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#load-one-object","content":"The third argument is either a boolean that enables or disables the query, or an options object:"},"3211":{"id":"/react/objects-66","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#track-an-instance-you-already-have","content":"When a component receives an object from a list, pass the instance itself. The hook does not fetch; it subscribes to the cached copy, so the component re-renders when an action or optimistic update changes that object, and `isOptimistic` tells you whether the change is confirmed."},"3212":{"id":"/react/objects-67","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#track-an-instance-you-already-have","content":"The instance form takes an optional boolean as its second argument to disable it."},"3213":{"id":"/react/objects-68","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#refresh-data","content":"`refetch` on the `useOsdkObjects` result invalidates the whole object type: every cached object, list, and link query of that type refetches, not only this list. Actions already invalidate the types they modify, so you only need `refetch` for changes made outside the app."},"3214":{"id":"/react/objects-69","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#refresh-data","content":"To refresh one object, invalidate it with the observable client:"},"3215":{"id":"/react/objects-70","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#refresh-data","content":"`useOsdkObject` also returns a `forceUpdate` function, but it is not implemented and throws when called. Cache invalidation covers the other invalidation methods."},"3216":{"id":"/react/objects-71","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option  | Type             | Default | Description                                                          |\n| ------- | ---------------- | ------- | -------------------------------------------------------------------- |\n| `where` | `WhereClause<T>` |         | Filter clause. Can reference properties defined in `withProperties`. |","table":"table-4"},"3217":{"id":"/react/objects-72","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option    | Type                               | Default | Description               |\n| --------- | ---------------------------------- | ------- | ------------------------- |\n| `orderBy` | `{ [property]?: \"asc\" \\| \"desc\" }` |         | Sort order, in key order. |","table":"table-4"},"3218":{"id":"/react/objects-73","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option     | Type     | Default        | Description          |\n| ---------- | -------- | -------------- | -------------------- |\n| `pageSize` | `number` | Server default | Objects per request. |","table":"table-4"},"3219":{"id":"/react/objects-74","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option          | Type                | Default | Description                                                                |\n| --------------- | ------------------- | ------- | -------------------------------------------------------------------------- |\n| `autoFetchMore` | `boolean \\| number` |         | Load pages automatically: `true` for all, a number for at least that many. |","table":"table-4"},"3220":{"id":"/react/objects-75","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option    | Type                | Default            | Description                                            |\n| --------- | ------------------- | ------------------ | ------------------------------------------------------ |\n| `$select` | `PropertyKeys<T>[]` | Server default set | Properties to load. Does not narrow the returned type. |","table":"table-4"},"3221":{"id":"/react/objects-76","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option | Type                | Default | Description                                                                 |\n| ------ | ------------------- | ------- | --------------------------------------------------------------------------- |\n| `rids` | `readonly string[]` |         | Start from these objects instead of the whole type. Adds `$rid` to results. |","table":"table-4"},"3222":{"id":"/react/objects-77","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option          | Type                               | Default | Description                                           |\n| --------------- | ---------------------------------- | ------- | ----------------------------------------------------- |\n| `intersectWith` | `Array<{ where: WhereClause<T> }>` |         | Additional filters that every result must also match. |","table":"table-4"},"3223":{"id":"/react/objects-78","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option    | Type      | Default | Description                                                                    |\n| --------- | --------- | ------- | ------------------------------------------------------------------------------ |\n| `pivotTo` | Link name |         | Return the objects linked from the matching objects instead. See Follow links. |","table":"table-4"},"3224":{"id":"/react/objects-79","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option           | Type                     | Default | Description                                                |\n| ---------------- | ------------------------ | ------- | ---------------------------------------------------------- |\n| `withProperties` | `DerivedProperty.Clause` |         | Properties computed on the server. See derived properties. |","table":"table-4"},"3225":{"id":"/react/objects-80","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option          | Type      | Default | Description                                                        |\n| --------------- | --------- | ------- | ------------------------------------------------------------------ |\n| `streamUpdates` | `boolean` | `false` | Subscribe to live changes. Not with `pivotTo` or `withProperties`. |","table":"table-4"},"3226":{"id":"/react/objects-81","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option    | Type      | Default | Description                                                 |\n| --------- | --------- | ------- | ----------------------------------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made and `data` is `undefined`. |","table":"table-4"},"3227":{"id":"/react/objects-82","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option             | Type     | Default | Description                                                 |\n| ------------------ | -------- | ------- | ----------------------------------------------------------- |\n| `dedupeIntervalMs` | `number` | `2000`  | Two identical queries within this window share one request. |","table":"table-4"},"3228":{"id":"/react/objects-83","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option                          | Type      | Default | Description                                                                           |\n| ------------------------------- | --------- | ------- | ------------------------------------------------------------------------------------- |\n| `$loadPropertySecurityMetadata` | `boolean` | `false` | Populate `$propertySecurities` on each object with per-property marking requirements. |","table":"table-4"},"3229":{"id":"/react/objects-84","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option                            | Type      | Default | Description                                                    |\n| --------------------------------- | --------- | ------- | -------------------------------------------------------------- |\n| `$includeAllBaseObjectProperties` | `boolean` | `false` | Interfaces only: also load the implementing type's properties. |","table":"table-4"},"3230":{"id":"/react/objects-85","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Option                | Type      | Default | Description                                                 |\n| --------------------- | --------- | ------- | ----------------------------------------------------------- |\n| `resolveToObjectType` | `boolean` | `false` | Interfaces only: return implementing object type instances. |","table":"table-4"},"3231":{"id":"/react/objects-86","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return | Type                              | Description                                                           |\n| ------ | --------------------------------- | --------------------------------------------------------------------- |\n| `data` | `Osdk.Instance<T>[] \\| undefined` | Loaded objects. `undefined` before the first page and while disabled. |","table":"table-5"},"3232":{"id":"/react/objects-87","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return      | Type      | Description                                                                      |\n| ----------- | --------- | -------------------------------------------------------------------------------- |\n| `isLoading` | `boolean` | `true` while a request is in flight, including revalidation with `data` present. |","table":"table-5"},"3233":{"id":"/react/objects-88","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return  | Type                 | Description                          |\n| ------- | -------------------- | ------------------------------------ |\n| `error` | `Error \\| undefined` | The last error, if the query failed. |","table":"table-5"},"3234":{"id":"/react/objects-89","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return         | Type      | Description                                                                   |\n| -------------- | --------- | ----------------------------------------------------------------------------- |\n| `isOptimistic` | `boolean` | Whether the list order or membership includes unconfirmed optimistic changes. |","table":"table-5"},"3235":{"id":"/react/objects-90","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return      | Type                                 | Description                                                   |\n| ----------- | ------------------------------------ | ------------------------------------------------------------- |\n| `fetchMore` | `(() => Promise<void>) \\| undefined` | Load the next page. `undefined` when there are no more pages. |","table":"table-5"},"3236":{"id":"/react/objects-91","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return    | Type      | Description               |\n| --------- | --------- | ------------------------- |\n| `hasMore` | `boolean` | Whether more pages exist. |","table":"table-5"},"3237":{"id":"/react/objects-92","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return       | Type                  | Description                                         |\n| ------------ | --------------------- | --------------------------------------------------- |\n| `totalCount` | `string \\| undefined` | Total matching objects, when the server reports it. |","table":"table-5"},"3238":{"id":"/react/objects-93","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return      | Type                        | Description                                                                                                                        |\n| ----------- | --------------------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `objectSet` | `ObjectSet<T> \\| undefined` | The object set the hook queried, after `where`, `intersectWith`, and `pivotTo`. Pass it to `useOsdkAggregation` or `useObjectSet`. |","table":"table-5"},"3239":{"id":"/react/objects-94","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobjectstype-options","content":"| Return    | Type                  | Description                             |\n| --------- | --------------------- | --------------------------------------- |\n| `refetch` | `() => Promise<void>` | Invalidate the object type and refetch. |","table":"table-5"},"3240":{"id":"/react/objects-95","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Signature                                   | Description          |\n| ------------------------------------------- | -------------------- |\n| `useOsdkObject(type, primaryKey, enabled?)` | Load by primary key. |","table":"table-6"},"3241":{"id":"/react/objects-96","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Signature                                   | Description                       |\n| ------------------------------------------- | --------------------------------- |\n| `useOsdkObject(type, primaryKey, options?)` | Load by primary key with options. |","table":"table-6"},"3242":{"id":"/react/objects-97","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Signature                           | Description                                                                  |\n| ----------------------------------- | ---------------------------------------------------------------------------- |\n| `useOsdkObject(instance, enabled?)` | Subscribe to an instance you already have. Reads the cache without fetching. |","table":"table-6"},"3243":{"id":"/react/objects-98","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Option    | Type      | Default | Description                       |\n| --------- | --------- | ------- | --------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made. |","table":"table-7"},"3244":{"id":"/react/objects-99","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Option    | Type                | Default            | Description         |\n| --------- | ------------------- | ------------------ | ------------------- |\n| `$select` | `PropertyKeys<T>[]` | Server default set | Properties to load. |","table":"table-7"},"3245":{"id":"/react/objects-100","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Option                          | Type      | Default | Description                                                            |\n| ------------------------------- | --------- | ------- | ---------------------------------------------------------------------- |\n| `$loadPropertySecurityMetadata` | `boolean` | `false` | Populate `$propertySecurities` with per-property marking requirements. |","table":"table-7"},"3246":{"id":"/react/objects-101","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Option                            | Type      | Default | Description                                                    |\n| --------------------------------- | --------- | ------- | -------------------------------------------------------------- |\n| `$includeAllBaseObjectProperties` | `boolean` | `false` | Interfaces only: also load the implementing type's properties. |","table":"table-7"},"3247":{"id":"/react/objects-102","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Return   | Type                            | Description                                                                    |\n| -------- | ------------------------------- | ------------------------------------------------------------------------------ |\n| `object` | `Osdk.Instance<T> \\| undefined` | The object. `undefined` while loading, while disabled, or if it was not found. |","table":"table-8"},"3248":{"id":"/react/objects-103","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Return      | Type      | Description                                                          |\n| ----------- | --------- | -------------------------------------------------------------------- |\n| `isLoading` | `boolean` | `true` while a request is in flight. `false` once there is an error. |","table":"table-8"},"3249":{"id":"/react/objects-104","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Return  | Type                 | Description                         |\n| ------- | -------------------- | ----------------------------------- |\n| `error` | `Error \\| undefined` | The last error, if the load failed. |","table":"table-8"},"3250":{"id":"/react/objects-105","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Return         | Type      | Description                                                 |\n| -------------- | --------- | ----------------------------------------------------------- |\n| `isOptimistic` | `boolean` | Whether the object includes unconfirmed optimistic changes. |","table":"table-8"},"3251":{"id":"/react/objects-106","page_id":"/react/objects","tags":[],"type":"text","url":"/react/objects#useosdkobject","content":"| Return        | Type         | Description                                               |\n| ------------- | ------------ | --------------------------------------------------------- |\n| `forceUpdate` | `() => void` | Not implemented; throws. Use `invalidateObjects` instead. |","table":"table-8"},"3252":{"id":"/react/optimistic-updates","page_id":"/react/optimistic-updates","type":"page","content":"Optimistic updates","breadcrumbs":["OSDK TypeScript","React","Write data"],"tags":[],"url":"/react/optimistic-updates"},"3253":{"id":"/react/optimistic-updates-0","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates","content":"Show an action's result before the server responds by layering optimistic edits on the cache, with automatic rollback when the action fails."},"3254":{"id":"/react/optimistic-updates-1","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#add-an-optimistic-update","content":"Add an optimistic update"},"3255":{"id":"/react/optimistic-updates-2","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#builder-methods","content":"Builder methods"},"3256":{"id":"/react/optimistic-updates-3","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#create-an-object","content":"Create an object"},"3257":{"id":"/react/optimistic-updates-4","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#edit-several-objects","content":"Edit several objects"},"3258":{"id":"/react/optimistic-updates-5","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#what-happens-when-the-action-runs","content":"What happens when the action runs"},"3259":{"id":"/react/optimistic-updates-6","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#the-optimistic-layer-is-applied","content":"The optimistic layer is applied"},"3260":{"id":"/react/optimistic-updates-7","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#the-action-is-sent","content":"The action is sent"},"3261":{"id":"/react/optimistic-updates-8","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#the-layer-is-removed","content":"The layer is removed"},"3262":{"id":"/react/optimistic-updates-9","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#show-that-a-change-is-pending","content":"Show that a change is pending"},"3263":{"id":"/react/optimistic-updates-10","page_id":"/react/optimistic-updates","type":"heading","tags":[],"url":"/react/optimistic-updates#simulate-latency-in-development","content":"Simulate latency in development"},"3264":{"id":"/react/optimistic-updates-11","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates","content":"An optimistic update shows the expected result of an action as soon as the user triggers it. You describe the edits, the cache shows them on top of the real data, and they are removed when the action finishes, whether it succeeds or fails."},"3265":{"id":"/react/optimistic-updates-12","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#add-an-optimistic-update","content":"Add `$optimisticUpdate` to the parameters you pass to `applyAction` from `useOsdkAction`. The callback receives a builder for the edits you expect:"},"3266":{"id":"/react/optimistic-updates-13","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#add-an-optimistic-update","content":"`$optimisticUpdate` runs synchronously when you call `applyAction`, before the request is sent. The `$` prefix keeps it apart from the action's own parameters, and it is not sent to the server."},"3267":{"id":"/react/optimistic-updates-14","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#builder-methods","content":"Each method returns the builder, so you can chain calls."},"3268":{"id":"/react/optimistic-updates-15","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#builder-methods","content":"| Method                   | Description                                                       |\n| ------------------------ | ----------------------------------------------------------------- |\n| `updateObject(instance)` | Replaces a cached object with `instance`. Build it with `$clone`. |","table":"table-0"},"3269":{"id":"/react/optimistic-updates-16","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#builder-methods","content":"| Method                                       | Description                                                                                                                               |\n| -------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------- |\n| `createObject(type, primaryKey, properties)` | Adds a new object of `type` to the cache. `properties` lists every property of the type; pass `undefined` for values you do not know yet. |","table":"table-0"},"3270":{"id":"/react/optimistic-updates-17","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#builder-methods","content":"| Method                   | Description                                                             |\n| ------------------------ | ----------------------------------------------------------------------- |\n| `deleteObject(instance)` | Removes the object from the cache and from every list that contains it. |","table":"table-0"},"3271":{"id":"/react/optimistic-updates-18","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#builder-methods","content":"OSDK objects are immutable. `$clone` returns a copy with the properties you pass changed:"},"3272":{"id":"/react/optimistic-updates-19","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#create-an-object","content":"The server assigns the real primary key, so give the optimistic object a temporary one that cannot collide with a real object. This example uses `applyAction` from `useOsdkAction(createOffice)`, for an `Office` type whose properties are `officeId`, `name`, and `city`:"},"3273":{"id":"/react/optimistic-updates-20","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#create-an-object","content":"Lists of that type add the new object if it matches their `where` clause. When the action finishes, the temporary object goes away and the real one loads in its place."},"3274":{"id":"/react/optimistic-updates-21","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#edit-several-objects","content":"One callback can describe every edit the action makes. For an action that moves a lead and their reports to a new department:"},"3275":{"id":"/react/optimistic-updates-22","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#the-optimistic-layer-is-applied","content":"Your edits go into a separate layer on top of the cached server data. Every component that reads an edited object, or a list that contains one, re-renders with the edits."},"3276":{"id":"/react/optimistic-updates-23","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#the-action-is-sent","content":"The request goes to Foundry while the layer is shown. `isPending` from `useOsdkAction` is `true`."},"3277":{"id":"/react/optimistic-updates-24","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#the-layer-is-removed","content":"If the action succeeds, the cache first refetches every object the server reports as edited, then removes the layer, so the UI moves from your edits to the server's values without showing the old ones in between."},"3278":{"id":"/react/optimistic-updates-25","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#the-layer-is-removed","content":"If the action fails, the layer is removed straight away and the UI returns to the previous server values. `applyAction` rejects and `error` is set. You do not undo anything yourself."},"3279":{"id":"/react/optimistic-updates-26","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#the-layer-is-removed","content":"An optimistic edit can add an object to a list or remove a deleted one, but it does not remove an object that stops matching a list's `where` clause. That list catches up when the server responds."},"3280":{"id":"/react/optimistic-updates-27","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#the-layer-is-removed","content":"Because the layer is always removed, write the update you expect the server to make. If the server's result differs, for example a property computed on the server, the server's value replaces yours when the layer goes."},"3281":{"id":"/react/optimistic-updates-28","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#show-that-a-change-is-pending","content":"Hooks that read from the cache report whether what they show includes optimistic edits:"},"3282":{"id":"/react/optimistic-updates-29","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#show-that-a-change-is-pending","content":"| Hook            | Field          | `true` when                                |\n| --------------- | -------------- | ------------------------------------------ |\n| `useOsdkObject` | `isOptimistic` | The object comes from an optimistic layer. |","table":"table-1"},"3283":{"id":"/react/optimistic-updates-30","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#show-that-a-change-is-pending","content":"| Hook                                         | Field          | `true` when                                                                                                                                                                                          |\n| -------------------------------------------- | -------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `useOsdkObjects`, `useObjectSet`, `useLinks` | `isOptimistic` | The membership or order of the list comes from an optimistic layer. An edit that only changes properties of an object already in the list does not set it; check those objects with `useOsdkObject`. |","table":"table-1"},"3284":{"id":"/react/optimistic-updates-31","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#show-that-a-change-is-pending","content":"Use `isOptimistic` for a subtle \"saving\" cue, and `isPending` from `useOsdkAction` to disable controls."},"3285":{"id":"/react/optimistic-updates-32","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#simulate-latency-in-development","content":"Against a fast backend, the optimistic state can disappear before you see it. In development builds, the cache waits 1000 ms after the server responds before removing the layer, so you can check that the optimistic state renders correctly. The first time it waits, it logs a message to the console."},"3286":{"id":"/react/optimistic-updates-33","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#simulate-latency-in-development","content":"The delay applies only to single `applyAction` calls that pass `$optimisticUpdate`. Batches and actions without an optimistic update are not delayed, and production builds never delay. Change it with the `devMode` prop on `OsdkProvider`:"},"3287":{"id":"/react/optimistic-updates-34","page_id":"/react/optimistic-updates","tags":[],"type":"text","url":"/react/optimistic-updates#simulate-latency-in-development","content":"Set `actionDelayMs: 0` to turn the delay off. `devMode` also accepts `logLevel` and `debug` for logging cache internals; see Invalidate the cache."},"3288":{"id":"/react/platform-apis","page_id":"/react/platform-apis","type":"page","content":"Users and markings","breadcrumbs":["OSDK TypeScript","React","Platform"],"tags":[],"url":"/react/platform-apis"},"3289":{"id":"/react/platform-apis-0","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis","content":"Load Foundry users, markings, and CBAC classification banners in React with the hooks in @osdk/react/platform-apis."},"3290":{"id":"/react/platform-apis-1","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#install-the-platform-packages","content":"Install the platform packages"},"3291":{"id":"/react/platform-apis-2","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#show-the-signed-in-user","content":"Show the signed-in user"},"3292":{"id":"/react/platform-apis-3","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#look-up-a-user","content":"Look up a user"},"3293":{"id":"/react/platform-apis-4","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#list-users","content":"List users"},"3294":{"id":"/react/platform-apis-5","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#list-markings","content":"List markings"},"3295":{"id":"/react/platform-apis-6","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#get-a-users-markings","content":"Get a user's markings"},"3296":{"id":"/react/platform-apis-7","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#show-a-classification-banner","content":"Show a classification banner"},"3297":{"id":"/react/platform-apis-8","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#how-these-hooks-load-data","content":"How these hooks load data"},"3298":{"id":"/react/platform-apis-9","page_id":"/react/platform-apis","type":"heading","tags":[],"url":"/react/platform-apis#handle-errors","content":"Handle errors"},"3299":{"id":"/react/platform-apis-10","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis","content":"The hooks in `@osdk/react/platform-apis` call Foundry platform APIs for users and markings with the client from `OsdkProvider`. Use them to show who is signed in, look up other users, list markings, and render classification banners."},"3300":{"id":"/react/platform-apis-11","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#install-the-platform-packages","content":"The hooks depend on two optional peer packages. Install them before importing from `@osdk/react/platform-apis`:"},"3301":{"id":"/react/platform-apis-12","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#install-the-platform-packages","content":"Without them, the bundler fails with `Rollup failed to resolve import \"@osdk/foundry.admin\"` or a similar error. The rest of `@osdk/react` works without these packages."},"3302":{"id":"/react/platform-apis-13","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#install-the-platform-packages","content":"Every hook needs an `OsdkProvider` above it. The signed-in user's token must allow the platform API you call; a missing permission comes back as an `error`."},"3303":{"id":"/react/platform-apis-14","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-the-signed-in-user","content":"`useCurrentFoundryUser` loads the user the client's token belongs to:"},"3304":{"id":"/react/platform-apis-15","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-the-signed-in-user","content":"| Option    | Type      | Default | Description                       |\n| --------- | --------- | ------- | --------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made. |","table":"table-0"},"3305":{"id":"/react/platform-apis-16","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-the-signed-in-user","content":"| Field         | Type                | Description                                                                                                               |\n| ------------- | ------------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `currentUser` | `User \\| undefined` | The user, with `id`, `username`, `givenName`, `familyName`, `email`, `realm`, `organization`, `status`, and `attributes`. |","table":"table-1"},"3306":{"id":"/react/platform-apis-17","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-the-signed-in-user","content":"| Field       | Type      | Description                    |\n| ----------- | --------- | ------------------------------ |\n| `isLoading` | `boolean` | `true` while the request runs. |","table":"table-1"},"3307":{"id":"/react/platform-apis-18","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-the-signed-in-user","content":"| Field   | Type                 | Description                  |\n| ------- | -------------------- | ---------------------------- |\n| `error` | `Error \\| undefined` | Set when the request failed. |","table":"table-1"},"3308":{"id":"/react/platform-apis-19","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-the-signed-in-user","content":"| Field     | Type         | Description              |\n| --------- | ------------ | ------------------------ |\n| `refetch` | `() => void` | Requests the user again. |","table":"table-1"},"3309":{"id":"/react/platform-apis-20","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#look-up-a-user","content":"`useFoundryUser` takes the user ID as its first argument and options second:"},"3310":{"id":"/react/platform-apis-21","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#look-up-a-user","content":"| Option    | Type      | Default | Description                       |\n| --------- | --------- | ------- | --------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made. |","table":"table-2"},"3311":{"id":"/react/platform-apis-22","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#look-up-a-user","content":"| Option   | Type                    | Default    | Description                                                                             |\n| -------- | ----------------------- | ---------- | --------------------------------------------------------------------------------------- |\n| `status` | `\"ACTIVE\" \\| \"DELETED\"` | `\"ACTIVE\"` | Status of the user to look up. Pass `\"DELETED\"` to resolve users who have been removed. |","table":"table-2"},"3312":{"id":"/react/platform-apis-23","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#look-up-a-user","content":"The result has `user`, `isLoading`, `error`, and `refetch`. A new `userId` triggers a new request."},"3313":{"id":"/react/platform-apis-24","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"`useFoundryUsersList` returns one page of users. Pass the previous page's `nextPageToken` as `pageToken` to load the next one:"},"3314":{"id":"/react/platform-apis-25","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Option    | Type      | Default | Description                       |\n| --------- | --------- | ------- | --------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made. |","table":"table-3"},"3315":{"id":"/react/platform-apis-26","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Option    | Type                    | Default    | Description          |\n| --------- | ----------------------- | ---------- | -------------------- |\n| `include` | `\"ACTIVE\" \\| \"DELETED\"` | `\"ACTIVE\"` | Which users to list. |","table":"table-3"},"3316":{"id":"/react/platform-apis-27","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Option     | Type     | Default | Description                                               |\n| ---------- | -------- | ------- | --------------------------------------------------------- |\n| `pageSize` | `number` | `1000`  | Preferred page size. The server can return more or fewer. |","table":"table-3"},"3317":{"id":"/react/platform-apis-28","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Option      | Type     | Default     | Description                                          |\n| ----------- | -------- | ----------- | ---------------------------------------------------- |\n| `pageToken` | `string` | `undefined` | Token for the page to load. Omit for the first page. |","table":"table-3"},"3318":{"id":"/react/platform-apis-29","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Field   | Type                  | Description             |\n| ------- | --------------------- | ----------------------- |\n| `users` | `User[] \\| undefined` | The users on this page. |","table":"table-4"},"3319":{"id":"/react/platform-apis-30","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Field           | Type                  | Description                                            |\n| --------------- | --------------------- | ------------------------------------------------------ |\n| `nextPageToken` | `string \\| undefined` | Token for the next page. `undefined` on the last page. |","table":"table-4"},"3320":{"id":"/react/platform-apis-31","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"| Field                           | Type | Description                     |\n| ------------------------------- | ---- | ------------------------------- |\n| `isLoading`, `error`, `refetch` |      | As for `useCurrentFoundryUser`. |","table":"table-4"},"3321":{"id":"/react/platform-apis-32","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-users","content":"Each page replaces the previous one. To show every page loaded so far, keep the users you have received in state."},"3322":{"id":"/react/platform-apis-33","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-markings","content":"`useMarkings` lists the markings the user can see, and `useMarkingCategories` lists the categories they belong to. Join them on `marking.categoryId`:"},"3323":{"id":"/react/platform-apis-34","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-markings","content":"| Hook          | Option           | Default | Returns                                                                                      |\n| ------------- | ---------------- | ------- | -------------------------------------------------------------------------------------------- |\n| `useMarkings` | `includeDeleted` | `true`  | `markings`: `Marking[]`, each with `id`, `categoryId`, `name`, `description`, and `deleted`. |","table":"table-5"},"3324":{"id":"/react/platform-apis-35","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-markings","content":"| Hook                   | Option           | Default | Returns                                                                                                            |\n| ---------------------- | ---------------- | ------- | ------------------------------------------------------------------------------------------------------------------ |\n| `useMarkingCategories` | `includeDeleted` | `true`  | `categories`: `MarkingCategory[]`, each with `id`, `name`, `description`, `markings` (marking IDs), and `deleted`. |","table":"table-5"},"3325":{"id":"/react/platform-apis-36","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-markings","content":"| Hook | Option        | Default   | Returns                                                     |\n| ---- | ------------- | --------- | ----------------------------------------------------------- |\n| Both | `markingType` | All types | Only markings or categories of this type, such as `\"CBAC\"`. |","table":"table-5"},"3326":{"id":"/react/platform-apis-37","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#list-markings","content":"Both accept `enabled` and return `isLoading`, `error`, and `refetch`. Deleted entries are included unless you pass `includeDeleted: false`."},"3327":{"id":"/react/platform-apis-38","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#get-a-users-markings","content":"`useUserViewMarkings` returns the IDs of the markings a user can view. Without `userId`, it uses the signed-in user:"},"3328":{"id":"/react/platform-apis-39","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#get-a-users-markings","content":"| Option   | Type     | Default        | Description          |\n| -------- | -------- | -------------- | -------------------- |\n| `userId` | `string` | Signed-in user | The user to look up. |","table":"table-6"},"3329":{"id":"/react/platform-apis-40","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#get-a-users-markings","content":"| Option    | Type      | Default | Description                       |\n| --------- | --------- | ------- | --------------------------------- |\n| `enabled` | `boolean` | `true`  | When `false`, no request is made. |","table":"table-6"},"3330":{"id":"/react/platform-apis-41","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#get-a-users-markings","content":"The result has `markingIds` (`string[] | undefined`), `isLoading`, `error`, and `refetch`."},"3331":{"id":"/react/platform-apis-42","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"For classification-based access control (CBAC), `useCbacBanner` returns the banner text and colors for a set of marking IDs:"},"3332":{"id":"/react/platform-apis-43","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                         | Type     | Description      |\n| ----------------------------- | -------- | ---------------- |\n| `banner.classificationString` | `string` | The banner text. |","table":"table-7"},"3333":{"id":"/react/platform-apis-44","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field              | Type     | Description |\n| ------------------ | -------- | ----------- |\n| `banner.textColor` | `string` | Text color. |","table":"table-7"},"3334":{"id":"/react/platform-apis-45","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                     | Type       | Description                    |\n| ------------------------- | ---------- | ------------------------------ |\n| `banner.backgroundColors` | `string[]` | One or more background colors. |","table":"table-7"},"3335":{"id":"/react/platform-apis-46","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field               | Type       | Description                         |\n| ------------------- | ---------- | ----------------------------------- |\n| `banner.markingIds` | `string[]` | The markings the banner represents. |","table":"table-7"},"3336":{"id":"/react/platform-apis-47","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"`useCbacMarkingRestrictions` checks a proposed set of marking IDs before you apply it, for example in a marking picker:"},"3337":{"id":"/react/platform-apis-48","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                  | Type      | Description                                                                                                 |\n| ---------------------- | --------- | ----------------------------------------------------------------------------------------------------------- |\n| `restrictions.isValid` | `boolean` | Whether the markings form a valid classification: none are disallowed and every required constraint is met. |","table":"table-8"},"3338":{"id":"/react/platform-apis-49","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                                | Type      | Description                                        |\n| ------------------------------------ | --------- | -------------------------------------------------- |\n| `restrictions.userSatisfiesMarkings` | `boolean` | Whether the signed-in user satisfies the markings. |","table":"table-8"},"3339":{"id":"/react/platform-apis-50","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                          | Type       | Description                          |\n| ------------------------------ | ---------- | ------------------------------------ |\n| `restrictions.impliedMarkings` | `string[]` | Markings that the selection implies. |","table":"table-8"},"3340":{"id":"/react/platform-apis-51","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                             | Type       | Description                                      |\n| --------------------------------- | ---------- | ------------------------------------------------ |\n| `restrictions.disallowedMarkings` | `string[]` | Markings that are disallowed with the selection. |","table":"table-8"},"3341":{"id":"/react/platform-apis-52","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"| Field                           | Type         | Description                                             |\n| ------------------------------- | ------------ | ------------------------------------------------------- |\n| `restrictions.requiredMarkings` | `string[][]` | Required marking constraints, as groups of marking IDs. |","table":"table-8"},"3342":{"id":"/react/platform-apis-53","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#show-a-classification-banner","content":"Both hooks take `{ markingIds, enabled? }`, return `isLoading`, `error`, and `refetch`, and make no request while `markingIds` is empty. They call preview CBAC endpoints, which must be available on your Foundry stack. For a ready-made picker, see the CbacPicker component."},"3343":{"id":"/react/platform-apis-54","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#how-these-hooks-load-data","content":"These hooks do not use the object cache that powers `useOsdkObjects` and the other ontology hooks:"},"3344":{"id":"/react/platform-apis-55","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#how-these-hooks-load-data","content":"Each mounted hook makes its own request. Two components that call `useCurrentFoundryUser` make two requests. Call the hook once and pass the result down when that matters."},"3345":{"id":"/react/platform-apis-56","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#how-these-hooks-load-data","content":"A hook requests again when an option changes. `refetch` requests again on demand."},"3346":{"id":"/react/platform-apis-57","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#how-these-hooks-load-data","content":"While a request runs, the previous result is cleared and the data field is `undefined`."},"3347":{"id":"/react/platform-apis-58","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#how-these-hooks-load-data","content":"When a request fails, `isLoading` stays `true` next to `error`. Check `error` before `isLoading`, as the examples on this page do."},"3348":{"id":"/react/platform-apis-59","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"All hooks return failures as an `Error`. When the failure comes from a Foundry API, it is a `PalantirApiError`, exported from `@osdk/client`. Narrow with `instanceof` to read its fields, all of which are optional:"},"3349":{"id":"/react/platform-apis-60","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"| Field       | Type     | Description                                                |\n| ----------- | -------- | ---------------------------------------------------------- |\n| `errorName` | `string` | Stable identifier, such as `UserNotFound`. Switch on this. |","table":"table-9"},"3350":{"id":"/react/platform-apis-61","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"| Field       | Type     | Description                                                 |\n| ----------- | -------- | ----------------------------------------------------------- |\n| `errorCode` | `string` | Error category, such as `NOT_FOUND` or `PERMISSION_DENIED`. |","table":"table-9"},"3351":{"id":"/react/platform-apis-62","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"| Field              | Type     | Description                 |\n| ------------------ | -------- | --------------------------- |\n| `errorDescription` | `string` | Human-readable description. |","table":"table-9"},"3352":{"id":"/react/platform-apis-63","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"| Field        | Type     | Description  |\n| ------------ | -------- | ------------ |\n| `statusCode` | `number` | HTTP status. |","table":"table-9"},"3353":{"id":"/react/platform-apis-64","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"| Field             | Type     | Description                                                    |\n| ----------------- | -------- | -------------------------------------------------------------- |\n| `errorInstanceId` | `string` | Server-side ID for this occurrence. Include it in bug reports. |","table":"table-9"},"3354":{"id":"/react/platform-apis-65","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"| Field        | Type     | Description                                          |\n| ------------ | -------- | ---------------------------------------------------- |\n| `parameters` | `object` | Extra context from the server, such as `{ userId }`. |","table":"table-9"},"3355":{"id":"/react/platform-apis-66","page_id":"/react/platform-apis","tags":[],"type":"text","url":"/react/platform-apis#handle-errors","content":"Use it with any hook on this page:"},"3356":{"id":"/react/testing","page_id":"/react/testing","type":"page","content":"Test your app","breadcrumbs":["OSDK TypeScript","React","Quality"],"tags":[],"url":"/react/testing"},"3357":{"id":"/react/testing-0","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing","content":"Unit test OSDK React components with Vitest and Testing Library, using @osdk/react/testing and the mocks in @osdk/unit-testing."},"3358":{"id":"/react/testing-1","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#choose-an-approach","content":"Choose an approach"},"3359":{"id":"/react/testing-2","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#set-up","content":"Set up"},"3360":{"id":"/react/testing-3","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#test-a-component-that-loads-objects","content":"Test a component that loads objects"},"3361":{"id":"/react/testing-4","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#test-a-component-that-applies-an-action","content":"Test a component that applies an action"},"3362":{"id":"/react/testing-5","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#provide-the-osdk-context","content":"Provide the OSDK context"},"3363":{"id":"/react/testing-6","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#test-code-that-calls-the-client","content":"Test code that calls the client"},"3364":{"id":"/react/testing-7","page_id":"/react/testing","type":"heading","tags":[],"url":"/react/testing#osdkunit-testing-reference","content":"`@osdk/unit-testing` reference"},"3365":{"id":"/react/testing-8","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing","content":"Test components that use `@osdk/react` without a Foundry stack. Stub the hooks a component calls, give components that read the OSDK context a test provider, and use mock clients and objects from `@osdk/unit-testing` for code that calls the client directly."},"3366":{"id":"/react/testing-9","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#choose-an-approach","content":"| What the code under test uses                                                                       | Approach                                                             | Tools                             |\n| --------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------- | --------------------------------- |\n| Ontology hooks: `useOsdkObjects`, `useOsdkObject`, `useOsdkAction`, `useOsdkFunction`, and the rest | Replace the hook with a stub that returns the state you want to test | `vi.mock`, `createMockOsdkObject` |","table":"table-0"},"3367":{"id":"/react/testing-10","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#choose-an-approach","content":"| What the code under test uses                                                       | Approach                         | Tools                                          |\n| ----------------------------------------------------------------------------------- | -------------------------------- | ---------------------------------------------- |\n| `useOsdkClient`, `useObservableClient`, or the hooks in `@osdk/react/platform-apis` | Render inside `TestOsdkProvider` | `@osdk/react/testing`, `createMockClient`, MSW |","table":"table-0"},"3368":{"id":"/react/testing-11","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#choose-an-approach","content":"| What the code under test uses              | Approach                                  | Tools                                     |\n| ------------------------------------------ | ----------------------------------------- | ----------------------------------------- |\n| The `Client` directly, in a helper or hook | Pass a mock client with stubbed responses | `createMockClient`, `createMockObjectSet` |","table":"table-0"},"3369":{"id":"/react/testing-12","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#choose-an-approach","content":"Stubbing the ontology hooks keeps tests fast and lets you set loading, error, and optimistic states directly. The mock client from `@osdk/unit-testing` cannot power `OsdkProvider` or the ontology hooks, because they need the observable client that `OsdkProvider` builds from a real client."},"3370":{"id":"/react/testing-13","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#set-up","content":"Install Vitest, a DOM environment, Testing Library, and the OSDK test helpers. `@osdk/unit-testing` has `@osdk/functions` as a peer dependency, and MSW is only needed for the platform API example:"},"3371":{"id":"/react/testing-14","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#set-up","content":"Run tests in a DOM environment:"},"3372":{"id":"/react/testing-15","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#set-up","content":"`TestOsdkProvider` and `fakeObservableClient` ship in `@osdk/react` under `@osdk/react/testing`, so they need no extra install."},"3373":{"id":"/react/testing-16","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-a-component-that-loads-objects","content":"This component lists employees with `useOsdkObjects`:"},"3374":{"id":"/react/testing-17","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-a-component-that-loads-objects","content":"Replace `useOsdkObjects` with a Vitest mock, keep the rest of `@osdk/react` real, and build objects with `createMockOsdkObject`:"},"3375":{"id":"/react/testing-18","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-a-component-that-loads-objects","content":"`createMockOsdkObject(type, properties, options?)` returns an object instance with `$apiName`, `$objectType`, `$primaryKey`, `$rid`, `$clone`, and `$link`. The primary key property must be in `properties`. Pass `options.links` to stub linked objects, and `options.titlePropertyApiName` to set `$title`."},"3376":{"id":"/react/testing-19","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-a-component-that-applies-an-action","content":"Stub `useOsdkAction` and assert on the `applyAction` mock. This test drives the `PromoteButton` from Apply actions:"},"3377":{"id":"/react/testing-20","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-a-component-that-applies-an-action","content":"The hook's state does not change by itself when the mock is called, so set `isPending`, `error`, or `validationResult` in each test rather than expecting `applyAction` to update them. To simulate a rejection, use `applyAction.mockRejectedValue(new Error(\"...\"))`."},"3378":{"id":"/react/testing-21","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#provide-the-osdk-context","content":"`TestOsdkProvider` from `@osdk/react/testing` puts a `client` and an `observableClient` of your choice into context, without the devtools and user-agent setup of `OsdkProvider`. Use it when the code under test calls `useOsdkClient`, `useObservableClient`, or a platform API hook."},"3379":{"id":"/react/testing-22","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#provide-the-osdk-context","content":"| Export             | Description                                                                               |\n| ------------------ | ----------------------------------------------------------------------------------------- |\n| `TestOsdkProvider` | Provider with `client` and `observableClient` props, both required. Use it only in tests. |","table":"table-1"},"3380":{"id":"/react/testing-23","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#provide-the-osdk-context","content":"| Export                 | Description                                                                                                                                             |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `fakeObservableClient` | An `ObservableClient` whose every method throws. Pass it when the code under test never uses the observable client, so an unexpected call fails loudly. |","table":"table-1"},"3381":{"id":"/react/testing-24","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#provide-the-osdk-context","content":"Platform API hooks call Foundry over HTTP with the context's `client`. A client from `createMockClient` sends those requests to `https://mock.invalid/`, so intercept them with MSW. This test renders the `CurrentUserBadge` from Users and markings:"},"3382":{"id":"/react/testing-25","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-code-that-calls-the-client","content":"For a helper or hook that calls the `Client` itself, pass a client from `createMockClient` and register the responses it should get. Stubs match on the exact chain of calls, including arguments:"},"3383":{"id":"/react/testing-26","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#test-code-that-calls-the-client","content":"A call with no matching stub throws, with `No stub for request` for object set calls or `No stub for query '<name>'` for functions. When several stubs match, the last one registered wins."},"3384":{"id":"/react/testing-27","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export               | Description                                                                                                                             |\n| -------------------- | --------------------------------------------------------------------------------------------------------------------------------------- |\n| `createMockClient()` | A `Client` whose responses you stub. Use it with `TestOsdkProvider` or pass it to code that takes a `Client`. It does not stub actions. |","table":"table-2"},"3385":{"id":"/react/testing-28","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                  | Description                                                                                                                                                                                               |\n| ----------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `client.when(callback)` | Stub an object set call chain that ends in `fetchPage`, `fetchOne`, `aggregate`, or similar. Complete it with `thenReturnObjects`, `thenReturnObject`, or `thenReturnAggregation`, depending on the call. |","table":"table-2"},"3386":{"id":"/react/testing-29","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                                      | Description                                                                                                  |\n| ------------------------------------------- | ------------------------------------------------------------------------------------------------------------ |\n| `client.whenObjectSet(objectSet, callback)` | Stub calls on an object set created with `createMockObjectSet`, for code that takes an `ObjectSet` argument. |","table":"table-2"},"3387":{"id":"/react/testing-30","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                          | Description                                                                       |\n| ------------------------------- | --------------------------------------------------------------------------------- |\n| `client.whenQuery(fn, params?)` | Stub a function call. Complete it with `thenReturn(value)` or `thenThrow(error)`. |","table":"table-2"},"3388":{"id":"/react/testing-31","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                | Description        |\n| --------------------- | ------------------ |\n| `client.clearStubs()` | Remove every stub. |","table":"table-2"},"3389":{"id":"/react/testing-32","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                                             | Description                                                  |\n| -------------------------------------------------- | ------------------------------------------------------------ |\n| `createMockOsdkObject(type, properties, options?)` | An object instance. See Test a component that loads objects. |","table":"table-2"},"3390":{"id":"/react/testing-33","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                      | Description                                                                   |\n| --------------------------- | ----------------------------------------------------------------------------- |\n| `createMockObjectSet(type)` | A standalone object set to pass as an argument and stub with `whenObjectSet`. |","table":"table-2"},"3391":{"id":"/react/testing-34","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                                        | Description                                                                      |\n| --------------------------------------------- | -------------------------------------------------------------------------------- |\n| `createMockAttachment(rid, blob?, metadata?)` | An attachment whose `fetchContents` and `fetchMetadata` return the given values. |","table":"table-2"},"3392":{"id":"/react/testing-35","page_id":"/react/testing","tags":[],"type":"text","url":"/react/testing#osdkunit-testing-reference","content":"| Export                        | Description                                                                                                                       |\n| ----------------------------- | --------------------------------------------------------------------------------------------------------------------------------- |\n| `createMockWriteableClient()` | A mock client that records edits, for testing Foundry functions written with `@osdk/functions`. Read the edits with `getEdits()`. |","table":"table-2"},"3393":{"id":"/reference/aip-core/foundry-model","page_id":"/reference/aip-core/foundry-model","type":"page","content":"foundryModel","breadcrumbs":["OSDK TypeScript","Reference","@osdk/aip-core"],"tags":[],"url":"/reference/aip-core/foundry-model"},"3394":{"id":"/reference/aip-core/foundry-model-0","page_id":"/reference/aip-core/foundry-model","tags":[],"type":"text","url":"/reference/aip-core/foundry-model","content":"Create a language model handle backed by the Foundry Language Model Service for generateText, streamText, and LmsChatTransport."},"3395":{"id":"/reference/aip-core/foundry-model-1","page_id":"/reference/aip-core/foundry-model","type":"heading","tags":[],"url":"/reference/aip-core/foundry-model#options","content":"Options"},"3396":{"id":"/reference/aip-core/foundry-model-2","page_id":"/reference/aip-core/foundry-model","type":"heading","tags":[],"url":"/reference/aip-core/foundry-model#returns","content":"Returns"},"3397":{"id":"/reference/aip-core/foundry-model-3","page_id":"/reference/aip-core/foundry-model","type":"heading","tags":[],"url":"/reference/aip-core/foundry-model#example","content":"Example"},"3398":{"id":"/reference/aip-core/foundry-model-4","page_id":"/reference/aip-core/foundry-model","type":"heading","tags":[],"url":"/reference/aip-core/foundry-model#see-also","content":"See also"},"3399":{"id":"/reference/aip-core/foundry-model-5","page_id":"/reference/aip-core/foundry-model","tags":[],"type":"text","url":"/reference/aip-core/foundry-model","content":"Returns an opaque `LanguageModel` that the other `@osdk/aip-core` functions accept. It holds the client and model identifier; it does not send a request."},"3400":{"id":"/reference/aip-core/foundry-model-6","page_id":"/reference/aip-core/foundry-model","tags":[],"type":"text","url":"/reference/aip-core/foundry-model#type-table-model.ts-FoundryModelOptions-client","content":"| `client` | `PlatformClient` | Foundry PlatformClient providing the auth token + base URL. |\n| -------- | ---------------- | ----------------------------------------------------------- |","table":"type-table-mod