cation-5","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#require-sign-in-before-rendering","content":"Require sign-in before rendering"},"8":{"id":"/authentication-6","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#scopes","content":"Scopes"},"9":{"id":"/authentication-7","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#token-storage","content":"Token storage"},"10":{"id":"/authentication-8","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#sign-out","content":"Sign out"},"11":{"id":"/authentication-9","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#listen-for-auth-events","content":"Listen for auth events"},"12":{"id":"/authentication-10","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#authenticate-a-server-or-service","content":"Authenticate a server or service"},"13":{"id":"/authentication-11","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#public-apps-without-sign-in","content":"Public apps without sign-in"},"14":{"id":"/authentication-12","page_id":"/authentication","type":"heading","tags":[],"url":"/authentication#use-an-existing-token","content":"Use an existing token"},"15":{"id":"/authentication-13","page_id":"/authentication","tags":[],"type":"text","url":"/authentication","content":"Every OSDK request needs a Foundry bearer token. `@osdk/oauth` creates token providers that sign users in, store and refresh tokens, and plug straight into `createClient`."},"16":{"id":"/authentication-14","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#choose-a-token-provider","content":"| Provider                  | Use it for                                                            | Grant                        |\n| ------------------------- | --------------------------------------------------------------------- | ---------------------------- |\n| `createPublicOauthClient` | Browser apps where each user signs in with their own Foundry account. | Authorization code with PKCE |","table":"table-0"},"17":{"id":"/authentication-15","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#choose-a-token-provider","content":"| Provider                        | Use it for                                                        | Grant              |\n| ------------------------------- | ----------------------------------------------------------------- | ------------------ |\n| `createConfidentialOauthClient` | Servers, scheduled jobs, and backends that act as a service user. | Client credentials |","table":"table-0"},"18":{"id":"/authentication-16","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#choose-a-token-provider","content":"| Provider               | Use it for                                                                                                                             | Grant |\n| ---------------------- | -------------------------------------------------------------------------------------------------------------------------------------- | ----- |\n| `createAuthlessClient` | Public apps that read Foundry data without a signed-in user, such as those from the **React (Public)** template of `@osdk/create-app`. | None  |","table":"table-0"},"19":{"id":"/authentication-17","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#choose-a-token-provider","content":"| Provider          | Use it for                                   | Grant |\n| ----------------- | -------------------------------------------- | ----- |\n| Your own function | Scripts and tests that already have a token. | None  |","table":"table-0"},"20":{"id":"/authentication-18","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#choose-a-token-provider","content":"A token provider is any function that returns `Promise<string>`. The OAuth clients are callable, so you pass them to `createClient` directly:"},"21":{"id":"/authentication-19","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#choose-a-token-provider","content":"The client calls `auth()` before each request. You can call it yourself: `await auth()` resolves to the current access token and starts sign-in when there is none."},"22":{"id":"/authentication-20","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"`createPublicOauthClient` runs the OAuth authorization code flow with PKCE against Foundry. Create it once, at module scope, next to your client."},"23":{"id":"/authentication-21","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Argument   | Type     | Description                                                 |\n| ---------- | -------- | ----------------------------------------------------------- |\n| `clientId` | `string` | The client ID from **OAuth & scopes** in Developer Console. |","table":"table-1"},"24":{"id":"/authentication-22","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Argument | Type     | Description                                                                        |\n| -------- | -------- | ---------------------------------------------------------------------------------- |\n| `url`    | `string` | The base URL of your Foundry stack, such as `https://example.palantirfoundry.com`. |","table":"table-1"},"25":{"id":"/authentication-23","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Argument      | Type     | Description                                                                                                       |\n| ------------- | -------- | ----------------------------------------------------------------------------------------------------------------- |\n| `redirectUrl` | `string` | The URL Foundry sends the user back to after sign-in. It must exactly match a redirect URL on **OAuth & scopes**. |","table":"table-1"},"26":{"id":"/authentication-24","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Argument  | Type                       | Description                      |\n| --------- | -------------------------- | -------------------------------- |\n| `options` | `PublicOauthClientOptions` | Optional settings, listed below. |","table":"table-1"},"27":{"id":"/authentication-25","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option   | Type       | Default                                                                                      | Description                          |\n| -------- | ---------- | -------------------------------------------------------------------------------------------- | ------------------------------------ |\n| `scopes` | `string[]` | `[\"api:read-data\", \"api:write-data\", \"api:use-ontologies-read\", \"api:use-ontologies-write\"]` | OAuth scopes to request. See Scopes. |","table":"table-2"},"28":{"id":"/authentication-26","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option         | Type                                           | Default          | Description                                         |\n| -------------- | ---------------------------------------------- | ---------------- | --------------------------------------------------- |\n| `tokenStorage` | `\"localStorage\" \\| \"sessionStorage\" \\| \"none\"` | `\"localStorage\"` | Where to keep the refresh token. See Token storage. |","table":"table-2"},"29":{"id":"/authentication-27","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option          | Type     | Default                                 | Description                                                                                                                      |\n| --------------- | -------- | --------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------- |\n| `postLoginPage` | `string` | The page URL when the client is created | Used with `loginPage`: the page to return to after sign-in. Without `loginPage`, the client returns to the page the user was on. |","table":"table-2"},"30":{"id":"/authentication-28","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option      | Type     | Default | Description                                                                                                                                                  |\n| ----------- | -------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `loginPage` | `string` |         | A page in your app to show before redirecting to Foundry, such as `/login`. When set, the client navigates there instead of redirecting straight to Foundry. |","table":"table-2"},"31":{"id":"/authentication-29","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option       | Type      | Default | Description                                                                                                                                                                            |\n| ------------ | --------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `useHistory` | `boolean` | `true`  | Navigate within your app, to `loginPage` or back to the original page after sign-in, with `history.replaceState()` instead of `window.location.assign()`, so the page does not reload. |","table":"table-2"},"32":{"id":"/authentication-30","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option               | Type     | Default | Description                                                                                                                    |\n| -------------------- | -------- | ------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `refreshTokenMarker` | `string` |         | An extra value stored with the refresh token. Change it to invalidate stored refresh tokens and make every user sign in again. |","table":"table-2"},"33":{"id":"/authentication-31","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option    | Type           | Default            | Description                          |\n| --------- | -------------- | ------------------ | ------------------------------------ |\n| `fetchFn` | `typeof fetch` | `globalThis.fetch` | The `fetch` used for token requests. |","table":"table-2"},"34":{"id":"/authentication-32","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option    | Type     | Default       | Description                                             |\n| --------- | -------- | ------------- | ------------------------------------------------------- |\n| `ctxPath` | `string` | `\"multipass\"` | The path of Foundry's authorization server under `url`. |","table":"table-2"},"35":{"id":"/authentication-33","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"| Option   | Type          | Default | Description                                                                                                                   |\n| -------- | ------------- | ------- | ----------------------------------------------------------------------------------------------------------------------------- |\n| `logger` | `OauthLogger` |         | Receives warnings, such as a failed refresh. Without it, warnings are dropped. Compatible with the `Logger` from `@osdk/api`. |","table":"table-2"},"36":{"id":"/authentication-34","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-users-in-from-a-browser","content":"The fourth argument can also be the older positional form, `useHistory, loginPage, postLoginPage, scopes, fetchFn, ctxPath`. Pass either an options object or positional arguments, not both. `tokenStorage`, `refreshTokenMarker`, and `logger` are only available in the options object."},"37":{"id":"/authentication-35","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#how-the-flow-works","content":"The first time your app needs a token, the client looks for a stored refresh token and uses it if it is valid."},"38":{"id":"/authentication-36","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#how-the-flow-works","content":"Without one, it saves a PKCE verifier and the current URL in `sessionStorage`, then redirects to Foundry's sign-in page."},"39":{"id":"/authentication-37","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#how-the-flow-works","content":"Foundry redirects to `redirectUrl` with an authorization code."},"40":{"id":"/authentication-38","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#how-the-flow-works","content":"On that page, your app asks for a token again. The client exchanges the code, stores the refresh token, and navigates back to the page the user started on."},"41":{"id":"/authentication-39","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#how-the-flow-works","content":"The client refreshes the access token one minute before it expires. You do not schedule refreshes yourself."},"42":{"id":"/authentication-40","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#how-the-flow-works","content":"Concurrent token requests share one sign-in, so several components asking for data at once trigger a single redirect."},"43":{"id":"/authentication-41","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#handle-the-redirect-callback","content":"Render a route at your redirect URL's path that calls `auth.signIn()`. This completes step 4. The React template from `@osdk/create-app` uses this component, which then navigates to `/`; navigate elsewhere if your app needs to:"},"44":{"id":"/authentication-42","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#handle-the-redirect-callback","content":"Register it at the same path as `redirectUrl`:"},"45":{"id":"/authentication-43","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#handle-the-redirect-callback","content":"If the redirect URL in your code, in `.env` files, and on **OAuth & scopes** differ in any character, including the port and a trailing slash, Foundry rejects the sign-in."},"46":{"id":"/authentication-44","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#require-sign-in-before-rendering","content":"The client starts sign-in on the first request, so pages that load OSDK data trigger it automatically. To keep a route from rendering until the user is signed in, check for a token first. `getTokenOrUndefined()` returns the current access token synchronously, or `undefined` if there is none or it has expired:"},"47":{"id":"/authentication-45","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#scopes","content":"Scopes limit what the token can do. Both OAuth clients default to `api:read-data`, `api:write-data`, `api:use-ontologies-read`, and `api:use-ontologies-write`. Request only what your app needs, and make sure each scope is allowed for your application on **OAuth & scopes** in Developer Console. A read-only app can drop the two `write` scopes."},"48":{"id":"/authentication-46","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#scopes","content":"The defaults only cover the Ontology. Add the scopes for anything else your app calls: each Platform SDK endpoint lists its required scopes (see Platform SDK setup), and the AI packages need `api:use-language-models-execute` (see AI)."},"49":{"id":"/authentication-47","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#scopes","content":"The public client also requests `offline_access` so Foundry issues a refresh token, unless `tokenStorage` is `\"none\"`. A stored refresh token is only reused when it was issued for the same set of scopes, so changing `scopes` signs users in again."},"50":{"id":"/authentication-48","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#token-storage","content":"| `tokenStorage`   | Refresh token kept      | Trade-off                                                                   |\n| ---------------- | ----------------------- | --------------------------------------------------------------------------- |\n| `\"localStorage\"` | Across browser sessions | Fewest sign-ins. Anyone with access to the browser profile stays signed in. |","table":"table-3"},"51":{"id":"/authentication-49","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#token-storage","content":"| `tokenStorage`     | Refresh token kept              | Trade-off                       |\n| ------------------ | ------------------------------- | ------------------------------- |\n| `\"sessionStorage\"` | Until the tab or browser closes | Recommended for shared devices. |","table":"table-3"},"52":{"id":"/authentication-50","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#token-storage","content":"| `tokenStorage` | Refresh token kept | Trade-off                                                                 |\n| -------------- | ------------------ | ------------------------------------------------------------------------- |\n| `\"none\"`       | Never              | Users sign in on every page load. No `offline_access` scope is requested. |","table":"table-3"},"53":{"id":"/authentication-51","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#token-storage","content":"The refresh token is stored under the key `@osdk/oauth : refresh : <clientId>`. Access tokens stay in memory."},"54":{"id":"/authentication-52","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-out","content":"`signOut()` revokes the access token with Foundry, deletes the stored refresh token, and emits a `signOut` event. It does not navigate, so redirect the user yourself:"},"55":{"id":"/authentication-53","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#sign-out","content":"`signOut()` throws if nobody is signed in. The next token request after sign-out starts a new sign-in."},"56":{"id":"/authentication-54","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"The public client emits `signIn`, `refresh`, and `signOut` events. `signIn` and `refresh` carry the new token in `event.detail`:"},"57":{"id":"/authentication-55","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member   | Description                                                             |\n| -------- | ----------------------------------------------------------------------- |\n| `auth()` | Resolves to a valid access token, refreshing or signing in when needed. |","table":"table-4"},"58":{"id":"/authentication-56","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member          | Description                                                                                                                        |\n| --------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `auth.signIn()` | Runs sign-in: refreshes from a stored token, completes a redirect callback, or redirects to Foundry. Resolves to the token object. |","table":"table-4"},"59":{"id":"/authentication-57","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member           | Description                                               |\n| ---------------- | --------------------------------------------------------- |\n| `auth.refresh()` | Refreshes the access token with the stored refresh token. |","table":"table-4"},"60":{"id":"/authentication-58","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member           | Description                                |\n| ---------------- | ------------------------------------------ |\n| `auth.signOut()` | Revokes the token and clears stored state. |","table":"table-4"},"61":{"id":"/authentication-59","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member                       | Description                                                                          |\n| ---------------------------- | ------------------------------------------------------------------------------------ |\n| `auth.getTokenOrUndefined()` | Returns the current access token, or `undefined` if there is none or it has expired. |","table":"table-4"},"62":{"id":"/authentication-60","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member                                  | Description                                    |\n| --------------------------------------- | ---------------------------------------------- |\n| `auth.addEventListener(type, listener)` | Listens for `signIn`, `refresh`, or `signOut`. |","table":"table-4"},"63":{"id":"/authentication-61","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#listen-for-auth-events","content":"| Member                                     | Description         |\n| ------------------------------------------ | ------------------- |\n| `auth.removeEventListener(type, listener)` | Removes a listener. |","table":"table-4"},"64":{"id":"/authentication-62","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"`createConfidentialOauthClient` uses the client credentials grant with a client ID and secret from a confidential application in Developer Console. Requests run as that application's service user, not as a person."},"65":{"id":"/authentication-63","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"| Argument   | Type     | Default | Description                               |\n| ---------- | -------- | ------- | ----------------------------------------- |\n| `clientId` | `string` |         | The confidential application's client ID. |","table":"table-5"},"66":{"id":"/authentication-64","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"| Argument       | Type     | Default | Description        |\n| -------------- | -------- | ------- | ------------------ |\n| `clientSecret` | `string` |         | The client secret. |","table":"table-5"},"67":{"id":"/authentication-65","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"| Argument | Type     | Default | Description                         |\n| -------- | -------- | ------- | ----------------------------------- |\n| `url`    | `string` |         | The base URL of your Foundry stack. |","table":"table-5"},"68":{"id":"/authentication-66","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"| Argument | Type       | Default                                                                                      | Description        |\n| -------- | ---------- | -------------------------------------------------------------------------------------------- | ------------------ |\n| `scopes` | `string[]` | `[\"api:read-data\", \"api:write-data\", \"api:use-ontologies-read\", \"api:use-ontologies-write\"]` | Scopes to request. |","table":"table-5"},"69":{"id":"/authentication-67","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"| Argument  | Type           | Default            | Description                          |\n| --------- | -------------- | ------------------ | ------------------------------------ |\n| `fetchFn` | `typeof fetch` | `globalThis.fetch` | The `fetch` used for token requests. |","table":"table-5"},"70":{"id":"/authentication-68","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"| Argument  | Type     | Default       | Description                                             |\n| --------- | -------- | ------------- | ------------------------------------------------------- |\n| `ctxPath` | `string` | `\"multipass\"` | The path of Foundry's authorization server under `url`. |","table":"table-5"},"71":{"id":"/authentication-69","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"The client requests a new token when the current one expires. There is no refresh token or browser storage. It supports `signIn()`, `signOut()`, `getTokenOrUndefined()`, and `signIn` and `signOut` events, but not `refresh()`."},"72":{"id":"/authentication-70","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#authenticate-a-server-or-service","content":"Never use `createConfidentialOauthClient` in browser code. Anything you ship to a browser, including environment variables inlined by your bundler, is readable by users, and the client secret lets anyone act as your application."},"73":{"id":"/authentication-71","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#public-apps-without-sign-in","content":"`createAuthlessClient()` returns a token provider that sends a fixed public token, for apps that let anyone view data without a Foundry account:"},"74":{"id":"/authentication-72","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#public-apps-without-sign-in","content":"The **React (Public)** template of `@osdk/create-app` sets this up, including the request proxy it relies on. It reads the Foundry URL and Ontology RID from the `osdk-foundryUrl` and `osdk-ontologyRid` `<meta>` tags instead of environment variables, so a Marketplace installation uses its destination's Foundry URL and Ontology."},"75":{"id":"/authentication-73","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#use-an-existing-token","content":"For scripts, tests, and one-off tools, pass a function that returns a token you already have, such as one from an environment variable:"},"76":{"id":"/authentication-74","page_id":"/authentication","tags":[],"type":"text","url":"/authentication#use-an-existing-token","content":"The client does not refresh a static token. When it expires, requests fail with `401` until you supply a new one."},"77":{"id":"/client","page_id":"/client","type":"page","content":"Create a client","breadcrumbs":["OSDK TypeScript","Guides","Get started"],"tags":[],"url":"/client"},"78":{"id":"/client-0","page_id":"/client","tags":[],"type":"text","url":"/client","content":"Configure createClient with your Foundry URL, Ontology RID, and token provider, share it through OsdkProvider, and query without React."},"79":{"id":"/client-1","page_id":"/client","type":"heading","tags":[],"url":"/client#createclient","content":"`createClient`"},"80":{"id":"/client-2","page_id":"/client","type":"heading","tags":[],"url":"/client#keep-one-client-per-app","content":"Keep one client per app"},"81":{"id":"/client-3","page_id":"/client","type":"heading","tags":[],"url":"/client#platform-api-only-clients","content":"Platform API only clients"},"82":{"id":"/client-4","page_id":"/client","type":"heading","tags":[],"url":"/client#provide-the-client-to-react","content":"Provide the client to React"},"83":{"id":"/client-5","page_id":"/client","type":"heading","tags":[],"url":"/client#use-the-client-without-react","content":"Use the client without React"},"84":{"id":"/client-6","page_id":"/client","type":"heading","tags":[],"url":"/client#fetch-objects","content":"Fetch objects"},"85":{"id":"/client-7","page_id":"/client","type":"heading","tags":[],"url":"/client#apply-an-action","content":"Apply an action"},"86":{"id":"/client-8","page_id":"/client","type":"heading","tags":[],"url":"/client#execute-a-function","content":"Execute a function"},"87":{"id":"/client-9","page_id":"/client","type":"heading","tags":[],"url":"/client#read-metadata","content":"Read metadata"},"88":{"id":"/client-10","page_id":"/client","tags":[],"type":"text","url":"/client","content":"The client from `@osdk/client` sends every OSDK request: it fetches objects, applies actions, and executes functions. Create it once per app, then hand it to `OsdkProvider` for React or call it directly."},"89":{"id":"/client-11","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Argument  | Type     | Description                                                                                                                                            |\n| --------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `baseUrl` | `string` | The base URL of your Foundry stack, such as `https://example.palantirfoundry.com`. In local development behind a CORS proxy, your dev server's origin. |","table":"table-0"},"90":{"id":"/client-12","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Argument      | Type                        | Description                                                                                                      |\n| ------------- | --------------------------- | ---------------------------------------------------------------------------------------------------------------- |\n| `ontologyRid` | `string \\| Promise<string>` | The Ontology to query, such as `ri.ontology.main.ontology.<id>`. Usually `$ontologyRid` from your generated SDK. |","table":"table-0"},"91":{"id":"/client-13","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Argument        | Type                    | Description                                                                                              |\n| --------------- | ----------------------- | -------------------------------------------------------------------------------------------------------- |\n| `tokenProvider` | `() => Promise<string>` | Returns a bearer token for each request. Usually an OAuth client from `@osdk/oauth`. See Authentication. |","table":"table-0"},"92":{"id":"/client-14","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Argument  | Type     | Description                      |\n| --------- | -------- | -------------------------------- |\n| `options` | `object` | Optional settings, listed below. |","table":"table-0"},"93":{"id":"/client-15","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Argument  | Type           | Description                                                         |\n| --------- | -------------- | ------------------------------------------------------------------- |\n| `fetchFn` | `typeof fetch` | The `fetch` used for every request. Defaults to the global `fetch`. |","table":"table-0"},"94":{"id":"/client-16","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Option    | Type                     | Default | Description                           |\n| --------- | ------------------------ | ------- | ------------------------------------- |\n| `headers` | `Record<string, string>` |         | Extra headers added to every request. |","table":"table-1"},"95":{"id":"/client-17","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Option   | Type     | Default                   | Description                                                                   |\n| -------- | -------- | ------------------------- | ----------------------------------------------------------------------------- |\n| `logger` | `Logger` | A minimal built-in logger | A `Logger`, as defined in `@osdk/api`, that receives the client's log output. |","table":"table-1"},"96":{"id":"/client-18","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"| Option                       | Type             | Default            | Description                                                                                                                                                                                                                |\n| ---------------------------- | ---------------- | ------------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `UNSTABLE_DO_NOT_USE_BRANCH` | `string \\| null` | Read from the page | Beta. The Foundry branch to read and write on. When omitted in a browser, the client uses the `foundryBranchRid` query parameter, then the branch meta tag injected by OSDK build tooling. `null` pins the default branch. |","table":"table-1"},"97":{"id":"/client-19","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"`createClient` throws `Invalid ontology RID` when `ontologyRid` is a string that does not start with `ri.`."},"98":{"id":"/client-20","page_id":"/client","tags":[],"type":"text","url":"/client#createclient","content":"Some generated SDKs omit `$ontologyRid`, because they are built to run on more than one Foundry stack and an embedded RID would only be correct on one. Pass the RID from configuration instead."},"99":{"id":"/client-21","page_id":"/client","tags":[],"type":"text","url":"/client#keep-one-client-per-app","content":"Create the client at module scope in a single file, such as `src/client.ts`, and import it everywhere. `OsdkProvider` builds its cache from the client instance, so a new instance starts over with an empty cache."},"100":{"id":"/client-22","page_id":"/client","tags":[],"type":"text","url":"/client#keep-one-client-per-app","content":"Read configuration from your environment instead of hard-coding it. With Vite, use `import.meta.env`:"},"101":{"id":"/client-23","page_id":"/client","tags":[],"type":"text","url":"/client#keep-one-client-per-app","content":"The React template from `@osdk/create-app` goes one step further: `index.html` renders the env values into `<meta>` tags, such as `<meta name=\"osdk-foundryUrl\" content=\"%VITE_FOUNDRY_API_URL%\" />`, and `src/client.ts` reads them at startup. Hosting can then change configuration by rewriting the HTML, without a new JavaScript build:"},"102":{"id":"/client-24","page_id":"/client","tags":[],"type":"text","url":"/client#platform-api-only-clients","content":"`createPlatformClient(baseUrl, tokenProvider, options?, fetchFn?)` creates a client for Foundry Platform APIs, such as `@osdk/foundry.admin`, without an Ontology. Use it in apps that have no generated SDK. A client from `createClient` also works with the `@osdk/foundry.*` Platform SDK functions, so most apps need only one client. The exception is the AI helpers in `@osdk/aip-core`, such as `foundryModel`, which require a client from `createPlatformClient` (see Chat and streaming):"},"103":{"id":"/client-25","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"Wrap your app's root in `OsdkProvider` from `@osdk/react`. Every `@osdk/react` hook reads the client and its cache from the provider."},"104":{"id":"/client-26","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| Prop     | Type     | Default | Description                                                                        |\n| -------- | -------- | ------- | ---------------------------------------------------------------------------------- |\n| `client` | `Client` |         | The client from `createClient`. The provider creates its cache from this instance. |","table":"table-2"},"105":{"id":"/client-27","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| Prop       | Type        | Default | Description |\n| ---------- | ----------- | ------- | ----------- |\n| `children` | `ReactNode` |         | Your app.   |","table":"table-2"},"106":{"id":"/client-28","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| Prop             | Type      | Default                                          | Description                                                                  |\n| ---------------- | --------- | ------------------------------------------------ | ---------------------------------------------------------------------------- |\n| `enableDevTools` | `boolean` | `true` when `@osdk/react-devtools` is registered | Turns the OSDK Devtools panel on or off. Has no effect in production builds. |","table":"table-2"},"107":{"id":"/client-29","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| Prop      | Type     | Default | Description                                                               |\n| --------- | -------- | ------- | ------------------------------------------------------------------------- |\n| `devMode` | `object` |         | Development-only cache behavior, ignored in production builds. See below. |","table":"table-2"},"108":{"id":"/client-30","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| `devMode` field | Type     | Default | Description                                                                                                                |\n| --------------- | -------- | ------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `actionDelayMs` | `number` | `1000`  | Delays the result of an action that has an optimistic update, so you can see the optimistic state. Set `0` to turn it off. |","table":"table-3"},"109":{"id":"/client-31","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| `devMode` field | Type                                                           | Default   | Description                                                |\n| --------------- | -------------------------------------------------------------- | --------- | ---------------------------------------------------------- |\n| `logLevel`      | `\"trace\" \\| \"debug\" \\| \"info\" \\| \"warn\" \\| \"error\" \\| \"fatal\"` | `\"error\"` | Log level of the cache layer. `\"debug\"` shows its tracing. |","table":"table-3"},"110":{"id":"/client-32","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| `devMode` field   | Type      | Default | Description                                                                                      |\n| ----------------- | --------- | ------- | ------------------------------------------------------------------------------------------------ |\n| `debug.refCounts` | `boolean` | `false` | Logs cache entry reference counts and cleanup, and shortens retention so cleanup happens sooner. |","table":"table-3"},"111":{"id":"/client-33","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"| `devMode` field   | Type      | Default | Description             |\n| ----------------- | --------- | ------- | ----------------------- |\n| `debug.cacheKeys` | `boolean` | `false` | Logs cache key lookups. |","table":"table-3"},"112":{"id":"/client-34","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"Put the provider above everything that uses OSDK data, including headers and navigation, and pass it a client created at module scope. `<OsdkProvider client={createClient(...)}>` inside a component creates a new client, and an empty cache, on every render."},"113":{"id":"/client-35","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"A hook rendered outside the provider throws:"},"114":{"id":"/client-36","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"To call the client inside a component, for example in an event handler, read it from the provider with `useOsdkClient`:"},"115":{"id":"/client-37","page_id":"/client","tags":[],"type":"text","url":"/client#provide-the-client-to-react","content":"For data you render, prefer the hooks, such as `useOsdkObjects` and `useOsdkAction`: they cache results and update when objects change. Direct client calls bypass the cache."},"116":{"id":"/client-38","page_id":"/client","tags":[],"type":"text","url":"/client#use-the-client-without-react","content":"Call `client` with a definition from your SDK. What it returns depends on the definition:"},"117":{"id":"/client-39","page_id":"/client","tags":[],"type":"text","url":"/client#use-the-client-without-react","content":"| You pass                        | You get                                   | Main methods                                                          |\n| ------------------------------- | ----------------------------------------- | --------------------------------------------------------------------- |\n| Object type, such as `Employee` | An object set of all objects of that type | `where`, `fetchPage`, `fetchOne`, `asyncIter`, `aggregate`, `pivotTo` |","table":"table-4"},"118":{"id":"/client-40","page_id":"/client","tags":[],"type":"text","url":"/client#use-the-client-without-react","content":"| You pass  | You get                                          | Main methods                                         |\n| --------- | ------------------------------------------------ | ---------------------------------------------------- |\n| Interface | An object set over every type that implements it | Object set methods except `fetchOne`; see Interfaces |","table":"table-4"},"119":{"id":"/client-41","page_id":"/client","tags":[],"type":"text","url":"/client#use-the-client-without-react","content":"| You pass                         | You get           | Main methods                      |\n| -------------------------------- | ----------------- | --------------------------------- |\n| Action, such as `modifyEmployee` | An action invoker | `applyAction`, `batchApplyAction` |","table":"table-4"},"120":{"id":"/client-42","page_id":"/client","tags":[],"type":"text","url":"/client#use-the-client-without-react","content":"| You pass         | You get            | Main methods      |\n| ---------------- | ------------------ | ----------------- |\n| Function (query) | A function invoker | `executeFunction` |","table":"table-4"},"121":{"id":"/client-43","page_id":"/client","tags":[],"type":"text","url":"/client#fetch-objects","content":"`fetchPage` returns one page with `data`, `nextPageToken`, and `totalCount`. `where` narrows the set and returns a new object set, so you can chain it:"},"122":{"id":"/client-44","page_id":"/client","tags":[],"type":"text","url":"/client#fetch-objects","content":"Without `$select`, the response includes the type's default properties. Select only what you read. `$pageSize` sizes each page; it does not cap the total."},"123":{"id":"/client-45","page_id":"/client","tags":[],"type":"text","url":"/client#fetch-objects","content":"Fetch one object by primary key with `fetchOne`, and follow links from it through `$link`:"},"124":{"id":"/client-46","page_id":"/client","tags":[],"type":"text","url":"/client#fetch-objects","content":"To process every matching object, iterate with `asyncIter`. It fetches page after page from a consistent snapshot, so each object arrives once even if the data changes during the loop:"},"125":{"id":"/client-47","page_id":"/client","tags":[],"type":"text","url":"/client#fetch-objects","content":"For counts, sums, and group-bys, use `aggregate` instead of loading every object."},"126":{"id":"/client-48","page_id":"/client","tags":[],"type":"text","url":"/client#apply-an-action","content":"`applyAction` takes the action's parameters and an optional options object. Object parameters accept an object instance or its primary key:"},"127":{"id":"/client-49","page_id":"/client","tags":[],"type":"text","url":"/client#apply-an-action","content":"| Option | Returns     |\n| ------ | ----------- |\n| none   | `undefined` |","table":"table-5"},"128":{"id":"/client-50","page_id":"/client","tags":[],"type":"text","url":"/client#apply-an-action","content":"| Option                   | Returns                                                          |\n| ------------------------ | ---------------------------------------------------------------- |\n| `{ $returnEdits: true }` | The edits the action made: objects added, modified, and deleted. |","table":"table-5"},"129":{"id":"/client-51","page_id":"/client","tags":[],"type":"text","url":"/client#apply-an-action","content":"| Option                    | Returns                                             |\n| ------------------------- | --------------------------------------------------- |\n| `{ $validateOnly: true }` | The validation result, without applying the action. |","table":"table-5"},"130":{"id":"/client-52","page_id":"/client","tags":[],"type":"text","url":"/client#apply-an-action","content":"`applyAction` throws `ActionValidationError` when the parameters fail validation, with the details in `error.validation`. `batchApplyAction` takes an array of parameter objects and applies them in one request."},"131":{"id":"/client-53","page_id":"/client","tags":[],"type":"text","url":"/client#execute-a-function","content":"Replace `getEmployeeCount` with a function from your SDK. Its parameters and return type come from the function's definition."},"132":{"id":"/client-54","page_id":"/client","tags":[],"type":"text","url":"/client#read-metadata","content":"`client.fetchMetadata(definition)` returns runtime metadata, such as display names and descriptions, for an object type, interface, action, or function:"},"133":{"id":"/concepts/caching","page_id":"/concepts/caching","type":"page","content":"Caching and reactivity","breadcrumbs":["OSDK TypeScript","Guides","Concepts"],"tags":[],"url":"/concepts/caching"},"134":{"id":"/concepts/caching-0","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching","content":"How @osdk/react stores objects once, shares them across hooks, deduplicates requests, and updates every view after an action."},"135":{"id":"/concepts/caching-1","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#one-cache-per-provider","content":"One cache per provider"},"136":{"id":"/concepts/caching-2","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#objects-are-stored-once","content":"Objects are stored once"},"137":{"id":"/concepts/caching-3","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#read-an-instance-you-already-have","content":"Read an instance you already have"},"138":{"id":"/concepts/caching-4","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#when-two-hooks-share-an-entry","content":"When two hooks share an entry"},"139":{"id":"/concepts/caching-5","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#when-hooks-fetch","content":"When hooks fetch"},"140":{"id":"/concepts/caching-6","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#deduplication","content":"Deduplication"},"141":{"id":"/concepts/caching-7","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#retention","content":"Retention"},"142":{"id":"/concepts/caching-8","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#updates-after-actions","content":"Updates after actions"},"143":{"id":"/concepts/caching-9","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#how-lists-stay-correct","content":"How lists stay correct"},"144":{"id":"/concepts/caching-10","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#functions","content":"Functions"},"145":{"id":"/concepts/caching-11","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#optimistic-updates","content":"Optimistic updates"},"146":{"id":"/concepts/caching-12","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#real-time-updates","content":"Real-time updates"},"147":{"id":"/concepts/caching-13","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#when-you-need-to-invalidate","content":"When you need to invalidate"},"148":{"id":"/concepts/caching-14","page_id":"/concepts/caching","type":"heading","tags":[],"url":"/concepts/caching#practices","content":"Practices"},"149":{"id":"/concepts/caching-15","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching","content":"`@osdk/react` keeps one normalized cache per `OsdkProvider`. This page explains what the cache stores, when hooks hit the network, and how data updates after actions, so you can predict what a component renders."},"150":{"id":"/concepts/caching-16","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#one-cache-per-provider","content":"`OsdkProvider` wraps your `Client` in an `ObservableClient` from `@osdk/client/observable`. Every hook below that provider reads from and writes to the same cache:"},"151":{"id":"/concepts/caching-17","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#one-cache-per-provider","content":"Create the client once, outside any component. A new client creates a new, empty cache."},"152":{"id":"/concepts/caching-18","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"The cache stores each object under its object type and primary key, such as `Employee:12345`. Lists, links, and object sets do not copy objects. They store references to those entries."},"153":{"id":"/concepts/caching-19","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"| Hook            | What the cache stores                      |\n| --------------- | ------------------------------------------ |\n| `useOsdkObject` | One entry per object type and primary key. |","table":"table-0"},"154":{"id":"/concepts/caching-20","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"| Hook                             | What the cache stores                                               |\n| -------------------------------- | ------------------------------------------------------------------- |\n| `useOsdkObjects`, `useObjectSet` | The ordered list of references, plus `totalCount` and paging state. |","table":"table-0"},"155":{"id":"/concepts/caching-21","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"| Hook       | What the cache stores                                                             |\n| ---------- | --------------------------------------------------------------------------------- |\n| `useLinks` | References to the linked objects, keyed by source object, link name, and filters. |","table":"table-0"},"156":{"id":"/concepts/caching-22","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"| Hook                 | What the cache stores                                                           |\n| -------------------- | ------------------------------------------------------------------------------- |\n| `useOsdkAggregation` | The aggregation result, keyed by object type, filter, and aggregate definition. |","table":"table-0"},"157":{"id":"/concepts/caching-23","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"| Hook              | What the cache stores                                  |\n| ----------------- | ------------------------------------------------------ |\n| `useOsdkFunction` | The function result, keyed by function and parameters. |","table":"table-0"},"158":{"id":"/concepts/caching-24","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"Because objects are shared, a change to `Employee:12345` reaches every list, link, and detail view that contains it in the same render:"},"159":{"id":"/concepts/caching-25","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#objects-are-stored-once","content":"All three render the same `Employee` instance for `12345`."},"160":{"id":"/concepts/caching-26","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#read-an-instance-you-already-have","content":"`useOsdkObject(instance)` reads the object from the cache and does not send a request. Use it in a row component to get `isOptimistic` for an object a list already loaded:"},"161":{"id":"/concepts/caching-27","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#read-an-instance-you-already-have","content":"`useOsdkObject(Employee, id)` with a type and primary key does fetch. Calls for the same object type made within 25 ms are batched into one request of up to 100 objects."},"162":{"id":"/concepts/caching-28","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"Two hooks share a cache entry when they ask for the same data. The client canonicalizes options before building the key, so structurally equal options match even if you write them inline or list keys in a different order."},"163":{"id":"/concepts/caching-29","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"| Part of the key          | Not part of the key |\n| ------------------------ | ------------------- |\n| Object type or interface | `pageSize`          |","table":"table-1"},"164":{"id":"/concepts/caching-30","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"| Part of the key | Not part of the key |\n| --------------- | ------------------- |\n| `where`         | `enabled`           |","table":"table-1"},"165":{"id":"/concepts/caching-31","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"| Part of the key | Not part of the key |\n| --------------- | ------------------- |\n| `orderBy`       | `dedupeIntervalMs`  |","table":"table-1"},"166":{"id":"/concepts/caching-32","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"| Part of the key  | Not part of the key |\n| ---------------- | ------------------- |\n| `withProperties` | `autoFetchMore`     |","table":"table-1"},"167":{"id":"/concepts/caching-33","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"| Part of the key                               | Not part of the key |\n| --------------------------------------------- | ------------------- |\n| `$select`, `intersectWith`, `pivotTo`, `rids` |                     |","table":"table-1"},"168":{"id":"/concepts/caching-34","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"For example, these share one entry, and each component sees its own page size:"},"169":{"id":"/concepts/caching-35","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"These are separate entries, because the filters differ:"},"170":{"id":"/concepts/caching-36","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-two-hooks-share-an-entry","content":"Adding `withProperties` creates a separate variant of each object, so derived properties never leak into views that did not request them."},"171":{"id":"/concepts/caching-37","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-hooks-fetch","content":"The cache serves data immediately and refreshes it in the background. When a hook subscribes, it does three things:"},"172":{"id":"/concepts/caching-38","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-hooks-fetch","content":"Returns any data already in the cache for its key."},"173":{"id":"/concepts/caching-39","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-hooks-fetch","content":"Starts a request to revalidate the entry, unless a request for that entry is already in flight or one started within `dedupeIntervalMs`."},"174":{"id":"/concepts/caching-40","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-hooks-fetch","content":"Updates when the response arrives."},"175":{"id":"/concepts/caching-41","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-hooks-fetch","content":"So a component that mounts onto cached data renders it at once, with `isLoading: true` while the refresh runs. See Loading and errors for how to render that state."},"176":{"id":"/concepts/caching-42","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#deduplication","content":"`dedupeIntervalMs` defaults to `2000` on `useOsdkObjects`, `useObjectSet`, `useLinks`, `useOsdkAggregation`, and `useOsdkFunction`. If two components mount the same query within that window, the second one reuses the first request."},"177":{"id":"/concepts/caching-43","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#deduplication","content":"When several mounted hooks share an entry, the smallest `dedupeIntervalMs` among them applies. In-flight requests are always shared, whatever the interval."},"178":{"id":"/concepts/caching-44","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#retention","content":"An entry stays in the cache for about 60 seconds after its last hook unmounts. Navigating away and back within that window renders the cached data while it revalidates. After that, the entry is removed and the next mount starts empty."},"179":{"id":"/concepts/caching-45","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#updates-after-actions","content":"When you apply an action with `useOsdkAction`, the client requests the action's edits from the server and updates the cache from them. You do not need to invalidate anything."},"180":{"id":"/concepts/caching-46","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#updates-after-actions","content":"| Edit            | What happens                                                                              |\n| --------------- | ----------------------------------------------------------------------------------------- |\n| Object modified | The object is refetched. Every list, link, and detail view that references it re-renders. |","table":"table-2"},"181":{"id":"/concepts/caching-47","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#updates-after-actions","content":"| Edit         | What happens                                                                      |\n| ------------ | --------------------------------------------------------------------------------- |\n| Object added | The object is fetched. Lists of that type whose `where` clause it matches add it. |","table":"table-2"},"182":{"id":"/concepts/caching-48","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#updates-after-actions","content":"| Edit           | What happens                                                                |\n| -------------- | --------------------------------------------------------------------------- |\n| Object deleted | The object is removed from the cache and from every list that contained it. |","table":"table-2"},"183":{"id":"/concepts/caching-49","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#updates-after-actions","content":"| Edit               | What happens                                                                                                                   |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------ |\n| Any edit to a type | Aggregations over that type refetch. Links to that type re-evaluate. Functions with `dependsOn` that include the type refetch. |","table":"table-2"},"184":{"id":"/concepts/caching-50","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#updates-after-actions","content":"The action's promise resolves after the edited objects are refetched. Aggregation and other type-wide refreshes continue in the background."},"185":{"id":"/concepts/caching-51","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#how-lists-stay-correct","content":"For a modified or added object, each list of that type checks the object against its `where` clause in the browser:"},"186":{"id":"/concepts/caching-52","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#how-lists-stay-correct","content":"If the object matches, the list keeps it or inserts it."},"187":{"id":"/concepts/caching-53","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#how-lists-stay-correct","content":"If the object no longer matches, the list removes it."},"188":{"id":"/concepts/caching-54","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#how-lists-stay-correct","content":"If the clause uses a filter the browser cannot evaluate, such as full-text search, the list refetches from the server with `isLoading: true` and keeps its current data until the response arrives."},"189":{"id":"/concepts/caching-55","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#how-lists-stay-correct","content":"Lists that follow a link (`pivotTo`) or return a different object type than they start from always refetch from the server when objects of their result type change."},"190":{"id":"/concepts/caching-56","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#functions","content":"Function results are not tied to objects, so the cache cannot know which edits affect them. Declare the dependency with `dependsOn` or `dependsOnObjects`:"},"191":{"id":"/concepts/caching-57","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#functions","content":"| Option                  | Refetches when                  |\n| ----------------------- | ------------------------------- |\n| `dependsOn: [Employee]` | An action edits any `Employee`. |","table":"table-3"},"192":{"id":"/concepts/caching-58","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#functions","content":"| Option                         | Refetches when                        |\n| ------------------------------ | ------------------------------------- |\n| `dependsOnObjects: [employee]` | An action edits that specific object. |","table":"table-3"},"193":{"id":"/concepts/caching-59","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#functions","content":"| Option                          | Refetches when                                       |\n| ------------------------------- | ---------------------------------------------------- |\n| `dependsOnObjects: [objectSet]` | An action edits any object of the object set's type. |","table":"table-3"},"194":{"id":"/concepts/caching-60","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#optimistic-updates","content":"`useOsdkAction` accepts `$optimisticUpdate`, which writes your predicted change to a temporary layer above the server data. Every view shows the predicted change at once and reports `isOptimistic: true`. When the action finishes, the layer is removed and the server's data replaces it. If the action fails, the layer is removed and the views return to the previous data."},"195":{"id":"/concepts/caching-61","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#optimistic-updates","content":"In development, an action with an optimistic update is delayed by 1000 ms so you can see the optimistic state. Set `devMode={{ actionDelayMs: 0 }}` on `OsdkProvider` to turn the delay off. The delay never applies in production builds."},"196":{"id":"/concepts/caching-62","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#optimistic-updates","content":"See Optimistic updates for the API."},"197":{"id":"/concepts/caching-63","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#real-time-updates","content":"Pass `streamUpdates: true` to `useOsdkObjects` to keep a list current over a WebSocket. Changes made outside your app, by other users or pipelines, arrive without polling. `streamUpdates` cannot be combined with `pivotTo`, because the server does not support subscriptions for link traversal."},"198":{"id":"/concepts/caching-64","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-you-need-to-invalidate","content":"Automatic updates cover changes that go through `useOsdkAction` in this app. Invalidate manually when data changes another way:"},"199":{"id":"/concepts/caching-65","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-you-need-to-invalidate","content":"Another system or pipeline edits the data."},"200":{"id":"/concepts/caching-66","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-you-need-to-invalidate","content":"Your code edits data with `@osdk/client` directly, a REST call, or a background job."},"201":{"id":"/concepts/caching-67","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-you-need-to-invalidate","content":"A function reads data the cache cannot track."},"202":{"id":"/concepts/caching-68","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#when-you-need-to-invalidate","content":"See Cache invalidation for `invalidateObjects`, `invalidateObjectType`, `invalidateFunction`, and the other methods."},"203":{"id":"/concepts/caching-69","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#practices","content":"**Let actions drive updates.** Do not call `invalidate*` after `applyAction`. The cache already handles the edits."},"204":{"id":"/concepts/caching-70","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#practices","content":"**Keep one source of truth.** Do not copy OSDK data into Redux, TanStack Query, or component state. Copies miss optimistic updates and action edits."},"205":{"id":"/concepts/caching-71","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#practices","content":"**Declare function dependencies.** Prefer `dependsOn` and `dependsOnObjects` over invalidating functions by hand."},"206":{"id":"/concepts/caching-72","page_id":"/concepts/caching","tags":[],"type":"text","url":"/concepts/caching#practices","content":"**Use the devtools.** The Cache panel shows entries, hits, and misses in a running app."},"207":{"id":"/concepts/loading-and-errors","page_id":"/concepts/loading-and-errors","type":"page","content":"Loading and errors","breadcrumbs":["OSDK TypeScript","Guides","Concepts"],"tags":[],"url":"/concepts/loading-and-errors"},"208":{"id":"/concepts/loading-and-errors-0","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors","content":"Render @osdk/react hooks correctly while data loads, refreshes, or fails, and narrow errors to PalantirApiError and ActionValidationError."},"209":{"id":"/concepts/loading-and-errors-1","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"Loading is not the same as empty"},"210":{"id":"/concepts/loading-and-errors-2","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#keep-rendering-while-loading","content":"Keep rendering while loading"},"211":{"id":"/concepts/loading-and-errors-3","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"Loading and error fields by hook"},"212":{"id":"/concepts/loading-and-errors-4","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#narrow-api-errors","content":"Narrow API errors"},"213":{"id":"/concepts/loading-and-errors-5","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#handle-action-errors","content":"Handle action errors"},"214":{"id":"/concepts/loading-and-errors-6","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#validation-not-message","content":"`.validation`, not `.message`"},"215":{"id":"/concepts/loading-and-errors-7","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#validate-before-you-apply","content":"Validate before you apply"},"216":{"id":"/concepts/loading-and-errors-8","page_id":"/concepts/loading-and-errors","type":"heading","tags":[],"url":"/concepts/loading-and-errors#related","content":"Related"},"217":{"id":"/concepts/loading-and-errors-9","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors","content":"`@osdk/react` hooks can return data and report loading at the same time. This page shows the loading pattern that avoids flashing UI, the error shape of each hook, and how to turn an error into a message the user can act on."},"218":{"id":"/concepts/loading-and-errors-10","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"`isLoading` means a request for the hook's data is in flight. It does not mean `data` is missing. The cache serves what it has and refreshes in the background, so `isLoading` is `true` with data present when:"},"219":{"id":"/concepts/loading-and-errors-11","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"The component mounts onto data that another component already cached."},"220":{"id":"/concepts/loading-and-errors-12","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"An action edits an object and a list must refetch to decide whether the object still belongs in it."},"221":{"id":"/concepts/loading-and-errors-13","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"You call `refetch`, or something invalidates the entry."},"222":{"id":"/concepts/loading-and-errors-14","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"An optimistic update is applied to a list."},"223":{"id":"/concepts/loading-and-errors-15","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"The states you can see are:"},"224":{"id":"/concepts/loading-and-errors-16","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"| `data`      | `isLoading` | Meaning                     | Render                     |\n| ----------- | ----------- | --------------------------- | -------------------------- |\n| `undefined` | `true`      | First load, nothing cached. | A placeholder or skeleton. |","table":"table-0"},"225":{"id":"/concepts/loading-and-errors-17","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"| `data`  | `isLoading` | Meaning                 | Render                                       |\n| ------- | ----------- | ----------------------- | -------------------------------------------- |\n| Present | `true`      | Refreshing cached data. | The data, with a small refreshing indicator. |","table":"table-0"},"226":{"id":"/concepts/loading-and-errors-18","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"| `data`  | `isLoading` | Meaning     | Render    |\n| ------- | ----------- | ----------- | --------- |\n| Present | `false`     | Up to date. | The data. |","table":"table-0"},"227":{"id":"/concepts/loading-and-errors-19","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"| `data`      | `isLoading` | Meaning                                                         | Render                        |\n| ----------- | ----------- | --------------------------------------------------------------- | ----------------------------- |\n| `undefined` | `false`     | The hook is disabled with `enabled: false`, or the load failed. | An empty state, or the error. |","table":"table-0"},"228":{"id":"/concepts/loading-and-errors-20","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-is-not-the-same-as-empty","content":"See Caching and reactivity for when hooks refetch."},"229":{"id":"/concepts/loading-and-errors-21","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#keep-rendering-while-loading","content":"Do not return early on `isLoading`. An early return replaces the content with a spinner every time the cache refreshes, which makes the page flash and resets scroll position and focus. The only early return that is safe is the initial state, when there is no data yet:"},"230":{"id":"/concepts/loading-and-errors-22","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#keep-rendering-while-loading","content":"The component checks `error` separately from `data`. A refresh can fail after earlier data loaded, so both can be set at once."},"231":{"id":"/concepts/loading-and-errors-23","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#keep-rendering-while-loading","content":"Do not write `if (isLoading) return <Spinner />`. Use `if (data == null && isLoading)` for the initial load, and render an inline indicator for refreshes."},"232":{"id":"/concepts/loading-and-errors-24","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"The hooks do not all use the same field names. Check this table before you destructure:"},"233":{"id":"/concepts/loading-and-errors-25","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook             | Data   | Loading     | Error                       | Retry       |\n| ---------------- | ------ | ----------- | --------------------------- | ----------- |\n| `useOsdkObjects` | `data` | `isLoading` | `error: Error \\| undefined` | `refetch()` |","table":"table-1"},"234":{"id":"/concepts/loading-and-errors-26","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook           | Data   | Loading     | Error                       | Retry       |\n| -------------- | ------ | ----------- | --------------------------- | ----------- |\n| `useObjectSet` | `data` | `isLoading` | `error: Error \\| undefined` | `refetch()` |","table":"table-1"},"235":{"id":"/concepts/loading-and-errors-27","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook            | Data     | Loading     | Error                       | Retry |\n| --------------- | -------- | ----------- | --------------------------- | ----- |\n| `useOsdkObject` | `object` | `isLoading` | `error: Error \\| undefined` | None  |","table":"table-1"},"236":{"id":"/concepts/loading-and-errors-28","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook       | Data    | Loading     | Error                       | Retry |\n| ---------- | ------- | ----------- | --------------------------- | ----- |\n| `useLinks` | `links` | `isLoading` | `error: Error \\| undefined` | None  |","table":"table-1"},"237":{"id":"/concepts/loading-and-errors-29","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook                 | Data   | Loading     | Error                       | Retry       |\n| -------------------- | ------ | ----------- | --------------------------- | ----------- |\n| `useOsdkAggregation` | `data` | `isLoading` | `error: Error \\| undefined` | `refetch()` |","table":"table-1"},"238":{"id":"/concepts/loading-and-errors-30","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook              | Data   | Loading     | Error                       | Retry       |\n| ----------------- | ------ | ----------- | --------------------------- | ----------- |\n| `useOsdkFunction` | `data` | `isLoading` | `error: Error \\| undefined` | `refetch()` |","table":"table-1"},"239":{"id":"/concepts/loading-and-errors-31","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook            | Data   | Loading                     | Error                                                 | Retry                    |\n| --------------- | ------ | --------------------------- | ----------------------------------------------------- | ------------------------ |\n| `useOsdkAction` | `data` | `isPending`, `isValidating` | `error: { actionValidation?, unknown? } \\| undefined` | Call `applyAction` again |","table":"table-1"},"240":{"id":"/concepts/loading-and-errors-32","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"| Hook              | Data       | Loading   | Error                        | Retry |\n| ----------------- | ---------- | --------- | ---------------------------- | ----- |\n| `useOsdkMetadata` | `metadata` | `loading` | `error: string \\| undefined` | None  |","table":"table-1"},"241":{"id":"/concepts/loading-and-errors-33","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"Details that differ between hooks:"},"242":{"id":"/concepts/loading-and-errors-34","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"**`refetch` scope.** On `useOsdkObjects`, `useObjectSet`, and `useOsdkAggregation`, `refetch` invalidates the whole object type, so every list and aggregation of that type refetches. On `useOsdkFunction`, it refetches only that function call with those parameters. To refetch more narrowly, use the methods in Cache invalidation."},"243":{"id":"/concepts/loading-and-errors-35","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"**`useOsdkObject`.** `isLoading` is `false` as soon as `error` is set."},"244":{"id":"/concepts/loading-and-errors-36","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"**`useObjectSet`.** When the object set changes, `data` keeps the last loaded result until the new set loads."},"245":{"id":"/concepts/loading-and-errors-37","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"**`useOsdkFunction`.** `isLoading` is `true` only while a request is in flight, so the first render can report `isLoading: false` with no data. Treat `data === undefined && error == null` as the initial state, or check `lastUpdated === 0`."},"246":{"id":"/concepts/loading-and-errors-38","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"**`useOsdkMetadata`.** It uses `loading`, not `isLoading`, and `error` is the error's message as a string, not an `Error`. It does not retry after a failure."},"247":{"id":"/concepts/loading-and-errors-39","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#loading-and-error-fields-by-hook","content":"**Disabled hooks.** With `enabled: false` (or `false` as the last argument to `useOsdkObject`), `isLoading` is `false` and no request is sent."},"248":{"id":"/concepts/loading-and-errors-40","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"Errors from Foundry are instances of `PalantirApiError`, which `@osdk/client` exports. Data hooks type `error` as `Error`, so narrow it with `instanceof`:"},"249":{"id":"/concepts/loading-and-errors-41","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field     | Type     | Description                                                       |\n| --------- | -------- | ----------------------------------------------------------------- |\n| `message` | `string` | The server's message, or `Failed to fetch <status> <statusText>`. |","table":"table-2"},"250":{"id":"/concepts/loading-and-errors-42","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field       | Type                  | Description                                                                                                 |\n| ----------- | --------------------- | ----------------------------------------------------------------------------------------------------------- |\n| `errorCode` | `string \\| undefined` | The error category, such as `PERMISSION_DENIED`, `NOT_FOUND`, `INVALID_ARGUMENT`, `CONFLICT`, or `TIMEOUT`. |","table":"table-2"},"251":{"id":"/concepts/loading-and-errors-43","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field       | Type                  | Description                                   |\n| ----------- | --------------------- | --------------------------------------------- |\n| `errorName` | `string \\| undefined` | The specific error, such as `ObjectNotFound`. |","table":"table-2"},"252":{"id":"/concepts/loading-and-errors-44","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field              | Type                  | Description                        |\n| ------------------ | --------------------- | ---------------------------------- |\n| `errorDescription` | `string \\| undefined` | A longer description of the error. |","table":"table-2"},"253":{"id":"/concepts/loading-and-errors-45","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field        | Type                  | Description           |\n| ------------ | --------------------- | --------------------- |\n| `statusCode` | `number \\| undefined` | The HTTP status code. |","table":"table-2"},"254":{"id":"/concepts/loading-and-errors-46","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field             | Type                  | Description                                                                                    |\n| ----------------- | --------------------- | ---------------------------------------------------------------------------------------------- |\n| `errorInstanceId` | `string \\| undefined` | An ID for this occurrence. Include it when you report a problem to your Foundry administrator. |","table":"table-2"},"255":{"id":"/concepts/loading-and-errors-47","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"| Field        | Type      | Description                                                         |\n| ------------ | --------- | ------------------------------------------------------------------- |\n| `parameters` | `unknown` | Error-specific details, such as the object type that was not found. |","table":"table-2"},"256":{"id":"/concepts/loading-and-errors-48","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"Some errors carry only a message:"},"257":{"id":"/concepts/loading-and-errors-49","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"When a request fails before reaching Foundry, or the response is not JSON, the error is a `PalantirApiError` subclass whose `name` is `\"UnknownError\"`. `statusCode` is set if a response arrived."},"258":{"id":"/concepts/loading-and-errors-50","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"`useOsdkObject(Employee, id)` for an object that does not exist, or that you cannot see, reports a `PalantirApiError` with the message `Object not found: <id>` and no `errorCode` or `statusCode`."},"259":{"id":"/concepts/loading-and-errors-51","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#narrow-api-errors","content":"The client retries requests that fail with `429` or `503` up to three times, with exponential backoff, before the error reaches your hook."},"260":{"id":"/concepts/loading-and-errors-52","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#handle-action-errors","content":"`useOsdkAction` splits errors into two kinds:"},"261":{"id":"/concepts/loading-and-errors-53","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#handle-action-errors","content":"| Field                    | Set when                                                                                                            | Type                    |\n| ------------------------ | ------------------------------------------------------------------------------------------------------------------- | ----------------------- |\n| `error.actionValidation` | The server ran the action's validation and it failed: a submission criterion or a parameter constraint was not met. | `ActionValidationError` |","table":"table-3"},"262":{"id":"/concepts/loading-and-errors-54","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#handle-action-errors","content":"| Field           | Set when                                                                         | Type      |\n| --------------- | -------------------------------------------------------------------------------- | --------- |\n| `error.unknown` | Anything else, such as a network failure, a permission error, or a server error. | `unknown` |","table":"table-3"},"263":{"id":"/concepts/loading-and-errors-55","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#handle-action-errors","content":"`applyAction` also rethrows the error, so always await it in `try`/`catch` or attach `.catch`. Otherwise a failed action becomes an unhandled promise rejection:"},"264":{"id":"/concepts/loading-and-errors-56","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#validation-not-message","content":"`ActionValidationError.message` is `\"Validation Error: \"` followed by the validation response as JSON. It is useful in logs, not in UI. Read `.validation` instead:"},"265":{"id":"/concepts/loading-and-errors-57","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#validation-not-message","content":"| Field               | Type                   | Description         |\n| ------------------- | ---------------------- | ------------------- |\n| `validation.result` | `\"VALID\" \\| \"INVALID\"` | The overall result. |","table":"table-4"},"266":{"id":"/concepts/loading-and-errors-58","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#validation-not-message","content":"| Field                           | Type                                             | Description                                                                                              |\n| ------------------------------- | ------------------------------------------------ | -------------------------------------------------------------------------------------------------------- |\n| `validation.submissionCriteria` | Array of `{ result, configuredFailureMessage? }` | One entry per submission criterion. `configuredFailureMessage` is the message the action's author wrote. |","table":"table-4"},"267":{"id":"/concepts/loading-and-errors-59","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#validation-not-message","content":"| Field                   | Type                                                                   | Description                                             |\n| ----------------------- | ---------------------------------------------------------------------- | ------------------------------------------------------- |\n| `validation.parameters` | Record of parameter ID to `{ result, required, evaluatedConstraints }` | Per-parameter results. Use it to highlight form fields. |","table":"table-4"},"268":{"id":"/concepts/loading-and-errors-60","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#validate-before-you-apply","content":"`validateAction` runs the same validation without applying the action. An invalid result does not throw: it resolves to the validation response, which the hook also stores as `validationResult`. `validateAction` throws only for other failures, and resolves to `undefined` if a newer validation or an `applyAction` call supersedes it."},"269":{"id":"/concepts/loading-and-errors-61","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#validate-before-you-apply","content":"The hook clears `error` when you call `applyAction` or `validateAction` again."},"270":{"id":"/concepts/loading-and-errors-62","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#related","content":"Actions: apply, validate, and batch actions."},"271":{"id":"/concepts/loading-and-errors-63","page_id":"/concepts/loading-and-errors","tags":[],"type":"text","url":"/concepts/loading-and-errors#related","content":"Troubleshooting: fixes for setup, version, and auth errors."},"272":{"id":"/concepts/ontology","page_id":"/concepts/ontology","type":"page","content":"The Ontology and your SDK","breadcrumbs":["OSDK TypeScript","Guides","Concepts"],"tags":[],"url":"/concepts/ontology"},"273":{"id":"/concepts/ontology-0","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology","content":"How object types, links, actions, functions, interfaces, and object sets map to the generated SDK and to Osdk.Instance values in TypeScript."},"274":{"id":"/concepts/ontology-1","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#ontology-concepts","content":"Ontology concepts"},"275":{"id":"/concepts/ontology-2","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#why-clientemployee","content":"Why `client(Employee)`"},"276":{"id":"/concepts/ontology-3","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#object-instances","content":"Object instances"},"277":{"id":"/concepts/ontology-4","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#metadata-fields","content":"Metadata fields"},"278":{"id":"/concepts/ontology-5","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#instances-are-immutable","content":"Instances are immutable"},"279":{"id":"/concepts/ontology-6","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#links","content":"Links"},"280":{"id":"/concepts/ontology-7","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#property-value-types","content":"Property value types"},"281":{"id":"/concepts/ontology-8","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#dates-and-timestamps","content":"Dates and timestamps"},"282":{"id":"/concepts/ontology-9","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#object-sets","content":"Object sets"},"283":{"id":"/concepts/ontology-10","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#interfaces","content":"Interfaces"},"284":{"id":"/concepts/ontology-11","page_id":"/concepts/ontology","type":"heading","tags":[],"url":"/concepts/ontology#related","content":"Related"},"285":{"id":"/concepts/ontology-12","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology","content":"Your generated SDK is a typed description of part of a Foundry Ontology. This page explains what each Ontology concept becomes in TypeScript, so you can read the SDK and the values it returns."},"286":{"id":"/concepts/ontology-13","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept     | What it is                                           | In the generated SDK                                                                             | How you use it                                                |\n| ----------- | ---------------------------------------------------- | ------------------------------------------------------------------------------------------------ | ------------------------------------------------------------- |\n| Object type | A schema for real-world entities, such as employees. | A definition, `Employee`, plus the namespace types `Employee.Props` and `Employee.OsdkInstance`. | `client(Employee)` returns an object set of every `Employee`. |","table":"table-0"},"287":{"id":"/concepts/ontology-14","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept  | What it is                       | In the generated SDK                                            | How you use it                               |\n| -------- | -------------------------------- | --------------------------------------------------------------- | -------------------------------------------- |\n| Property | A typed field on an object type. | A key in `Employee.Props`, typed from the property's base type. | Read it on an instance: `employee.fullName`. |","table":"table-0"},"288":{"id":"/concepts/ontology-15","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept     | What it is                                       | In the generated SDK                                        | How you use it                                                 |\n| ----------- | ------------------------------------------------ | ----------------------------------------------------------- | -------------------------------------------------------------- |\n| Primary key | The property that uniquely identifies an object. | `primaryKeyApiName` and `primaryKeyType` on the definition. | `client(Employee).fetchOne(12345)`, or `employee.$primaryKey`. |","table":"table-0"},"289":{"id":"/concepts/ontology-16","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept   | What it is                               | In the generated SDK         | How you use it                                                              |\n| --------- | ---------------------------------------- | ---------------------------- | --------------------------------------------------------------------------- |\n| Link type | A relationship between two object types. | Entries in `Employee.Links`. | `employee.$link.lead` for a single link, `employee.$link.reports` for many. |","table":"table-0"},"290":{"id":"/concepts/ontology-17","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept     | What it is                        | In the generated SDK            | How you use it                                 |\n| ----------- | --------------------------------- | ------------------------------- | ---------------------------------------------- |\n| Action type | A transaction that edits objects. | A definition, `modifyEmployee`. | `client(modifyEmployee).applyAction({ ... })`. |","table":"table-0"},"291":{"id":"/concepts/ontology-18","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept          | What it is                                                     | In the generated SDK                        | How you use it                                         |\n| ---------------- | -------------------------------------------------------------- | ------------------------------------------- | ------------------------------------------------------ |\n| Function (query) | Server-side logic that reads the Ontology and returns a value. | A definition, such as `getEmployeeMetrics`. | `client(getEmployeeMetrics).executeFunction({ ... })`. |","table":"table-0"},"292":{"id":"/concepts/ontology-19","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept   | What it is                                          | In the generated SDK                  | How you use it                                                    |\n| --------- | --------------------------------------------------- | ------------------------------------- | ----------------------------------------------------------------- |\n| Interface | A shared shape that several object types implement. | A definition with its own properties. | `client(MyInterface).fetchPage()`, then `instance.$as(Employee)`. |","table":"table-0"},"293":{"id":"/concepts/ontology-20","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"| Concept    | What it is                             | In the generated SDK  | How you use it                                     |\n| ---------- | -------------------------------------- | --------------------- | -------------------------------------------------- |\n| Object set | A lazy, composable query over objects. | `Employee.ObjectSet`. | `client(Employee).where({ ... }).pivotTo(\"lead\")`. |","table":"table-0"},"294":{"id":"/concepts/ontology-21","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"The generated package does not contain a client. It exports definitions, which are plain metadata. You pass a definition to a client created with `createClient` from `@osdk/client`, and the client does the work:"},"295":{"id":"/concepts/ontology-22","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#ontology-concepts","content":"See Create a client to set up `client`."},"296":{"id":"/concepts/ontology-23","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#why-clientemployee","content":"The SDK separates the code that knows your Ontology (the generated package) from the code that talks to Foundry (`@osdk/client`). That design has practical effects:"},"297":{"id":"/concepts/ontology-24","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#why-clientemployee","content":"**Smaller bundles.** Each definition is a small named export. Bundlers drop the ones you do not import, so the SDK's cost scales with what you use, not with the size of the Ontology."},"298":{"id":"/concepts/ontology-25","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#why-clientemployee","content":"**One runtime.** Several generated SDKs share the same `@osdk/client` code instead of each shipping its own."},"299":{"id":"/concepts/ontology-26","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#why-clientemployee","content":"**Fixes without regenerating.** A bug fix in `@osdk/client` reaches you through a dependency update. You do not need to regenerate the SDK."},"300":{"id":"/concepts/ontology-27","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#why-clientemployee","content":"If you want autocomplete across the whole Ontology, import the namespace exports. Tree-shaking still removes what you do not reference:"},"301":{"id":"/concepts/ontology-28","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#why-clientemployee","content":"The generated package also exports `$Actions`, `$Queries`, and `$Interfaces`, and `$ontologyRid` when the SDK was generated for a single Foundry environment."},"302":{"id":"/concepts/ontology-29","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-instances","content":"Every object you fetch, from `@osdk/client` or from `@osdk/react` hooks, is an `Osdk.Instance`. The generated alias `Employee.OsdkInstance` is the same type:"},"303":{"id":"/concepts/ontology-30","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"Fields that start with `$` describe the object rather than hold Ontology data:"},"304":{"id":"/concepts/ontology-31","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field      | Type     | Description                                                                                 |\n| ---------- | -------- | ------------------------------------------------------------------------------------------- |\n| `$apiName` | `string` | API name of the type you queried. For an interface query, this is the interface's API name. |","table":"table-1"},"305":{"id":"/concepts/ontology-32","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field         | Type     | Description                                                               |\n| ------------- | -------- | ------------------------------------------------------------------------- |\n| `$objectType` | `string` | API name of the concrete object type, even when you queried an interface. |","table":"table-1"},"306":{"id":"/concepts/ontology-33","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field         | Type             | Description                                              |\n| ------------- | ---------------- | -------------------------------------------------------- |\n| `$primaryKey` | Primary key type | The object's primary key value. Use it as a React `key`. |","table":"table-1"},"307":{"id":"/concepts/ontology-34","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field    | Type                  | Description                                |\n| -------- | --------------------- | ------------------------------------------ |\n| `$title` | `string \\| undefined` | Value of the object type's title property. |","table":"table-1"},"308":{"id":"/concepts/ontology-35","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field              | Type              | Description                                                  |\n| ------------------ | ----------------- | ------------------------------------------------------------ |\n| `$objectSpecifier` | `ObjectSpecifier` | A string that identifies the object by type and primary key. |","table":"table-1"},"309":{"id":"/concepts/ontology-36","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field   | Type         | Description                       |\n| ------- | ------------ | --------------------------------- |\n| `$link` | Links object | Accessors for the object's links. |","table":"table-1"},"310":{"id":"/concepts/ontology-37","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field | Type     | Description                                                          |\n| ----- | -------- | -------------------------------------------------------------------- |\n| `$as` | Function | Converts between an interface and an object type that implements it. |","table":"table-1"},"311":{"id":"/concepts/ontology-38","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field    | Type     | Description                                             |\n| -------- | -------- | ------------------------------------------------------- |\n| `$clone` | Function | Returns a copy of the instance with updated properties. |","table":"table-1"},"312":{"id":"/concepts/ontology-39","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#metadata-fields","content":"| Field  | Type     | Description                                                                  |\n| ------ | -------- | ---------------------------------------------------------------------------- |\n| `$rid` | `string` | The object's RID. Present only when you request it with `$includeRid: true`. |","table":"table-1"},"313":{"id":"/concepts/ontology-40","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#instances-are-immutable","content":"Instances are frozen, and their properties are `readonly`. To get a changed copy, call `$clone`:"},"314":{"id":"/concepts/ontology-41","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#instances-are-immutable","content":"`$clone` throws if the update changes the primary key. It does not write anything to Foundry. Use it to build optimistic state for an action, as shown in Optimistic updates. To change data, apply an action."},"315":{"id":"/concepts/ontology-42","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#links","content":"A single-valued link returns an accessor with `fetchOne`. A many-valued link returns an object set:"},"316":{"id":"/concepts/ontology-43","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#links","content":"In React, use `useLinks` instead so linked objects share the cache."},"317":{"id":"/concepts/ontology-44","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"Most properties are optional on the instance (`T | undefined`). Only the primary key and properties the Ontology marks as required are always present."},"318":{"id":"/concepts/ontology-45","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes |\n| ------------- | ---------------- | ----- |\n| `string`      | `string`         |       |","table":"table-2"},"319":{"id":"/concepts/ontology-46","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes |\n| ------------- | ---------------- | ----- |\n| `boolean`     | `boolean`        |       |","table":"table-2"},"320":{"id":"/concepts/ontology-47","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type                                 | TypeScript value | Notes |\n| --------------------------------------------- | ---------------- | ----- |\n| `integer`, `short`, `byte`, `float`, `double` | `number`         |       |","table":"table-2"},"321":{"id":"/concepts/ontology-48","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes                                                    |\n| ------------- | ---------------- | -------------------------------------------------------- |\n| `long`        | `string`         | Strings keep 64-bit precision that `number` cannot hold. |","table":"table-2"},"322":{"id":"/concepts/ontology-49","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes                             |\n| ------------- | ---------------- | --------------------------------- |\n| `decimal`     | `string`         | Strings keep arbitrary precision. |","table":"table-2"},"323":{"id":"/concepts/ontology-50","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes                                  |\n| ------------- | ---------------- | -------------------------------------- |\n| `date`        | `string`         | ISO 8601 date, such as `\"2024-03-15\"`. |","table":"table-2"},"324":{"id":"/concepts/ontology-51","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes                                                     |\n| ------------- | ---------------- | --------------------------------------------------------- |\n| `timestamp`   | `string`         | ISO 8601 date and time, such as `\"2024-03-15T09:30:00Z\"`. |","table":"table-2"},"325":{"id":"/concepts/ontology-52","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes |\n| ------------- | ---------------- | ----- |\n| `geopoint`    | `GeoJSON.Point`  |       |","table":"table-2"},"326":{"id":"/concepts/ontology-53","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value  | Notes |\n| ------------- | ----------------- | ----- |\n| `geoshape`    | `GeoJSON.GeoJSON` |       |","table":"table-2"},"327":{"id":"/concepts/ontology-54","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes                                                                                |\n| ------------- | ---------------- | ------------------------------------------------------------------------------------ |\n| `attachment`  | `Attachment`     | Has `rid`, `fetchMetadata()`, and `fetchContents()`, which resolves to a `Response`. |","table":"table-2"},"328":{"id":"/concepts/ontology-55","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type    | TypeScript value | Notes                                                                |\n| ---------------- | ---------------- | -------------------------------------------------------------------- |\n| `mediaReference` | `Media`          | Has `fetchMetadata()`, `fetchContents()`, and `getMediaReference()`. |","table":"table-2"},"329":{"id":"/concepts/ontology-56","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes                                  |\n| ------------- | ---------------- | -------------------------------------- |\n| `cipherText`  | `CipherText`     | Call `decrypt()` to get the plaintext. |","table":"table-2"},"330":{"id":"/concepts/ontology-57","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes |\n| ------------- | ---------------- | ----- |\n| `marking`     | `string`         |       |","table":"table-2"},"331":{"id":"/concepts/ontology-58","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type | TypeScript value | Notes |\n| ------------- | ---------------- | ----- |\n| `vector`      | `number[]`       |       |","table":"table-2"},"332":{"id":"/concepts/ontology-59","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type                           | TypeScript value     | Notes                                                          |\n| --------------------------------------- | -------------------- | -------------------------------------------------------------- |\n| Numeric, string, and sensor time series | `TimeSeriesProperty` | Has `getFirstPoint()`, `getLastPoint()`, and `getAllPoints()`. |","table":"table-2"},"333":{"id":"/concepts/ontology-60","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#property-value-types","content":"| Ontology type            | TypeScript value        | Notes |\n| ------------------------ | ----------------------- | ----- |\n| `geotimeSeriesReference` | `GeotimeSeriesProperty` |       |","table":"table-2"},"334":{"id":"/concepts/ontology-61","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#dates-and-timestamps","content":"The SDK returns dates and timestamps as ISO 8601 strings instead of `Date` objects or a date library's types. This keeps a large date library out of your bundle, lets you use the date library you already have, and avoids parsing values you never read."},"335":{"id":"/concepts/ontology-62","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#dates-and-timestamps","content":"Parse a value when you need date math:"},"336":{"id":"/concepts/ontology-63","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#dates-and-timestamps","content":"To send a date-only value, `@osdk/client` exports helpers that format a `Date` as `YYYY-MM-DD`:"},"337":{"id":"/concepts/ontology-64","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#dates-and-timestamps","content":"`extractDate` returns the date part of an ISO 8601 timestamp string."},"338":{"id":"/concepts/ontology-65","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"An object set describes which objects you want. Building one does not send a request; only fetching does:"},"339":{"id":"/concepts/ontology-66","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method          | Returns    | Description      |\n| --------------- | ---------- | ---------------- |\n| `where(clause)` | Object set | Filters the set. |","table":"table-3"},"340":{"id":"/concepts/ontology-67","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method                                                      | Returns    | Description                     |\n| ----------------------------------------------------------- | ---------- | ------------------------------- |\n| `union(...sets)`, `intersect(...sets)`, `subtract(...sets)` | Object set | Combines sets of the same type. |","table":"table-3"},"341":{"id":"/concepts/ontology-68","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method          | Returns    | Description                        |\n| --------------- | ---------- | ---------------------------------- |\n| `pivotTo(link)` | Object set | Follows a link to the linked type. |","table":"table-3"},"342":{"id":"/concepts/ontology-69","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method                | Returns    | Description                                     |\n| --------------------- | ---------- | ----------------------------------------------- |\n| `withProperties(...)` | Object set | Adds derived properties computed on the server. |","table":"table-3"},"343":{"id":"/concepts/ontology-70","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method               | Returns             | Description                                                  |\n| -------------------- | ------------------- | ------------------------------------------------------------ |\n| `fetchPage(options)` | `Promise` of a page | Fetches one page: `data`, `nextPageToken`, and `totalCount`. |","table":"table-3"},"344":{"id":"/concepts/ontology-71","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method                 | Returns                  | Description                            |\n| ---------------------- | ------------------------ | -------------------------------------- |\n| `fetchOne(primaryKey)` | `Promise` of an instance | Fetches one object. Object types only. |","table":"table-3"},"345":{"id":"/concepts/ontology-72","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method        | Returns        | Description                              |\n| ------------- | -------------- | ---------------------------------------- |\n| `asyncIter()` | Async iterator | Iterates over every object across pages. |","table":"table-3"},"346":{"id":"/concepts/ontology-73","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method               | Returns              | Description                        |\n| -------------------- | -------------------- | ---------------------------------- |\n| `aggregate(options)` | `Promise` of results | Runs an aggregation on the server. |","table":"table-3"},"347":{"id":"/concepts/ontology-74","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"| Method                | Returns      | Description                                   |\n| --------------------- | ------------ | --------------------------------------------- |\n| `subscribe(listener)` | Subscription | Receives changes to the set over a WebSocket. |","table":"table-3"},"348":{"id":"/concepts/ontology-75","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#object-sets","content":"In React, pass the same filters to `useOsdkObjects` or build a set with `useObjectSet`."},"349":{"id":"/concepts/ontology-76","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#interfaces","content":"An interface lets you query several object types through one shape. Instances from an interface query expose the interface's properties. `$objectType` tells you the concrete type, and `$as` converts to it:"},"350":{"id":"/concepts/ontology-77","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#related","content":"Caching and reactivity: how `@osdk/react` stores these instances."},"351":{"id":"/concepts/ontology-78","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#related","content":"Objects: query objects in React."},"352":{"id":"/concepts/ontology-79","page_id":"/concepts/ontology","tags":[],"type":"text","url":"/concepts/ontology#related","content":"Actions: edit objects."},"353":{"id":"/deploy/branches","page_id":"/deploy/branches","type":"page","content":"Develop on Foundry branches","breadcrumbs":["OSDK TypeScript","Guides","Deploy"],"tags":[],"url":"/deploy/branches"},"354":{"id":"/deploy/branches-0","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches","content":"Point your OSDK app at a Foundry global branch with osdk branch sync, @osdk/vite-plugin-branch, and the beta UNSTABLE_DO_NOT_USE_BRANCH client option."},"355":{"id":"/deploy/branches-1","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#how-it-works","content":"How it works"},"356":{"id":"/deploy/branches-2","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#set-up-a-new-app","content":"Set up a new app"},"357":{"id":"/deploy/branches-3","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#add-to-an-existing-app","content":"Add to an existing app"},"358":{"id":"/deploy/branches-4","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#install-the-packages","content":"Install the packages"},"359":{"id":"/deploy/branches-5","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#sync-the-sdk-on-install","content":"Sync the SDK on install"},"360":{"id":"/deploy/branches-6","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#register-the-vite-plugin","content":"Register the Vite plugin"},"361":{"id":"/deploy/branches-7","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#install-the-branchs-sdk","content":"Install the branch's SDK"},"362":{"id":"/deploy/branches-8","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#inject-the-branch-with-vite","content":"Inject the branch with Vite"},"363":{"id":"/deploy/branches-9","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#choose-the-branch-in-the-client","content":"Choose the branch in the client"},"364":{"id":"/deploy/branches-10","page_id":"/deploy/branches","type":"heading","tags":[],"url":"/deploy/branches#generate-an-sdk-on-a-branch","content":"Generate an SDK on a branch"},"365":{"id":"/deploy/branches-11","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches","content":"Develop against Ontology changes on a Foundry global branch before they merge, using the SDK versions generated for that branch and sending every request to it. Three pieces work together: `osdk branch sync` installs the branch's SDK, `@osdk/vite-plugin-branch` tells the client which branch you are on, and the client sends that branch with its requests."},"366":{"id":"/deploy/branches-12","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches","content":"Branch support is beta. The client option is named `UNSTABLE_DO_NOT_USE_BRANCH`, and `@osdk/create-app` only sets it up behind `--unstableFeatures`. Names and behavior can change in any release."},"367":{"id":"/deploy/branches-13","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#how-it-works","content":"| Piece                 | What it does                                                                                                                                                                                         |\n| --------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Branched SDK versions | An SDK generated on a branch is published as a prerelease under the npm dist tag `<branch>-latest`. Its `package.json` records the branch RID in `osdk.branch`, and the SDK exports it as `$branch`. |","table":"table-0"},"368":{"id":"/deploy/branches-14","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#how-it-works","content":"| Piece              | What it does                                                                                                                     |\n| ------------------ | -------------------------------------------------------------------------------------------------------------------------------- |\n| `osdk branch sync` | Reads your git branch and installs the matching SDK version: the branch's prerelease on a branch, the stable `latest` on `main`. |","table":"table-0"},"369":{"id":"/deploy/branches-15","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#how-it-works","content":"| Piece                      | What it does                                                                                        |\n| -------------------------- | --------------------------------------------------------------------------------------------------- |\n| `@osdk/vite-plugin-branch` | Injects the current branch into your app's HTML, and reloads the page when you switch git branches. |","table":"table-0"},"370":{"id":"/deploy/branches-16","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#how-it-works","content":"| Piece          | What it does                                                                                                              |\n| -------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `@osdk/client` | Reads the injected branch when you create the client, then reads and writes objects, actions, and queries on that branch. |","table":"table-0"},"371":{"id":"/deploy/branches-17","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#how-it-works","content":"Both the CLI and the plugin take the branch from `git branch --show-current`, so use the same name for your git branch and the Foundry branch you develop against."},"372":{"id":"/deploy/branches-18","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#set-up-a-new-app","content":"Pass `--unstableFeatures` to `@osdk/create-app`:"},"373":{"id":"/deploy/branches-19","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#set-up-a-new-app","content":"For an app with an SDK, this adds three things to the generated project:"},"374":{"id":"/deploy/branches-20","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#set-up-a-new-app","content":"`@osdk/cli` as a dev dependency."},"375":{"id":"/deploy/branches-21","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#set-up-a-new-app","content":"A `postinstall` script that runs `osdk branch sync`, so every install picks the SDK for your branch."},"376":{"id":"/deploy/branches-22","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#set-up-a-new-app","content":"`@osdk/vite-plugin-branch`, registered in `vite.config.ts`, for the Vite templates."},"377":{"id":"/deploy/branches-23","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-packages","content":"Install `@osdk/vite-plugin-branch` at the same version as `@osdk/client`. It supports Vite 6, 7, and 8."},"378":{"id":"/deploy/branches-24","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#register-the-vite-plugin","content":"`branchPlugin()` takes no options."},"379":{"id":"/deploy/branches-25","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"For each dependency in your root `package.json` whose installed `package.json` has an `osdk` block, the command reads the package's npm dist tags and picks a target:"},"380":{"id":"/deploy/branches-26","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"| You are on | Installed SDK | Target                                                                                |\n| ---------- | ------------- | ------------------------------------------------------------------------------------- |\n| A branch   | Any           | The `<branch>-latest` dist tag, if one is published. Otherwise the SDK is left alone. |","table":"table-1"},"381":{"id":"/deploy/branches-27","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"| You are on                             | Installed SDK         | Target                 |\n| -------------------------------------- | --------------------- | ---------------------- |\n| `main`, `master`, or a detached `HEAD` | Generated on a branch | The `latest` dist tag. |","table":"table-1"},"382":{"id":"/deploy/branches-28","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"| You are on                             | Installed SDK     | Target      |\n| -------------------------------------- | ----------------- | ----------- |\n| `main`, `master`, or a detached `HEAD` | Generated on main | Left alone. |","table":"table-1"},"383":{"id":"/deploy/branches-29","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"It installs every SDK whose declared version differs from its target in one `npm install <pkg>@<version> --save-exact`, so your `package.json` pins exact versions. It always runs `npm`, and only looks at `dependencies`, not `devDependencies`."},"384":{"id":"/deploy/branches-30","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"| Option                | Description                                            |\n| --------------------- | ------------------------------------------------------ |\n| `--branchName <name>` | Sync to this branch instead of the current git branch. |","table":"table-2"},"385":{"id":"/deploy/branches-31","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"| Option                 | Description         |\n| ---------------------- | ------------------- |\n| `--packageName <name>` | Sync only this SDK. |","table":"table-2"},"386":{"id":"/deploy/branches-32","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"| Option     | Description                                                     |\n| ---------- | --------------------------------------------------------------- |\n| `--dryRun` | Print `Would install <pkg>@<version>` lines without installing. |","table":"table-2"},"387":{"id":"/deploy/branches-33","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#install-the-branchs-sdk","content":"The command reads dist tags from your registry, so it needs the same `.npmrc` and `FOUNDRY_TOKEN` as a normal install. A `401` from the registry fails with `Not authorized to read <pkg>`. See Installation."},"388":{"id":"/deploy/branches-34","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"`branchPlugin()` adds a meta tag to the `<head>` of your HTML:"},"389":{"id":"/deploy/branches-35","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"It decides the value in this order:"},"390":{"id":"/deploy/branches-36","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"| Condition                                                       | Value       |\n| --------------------------------------------------------------- | ----------- |\n| `FOUNDRY_BRANCH_RID` is set in the environment or a `.env` file | That value. |","table":"table-3"},"391":{"id":"/deploy/branches-37","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"| Condition                            | Value                                  |\n| ------------------------------------ | -------------------------------------- |\n| The git branch is `main` or `master` | Empty, which means the default branch. |","table":"table-3"},"392":{"id":"/deploy/branches-38","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"| Condition            | Value            |\n| -------------------- | ---------------- |\n| Any other git branch | The branch name. |","table":"table-3"},"393":{"id":"/deploy/branches-39","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"| Condition                                                              | Value                                                                                      |\n| ---------------------------------------------------------------------- | ------------------------------------------------------------------------------------------ |\n| No branch: detached `HEAD`, or not a git repository, during `vite dev` | `ri.branch..branch.unknown`. Requests fail instead of silently reading the default branch. |","table":"table-3"},"394":{"id":"/deploy/branches-40","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"| Condition                     | Value                                  |\n| ----------------------------- | -------------------------------------- |\n| No branch during `vite build` | Empty, which means the default branch. |","table":"table-3"},"395":{"id":"/deploy/branches-41","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"`FOUNDRY_BRANCH_RID` has no `VITE_` prefix, so Vite does not expose it to your client code. Use it to pin a branch RID, or to build for a branch in CI where HEAD is detached:"},"396":{"id":"/deploy/branches-42","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"The dev server logs the branch it uses, such as `Using Foundry branch \"my-feature\".` While it runs, it checks the git branch every second and reloads open pages when it changes, so you do not restart the server. Reloading needs HMR, which is on by default."},"397":{"id":"/deploy/branches-43","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#inject-the-branch-with-vite","content":"A production build fixes the branch at build time. Rebuild to deploy for another branch."},"398":{"id":"/deploy/branches-44","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"`createClient` resolves the branch once, when you create the client:"},"399":{"id":"/deploy/branches-45","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"The `UNSTABLE_DO_NOT_USE_BRANCH` option, when you pass it. `null` forces the default branch."},"400":{"id":"/deploy/branches-46","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"The `foundryBranchRid` query parameter in the page URL, such as `?foundryBranchRid=ri.branch..branch.<id>`. This lets a page that embeds your app in an iframe choose the branch."},"401":{"id":"/deploy/branches-47","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"The `osdk-foundry-branch-rid` meta tag from the Vite plugin."},"402":{"id":"/deploy/branches-48","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"Blank values count as unset. Outside a browser, only the option applies."},"403":{"id":"/deploy/branches-49","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"| Option                       | Type             | Default     | Description                                                                                                                                    |\n| ---------------------------- | ---------------- | ----------- | ---------------------------------------------------------------------------------------------------------------------------------------------- |\n| `UNSTABLE_DO_NOT_USE_BRANCH` | `string \\| null` | `undefined` | Beta. The branch for every request. `undefined` reads the query parameter, then the meta tag. `null` ignores both and uses the default branch. |","table":"table-4"},"404":{"id":"/deploy/branches-50","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"To pin a client to the branch your SDK was generated on, pass the SDK's `$branch` export. It is `undefined` for SDKs generated on main, which keeps the default lookup:"},"405":{"id":"/deploy/branches-51","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#choose-the-branch-in-the-client","content":"In Node.js scripts there is no meta tag, so pass the branch explicitly:"},"406":{"id":"/deploy/branches-52","page_id":"/deploy/branches","tags":[],"type":"text","url":"/deploy/branches#generate-an-sdk-on-a-branch","content":"To generate SDK files locally from a branch's Ontology, pass the branch RID to `osdk unstable typescript generate --branch`. See Generate an SDK."},"407":{"id":"/deploy/cli","page_id":"/deploy/cli","type":"page","content":"CLI reference","breadcrumbs":["OSDK TypeScript","Guides","Deploy"],"tags":[],"url":"/deploy/cli"},"408":{"id":"/deploy/cli-0","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli","content":"Every @osdk/cli command and flag for deploying sites and widget sets, managing versions, syncing branched SDKs, and generating SDKs locally."},"409":{"id":"/deploy/cli-1","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#run-the-cli","content":"Run the CLI"},"410":{"id":"/deploy/cli-2","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#global-options","content":"Global options"},"411":{"id":"/deploy/cli-3","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#configuration","content":"Configuration"},"412":{"id":"/deploy/cli-4","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#tokens","content":"Tokens"},"413":{"id":"/deploy/cli-5","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-site","content":"`osdk site`"},"414":{"id":"/deploy/cli-6","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-site-deploy","content":"`osdk site deploy`"},"415":{"id":"/deploy/cli-7","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-site-version","content":"`osdk site version`"},"416":{"id":"/deploy/cli-8","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#site-errors","content":"Site errors"},"417":{"id":"/deploy/cli-9","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-widgetset","content":"`osdk widgetset`"},"418":{"id":"/deploy/cli-10","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-widgetset-deploy","content":"`osdk widgetset deploy`"},"419":{"id":"/deploy/cli-11","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-widgetset-version","content":"`osdk widgetset version`"},"420":{"id":"/deploy/cli-12","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-branch-sync","content":"`osdk branch sync`"},"421":{"id":"/deploy/cli-13","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-unstable-typescript-generate","content":"`osdk unstable typescript generate`"},"422":{"id":"/deploy/cli-14","page_id":"/deploy/cli","type":"heading","tags":[],"url":"/deploy/cli#osdk-unstable-auth-login","content":"`osdk unstable auth login`"},"423":{"id":"/deploy/cli-15","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli","content":"`@osdk/cli` deploys your app to Foundry website hosting, manages its versions, publishes widget sets, keeps branched SDKs in sync, and generates SDKs from an Ontology. This page lists every command and flag."},"424":{"id":"/deploy/cli-16","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"Run it with `npx`, or install it as a dev dependency to get the `osdk` binary:"},"425":{"id":"/deploy/cli-17","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command            | Description                                                      |\n| ------------------ | ---------------------------------------------------------------- |\n| `osdk site deploy` | Upload a new version of your site and, by default, make it live. |","table":"table-0"},"426":{"id":"/deploy/cli-18","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command             | Description                                      |\n| ------------------- | ------------------------------------------------ |\n| `osdk site version` | List, get, set, unset, and delete site versions. |","table":"table-0"},"427":{"id":"/deploy/cli-19","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command                 | Description                       |\n| ----------------------- | --------------------------------- |\n| `osdk widgetset deploy` | Publish a new widget set version. |","table":"table-0"},"428":{"id":"/deploy/cli-20","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command                  | Description                                    |\n| ------------------------ | ---------------------------------------------- |\n| `osdk widgetset version` | List, inspect, and delete widget set versions. |","table":"table-0"},"429":{"id":"/deploy/cli-21","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command            | Description                                                 |\n| ------------------ | ----------------------------------------------------------- |\n| `osdk branch sync` | Install the SDK versions published for your current branch. |","table":"table-0"},"430":{"id":"/deploy/cli-22","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command                             | Description                                           |\n| ----------------------------------- | ----------------------------------------------------- |\n| `osdk unstable typescript generate` | Generate SDK source files from an Ontology. Unstable. |","table":"table-0"},"431":{"id":"/deploy/cli-23","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"| Command                    | Description                                        |\n| -------------------------- | -------------------------------------------------- |\n| `osdk unstable auth login` | Test an OAuth sign-in from the terminal. Unstable. |","table":"table-0"},"432":{"id":"/deploy/cli-24","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#run-the-cli","content":"`osdk experimental` is an alias for `osdk unstable`. Commands under it can change or be removed in any release."},"433":{"id":"/deploy/cli-25","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#global-options","content":"| Option            | Type  | Description                                                                     |\n| ----------------- | ----- | ------------------------------------------------------------------------------- |\n| `--verbose`, `-v` | count | Debug logging. Pass `-vv` for trace logging, which includes every HTTP request. |","table":"table-1"},"434":{"id":"/deploy/cli-26","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#global-options","content":"| Option   | Type    | Description                                                                                 |\n| -------- | ------- | ------------------------------------------------------------------------------------------- |\n| `--help` | boolean | Print the commands and options available at that level, such as `osdk site version --help`. |","table":"table-1"},"435":{"id":"/deploy/cli-27","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#global-options","content":"Each option also accepts its kebab-case form: `--foundryUrl` and `--foundry-url` are the same option."},"436":{"id":"/deploy/cli-28","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#configuration","content":"Options come from three places. The first one set wins:"},"437":{"id":"/deploy/cli-29","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#configuration","content":"The command-line flag."},"438":{"id":"/deploy/cli-30","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#configuration","content":"An environment variable named `OSDK_` plus the option in upper snake case, such as `OSDK_FOUNDRY_URL`, `OSDK_APPLICATION`, or `OSDK_DIRECTORY`."},"439":{"id":"/deploy/cli-31","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#configuration","content":"`foundry.config.json`, for the options it covers."},"440":{"id":"/deploy/cli-32","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#configuration","content":"The CLI looks for `foundry.config.json` in the current directory and then each parent, and uses the first one it finds. A file holds either a `site` block or a `widgetSet` block, not both. The full schema is in Host on Foundry."},"441":{"id":"/deploy/cli-33","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#tokens","content":"Every `site` and `widgetset` command needs a Foundry token. The CLI uses the first of:"},"442":{"id":"/deploy/cli-34","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#tokens","content":"`--token <token>`"},"443":{"id":"/deploy/cli-35","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#tokens","content":"`--tokenFile <path>`, a file whose contents are the token"},"444":{"id":"/deploy/cli-36","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#tokens","content":"The `FOUNDRY_TOKEN` environment variable"},"445":{"id":"/deploy/cli-37","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#tokens","content":"The `FOUNDRY_SDK_AUTH_TOKEN` environment variable, which is deprecated and logs a warning"},"446":{"id":"/deploy/cli-38","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#tokens","content":"`--token` and `--tokenFile` cannot be used together. The token must be a JWT. Without one, the command exits with `No token found.`"},"447":{"id":"/deploy/cli-39","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site","content":"Manages the website hosted for a Developer Console application. Run it with a subcommand: `deploy` or `version`."},"448":{"id":"/deploy/cli-40","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site","content":"These options apply to every `site` subcommand:"},"449":{"id":"/deploy/cli-41","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site","content":"| Option          | Type     | Default            | Description                                                                                 |\n| --------------- | -------- | ------------------ | ------------------------------------------------------------------------------------------- |\n| `--application` | `string` | `site.application` | The application RID, such as `ri.third-party-applications.main.application.<id>`. Required. |","table":"table-2"},"450":{"id":"/deploy/cli-42","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site","content":"| Option         | Type     | Default      | Description                                                  |\n| -------------- | -------- | ------------ | ------------------------------------------------------------ |\n| `--foundryUrl` | `string` | `foundryUrl` | The Foundry stack URL. Must start with `https://`. Required. |","table":"table-2"},"451":{"id":"/deploy/cli-43","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site","content":"| Option    | Type     | Default | Description                                    |\n| --------- | -------- | ------- | ---------------------------------------------- |\n| `--token` | `string` |         | A Foundry token. Conflicts with `--tokenFile`. |","table":"table-2"},"452":{"id":"/deploy/cli-44","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site","content":"| Option        | Type     | Default | Description                                                            |\n| ------------- | -------- | ------- | ---------------------------------------------------------------------- |\n| `--tokenFile` | `string` |         | A path to a file containing a Foundry token. Conflicts with `--token`. |","table":"table-2"},"453":{"id":"/deploy/cli-45","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"Zips the contents of a directory, uploads it as a new site version, and makes that version live."},"454":{"id":"/deploy/cli-46","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option        | Type     | Default          | Description                                                                                                                      |\n| ------------- | -------- | ---------------- | -------------------------------------------------------------------------------------------------------------------------------- |\n| `--directory` | `string` | `site.directory` | The directory to upload, usually your build output. Required. Everything in it is zipped, with the directory itself as the root. |","table":"table-3"},"455":{"id":"/deploy/cli-47","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option      | Type     | Default | Description                                                                                                                                               |\n| ----------- | -------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--version` | `string` |         | The version to create. Must be valid SemVer. Conflicts with `--autoVersion`; when `site.autoVersion` is set in the config file, `--version` overrides it. |","table":"table-3"},"456":{"id":"/deploy/cli-48","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option          | Type                               | Default                 | Description                                                                 |\n| --------------- | ---------------------------------- | ----------------------- | --------------------------------------------------------------------------- |\n| `--autoVersion` | `\"git-describe\" \\| \"package-json\"` | `site.autoVersion.type` | Compute the version instead of passing `--version`. See Automatic versions. |","table":"table-3"},"457":{"id":"/deploy/cli-49","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option           | Type     | Default                      | Description                                                                                                                                                                                   |\n| ---------------- | -------- | ---------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--gitTagPrefix` | `string` | `site.autoVersion.tagPrefix` | With `git-describe`, match only tags that start with this prefix, and strip it from the version. Without it, every tag matches and a leading `v` is stripped. Only valid with `git-describe`. |","table":"table-3"},"458":{"id":"/deploy/cli-50","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option         | Type      | Default                         | Description                                                                       |\n| -------------- | --------- | ------------------------------- | --------------------------------------------------------------------------------- |\n| `--uploadOnly` | `boolean` | `site.uploadOnly`, else `false` | Upload the version without making it live. The CLI prints a preview link instead. |","table":"table-3"},"459":{"id":"/deploy/cli-51","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option       | Type      | Default | Description                                                                                                                      |\n| ------------ | --------- | ------- | -------------------------------------------------------------------------------------------------------------------------------- |\n| `--snapshot` | `boolean` | `false` | Upload a snapshot version with automatic retention. The CLI never makes a snapshot live. Cannot be combined with `--uploadOnly`. |","table":"table-3"},"460":{"id":"/deploy/cli-52","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"| Option         | Type     | Default | Description                                                        |\n| -------------- | -------- | ------- | ------------------------------------------------------------------ |\n| `--snapshotId` | `string` |         | An alias to attach to the snapshot version. Requires `--snapshot`. |","table":"table-3"},"461":{"id":"/deploy/cli-53","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-deploy","content":"You must pass `--version` or `--autoVersion`, or set `site.autoVersion` in `foundry.config.json`. When the deploy succeeds, the CLI prints the live URL, `https://<subdomain>`. With `--uploadOnly`, it prints `https://<subdomain>/.system/preview?previewVersion=<version>` instead."},"462":{"id":"/deploy/cli-54","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"Manages existing versions. Run it with a subcommand."},"463":{"id":"/deploy/cli-55","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"| Command                  | Description                                                                                  |\n| ------------------------ | -------------------------------------------------------------------------------------------- |\n| `osdk site version list` | Lists every version that is valid SemVer, newest first, and marks the live one `(deployed)`. |","table":"table-4"},"464":{"id":"/deploy/cli-56","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"| Command                 | Description                                             |\n| ----------------------- | ------------------------------------------------------- |\n| `osdk site version get` | Prints the live version, or `No live site version set`. |","table":"table-4"},"465":{"id":"/deploy/cli-57","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"| Command                           | Description                                                                                       |\n| --------------------------------- | ------------------------------------------------------------------------------------------------- |\n| `osdk site version set <version>` | Makes `<version>` live. Use it to roll back or to publish a version uploaded with `--uploadOnly`. |","table":"table-4"},"466":{"id":"/deploy/cli-58","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"| Command                   | Description                                                                                                 |\n| ------------------------- | ----------------------------------------------------------------------------------------------------------- |\n| `osdk site version unset` | Clears the live version after a confirmation prompt. The site is unreachable until you set a version again. |","table":"table-4"},"467":{"id":"/deploy/cli-59","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"| Command                              | Description                                                                                                       |\n| ------------------------------------ | ----------------------------------------------------------------------------------------------------------------- |\n| `osdk site version delete <version>` | Deletes a version after a confirmation prompt. You cannot delete the live version, and deletion cannot be undone. |","table":"table-4"},"468":{"id":"/deploy/cli-60","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-site-version","content":"| Option        | Applies to        | Type      | Description                   |\n| ------------- | ----------------- | --------- | ----------------------------- |\n| `--yes`, `-y` | `unset`, `delete` | `boolean` | Skip the confirmation prompt. |","table":"table-5"},"469":{"id":"/deploy/cli-61","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"The CLI turns Foundry errors into these messages:"},"470":{"id":"/deploy/cli-62","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                           | Cause                                           | What to do                                 |\n| --------------------------------- | ----------------------------------------------- | ------------------------------------------ |\n| `The site version already exists` | A version with that number was uploaded before. | Use a new version. Versions are immutable. |","table":"table-6"},"471":{"id":"/deploy/cli-63","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                                                         | Cause                      | What to do                                                                        |\n| --------------------------------------------------------------- | -------------------------- | --------------------------------------------------------------------------------- |\n| `The site version is invalid and must be a valid SemVer string` | The version is not SemVer. | Fix `--version`, or the tag or `package.json` version that `--autoVersion` reads. |","table":"table-6"},"472":{"id":"/deploy/cli-64","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                               | Cause                                                            | What to do                                           |\n| ------------------------------------- | ---------------------------------------------------------------- | ---------------------------------------------------- |\n| `The site contains too many versions` | The application reached its version limit, shown in the message. | Delete old versions with `osdk site version delete`. |","table":"table-6"},"473":{"id":"/deploy/cli-65","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                                 | Cause                                           | What to do                               |\n| --------------------------------------- | ----------------------------------------------- | ---------------------------------------- |\n| `The .zip file contains too many files` | The build output has more files than the limit. | Reduce the number of files in the build. |","table":"table-6"},"474":{"id":"/deploy/cli-66","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                                               | Cause                            | What to do                 |\n| ----------------------------------------------------- | -------------------------------- | -------------------------- |\n| `The .zip file contains a file ... that is too large` | One file exceeds the size limit. | Shrink or split that file. |","table":"table-6"},"475":{"id":"/deploy/cli-67","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                                                                               | Cause                                 | What to do                                                                                                                                            |\n| ------------------------------------------------------------------------------------- | ------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `The website version is being scanned for vulnerabilities and cannot be deployed yet` | Foundry is still scanning the upload. | Deploy with `--uploadOnly`, then make the version live after the scan, with `osdk site version set` or from **Website hosting** in Developer Console. |","table":"table-6"},"476":{"id":"/deploy/cli-68","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                                                    | Cause                                 | What to do                      |\n| ---------------------------------------------------------- | ------------------------------------- | ------------------------------- |\n| `The site version to delete is live and cannot be deleted` | You tried to delete the live version. | Set another version live first. |","table":"table-6"},"477":{"id":"/deploy/cli-69","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"| Message                               | Cause                       | What to do                      |\n| ------------------------------------- | --------------------------- | ------------------------------- |\n| `The site version could not be found` | The version does not exist. | Check `osdk site version list`. |","table":"table-6"},"478":{"id":"/deploy/cli-70","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#site-errors","content":"A `401` means the token is invalid or expired; a `403` means it lacks the permission or scopes for the request."},"479":{"id":"/deploy/cli-71","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset","content":"Publishes and manages widget sets for Workshop custom widgets. Run it with a subcommand: `deploy` or `version`. Publish a widget set covers the build and the manifest."},"480":{"id":"/deploy/cli-72","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset","content":"These options apply to every `widgetset` subcommand:"},"481":{"id":"/deploy/cli-73","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset","content":"| Option        | Type     | Default         | Description                   |\n| ------------- | -------- | --------------- | ----------------------------- |\n| `--widgetSet` | `string` | `widgetSet.rid` | The widget set RID. Required. |","table":"table-7"},"482":{"id":"/deploy/cli-74","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset","content":"| Option         | Type     | Default      | Description                                                  |\n| -------------- | -------- | ------------ | ------------------------------------------------------------ |\n| `--foundryUrl` | `string` | `foundryUrl` | The Foundry stack URL. Must start with `https://`. Required. |","table":"table-7"},"483":{"id":"/deploy/cli-75","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset","content":"| Option    | Type     | Default | Description                                    |\n| --------- | -------- | ------- | ---------------------------------------------- |\n| `--token` | `string` |         | A Foundry token. Conflicts with `--tokenFile`. |","table":"table-7"},"484":{"id":"/deploy/cli-76","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset","content":"| Option        | Type     | Default | Description                                                            |\n| ------------- | -------- | ------- | ---------------------------------------------------------------------- |\n| `--tokenFile` | `string` |         | A path to a file containing a Foundry token. Conflicts with `--token`. |","table":"table-7"},"485":{"id":"/deploy/cli-77","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-deploy","content":"Zips a directory and publishes it as a new widget set version. The version comes from the manifest at `.palantir/widgets.config.json` inside the directory; there is no version flag."},"486":{"id":"/deploy/cli-78","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-deploy","content":"| Option        | Type     | Default               | Description                        |\n| ------------- | -------- | --------------------- | ---------------------------------- |\n| `--directory` | `string` | `widgetSet.directory` | The directory to upload. Required. |","table":"table-8"},"487":{"id":"/deploy/cli-79","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-deploy","content":"| Option         | Type     | Default                | Description                                                                                            |\n| -------------- | -------- | ---------------------- | ------------------------------------------------------------------------------------------------------ |\n| `--repository` | `string` | `widgetSet.repository` | A code repository RID to publish through. The repository must be authorized to publish the widget set. |","table":"table-8"},"488":{"id":"/deploy/cli-80","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-deploy","content":"| Option         | Type     | Default                | Description                     |\n| -------------- | -------- | ---------------------- | ------------------------------- |\n| `--branchName` | `string` | The current git branch | The git branch to publish from. |","table":"table-8"},"489":{"id":"/deploy/cli-81","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-version","content":"| Command                       | Description                                                                  |\n| ----------------------------- | ---------------------------------------------------------------------------- |\n| `osdk widgetset version list` | Lists published versions for the current git branch. Accepts `--branchName`. |","table":"table-9"},"490":{"id":"/deploy/cli-82","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-version","content":"| Command                                 | Description                        |\n| --------------------------------------- | ---------------------------------- |\n| `osdk widgetset version info <version>` | Prints the details of one version. |","table":"table-9"},"491":{"id":"/deploy/cli-83","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-widgetset-version","content":"| Command                                   | Description                                                                      |\n| ----------------------------------------- | -------------------------------------------------------------------------------- |\n| `osdk widgetset version delete <version>` | Deletes a version after a confirmation prompt. `--yes` or `-y` skips the prompt. |","table":"table-9"},"492":{"id":"/deploy/cli-84","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-branch-sync","content":"Installs the version of each generated SDK that matches your current branch: the newest prerelease published for that branch, or the stable `latest` release when you are on `main`. Develop on Foundry branches explains the workflow."},"493":{"id":"/deploy/cli-85","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-branch-sync","content":"| Option         | Type     | Default                | Description                                                                             |\n| -------------- | -------- | ---------------------- | --------------------------------------------------------------------------------------- |\n| `--branchName` | `string` | The current git branch | The branch to sync to. `main`, `master`, and a detached `HEAD` mean the default branch. |","table":"table-10"},"494":{"id":"/deploy/cli-86","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-branch-sync","content":"| Option          | Type     | Default | Description                                    |\n| --------------- | -------- | ------- | ---------------------------------------------- |\n| `--packageName` | `string` |         | Sync only this SDK instead of every SDK found. |","table":"table-10"},"495":{"id":"/deploy/cli-87","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-branch-sync","content":"| Option     | Type      | Default | Description                                              |\n| ---------- | --------- | ------- | -------------------------------------------------------- |\n| `--dryRun` | `boolean` | `false` | Print what would be installed without changing anything. |","table":"table-10"},"496":{"id":"/deploy/cli-88","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-branch-sync","content":"`osdk unstable branch sync` is the same command under its earlier name."},"497":{"id":"/deploy/cli-89","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"Generates SDK source files from an Ontology, either by signing in to Foundry or from a saved Ontology metadata file. Generate an SDK shows when to use it."},"498":{"id":"/deploy/cli-90","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option     | Type     | Default | Description                                   |\n| ---------- | -------- | ------- | --------------------------------------------- |\n| `--outDir` | `string` |         | Where to write the generated files. Required. |","table":"table-11"},"499":{"id":"/deploy/cli-91","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option      | Type     | Default | Description                                                                                                                              |\n| ----------- | -------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------------- |\n| `--version` | `string` |         | The SDK version: `dev` or a SemVer string. Sent in the request user agent, and used as the package version with `--asPackage`. Required. |","table":"table-11"},"500":{"id":"/deploy/cli-92","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option         | Type     | Default | Description                                                                 |\n| -------------- | -------- | ------- | --------------------------------------------------------------------------- |\n| `--foundryUrl` | `string` |         | Load the Ontology from this stack. Requires `--clientId`. Alias: `--stack`. |","table":"table-11"},"501":{"id":"/deploy/cli-93","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option       | Type     | Default | Description                                                   |\n| ------------ | -------- | ------- | ------------------------------------------------------------- |\n| `--clientId` | `string` |         | The OAuth client ID to sign in with. Requires `--foundryUrl`. |","table":"table-11"},"502":{"id":"/deploy/cli-94","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option          | Type     | Default | Description                                                                           |\n| --------------- | -------- | ------- | ------------------------------------------------------------------------------------- |\n| `--ontologyRid` | `string` |         | With `--foundryUrl`, use this Ontology. Needed when the client can see more than one. |","table":"table-11"},"503":{"id":"/deploy/cli-95","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option     | Type     | Default | Description                                                            |\n| ---------- | -------- | ------- | ---------------------------------------------------------------------- |\n| `--branch` | `string` |         | With `--foundryUrl`, the Foundry branch RID to load the Ontology from. |","table":"table-11"},"504":{"id":"/deploy/cli-96","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option                | Type     | Default | Description                                                                       |\n| --------------------- | -------- | ------- | --------------------------------------------------------------------------------- |\n| `--ontologyWritePath` | `string` |         | With `--foundryUrl`, also save the loaded Ontology metadata as JSON at this path. |","table":"table-11"},"505":{"id":"/deploy/cli-97","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option           | Type     | Default | Description                                                                                                      |\n| ---------------- | -------- | ------- | ---------------------------------------------------------------------------------------------------------------- |\n| `--ontologyPath` | `string` |         | Generate from an Ontology metadata JSON file instead of Foundry. Conflicts with `--foundryUrl` and `--clientId`. |","table":"table-11"},"506":{"id":"/deploy/cli-98","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option          | Type                     | Default      | Description                                         |\n| --------------- | ------------------------ | ------------ | --------------------------------------------------- |\n| `--packageType` | `\"commonjs\" \\| \"module\"` | `\"commonjs\"` | The module format of the project you generate into. |","table":"table-11"},"507":{"id":"/deploy/cli-99","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option    | Type      | Default | Description                          |\n| --------- | --------- | ------- | ------------------------------------ |\n| `--clean` | `boolean` |         | Delete `--outDir` before generating. |","table":"table-11"},"508":{"id":"/deploy/cli-100","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option                    | Type      | Default | Description                                                              |\n| ------------------------- | --------- | ------- | ------------------------------------------------------------------------ |\n| `--skipPackageJsonUpdate` | `boolean` | `false` | Do not add `@osdk/api` and `@osdk/client` to the nearest `package.json`. |","table":"table-11"},"509":{"id":"/deploy/cli-101","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option              | Type     | Default | Description                                                                                                                             |\n| ------------------- | -------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------- |\n| `--externalObjects` | `string` |         | Import these object types from another generated SDK instead of generating them, as `ApiName:@scope/package` pairs separated by commas. |","table":"table-11"},"510":{"id":"/deploy/cli-102","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option                 | Type     | Default | Description               |\n| ---------------------- | -------- | ------- | ------------------------- |\n| `--externalInterfaces` | `string` |         | The same, for interfaces. |","table":"table-11"},"511":{"id":"/deploy/cli-103","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option                           | Type      | Default | Description                                                                                                    |\n| -------------------------------- | --------- | ------- | -------------------------------------------------------------------------------------------------------------- |\n| `--experimentalOntologyMetadata` | `boolean` | `false` | Also emit the raw Ontology metadata as an `./experimental/ontology-metadata` export. May change or be removed. |","table":"table-11"},"512":{"id":"/deploy/cli-104","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option        | Type      | Default | Description                                                                                       |\n| ------------- | --------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `--asPackage` | `boolean` |         | Generate a standalone package with its own `package.json`. Requires `--packageName` and `--beta`. |","table":"table-11"},"513":{"id":"/deploy/cli-105","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option          | Type     | Default | Description                                |\n| --------------- | -------- | ------- | ------------------------------------------ |\n| `--packageName` | `string` |         | The package name when using `--asPackage`. |","table":"table-11"},"514":{"id":"/deploy/cli-106","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option   | Type      | Default | Description                  |\n| -------- | --------- | ------- | ---------------------------- |\n| `--beta` | `boolean` |         | Required with `--asPackage`. |","table":"table-11"},"515":{"id":"/deploy/cli-107","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"| Option       | Type      | Default | Description                                                                 |\n| ------------ | --------- | ------- | --------------------------------------------------------------------------- |\n| `--internal` | `boolean` | `false` | For the `osdk-ts` repository only. Writes `workspace:` dependency versions. |","table":"table-11"},"516":{"id":"/deploy/cli-108","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-typescript-generate","content":"Pass either `--ontologyPath`, or `--foundryUrl` and `--clientId`."},"517":{"id":"/deploy/cli-109","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-auth-login","content":"Runs the OAuth authorization code flow in your browser, to check that a client ID and redirect URL work. It does not save or print the token."},"518":{"id":"/deploy/cli-110","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-auth-login","content":"| Option         | Type     | Description                                          |\n| -------------- | -------- | ---------------------------------------------------- |\n| `--foundryUrl` | `string` | The Foundry stack URL. Required. Alias: `--baseUrl`. |","table":"table-12"},"519":{"id":"/deploy/cli-111","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-auth-login","content":"| Option       | Type     | Description                                              |\n| ------------ | -------- | -------------------------------------------------------- |\n| `--clientId` | `string` | The OAuth client ID. Required. Alias: `--applicationId`. |","table":"table-12"},"520":{"id":"/deploy/cli-112","page_id":"/deploy/cli","tags":[],"type":"text","url":"/deploy/cli#osdk-unstable-auth-login","content":"The CLI listens on port 8080 and uses `http://localhost:8080/auth/callback` as the redirect URL, so that URL must be allowed on **OAuth & scopes** in Developer Console and port 8080 must be free. It requests the `offline_access`, `api:read-data`, and `api:use-ontologies-read` scopes. `osdk unstable typescript generate --foundryUrl` uses the same sign-in."},"521":{"id":"/deploy/generate-sdk","page_id":"/deploy/generate-sdk","type":"page","content":"Generate an SDK","breadcrumbs":["OSDK TypeScript","Guides","Deploy"],"tags":[],"url":"/deploy/generate-sdk"},"522":{"id":"/deploy/generate-sdk-0","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk","content":"Generate your Ontology SDK in Developer Console or locally with osdk unstable typescript generate or @osdk/foundry-sdk-generator, and update it when the Ontology changes."},"523":{"id":"/deploy/generate-sdk-1","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#choose-a-method","content":"Choose a method"},"524":{"id":"/deploy/generate-sdk-2","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#generate-in-developer-console","content":"Generate in Developer Console"},"525":{"id":"/deploy/generate-sdk-3","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#choose-the-resources","content":"Choose the resources"},"526":{"id":"/deploy/generate-sdk-4","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#generate-a-version","content":"Generate a version"},"527":{"id":"/deploy/generate-sdk-5","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#install-it","content":"Install it"},"528":{"id":"/deploy/generate-sdk-6","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#what-the-package-exports","content":"What the package exports"},"529":{"id":"/deploy/generate-sdk-7","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#update-the-sdk-when-the-ontology-changes","content":"Update the SDK when the Ontology changes"},"530":{"id":"/deploy/generate-sdk-8","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#generate-locally","content":"Generate locally"},"531":{"id":"/deploy/generate-sdk-9","page_id":"/deploy/generate-sdk","type":"heading","tags":[],"url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"Build a package with `@osdk/foundry-sdk-generator`"},"532":{"id":"/deploy/generate-sdk-10","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk","content":"Your generated SDK holds typed definitions for the object types, links, actions, functions, and interfaces your app uses. Generate it in Developer Console and install it from your Foundry npm registry, or generate it yourself from the command line."},"533":{"id":"/deploy/generate-sdk-11","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#choose-a-method","content":"| Method            | Output                                            | Use it when                                            |\n| ----------------- | ------------------------------------------------- | ------------------------------------------------------ |\n| Developer Console | A versioned npm package in your Foundry registry. | Almost always. Apps from `@osdk/create-app` expect it. |","table":"table-0"},"534":{"id":"/deploy/generate-sdk-12","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#choose-a-method","content":"| Method                              | Output                                               | Use it when                                                                          |\n| ----------------------------------- | ---------------------------------------------------- | ------------------------------------------------------------------------------------ |\n| `osdk unstable typescript generate` | TypeScript source files in a folder of your project. | You want the SDK in your repository, or you work offline from a saved Ontology file. |","table":"table-0"},"535":{"id":"/deploy/generate-sdk-13","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#choose-a-method","content":"| Method                        | Output                                                 | Use it when                                      |\n| ----------------------------- | ------------------------------------------------------ | ------------------------------------------------ |\n| `@osdk/foundry-sdk-generator` | A built npm package directory you can pack or publish. | You publish SDK packages from your own pipeline. |","table":"table-0"},"536":{"id":"/deploy/generate-sdk-14","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#choose-the-resources","content":"In your application in Developer Console, add the object types, link types, actions, functions, and interfaces your app uses to the application's SDK. Only those resources are generated."},"537":{"id":"/deploy/generate-sdk-15","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-a-version","content":"On **SDK versions**, generate a new version with the **npm** package type and the latest generator. The install instructions show the package name, such as `@my-app/sdk`, and your registry URL."},"538":{"id":"/deploy/generate-sdk-16","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#install-it","content":"Point your SDK's npm scope at the Foundry registry in `.npmrc`, then install:"},"539":{"id":"/deploy/generate-sdk-17","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#install-it","content":"Installation covers the `.npmrc` lines, the token, and the other packages you need."},"540":{"id":"/deploy/generate-sdk-18","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#what-the-package-exports","content":"| Export                           | Description                          |\n| -------------------------------- | ------------------------------------ |\n| Object types, such as `Employee` | Pass to `client(Employee)` to query. |","table":"table-1"},"541":{"id":"/deploy/generate-sdk-19","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#what-the-package-exports","content":"| Export                            | Description                                        |\n| --------------------------------- | -------------------------------------------------- |\n| Actions, such as `modifyEmployee` | Pass to `client(modifyEmployee).applyAction(...)`. |","table":"table-1"},"542":{"id":"/deploy/generate-sdk-20","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#what-the-package-exports","content":"| Export                   | Description                         |\n| ------------------------ | ----------------------------------- |\n| Functions and interfaces | Pass to `client(...)` the same way. |","table":"table-1"},"543":{"id":"/deploy/generate-sdk-21","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#what-the-package-exports","content":"| Export         | Description                           |\n| -------------- | ------------------------------------- |\n| `$ontologyRid` | The Ontology RID, for `createClient`. |","table":"table-1"},"544":{"id":"/deploy/generate-sdk-22","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#what-the-package-exports","content":"| Export    | Description                                                                                                |\n| --------- | ---------------------------------------------------------------------------------------------------------- |\n| `$branch` | The Foundry branch RID the SDK was generated on, or `undefined` for main. See Develop on Foundry branches. |","table":"table-1"},"545":{"id":"/deploy/generate-sdk-23","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#update-the-sdk-when-the-ontology-changes","content":"The SDK is a snapshot of the Ontology when you generated it. When you add a resource to the SDK, or a property, parameter, or link you use changes:"},"546":{"id":"/deploy/generate-sdk-24","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#update-the-sdk-when-the-ontology-changes","content":"Generate a new version in Developer Console."},"547":{"id":"/deploy/generate-sdk-25","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#update-the-sdk-when-the-ontology-changes","content":"Install it:"},"548":{"id":"/deploy/generate-sdk-26","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#update-the-sdk-when-the-ontology-changes","content":"Run your type checker. Renamed or removed properties and parameters show up as type errors where your code uses them."},"549":{"id":"/deploy/generate-sdk-27","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#update-the-sdk-when-the-ontology-changes","content":"The SDK has a peer dependency on the `@osdk/client` version that generated it. If npm reports a peer conflict, align `@osdk/client`, `@osdk/api`, and `@osdk/react` as described in Version compatibility. On a Foundry branch, `osdk branch sync` picks the branch's SDK version instead of `latest`."},"550":{"id":"/deploy/generate-sdk-28","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"`osdk unstable typescript generate` from `@osdk/cli` writes the SDK as TypeScript source files into your project. It is unstable: flags and output can change in any release."},"551":{"id":"/deploy/generate-sdk-29","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"The CLI opens your browser to sign in, with `http://localhost:8080/auth/callback` as the redirect URL, so allow that URL on **OAuth & scopes** and keep port 8080 free. It generates every object type, action, function, and interface the client can see in the Ontology, except functions that return Ontology edits. If the client can see more than one Ontology, pass `--ontologyRid`. Pass `--branch <branch RID>` to read a branch's Ontology."},"552":{"id":"/deploy/generate-sdk-30","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"`--ontologyWritePath` saves the loaded metadata so you can regenerate later without signing in."},"553":{"id":"/deploy/generate-sdk-31","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"`--ontologyPath` takes an Ontology metadata file written by `--ontologyWritePath`."},"554":{"id":"/deploy/generate-sdk-32","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"Import from the generated folder instead of a package:"},"555":{"id":"/deploy/generate-sdk-33","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"Unless you pass `--skipPackageJsonUpdate`, the command also edits the nearest `package.json` above `--outDir`: it adds `@osdk/api` and `@osdk/client` as peer dependencies and `@osdk/api` as a dev dependency, and sets any existing `@osdk/api` and `@osdk/client` entries to the versions the CLI was built with. Install `@osdk/client` as a regular dependency of your app yourself."},"556":{"id":"/deploy/generate-sdk-34","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#generate-locally","content":"All flags are in the CLI reference."},"557":{"id":"/deploy/generate-sdk-35","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"`@osdk/foundry-sdk-generator` loads the resources you name from Foundry and writes a compiled npm package with ESM, CommonJS, and bundled type definitions."},"558":{"id":"/deploy/generate-sdk-36","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"The package is written to `<outputDir>/<packageName>`, here `./out/@my-app/sdk`, with a `peerDependencies` entry for `@osdk/client`. Pack or publish it from there with npm."},"559":{"id":"/deploy/generate-sdk-37","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option        | Type     | Description                |\n| ------------- | -------- | -------------------------- |\n| `--authToken` | `string` | A Foundry token. Required. |","table":"table-2"},"560":{"id":"/deploy/generate-sdk-38","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option              | Type     | Description                                                                                    |\n| ------------------- | -------- | ---------------------------------------------------------------------------------------------- |\n| `--foundryHostname` | `string` | Your stack, such as `example.palantirfoundry.com`. A full `https://` URL also works. Required. |","table":"table-2"},"561":{"id":"/deploy/generate-sdk-39","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option       | Type     | Description                   |\n| ------------ | -------- | ----------------------------- |\n| `--ontology` | `string` | The Ontology RID or API name. |","table":"table-2"},"562":{"id":"/deploy/generate-sdk-40","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option          | Type     | Description                     |\n| --------------- | -------- | ------------------------------- |\n| `--packageName` | `string` | The npm package name. Required. |","table":"table-2"},"563":{"id":"/deploy/generate-sdk-41","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option             | Type     | Description                                    |\n| ------------------ | -------- | ---------------------------------------------- |\n| `--packageVersion` | `string` | The package version. Must be SemVer. Required. |","table":"table-2"},"564":{"id":"/deploy/generate-sdk-42","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option        | Type     | Description                                         |\n| ------------- | -------- | --------------------------------------------------- |\n| `--outputDir` | `string` | The directory to write the package under. Required. |","table":"table-2"},"565":{"id":"/deploy/generate-sdk-43","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option          | Type       | Description            |\n| --------------- | ---------- | ---------------------- |\n| `--objectTypes` | `string[]` | Object type API names. |","table":"table-2"},"566":{"id":"/deploy/generate-sdk-44","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option        | Type       | Description                                           |\n| ------------- | ---------- | ----------------------------------------------------- |\n| `--linkTypes` | `string[]` | Links to include, as `ObjectTypeApiName.linkApiName`. |","table":"table-2"},"567":{"id":"/deploy/generate-sdk-45","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option          | Type       | Description            |\n| --------------- | ---------- | ---------------------- |\n| `--actionTypes` | `string[]` | Action type API names. |","table":"table-2"},"568":{"id":"/deploy/generate-sdk-46","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option         | Type       | Description                                                                            |\n| -------------- | ---------- | -------------------------------------------------------------------------------------- |\n| `--queryTypes` | `string[]` | Function API names. Add `:<version>` to pin a version, such as `countEmployees:1.2.0`. |","table":"table-2"},"569":{"id":"/deploy/generate-sdk-47","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option             | Type       | Description          |\n| ------------------ | ---------- | -------------------- |\n| `--interfaceTypes` | `string[]` | Interface API names. |","table":"table-2"},"570":{"id":"/deploy/generate-sdk-48","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option     | Type       | Description                       |\n| ---------- | ---------- | --------------------------------- |\n| `--agents` | `string[]` | AIP Agents, as `apiName:version`. |","table":"table-2"},"571":{"id":"/deploy/generate-sdk-49","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"| Option                           | Type      | Description                                                                       |\n| -------------------------------- | --------- | --------------------------------------------------------------------------------- |\n| `--experimentalOntologyMetadata` | `boolean` | Also export the raw metadata at `./experimental/ontology-metadata`. Experimental. |","table":"table-2"},"572":{"id":"/deploy/generate-sdk-50","page_id":"/deploy/generate-sdk","tags":[],"type":"text","url":"/deploy/generate-sdk#build-a-package-with-osdkfoundry-sdk-generator","content":"Each list flag takes space-separated values. The generator includes only what you list: an object type's links are left out unless you pass them in `--linkTypes`, and generation fails if a requested resource is missing."},"573":{"id":"/deploy/hosting","page_id":"/deploy/hosting","type":"page","content":"Host on Foundry","breadcrumbs":["OSDK TypeScript","Guides","Deploy"],"tags":[],"url":"/deploy/hosting"},"574":{"id":"/deploy/hosting-0","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting","content":"Build your OSDK app with Vite and deploy it to Foundry website hosting with osdk site deploy, foundry.config.json, versions, previews, and rollbacks."},"575":{"id":"/deploy/hosting-1","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#before-you-start","content":"Before you start"},"576":{"id":"/deploy/hosting-2","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#deploy-your-app","content":"Deploy your app"},"577":{"id":"/deploy/hosting-3","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#add-foundryconfigjson","content":"Add `foundry.config.json`"},"578":{"id":"/deploy/hosting-4","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#set-the-production-redirect-url","content":"Set the production redirect URL"},"579":{"id":"/deploy/hosting-5","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#build","content":"Build"},"580":{"id":"/deploy/hosting-6","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#deploy","content":"Deploy"},"581":{"id":"/deploy/hosting-7","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#foundryconfigjson","content":"`foundry.config.json`"},"582":{"id":"/deploy/hosting-8","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#automatic-versions","content":"Automatic versions"},"583":{"id":"/deploy/hosting-9","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#preview-before-going-live","content":"Preview before going live"},"584":{"id":"/deploy/hosting-10","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#roll-back","content":"Roll back"},"585":{"id":"/deploy/hosting-11","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#clean-up-old-versions","content":"Clean up old versions"},"586":{"id":"/deploy/hosting-12","page_id":"/deploy/hosting","type":"heading","tags":[],"url":"/deploy/hosting#host-somewhere-else","content":"Host somewhere else"},"587":{"id":"/deploy/hosting-13","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting","content":"Foundry website hosting serves your app's static build from a subdomain of your Foundry stack. You upload each build as a version with `@osdk/cli`, and one version at a time is live. This page covers configuring production, deploying, and managing versions; the CLI reference lists every flag."},"588":{"id":"/deploy/hosting-14","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#before-you-start","content":"| You need                                                        | Where to get it                                                                             |\n| --------------------------------------------------------------- | ------------------------------------------------------------------------------------------- |\n| An application in Developer Console with website hosting set up | Developer Console. Note the subdomain, such as `https://myapp.example.palantirfoundry.com`. |","table":"table-0"},"589":{"id":"/deploy/hosting-15","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#before-you-start","content":"| You need            | Where to get it                                                                    |\n| ------------------- | ---------------------------------------------------------------------------------- |\n| The application RID | The application's Developer Console URL, `/workspace/developer-console/app/<rid>`. |","table":"table-0"},"590":{"id":"/deploy/hosting-16","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#before-you-start","content":"| You need        | Where to get it                                       |\n| --------------- | ----------------------------------------------------- |\n| A Foundry token | Set it as `FOUNDRY_TOKEN`. The CLI accepts only JWTs. |","table":"table-0"},"591":{"id":"/deploy/hosting-17","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#before-you-start","content":"| You need       | Where to get it                                                                |\n| -------------- | ------------------------------------------------------------------------------ |\n| A static build | Any framework works. Apps from `@osdk/create-app` build to `./dist` with Vite. |","table":"table-0"},"592":{"id":"/deploy/hosting-18","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#add-foundryconfigjson","content":"Apps from `@osdk/create-app` already have this file. Otherwise, create it in your project root:"},"593":{"id":"/deploy/hosting-19","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#add-foundryconfigjson","content":"The CLI reads it from the current directory or the nearest parent, so you do not repeat these values on every command. All fields are described in `foundry.config.json`."},"594":{"id":"/deploy/hosting-20","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#set-the-production-redirect-url","content":"After sign-in, Foundry sends users back to your app's redirect URL, which must point at the hosted subdomain in production. In an app from `@osdk/create-app`, set it in `.env.production`:"},"595":{"id":"/deploy/hosting-21","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#set-the-production-redirect-url","content":"If you skipped the production URL when you created the app, the redirect line is commented out with a placeholder. Then add the same URL as a redirect URL on **OAuth & scopes** in Developer Console. The two must match exactly. See Authentication."},"596":{"id":"/deploy/hosting-22","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#set-the-production-redirect-url","content":"The React template includes a test that fails while any of these variables is missing or still a placeholder:"},"597":{"id":"/deploy/hosting-23","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#build","content":"In the React templates from `@osdk/create-app` this runs `tsc && vite build` (`vue-tsc && vite build` for Vue, `expo export -p web` for Expo). Vite builds in `production` mode, reads `.env.production`, and writes to `./dist`. Your Vite config must define `process.env.NODE_ENV`; see Use OSDK with Vite."},"598":{"id":"/deploy/hosting-24","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#deploy","content":"The CLI computes the version, zips `./dist`, uploads it, makes it live, and prints the site URL. To set the version yourself, pass `--version 1.2.0`."},"599":{"id":"/deploy/hosting-25","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#foundryconfigjson","content":"| Field        | Type     | Required | Description                                        |\n| ------------ | -------- | -------- | -------------------------------------------------- |\n| `foundryUrl` | `string` | Yes      | The Foundry stack URL. Must start with `https://`. |","table":"table-1"},"600":{"id":"/deploy/hosting-26","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#foundryconfigjson","content":"| Field              | Type     | Required | Description                            |\n| ------------------ | -------- | -------- | -------------------------------------- |\n| `site.application` | `string` | Yes      | The Developer Console application RID. |","table":"table-1"},"601":{"id":"/deploy/hosting-27","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#foundryconfigjson","content":"| Field            | Type     | Required | Description                                                 |\n| ---------------- | -------- | -------- | ----------------------------------------------------------- |\n| `site.directory` | `string` | Yes      | The directory to upload, relative to where you run the CLI. |","table":"table-1"},"602":{"id":"/deploy/hosting-28","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#foundryconfigjson","content":"| Field              | Type     | Required | Description                                                                                                  |\n| ------------------ | -------- | -------- | ------------------------------------------------------------------------------------------------------------ |\n| `site.autoVersion` | `object` | No       | How to compute versions. `{ \"type\": \"git-describe\", \"tagPrefix\"?: string }` or `{ \"type\": \"package-json\" }`. |","table":"table-1"},"603":{"id":"/deploy/hosting-29","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#foundryconfigjson","content":"| Field             | Type      | Required | Description                                                        |\n| ----------------- | --------- | -------- | ------------------------------------------------------------------ |\n| `site.uploadOnly` | `boolean` | No       | Upload new versions without making them live. Defaults to `false`. |","table":"table-1"},"604":{"id":"/deploy/hosting-30","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#foundryconfigjson","content":"The file must not contain other top-level fields. A `widgetSet` block, used by widget sets, cannot share a file with `site`. Command-line flags and `OSDK_*` environment variables override the file; see Configuration."},"605":{"id":"/deploy/hosting-31","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"Every version must be valid SemVer and unique: Foundry rejects a version that already exists. Pass `--version`, or let the CLI compute it."},"606":{"id":"/deploy/hosting-32","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"| `autoVersion.type` | Version comes from                                                                                      |\n| ------------------ | ------------------------------------------------------------------------------------------------------- |\n| `git-describe`     | `git describe --tags --first-parent --dirty`, limited to tags starting with `tagPrefix` when it is set. |","table":"table-2"},"607":{"id":"/deploy/hosting-33","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"| `autoVersion.type` | Version comes from                                 |\n| ------------------ | -------------------------------------------------- |\n| `package-json`     | The `version` field of the nearest `package.json`. |","table":"table-2"},"608":{"id":"/deploy/hosting-34","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"With `git-describe`, the CLI strips `tagPrefix` from the result, or a leading `v` when there is no prefix. The result depends on where you are relative to the newest tag:"},"609":{"id":"/deploy/hosting-35","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"| Repository state     | Example tag | Version |\n| -------------------- | ----------- | ------- |\n| On the tagged commit | `v1.2.0`    | `1.2.0` |","table":"table-3"},"610":{"id":"/deploy/hosting-36","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"| Repository state            | Example tag | Version            |\n| --------------------------- | ----------- | ------------------ |\n| Three commits after the tag | `v1.2.0`    | `1.2.0-3-g1a2b3c4` |","table":"table-3"},"611":{"id":"/deploy/hosting-37","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"| Repository state    | Example tag | Version       |\n| ------------------- | ----------- | ------------- |\n| Uncommitted changes | `v1.2.0`    | `1.2.0-dirty` |","table":"table-3"},"612":{"id":"/deploy/hosting-38","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"| Repository state     | Example tag    | Version |\n| -------------------- | -------------- | ------- |\n| Tag prefix `my-app@` | `my-app@1.2.0` | `1.2.0` |","table":"table-3"},"613":{"id":"/deploy/hosting-39","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"The deploy fails if git is missing, the directory is not a git repository, no tag matches, or the result is not SemVer. In CI, check out tags as well as commits, or `git describe` finds no tag."},"614":{"id":"/deploy/hosting-40","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#automatic-versions","content":"To use the version in `package.json`, bump it before each deploy:"},"615":{"id":"/deploy/hosting-41","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#preview-before-going-live","content":"Upload a version without making it live with `--uploadOnly`, or set `site.uploadOnly` to `true` to make that the default:"},"616":{"id":"/deploy/hosting-42","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#preview-before-going-live","content":"The CLI prints a preview link, `https://<subdomain>/.system/preview?previewVersion=<version>`. When it looks right, make it live:"},"617":{"id":"/deploy/hosting-43","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#preview-before-going-live","content":"Use the same flow when Foundry reports that a version is still being scanned for vulnerabilities: upload with `--uploadOnly`, wait for the scan, then set the version live with the CLI or from **Website hosting** in Developer Console."},"618":{"id":"/deploy/hosting-44","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#roll-back","content":"To roll back, set an earlier uploaded version live:"},"619":{"id":"/deploy/hosting-45","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#roll-back","content":"`list` shows each version, newest first, and marks the live one. `osdk site version get` prints only the live version."},"620":{"id":"/deploy/hosting-46","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#clean-up-old-versions","content":"An application has a version limit. When you reach it, deploys fail with `The site contains too many versions`. Delete versions you no longer need:"},"621":{"id":"/deploy/hosting-47","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#clean-up-old-versions","content":"You cannot delete the live version. To take the site offline, clear the live version with `osdk site version unset`; the site is unreachable until you set one again."},"622":{"id":"/deploy/hosting-48","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#host-somewhere-else","content":"The build is static files, so any web server or CDN can host it. Foundry website hosting sets up cross-origin access to your stack for you; elsewhere you configure it yourself:"},"623":{"id":"/deploy/hosting-49","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#host-somewhere-else","content":"| Requirement                            | Why                                                                                                   |\n| -------------------------------------- | ----------------------------------------------------------------------------------------------------- |\n| Your stack allows your origin for CORS | The browser calls Foundry APIs directly from your origin. Ask your Foundry administrator to allow it. |","table":"table-4"},"624":{"id":"/deploy/hosting-50","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#host-somewhere-else","content":"| Requirement                               | Why                                                                                                                        |\n| ----------------------------------------- | -------------------------------------------------------------------------------------------------------------------------- |\n| The redirect URL is on **OAuth & scopes** | Foundry only redirects to listed URLs. Use your origin plus `/auth/callback`, and set the same value in `.env.production`. |","table":"table-4"},"625":{"id":"/deploy/hosting-51","page_id":"/deploy/hosting","tags":[],"type":"text","url":"/deploy/hosting#host-somewhere-else","content":"| Requirement                                      | Why                                                                                                                                       |\n| ------------------------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------- |\n| The server returns your app for `/auth/callback` | Sign-in lands on that path. A server that returns `404` for paths without a file breaks sign-in, so serve `index.html` for unknown paths. |","table":"table-4"},"626":{"id":"/deploy/integration-testing","page_id":"/deploy/integration-testing","type":"page","content":"Integration testing","breadcrumbs":["OSDK TypeScript","Guides","Deploy"],"tags":[],"url":"/deploy/integration-testing"},"627":{"id":"/deploy/integration-testing-0","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing","content":"Run OSDK code against a local Ontology server with @osdk/integration-testing, seed it with objects and links, and stub functions in Vitest."},"628":{"id":"/deploy/integration-testing-1","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#how-it-works","content":"How it works"},"629":{"id":"/deploy/integration-testing-2","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#requirements","content":"Requirements"},"630":{"id":"/deploy/integration-testing-3","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#install","content":"Install"},"631":{"id":"/deploy/integration-testing-4","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#foundry-cli","content":"Foundry CLI"},"632":{"id":"/deploy/integration-testing-5","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#get-the-ontology-metadata","content":"Get the Ontology metadata"},"633":{"id":"/deploy/integration-testing-6","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#write-a-test","content":"Write a test"},"634":{"id":"/deploy/integration-testing-7","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#create-a-fixture","content":"Create a fixture"},"635":{"id":"/deploy/integration-testing-8","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#build-the-seed-data","content":"Build the seed data"},"636":{"id":"/deploy/integration-testing-9","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#test-against-the-local-server","content":"Test against the local server"},"637":{"id":"/deploy/integration-testing-10","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#run-the-tests","content":"Run the tests"},"638":{"id":"/deploy/integration-testing-11","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#change-data-inside-a-test","content":"Change data inside a test"},"639":{"id":"/deploy/integration-testing-12","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#api-reference","content":"API reference"},"640":{"id":"/deploy/integration-testing-13","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#createintegrationserverconfig","content":"`createIntegrationServer(config)`"},"641":{"id":"/deploy/integration-testing-14","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#seedclient","content":"`SeedClient`"},"642":{"id":"/deploy/integration-testing-15","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#integrationclient","content":"`IntegrationClient`"},"643":{"id":"/deploy/integration-testing-16","page_id":"/deploy/integration-testing","type":"heading","tags":[],"url":"/deploy/integration-testing#other-exports","content":"Other exports"},"644":{"id":"/deploy/integration-testing-17","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing","content":"`@osdk/integration-testing` starts a local Ontology server from the Foundry CLI, fills it with seed objects and links, and gives you a real `Client` connected to it. Use it to test code that queries objects, filters, and follows links end to end, without a Foundry stack. To test React components with mocks instead, see Testing."},"645":{"id":"/deploy/integration-testing-18","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing","content":"`@osdk/integration-testing` is a `0.x` package and depends on the experimental `--experimentalOntologyMetadata` generator flag. Its API may change between releases."},"646":{"id":"/deploy/integration-testing-19","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#how-it-works","content":"| Piece                     | What it does                                                                                                                 |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------------------------- |\n| `createIntegrationServer` | Writes your Ontology metadata to a temporary `.test-run-*` directory and runs `foundry start ontology` from the Foundry CLI. |","table":"table-0"},"647":{"id":"/deploy/integration-testing-20","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#how-it-works","content":"| Piece       | What it does                                                                                                   |\n| ----------- | -------------------------------------------------------------------------------------------------------------- |\n| Seed client | Writes objects and links to the local server. Each call replaces the server's data with the seed built so far. |","table":"table-0"},"648":{"id":"/deploy/integration-testing-21","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#how-it-works","content":"| Piece              | What it does                                                                                                                                                      |\n| ------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Integration client | A `Client` from `@osdk/client` pointed at the local server. Object and interface calls, such as `fetchPage`, `where`, and `pivotTo`, run against the seeded data. |","table":"table-0"},"649":{"id":"/deploy/integration-testing-22","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#how-it-works","content":"| Piece          | What it does                                                                                                                                                               |\n| -------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Function stubs | The local Ontology cannot run functions, so the integration client sends function calls to an in-memory mock from `@osdk/unit-testing`. Register results with `whenQuery`. |","table":"table-0"},"650":{"id":"/deploy/integration-testing-23","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#requirements","content":"| Requirement | Details                                                                               |\n| ----------- | ------------------------------------------------------------------------------------- |\n| Node.js     | The package starts a subprocess and reads files, so tests run in Node, not a browser. |","table":"table-1"},"651":{"id":"/deploy/integration-testing-24","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#requirements","content":"| Requirement | Details                                                                                                            |\n| ----------- | ------------------------------------------------------------------------------------------------------------------ |\n| Foundry CLI | The `foundry` binary, version `0.224.0` or later, on your `PATH`. Pass `foundryCliPath` to use a binary elsewhere. |","table":"table-1"},"652":{"id":"/deploy/integration-testing-25","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#requirements","content":"| Requirement       | Details                                                                                         |\n| ----------------- | ----------------------------------------------------------------------------------------------- |\n| Ontology metadata | The full Ontology metadata your SDK was generated from, as JSON. See Get the Ontology metadata. |","table":"table-1"},"653":{"id":"/deploy/integration-testing-26","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#requirements","content":"| Requirement          | Details                                                      |\n| -------------------- | ------------------------------------------------------------ |\n| `@osdk/seed-helpers` | A peer dependency, `>=0.25.0 <1.0.0`, that builds seed data. |","table":"table-1"},"654":{"id":"/deploy/integration-testing-27","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#install","content":"`@osdk/client` and `@osdk/api` are peer dependencies as well; install them as described in Installation."},"655":{"id":"/deploy/integration-testing-28","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"On install, a postinstall script checks for the Foundry CLI:"},"656":{"id":"/deploy/integration-testing-29","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"If `foundry` is installed and recent enough, it does nothing."},"657":{"id":"/deploy/integration-testing-30","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"If it is too old, the install fails and asks you to run `foundry update self`."},"658":{"id":"/deploy/integration-testing-31","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"If it is missing, it downloads the installer from your Foundry stack and runs it. If that fails, the install continues with a warning, and creating a client fails until the CLI is installed."},"659":{"id":"/deploy/integration-testing-32","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"To find your stack and authenticate the download, the script reads, in order:"},"660":{"id":"/deploy/integration-testing-33","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"| Value        | Sources                                                                                  |\n| ------------ | ---------------------------------------------------------------------------------------- |\n| Foundry host | `FOUNDRY_EXTERNAL_HOST` or `FOUNDRY_HOSTNAME`, then the host of the git remote `origin`. |","table":"table-2"},"661":{"id":"/deploy/integration-testing-34","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"| Value | Sources                                                                                                                                                                                                              |\n| ----- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Token | `FOUNDRY_TOKEN` when `FOUNDRY_HOSTNAME`, `FOUNDRY_TOKEN`, and `FOUNDRY_USERNAME` are all set, otherwise the credentials in the git remote URL. Foundry CI and Code Workspaces provide their own token automatically. |","table":"table-2"},"662":{"id":"/deploy/integration-testing-35","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#foundry-cli","content":"Set the three variables before installing on a machine whose git remote does not point at Foundry:"},"663":{"id":"/deploy/integration-testing-36","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#get-the-ontology-metadata","content":"`createIntegrationServer` needs the Ontology metadata as an `OntologyFullMetadata` object. The SDK generator writes it when you generate locally with the experimental `--experimentalOntologyMetadata` flag:"},"664":{"id":"/deploy/integration-testing-37","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#get-the-ontology-metadata","content":"The metadata lands in `experimental/ontology-metadata.json` inside `--outDir`. An SDK package generated with the flag also exports it as the `./experimental/ontology-metadata` subpath, which the examples below import. For the other generate options, see Generate your SDK."},"665":{"id":"/deploy/integration-testing-38","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#write-a-test","content":"This example uses Vitest. One server starts per Vitest worker, and every test resets the seed before it runs."},"666":{"id":"/deploy/integration-testing-39","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#create-a-fixture","content":"`test.extend` creates the server, seed client, and integration client once per worker and passes them to each test. `stop()` runs in `finally`, so a server that fails to start does not leave its process or `.test-run-*` directory behind."},"667":{"id":"/deploy/integration-testing-40","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#build-the-seed-data","content":"`createSeedWithMetadata` from `@osdk/seed-helpers` builds seed data without a server, and returns it with whatever your function returns. `create` returns a reference with the object's properties, `$apiName`, and `$primaryKey`; `link` connects two references by link name."},"668":{"id":"/deploy/integration-testing-41","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#build-the-seed-data","content":"`create` throws when an object of that type with the same primary key already exists, and when the properties do not match the metadata. A non-primary-key property set to `undefined` is allowed, even when the metadata marks it required, and is left empty."},"669":{"id":"/deploy/integration-testing-42","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#test-against-the-local-server","content":"Reset the seed before each test so tests do not see each other's writes, and clear function stubs after each one."},"670":{"id":"/deploy/integration-testing-43","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#test-against-the-local-server","content":"Replace `countEmployees` with a function from your SDK. Pass its parameters as the second argument of `whenQuery` to stub one call: `client.whenQuery(fn, params).thenReturn(result)`. Use `thenThrow(error)` to make the call fail."},"671":{"id":"/deploy/integration-testing-44","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#run-the-tests","content":"Starting the Ontology server can take a while on the first run. If the fixture times out, raise Vitest's `hookTimeout` and `testTimeout`. Each server's `.test-run-*` directory is removed when it stops; add `.test-run-*` to `.gitignore` in case a run is killed first."},"672":{"id":"/deploy/integration-testing-45","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#change-data-inside-a-test","content":"Each seed client method updates the seed and writes it to the server before it resolves, so a test can set up extra data right before it queries:"},"673":{"id":"/deploy/integration-testing-46","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"Returns a `Promise<IntegrationServer>`. Creating the server writes the metadata to disk; `start()` launches the CLI."},"674":{"id":"/deploy/integration-testing-47","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| Option     | Type                   | Default | Description                                                                                                                                     |\n| ---------- | ---------------------- | ------- | ----------------------------------------------------------------------------------------------------------------------------------------------- |\n| `metadata` | `OntologyFullMetadata` |         | The Ontology metadata to serve. Required. Interfaces that object types implement but the metadata does not include are dropped, with a warning. |","table":"table-3"},"675":{"id":"/deploy/integration-testing-48","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| Option           | Type     | Default             | Description                     |\n| ---------------- | -------- | ------------------- | ------------------------------- |\n| `foundryCliPath` | `string` | `foundry` on `PATH` | Path to the Foundry CLI binary. |","table":"table-3"},"676":{"id":"/deploy/integration-testing-49","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| Option        | Type     | Default               | Description                                                                                                                |\n| ------------- | -------- | --------------------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `projectPath` | `string` | The working directory | An existing directory to create the server's `.test-run-*` directory in. Servers that share a `projectPath` stay isolated. |","table":"table-3"},"677":{"id":"/deploy/integration-testing-50","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| `IntegrationServer` member | Description                                                     |\n| -------------------------- | --------------------------------------------------------------- |\n| `start()`                  | Starts the Ontology service and resolves once it reports ready. |","table":"table-4"},"678":{"id":"/deploy/integration-testing-51","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| `IntegrationServer` member | Description                                                         |\n| -------------------------- | ------------------------------------------------------------------- |\n| `stop()`                   | Stops the service and deletes the server's `.test-run-*` directory. |","table":"table-4"},"679":{"id":"/deploy/integration-testing-52","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| `IntegrationServer` member | Description                                              |\n| -------------------------- | -------------------------------------------------------- |\n| `getOntologyUrl()`         | The local server's URL, or `undefined` before it starts. |","table":"table-4"},"680":{"id":"/deploy/integration-testing-53","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| `IntegrationServer` member | Description                                                                                 |\n| -------------------------- | ------------------------------------------------------------------------------------------- |\n| `getClient()`              | Resolves to the `IntegrationClient` for this server. Repeated calls return the same client. |","table":"table-4"},"681":{"id":"/deploy/integration-testing-54","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"| `IntegrationServer` member | Description                                                                               |\n| -------------------------- | ----------------------------------------------------------------------------------------- |\n| `getSeedClient()`          | Resolves to the `SeedClient` for this server. Repeated calls return the same seed client. |","table":"table-4"},"682":{"id":"/deploy/integration-testing-55","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#createintegrationserverconfig","content":"`getClient()` and `getSeedClient()` throw `Ontology server is not ready` when called before `start()` resolves."},"683":{"id":"/deploy/integration-testing-56","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"Every method applies the full seed to the server before it resolves."},"684":{"id":"/deploy/integration-testing-57","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member     | Description                                                                             |\n| ---------- | --------------------------------------------------------------------------------------- |\n| `seed(fn)` | Calls `fn` with a `SeedBuilder`, applies the result, and resolves to what `fn` returns. |","table":"table-5"},"685":{"id":"/deploy/integration-testing-58","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member         | Description                                                                 |\n| -------------- | --------------------------------------------------------------------------- |\n| `seed(output)` | Adds a `SeedOutput`, such as `baseSeed.output`, to the seed and applies it. |","table":"table-5"},"686":{"id":"/deploy/integration-testing-59","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member         | Description                                                                              |\n| -------------- | ---------------------------------------------------------------------------------------- |\n| `set(output?)` | Replaces the whole seed with `output` and applies it. With no argument, clears all data. |","table":"table-5"},"687":{"id":"/deploy/integration-testing-60","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member           | Description                                  |\n| ---------------- | -------------------------------------------- |\n| `addAll(output)` | Merges a `SeedOutput` into the current seed. |","table":"table-5"},"688":{"id":"/deploy/integration-testing-61","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member                | Description                                                                                |\n| --------------------- | ------------------------------------------------------------------------------------------ |\n| `create(type, props)` | Creates an object and resolves to its reference. Throws if the primary key already exists. |","table":"table-5"},"689":{"id":"/deploy/integration-testing-62","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member               | Description                                                                                                                                              |\n| -------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `update(ref, props)` | Merges `props` into the object, leaving omitted properties unchanged. A property set to `undefined` is cleared. Creates the object if it does not exist. |","table":"table-5"},"690":{"id":"/deploy/integration-testing-63","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member        | Description                                            |\n| ------------- | ------------------------------------------------------ |\n| `delete(ref)` | Removes the object. Does nothing if it does not exist. |","table":"table-5"},"691":{"id":"/deploy/integration-testing-64","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member                           | Description                                                                                        |\n| -------------------------------- | -------------------------------------------------------------------------------------------------- |\n| `link(source, linkName, target)` | Links `source` to one reference, or an array for many-valued links. Re-adding a link does nothing. |","table":"table-5"},"692":{"id":"/deploy/integration-testing-65","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member                             | Description                                         |\n| ---------------------------------- | --------------------------------------------------- |\n| `unlink(source, linkName, target)` | Removes matching links. Does nothing if none exist. |","table":"table-5"},"693":{"id":"/deploy/integration-testing-66","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#seedclient","content":"| Member                  | Description                                                                                            |\n| ----------------------- | ------------------------------------------------------------------------------------------------------ |\n| `ref(type, primaryKey)` | Returns the reference for an object already in the seed, or `undefined`. Does not write to the server. |","table":"table-5"},"694":{"id":"/deploy/integration-testing-67","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#integrationclient","content":"A `Client` from `@osdk/client` with two extra members:"},"695":{"id":"/deploy/integration-testing-68","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#integrationclient","content":"| Member                      | Description                                                                          |\n| --------------------------- | ------------------------------------------------------------------------------------ |\n| `whenQuery(query, params?)` | Starts a function stub. Finish it with `.thenReturn(result)` or `.thenThrow(error)`. |","table":"table-6"},"696":{"id":"/deploy/integration-testing-69","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#integrationclient","content":"| Member         | Description                  |\n| -------------- | ---------------------------- |\n| `clearStubs()` | Removes every function stub. |","table":"table-6"},"697":{"id":"/deploy/integration-testing-70","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#other-exports","content":"| Export                            | Description                                                                                                                                                                                                                                                              |\n| --------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `createIntegrationClient(config)` | Creates an `IntegrationClient` for a server that is already running, with `baseUrl` and `metadata`, and optionally `caCertPath` for the server's certificate. Without `caCertPath`, the client skips TLS certificate checks. Throws if the Foundry CLI is not installed. |","table":"table-7"},"698":{"id":"/deploy/integration-testing-71","page_id":"/deploy/integration-testing","tags":[],"type":"text","url":"/deploy/integration-testing#other-exports","content":"| Export                     | Description                                                                                                                                                                                                                                          |\n| -------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `checkFoundryCliVersion()` | Resolves to `{ type: \"installed\", version }`, `{ type: \"version-incompatible\", version }`, `{ type: \"version-error\" }`, or `{ type: \"not-found\" }`. Use it to skip integration tests on machines without the CLI, for example with `describe.runIf`. |","table":"table-7"},"699":{"id":"/faq","page_id":"/faq","type":"page","content":"FAQ","breadcrumbs":["OSDK TypeScript","Guides","Help"],"tags":[],"url":"/faq"},"700":{"id":"/faq-0","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Short answers about @osdk/react versus React Query, using OSDK without React or on a server, package versions, dates, templates, and changelogs."},"701":{"id":"/faq-1","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Short answers to common questions about the OSDK TypeScript and React SDKs. Each answer links to the page that covers the topic in full."},"702":{"id":"/faq-2","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"React Query and SWR cache responses by a key you choose. `@osdk/react` knows the Ontology, so it caches objects themselves:"},"703":{"id":"/faq-3","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Each object is stored once by type and primary key, and every list, link, and detail view that contains it updates together."},"704":{"id":"/faq-4","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Actions report which objects they added, modified, or deleted, and the cache applies those edits without manual invalidation."},"705":{"id":"/faq-5","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Optimistic updates roll back automatically if the action fails."},"706":{"id":"/faq-6","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"`streamUpdates: true` keeps lists live over a WebSocket."},"707":{"id":"/faq-7","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Use `@osdk/react` for Foundry data and keep React Query or SWR for other APIs. They work side by side, but do not copy OSDK data into another cache. See Caching and reactivity."},"708":{"id":"/faq-8","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Yes. `@osdk/client` has no UI dependency and works in any browser or JavaScript runtime with `fetch`. Create a client with `createClient` and call `client(Employee).fetchPage()`, `client(modifyEmployee).applyAction()`, and so on. See Use the client without React."},"709":{"id":"/faq-9","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"For the normalized cache outside React, `createObservableClient` from `@osdk/client/observable` is the same engine `OsdkProvider` uses."},"710":{"id":"/faq-10","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"`@osdk/api`, `@osdk/client`, and `@osdk/react` are released together with one version number. Install the same version of all three, and keep prereleases together. Your generated SDK has a peer dependency on `@osdk/client`, so generate a new SDK version when you upgrade the client across many versions."},"711":{"id":"/faq-11","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"`@osdk/react-components`, `@osdk/react-devtools`, and `@osdk/oauth` have their own version numbers. Upgrade them alongside the three core packages. See Version compatibility."},"712":{"id":"/faq-12","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Date and timestamp properties are ISO 8601 strings, such as `\"2024-03-15\"` and `\"2024-03-15T09:30:00Z\"`. Bundling a date library would add weight to every app, often duplicating a library you already use, and parsing every value costs time even when you never read it. Parse values with `Date` or your date library when you need date math. See Dates and timestamps."},"713":{"id":"/faq-13","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Yes, with `@osdk/client` and a confidential OAuth client. `createConfidentialOauthClient` from `@osdk/oauth` uses the client credentials grant, so requests act as the application's service user, not a signed-in person:"},"714":{"id":"/faq-14","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Keep the client secret on the server; never ship it to a browser. `@osdk/react` is for browser apps. See Authenticate a server or service."},"715":{"id":"/faq-15","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Yes. `@osdk/create-app` has React, Vue, and Expo templates, plus a React template for public apps without sign-in. Choose one at the prompt, or pass it directly:"},"716":{"id":"/faq-16","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"The Vue template uses `@osdk/client` and `@osdk/oauth` directly. `@osdk/react` and its components are React-only."},"717":{"id":"/faq-17","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Both come from your application in Developer Console:"},"718":{"id":"/faq-18","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"| Value     | Where to find it             |\n| --------- | ---------------------------- |\n| Client ID | The **OAuth & scopes** page. |","table":"table-0"},"719":{"id":"/faq-19","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"| Value        | Where to find it                                                                                                                |\n| ------------ | ------------------------------------------------------------------------------------------------------------------------------- |\n| Ontology RID | The **Ontology SDK** page. Your generated SDK also exports it as `$ontologyRid` when it was generated for a single environment. |","table":"table-0"},"720":{"id":"/faq-20","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"| Value        | Where to find it                                                                       |\n| ------------ | -------------------------------------------------------------------------------------- |\n| Redirect URL | Also on **OAuth & scopes**. The value in your app must match one listed there exactly. |","table":"table-0"},"721":{"id":"/faq-21","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Apps created with `@osdk/create-app` store these in `.env.development` and `.env.production` as `VITE_FOUNDRY_CLIENT_ID`, `VITE_FOUNDRY_ONTOLOGY_RID`, and `VITE_FOUNDRY_REDIRECT_URL`."},"722":{"id":"/faq-22","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"The generated SDK exports definitions, and the client does the work. Importing definitions by name lets your bundler drop the parts of the Ontology you do not use, and lets several SDKs share one `@osdk/client`. See Why `client(Employee)`."},"723":{"id":"/faq-23","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Each package has a `CHANGELOG.md` on GitHub and in its npm package:"},"724":{"id":"/faq-24","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"`@osdk/react` changelog"},"725":{"id":"/faq-25","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"`@osdk/client` changelog"},"726":{"id":"/faq-26","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"`@osdk/react-components` changelog"},"727":{"id":"/faq-27","page_id":"/faq","tags":[],"type":"text","url":"/faq","content":"Locally, open `node_modules/@osdk/react/CHANGELOG.md` to read the notes for the version you have installed."},"728":{"id":"/frameworks/expo","page_id":"/frameworks/expo","type":"page","content":"Expo and React Native","breadcrumbs":["OSDK TypeScript","Guides","Frameworks"],"tags":[],"url":"/frameworks/expo"},"729":{"id":"/frameworks/expo-0","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo","content":"Build an iOS, Android, and web app on OSDK with the create-app Expo template, sign in with expo-auth-session, and query objects from React Native screens."},"730":{"id":"/frameworks/expo-1","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#create-an-expo-app","content":"Create an Expo app"},"731":{"id":"/frameworks/expo-2","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#what-the-template-generates","content":"What the template generates"},"732":{"id":"/frameworks/expo-3","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#sign-in","content":"Sign in"},"733":{"id":"/frameworks/expo-4","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#store-the-token","content":"Store the token"},"734":{"id":"/frameworks/expo-5","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#run-the-authorization-flow","content":"Run the authorization flow"},"735":{"id":"/frameworks/expo-6","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#register-redirect-urls","content":"Register redirect URLs"},"736":{"id":"/frameworks/expo-7","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#query-objects","content":"Query objects"},"737":{"id":"/frameworks/expo-8","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#use-osdkreact-hooks","content":"Use `@osdk/react` hooks"},"738":{"id":"/frameworks/expo-9","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#metro-configuration","content":"Metro configuration"},"739":{"id":"/frameworks/expo-10","page_id":"/frameworks/expo","type":"heading","tags":[],"url":"/frameworks/expo#deploy-the-web-build","content":"Deploy the web build"},"740":{"id":"/frameworks/expo-11","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo","content":"The `expo` template of `@osdk/create-app` gives you an Expo Router app that signs in to Foundry and calls `@osdk/client` on iOS, Android, and the web. Sign-in works differently from the browser templates, so read Sign in before you configure redirect URLs."},"741":{"id":"/frameworks/expo-12","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"Run `@osdk/create-app` with the `expo` template:"},"742":{"id":"/frameworks/expo-13","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"The CLI asks for your Foundry URL, application RID, OAuth client ID, and SDK package. Quickstart lists every prompt and its flag. The Expo template supports SDK version 2.x only."},"743":{"id":"/frameworks/expo-14","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"Answer **No** to the CORS proxy prompt, or pass `--corsProxy false`. The Expo template has no proxy server, but a **Yes** still sets `EXPO_PUBLIC_FOUNDRY_API_URL` to `http://localhost:8080` in `.env.development`, so every request goes to the Expo dev server instead of Foundry."},"744":{"id":"/frameworks/expo-15","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"Then install and start the app:"},"745":{"id":"/frameworks/expo-16","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"`FOUNDRY_TOKEN` must be able to read your SDK's npm registry; see Installation."},"746":{"id":"/frameworks/expo-17","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script         | Runs                     | Use it to                                                                       |\n| -------------- | ------------------------ | ------------------------------------------------------------------------------- |\n| `dev`, `start` | `expo start --port 8080` | Start the dev server, then press `i`, `a`, or `w` to open iOS, Android, or web. |","table":"table-0"},"747":{"id":"/frameworks/expo-18","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script | Runs               | Use it to                         |\n| ------ | ------------------ | --------------------------------- |\n| `ios`  | `expo start --ios` | Start and open the iOS simulator. |","table":"table-0"},"748":{"id":"/frameworks/expo-19","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script    | Runs                   | Use it to                            |\n| --------- | ---------------------- | ------------------------------------ |\n| `android` | `expo start --android` | Start and open the Android emulator. |","table":"table-0"},"749":{"id":"/frameworks/expo-20","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script | Runs                           | Use it to                     |\n| ------ | ------------------------------ | ----------------------------- |\n| `web`  | `expo start --web --port 8080` | Start and open the web build. |","table":"table-0"},"750":{"id":"/frameworks/expo-21","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script  | Runs                 | Use it to                                    |\n| ------- | -------------------- | -------------------------------------------- |\n| `build` | `expo export -p web` | Export the web build to `dist/` for hosting. |","table":"table-0"},"751":{"id":"/frameworks/expo-22","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script | Runs                           | Use it to  |\n| ------ | ------------------------------ | ---------- |\n| `test` | `vitest run --passWithNoTests` | Run tests. |","table":"table-0"},"752":{"id":"/frameworks/expo-23","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#create-an-expo-app","content":"| Script          | Runs                              | Use it to                                                                  |\n| --------------- | --------------------------------- | -------------------------------------------------------------------------- |\n| `reset-project` | `node ./scripts/reset-project.js` | Move the starter screens to `app-example/` and start from an empty `app/`. |","table":"table-0"},"753":{"id":"/frameworks/expo-24","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\".env.development\" />"},"754":{"id":"/frameworks/expo-25","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\".env.production\" />"},"755":{"id":"/frameworks/expo-26","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\".npmrc\" />"},"756":{"id":"/frameworks/expo-27","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"app.json\" />"},"757":{"id":"/frameworks/expo-28","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"foundry.config.json\" />"},"758":{"id":"/frameworks/expo-29","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"metro.config.js\" />"},"759":{"id":"/frameworks/expo-30","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"package.json\" />"},"760":{"id":"/frameworks/expo-31","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"_layout.tsx\" />"},"761":{"id":"/frameworks/expo-32","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"_layout.tsx\" />"},"762":{"id":"/frameworks/expo-33","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"explore.tsx\" />"},"763":{"id":"/frameworks/expo-34","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"index.tsx\" />"},"764":{"id":"/frameworks/expo-35","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"login.tsx\" />"},"765":{"id":"/frameworks/expo-36","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"Auth.ts\" />"},"766":{"id":"/frameworks/expo-37","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"client.ts\" />"},"767":{"id":"/frameworks/expo-38","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"<File name=\"osdkConst.ts\" />"},"768":{"id":"/frameworks/expo-39","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File                                  | Purpose                                                                                                                                                        |\n| ------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `.env.development`, `.env.production` | `EXPO_PUBLIC_FOUNDRY_API_URL`, `EXPO_PUBLIC_FOUNDRY_CLIENT_ID`, and `EXPO_PUBLIC_FOUNDRY_ONTOLOGY_RID`. Expo inlines `EXPO_PUBLIC_` variables into the bundle. |","table":"table-1"},"769":{"id":"/frameworks/expo-40","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File                   | Purpose                                                                          |\n| ---------------------- | -------------------------------------------------------------------------------- |\n| `foundry/osdkConst.ts` | Reads those variables and throws `Missing environment variable` if one is unset. |","table":"table-1"},"770":{"id":"/frameworks/expo-41","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File              | Purpose                                                                                          |\n| ----------------- | ------------------------------------------------------------------------------------------------ |\n| `foundry/Auth.ts` | Holds the access token in memory and exposes `getValidAuthToken` as the client's token provider. |","table":"table-1"},"771":{"id":"/frameworks/expo-42","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File                | Purpose                               |\n| ------------------- | ------------------------------------- |\n| `foundry/client.ts` | Creates `client` with `createClient`. |","table":"table-1"},"772":{"id":"/frameworks/expo-43","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File                   | Purpose                                                                |\n| ---------------------- | ---------------------------------------------------------------------- |\n| `app/(tabs)/login.tsx` | The **Login** tab, which runs the OAuth flow with `expo-auth-session`. |","table":"table-1"},"773":{"id":"/frameworks/expo-44","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File                   | Purpose                                                       |\n| ---------------------- | ------------------------------------------------------------- |\n| `app/(tabs)/index.tsx` | The **Home** tab. On web it also completes the sign-in popup. |","table":"table-1"},"774":{"id":"/frameworks/expo-45","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File                     | Purpose                                                     |\n| ------------------------ | ----------------------------------------------------------- |\n| `app/(tabs)/explore.tsx` | Lists the object types, actions, and functions in your SDK. |","table":"table-1"},"775":{"id":"/frameworks/expo-46","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File              | Purpose                                                        |\n| ----------------- | -------------------------------------------------------------- |\n| `metro.config.js` | Lets Metro resolve the OSDK packages. See Metro configuration. |","table":"table-1"},"776":{"id":"/frameworks/expo-47","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"| File       | Purpose                                                                    |\n| ---------- | -------------------------------------------------------------------------- |\n| `app.json` | Expo config, including the URL `scheme` used for native sign-in redirects. |","table":"table-1"},"777":{"id":"/frameworks/expo-48","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#what-the-template-generates","content":"The generated `.env` files also contain `EXPO_PUBLIC_FOUNDRY_REDIRECT_URL`. The Expo template does not read it: the redirect URL comes from `makeRedirectUri`, described below."},"778":{"id":"/frameworks/expo-49","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#sign-in","content":"The browser templates use `createPublicOauthClient` from `@osdk/oauth`, which signs in by navigating the page to Foundry and back. A native app cannot do that, so the Expo template runs the same authorization code flow with PKCE through `expo-auth-session` instead, which opens Foundry's sign-in page in a system browser session and returns the code to the app."},"779":{"id":"/frameworks/expo-50","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#store-the-token","content":"`foundry/Auth.ts` keeps the token response in a module variable. `getValidAuthToken` is the token provider you pass to `createClient`; it throws until the user has signed in:"},"780":{"id":"/frameworks/expo-51","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#store-the-token","content":"The token lives only in memory. The template neither refreshes nor persists it, so the user signs in again when the app restarts or the access token expires."},"781":{"id":"/frameworks/expo-52","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#run-the-authorization-flow","content":"The **Login** tab points `useAuthRequest` at Foundry's authorize and token endpoints under `/multipass/api/oauth2`, then exchanges the returned code for a token. This version adds error handling to the generated screen:"},"782":{"id":"/frameworks/expo-53","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#run-the-authorization-flow","content":"Request only the scopes your app needs, and allow each of them for your application on **OAuth & scopes** in Developer Console."},"783":{"id":"/frameworks/expo-54","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#run-the-authorization-flow","content":"On web, `promptAsync` opens Foundry in a popup. Foundry redirects the popup to your app's root URL, where `app/(tabs)/index.tsx` calls `WebBrowser.maybeCompleteAuthSession()` from `expo-web-browser`. That call hands the result back to the original window and closes the popup. Keep it in whichever screen renders at the redirect path."},"784":{"id":"/frameworks/expo-55","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#register-redirect-urls","content":"`makeRedirectUri({ path: \"\" })` returns a different URL on each platform, and each one must be registered exactly on **OAuth & scopes**:"},"785":{"id":"/frameworks/expo-56","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#register-redirect-urls","content":"| Where the app runs     | Redirect URL                                           |\n| ---------------------- | ------------------------------------------------------ |\n| Web, local development | `http://localhost:8080`, with no `/auth/callback` path |","table":"table-2"},"786":{"id":"/frameworks/expo-57","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#register-redirect-urls","content":"| Where the app runs     | Redirect URL                                                                          |\n| ---------------------- | ------------------------------------------------------------------------------------- |\n| Web, hosted on Foundry | Your site's root URL, such as `https://<subdomain>.<your-domain>.palantirfoundry.com` |","table":"table-2"},"787":{"id":"/frameworks/expo-58","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#register-redirect-urls","content":"| Where the app runs | Redirect URL                                                                                                     |\n| ------------------ | ---------------------------------------------------------------------------------------------------------------- |\n| iOS and Android    | A URL with the `scheme` from `app.json`. The template's scheme is `my-app`; change it to one unique to your app. |","table":"table-2"},"788":{"id":"/frameworks/expo-59","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#register-redirect-urls","content":"To see the exact value on a device, render or log `redirectUri` from the **Login** screen and copy it into Developer Console."},"789":{"id":"/frameworks/expo-60","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#query-objects","content":"Call the client from a screen once the user has signed in. Keep the list on screen while it reloads:"},"790":{"id":"/frameworks/expo-61","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#query-objects","content":"A request made before sign-in fails with `No valid auth token`. Send users to the **Login** tab first, as the template does by making it the initial route. The rest of the client API is the same as on the web; see Use the client without React."},"791":{"id":"/frameworks/expo-62","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#use-osdkreact-hooks","content":"`@osdk/react` does not touch the DOM, so its hooks work in React Native screens. The template lists `@osdk/react` in `package.json` but does not use it, and pins it to `^0.7.0`, a release line from before `@osdk/react` shared a version number with `@osdk/client`. Install the same version as your `@osdk/client` first, for example:"},"792":{"id":"/frameworks/expo-63","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#use-osdkreact-hooks","content":"Version compatibility explains the rule. `react-dom`, a peer dependency of `@osdk/react`, is already in the template for the web build. Then wrap the root layout in `OsdkProvider`:"},"793":{"id":"/frameworks/expo-64","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#use-osdkreact-hooks","content":"The generated layout also loads fonts, controls the splash screen, and sets a theme; keep those and add `OsdkProvider` around the `Stack`. Screens can now use the hooks:"},"794":{"id":"/frameworks/expo-65","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#use-osdkreact-hooks","content":"Hooks fetch as soon as a screen mounts, so mount data screens only after sign-in. Everything else about the hooks is covered under Query objects and Apply actions. `@osdk/react-components` renders HTML, so it works in the web build only."},"795":{"id":"/frameworks/expo-66","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#metro-configuration","content":"`metro.config.js` makes three changes to Expo's default Metro config:"},"796":{"id":"/frameworks/expo-67","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#metro-configuration","content":"**Enables package exports** (`resolver.unstable_enablePackageExports: true`), because the OSDK packages publish their entry points, such as `@osdk/client/observable`, through the `exports` field."},"797":{"id":"/frameworks/expo-68","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#metro-configuration","content":"**Resolves `@osdk` packages with the `browser`, `require`, and `import` conditions**, so Metro picks their browser builds on every platform."},"798":{"id":"/frameworks/expo-69","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#metro-configuration","content":"**Loads `.env.development` with `dotenv`** and adds `react-native-svg-transformer` for `.svg` imports."},"799":{"id":"/frameworks/expo-70","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#metro-configuration","content":"Keep the first two if you replace the file. The template adds no polyfills."},"800":{"id":"/frameworks/expo-71","page_id":"/frameworks/expo","tags":[],"type":"text","url":"/frameworks/expo#deploy-the-web-build","content":"`npm run build` exports the web build to `dist/`, which `foundry.config.json` points at. Register your site's root URL as a redirect URL first, then follow Hosting. Publishing to the App Store or Google Play uses Expo's own build tooling and is not covered by the template."},"801":{"id":"/frameworks/node","page_id":"/frameworks/node","type":"page","content":"Node.js","breadcrumbs":["OSDK TypeScript","Guides","Frameworks"],"tags":[],"url":"/frameworks/node"},"802":{"id":"/frameworks/node-0","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node","content":"Use @osdk/client in Node.js scripts, servers, and serverless functions, with service-user or token auth, custom fetch, and a bulk-edit example."},"803":{"id":"/frameworks/node-1","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#requirements","content":"Requirements"},"804":{"id":"/frameworks/node-2","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#install","content":"Install"},"805":{"id":"/frameworks/node-3","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#authenticate","content":"Authenticate"},"806":{"id":"/frameworks/node-4","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#create-the-client","content":"Create the client"},"807":{"id":"/frameworks/node-5","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#environment-variables","content":"Environment variables"},"808":{"id":"/frameworks/node-6","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"Page through every object and apply an action"},"809":{"id":"/frameworks/node-7","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#apply-in-batches","content":"Apply in batches"},"810":{"id":"/frameworks/node-8","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#use-a-custom-fetch","content":"Use a custom `fetch`"},"811":{"id":"/frameworks/node-9","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#logging","content":"Logging"},"812":{"id":"/frameworks/node-10","page_id":"/frameworks/node","type":"heading","tags":[],"url":"/frameworks/node#servers-and-serverless-functions","content":"Servers and serverless functions"},"813":{"id":"/frameworks/node-11","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node","content":"`@osdk/client` runs in Node.js without a browser or bundler, so you can query the Ontology and apply actions from scripts, backend services, scheduled jobs, and serverless functions. This page covers what changes outside the browser: authentication, module format, `fetch`, and configuration."},"814":{"id":"/frameworks/node-12","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#requirements","content":"| Requirement | Details                                                                                                                          |\n| ----------- | -------------------------------------------------------------------------------------------------------------------------------- |\n| Node.js     | A version with a global `fetch`: Node 18 or later. The client and `@osdk/oauth` use `globalThis.fetch` unless you pass your own. |","table":"table-0"},"815":{"id":"/frameworks/node-13","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#requirements","content":"| Requirement   | Details                                                                                                                                                                                                                                     |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Module format | `@osdk/client`, `@osdk/api`, `@osdk/oauth`, and generated SDKs ship both ESM and CommonJS builds. The samples on this page use top-level `await`, which needs ESM: set `\"type\": \"module\"` in `package.json` or use `.mjs` and `.mts` files. |","table":"table-0"},"816":{"id":"/frameworks/node-14","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#requirements","content":"| Requirement | Details                                                                                                                                                                                                                                                                              |\n| ----------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| TypeScript  | Set `\"module\": \"NodeNext\"` (or `\"moduleResolution\": \"Bundler\"` if you bundle). Older `node` resolution ignores package `exports` and cannot find subpaths such as `@osdk/client/unstable-do-not-use`. With `NodeNext`, relative imports need a `.js` extension, as in `./client.js`. |","table":"table-0"},"817":{"id":"/frameworks/node-15","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#requirements","content":"Subscriptions work in Node without a polyfill: `@osdk/client` depends on `ws` and uses it for WebSocket connections in Node."},"818":{"id":"/frameworks/node-16","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#install","content":"Install the client, the OAuth helpers, and your generated SDK. The SDK comes from your Foundry npm registry, so set up `.npmrc` first as described in Installation."},"819":{"id":"/frameworks/node-17","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#install","content":"`@osdk/react` is not needed in Node."},"820":{"id":"/frameworks/node-18","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#authenticate","content":"A Node process has no browser to run the sign-in redirect, so `createPublicOauthClient` does not apply. Use one of these instead:"},"821":{"id":"/frameworks/node-19","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#authenticate","content":"| Token provider                                     | Requests run as                                                     | Use it for                                                                                                          |\n| -------------------------------------------------- | ------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------- |\n| `createConfidentialOauthClient` from `@osdk/oauth` | The service user of a confidential application in Developer Console | Servers, scheduled jobs, CI, and serverless functions. The client fetches a new token when the current one expires. |","table":"table-1"},"822":{"id":"/frameworks/node-20","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#authenticate","content":"| Token provider                                   | Requests run as                                           | Use it for                                                                                             |\n| ------------------------------------------------ | --------------------------------------------------------- | ------------------------------------------------------------------------------------------------------ |\n| A function that returns a token you already have | Whoever owns the token, such as you with a personal token | One-off scripts and local tools. The token is not refreshed; requests fail with `401` once it expires. |","table":"table-1"},"823":{"id":"/frameworks/node-21","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#authenticate","content":"Both options, and the scopes the confidential client requests, are covered on Authentication."},"824":{"id":"/frameworks/node-22","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#create-the-client","content":"Read the Foundry URL and credentials from environment variables and create one client at module scope. Other modules import it."},"825":{"id":"/frameworks/node-23","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#create-the-client","content":"`createClient` takes the same arguments in Node as in the browser; see Create a client for every option. Only an explicit `UNSTABLE_DO_NOT_USE_BRANCH` sets the branch in Node, because there is no page URL or meta tag to read it from."},"826":{"id":"/frameworks/node-24","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#environment-variables","content":"The OSDK packages do not read environment variables themselves. These names are a convention used on this page:"},"827":{"id":"/frameworks/node-25","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#environment-variables","content":"| Variable      | Used for                                                                           |\n| ------------- | ---------------------------------------------------------------------------------- |\n| `FOUNDRY_URL` | The base URL of your Foundry stack, such as `https://example.palantirfoundry.com`. |","table":"table-2"},"828":{"id":"/frameworks/node-26","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#environment-variables","content":"| Variable            | Used for                                  |\n| ------------------- | ----------------------------------------- |\n| `FOUNDRY_CLIENT_ID` | The confidential application's client ID. |","table":"table-2"},"829":{"id":"/frameworks/node-27","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#environment-variables","content":"| Variable                | Used for                                      |\n| ----------------------- | --------------------------------------------- |\n| `FOUNDRY_CLIENT_SECRET` | The confidential application's client secret. |","table":"table-2"},"830":{"id":"/frameworks/node-28","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#environment-variables","content":"| Variable        | Used for                                       |\n| --------------- | ---------------------------------------------- |\n| `FOUNDRY_TOKEN` | A bearer token, for the existing-token option. |","table":"table-2"},"831":{"id":"/frameworks/node-29","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#environment-variables","content":"Keep secrets out of source control. Locally, put them in a `.env` file that git ignores and load it with `node --env-file=.env` (Node 20.6 and later). In production, use your platform's secret store."},"832":{"id":"/frameworks/node-30","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"This script finds every `Employee` whose department is `Eng` and renames the department to `Engineering` with the `modifyEmployee` action. Pass `--dry-run` to validate each edit without applying it."},"833":{"id":"/frameworks/node-31","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"Run it with a TypeScript runner such as `tsx`, or compile it with `tsc` first:"},"834":{"id":"/frameworks/node-32","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"How it works:"},"835":{"id":"/frameworks/node-33","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"`asyncIter` fetches page after page until every matching object has loaded. It reads from a consistent snapshot, so each object arrives once even when data changes during the loop. Page size is chosen by the client; `asyncIter` has no `$pageSize` option."},"836":{"id":"/frameworks/node-34","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"The script collects primary keys first and applies the action afterwards. A long-running loop can outlive the snapshot, and `asyncIter` throws when the snapshot expires, so keep slow work out of the iteration."},"837":{"id":"/frameworks/node-35","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"Object parameters such as `employee` accept a primary key or a loaded object."},"838":{"id":"/frameworks/node-36","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"`applyAction` throws `ActionValidationError` when validation fails, with details in `error.validation`. Other request failures, such as a missing permission, throw `PalantirApiError` from `@osdk/client`. Catching per object lets the rest of the run continue."},"839":{"id":"/frameworks/node-37","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#page-through-every-object-and-apply-an-action","content":"With `{ $validateOnly: true }`, `applyAction` returns the validation result instead of applying the action. Its `result` is `\"VALID\"` or `\"INVALID\"`."},"840":{"id":"/frameworks/node-38","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#apply-in-batches","content":"`batchApplyAction` applies an array of parameter objects in one request, which is faster than one request per object. It does not support `$validateOnly`. Send the edits in chunks:"},"841":{"id":"/frameworks/node-39","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#apply-in-batches","content":"Pass `{ $returnEdits: true }` as the second argument to get the objects each batch added and modified."},"842":{"id":"/frameworks/node-40","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#use-a-custom-fetch","content":"Pass a `fetch` implementation as the fifth argument of `createClient`, and as the `fetchFn` argument of `createConfidentialOauthClient` so token requests use it too. A common reason is a stack whose TLS certificate is signed by a private certificate authority. With `undici`:"},"843":{"id":"/frameworks/node-41","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#use-a-custom-fetch","content":"Passing `undefined` for the scopes keeps the default scopes."},"844":{"id":"/frameworks/node-42","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#logging","content":"By default the client prints errors to the console. Pass a `logger` to route its output elsewhere. The `Logger` interface from `@osdk/api` matches pino, so a pino logger works as-is:"},"845":{"id":"/frameworks/node-43","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#servers-and-serverless-functions","content":"Create the client once at module scope, not per request. The token provider caches its access token in memory, so reusing the client avoids a token request for every call. In serverless functions, warm invocations reuse the module and its client."},"846":{"id":"/frameworks/node-44","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#servers-and-serverless-functions","content":"A confidential client acts as one service user for every request. To run a request as the user who called your server, create a client per request with that user's token, and do not share it across users."},"847":{"id":"/frameworks/node-45","page_id":"/frameworks/node","tags":[],"type":"text","url":"/frameworks/node#servers-and-serverless-functions","content":"Never ship the client secret to a browser. Keep `createConfidentialOauthClient` in server code only."},"848":{"id":"/frameworks/typescript-library","page_id":"/frameworks/typescript-library","type":"page","content":"TypeScript library","breadcrumbs":["OSDK TypeScript","Guides","Frameworks"],"tags":[],"url":"/frameworks/typescript-library"},"849":{"id":"/frameworks/typescript-library-0","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library","content":"Scaffold a standalone TypeScript package with the create-app typescript-library template, and add OSDK code that apps can share."},"850":{"id":"/frameworks/typescript-library-1","page_id":"/frameworks/typescript-library","type":"heading","tags":[],"url":"/frameworks/typescript-library#when-to-use-it","content":"When to use it"},"851":{"id":"/frameworks/typescript-library-2","page_id":"/frameworks/typescript-library","type":"heading","tags":[],"url":"/frameworks/typescript-library#create-the-library","content":"Create the library"},"852":{"id":"/frameworks/typescript-library-3","page_id":"/frameworks/typescript-library","type":"heading","tags":[],"url":"/frameworks/typescript-library#project-structure","content":"Project structure"},"853":{"id":"/frameworks/typescript-library-4","page_id":"/frameworks/typescript-library","type":"heading","tags":[],"url":"/frameworks/typescript-library#scripts","content":"Scripts"},"854":{"id":"/frameworks/typescript-library-5","page_id":"/frameworks/typescript-library","type":"heading","tags":[],"url":"/frameworks/typescript-library#add-osdk-code","content":"Add OSDK code"},"855":{"id":"/frameworks/typescript-library-6","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library","content":"The `typescript-library` template of `@osdk/create-app` creates a TypeScript package that builds ESM and type declarations with `tsc`, tests with Vitest, and lints with Ultracite. Use it to start a package of shared code, such as Ontology helpers that several of your OSDK apps import."},"856":{"id":"/frameworks/typescript-library-7","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library","content":"This template is beta and hidden from the CLI's framework list. Select it with `--template typescript-library`. It contains no OSDK code or dependencies; you add those yourself."},"857":{"id":"/frameworks/typescript-library-8","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#when-to-use-it","content":"| You want to                                                        | Use           |\n| ------------------------------------------------------------------ | ------------- |\n| Share functions, types, or object-set helpers between several apps | This template |","table":"table-0"},"858":{"id":"/frameworks/typescript-library-9","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#when-to-use-it","content":"| You want to         | Use                                                     |\n| ------------------- | ------------------------------------------------------- |\n| Build a browser app | The `react`, `vue`, or `expo` template. See Quickstart. |","table":"table-0"},"859":{"id":"/frameworks/typescript-library-10","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#when-to-use-it","content":"| You want to                                  | Use                                |\n| -------------------------------------------- | ---------------------------------- |\n| Run a script, server, or serverless function | A plain Node project. See Node.js. |","table":"table-0"},"860":{"id":"/frameworks/typescript-library-11","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#create-the-library","content":"Run `@osdk/create-app` with the template, and pass `--skipOsdk` to skip the SDK prompts. `--skipOsdk` only works with an explicit `--sdkVersion 2.x`:"},"861":{"id":"/frameworks/typescript-library-12","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#create-the-library","content":"The CLI still asks for a Foundry URL, application RID, and client ID, and writes `.env.development`, `.env.production`, `.npmrc`, and `foundry.config.json` from them. The library does not read the `.env` files or `foundry.config.json`; delete them if you do not need them. Keep `.npmrc` if you will install your SDK from the Foundry registry."},"862":{"id":"/frameworks/typescript-library-13","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#create-the-library","content":"Then install and build:"},"863":{"id":"/frameworks/typescript-library-14","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\".nvmrc\" />"},"864":{"id":"/frameworks/typescript-library-15","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"AGENTS.md\" />"},"865":{"id":"/frameworks/typescript-library-16","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"oxfmt.config.ts\" />"},"866":{"id":"/frameworks/typescript-library-17","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"oxlint.config.ts\" />"},"867":{"id":"/frameworks/typescript-library-18","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"package.json\" />"},"868":{"id":"/frameworks/typescript-library-19","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"tsconfig.json\" />"},"869":{"id":"/frameworks/typescript-library-20","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"CLAUDE.md\" />"},"870":{"id":"/frameworks/typescript-library-21","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"settings.json\" />"},"871":{"id":"/frameworks/typescript-library-22","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"extensions.json\" />"},"872":{"id":"/frameworks/typescript-library-23","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"index.ts\" />"},"873":{"id":"/frameworks/typescript-library-24","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"<File name=\"index.test.ts\" />"},"874":{"id":"/frameworks/typescript-library-25","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File           | Purpose                                                                                                                     |\n| -------------- | --------------------------------------------------------------------------------------------------------------------------- |\n| `src/index.ts` | The package entry point. Everything it exports is the library's public API. The template exports a sample `greet` function. |","table":"table-1"},"875":{"id":"/frameworks/typescript-library-26","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File             | Purpose                                                     |\n| ---------------- | ----------------------------------------------------------- |\n| `src/__tests__/` | Vitest tests. `tsconfig.json` excludes them from the build. |","table":"table-1"},"876":{"id":"/frameworks/typescript-library-27","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File           | Purpose                                                                                                               |\n| -------------- | --------------------------------------------------------------------------------------------------------------------- |\n| `package.json` | An ESM package (`\"type\": \"module\"`) whose `exports`, `main`, and `types` point at `dist/`. Only `dist/` is published. |","table":"table-1"},"877":{"id":"/frameworks/typescript-library-28","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File            | Purpose                                                                                                                   |\n| --------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `tsconfig.json` | Strict settings that compile `src/` to `dist/` with declaration files, declaration maps, and source maps. Targets ES2022. |","table":"table-1"},"878":{"id":"/frameworks/typescript-library-29","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File                                  | Purpose                                                                                                                 |\n| ------------------------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `oxlint.config.ts`, `oxfmt.config.ts` | The Ultracite presets for oxlint and oxfmt. Lint warns on function expressions and prefers named function declarations. |","table":"table-1"},"879":{"id":"/frameworks/typescript-library-30","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File     | Purpose                  |\n| -------- | ------------------------ |\n| `.nvmrc` | Pins Node.js `v24.14.1`. |","table":"table-1"},"880":{"id":"/frameworks/typescript-library-31","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File                    | Purpose                                                                                                                   |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `AGENTS.md`, `.claude/` | Coding standards for AI agents. `.claude/settings.json` runs `npx ultracite fix` after every file edit Claude Code makes. |","table":"table-1"},"881":{"id":"/frameworks/typescript-library-32","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#project-structure","content":"| File                      | Purpose                       |\n| ------------------------- | ----------------------------- |\n| `.vscode/extensions.json` | Recommends the Oxc extension. |","table":"table-1"},"882":{"id":"/frameworks/typescript-library-33","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script  | Runs  | Does                                                           |\n| ------- | ----- | -------------------------------------------------------------- |\n| `build` | `tsc` | Type-checks and emits JavaScript and `.d.ts` files to `dist/`. |","table":"table-2"},"883":{"id":"/frameworks/typescript-library-34","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script  | Runs          | Does                      |\n| ------- | ------------- | ------------------------- |\n| `clean` | `rm -rf dist` | Deletes the build output. |","table":"table-2"},"884":{"id":"/frameworks/typescript-library-35","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script | Runs         | Does                 |\n| ------ | ------------ | -------------------- |\n| `test` | `vitest run` | Runs the tests once. |","table":"table-2"},"885":{"id":"/frameworks/typescript-library-36","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script       | Runs     | Does                          |\n| ------------ | -------- | ----------------------------- |\n| `test:watch` | `vitest` | Runs the tests in watch mode. |","table":"table-2"},"886":{"id":"/frameworks/typescript-library-37","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script | Runs              | Does                              |\n| ------ | ----------------- | --------------------------------- |\n| `lint` | `ultracite check` | Checks formatting and lint rules. |","table":"table-2"},"887":{"id":"/frameworks/typescript-library-38","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script | Runs            | Does                              |\n| ------ | --------------- | --------------------------------- |\n| `fix`  | `ultracite fix` | Fixes formatting and lint issues. |","table":"table-2"},"888":{"id":"/frameworks/typescript-library-39","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"| Script   | Runs      | Does                |\n| -------- | --------- | ------------------- |\n| `format` | `oxfmt .` | Formats every file. |","table":"table-2"},"889":{"id":"/frameworks/typescript-library-40","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#scripts","content":"The generated `README.md` mentions `npm run check`. The script is named `lint`."},"890":{"id":"/frameworks/typescript-library-41","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#add-osdk-code","content":"Install `@osdk/client` and your SDK. Your SDK comes from your Foundry npm registry, so set up `.npmrc` first as described in Installation:"},"891":{"id":"/frameworks/typescript-library-42","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#add-osdk-code","content":"Also list both in `peerDependencies`, so an app that installs your library provides them. The app and your library then share one `@osdk/client` and one copy of the SDK. Your generated SDK already declares `@osdk/client` as a peer."},"892":{"id":"/frameworks/typescript-library-43","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#add-osdk-code","content":"Take the `Client` as a parameter instead of creating one in the library. The app keeps a single client with its own authentication, and your functions use it:"},"893":{"id":"/frameworks/typescript-library-44","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#add-osdk-code","content":"Export it from the entry point:"},"894":{"id":"/frameworks/typescript-library-45","page_id":"/frameworks/typescript-library","tags":[],"type":"text","url":"/frameworks/typescript-library#add-osdk-code","content":"`tsc` does not rewrite import paths. Write relative imports with the `.js` extension, as above, so `dist/` also loads in Node.js without a bundler. Create a client lists the client methods you can call."},"895":{"id":"/frameworks/vue","page_id":"/frameworks/vue","type":"page","content":"Vue","breadcrumbs":["OSDK TypeScript","Guides","Frameworks"],"tags":[],"url":"/frameworks/vue"},"896":{"id":"/frameworks/vue-0","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue","content":"Build a Vue app on OSDK with the create-app Vue template, set up sign-in, and query objects and apply actions from components with @osdk/client."},"897":{"id":"/frameworks/vue-1","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#create-a-vue-app","content":"Create a Vue app"},"898":{"id":"/frameworks/vue-2","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#what-the-template-generates","content":"What the template generates"},"899":{"id":"/frameworks/vue-3","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#set-up-the-client-and-sign-in","content":"Set up the client and sign-in"},"900":{"id":"/frameworks/vue-4","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#query-objects-in-a-component","content":"Query objects in a component"},"901":{"id":"/frameworks/vue-5","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#refetch-when-inputs-change","content":"Refetch when inputs change"},"902":{"id":"/frameworks/vue-6","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#apply-an-action","content":"Apply an action"},"903":{"id":"/frameworks/vue-7","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#reactivity-tips","content":"Reactivity tips"},"904":{"id":"/frameworks/vue-8","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#keep-lists-live-with-the-observable-client","content":"Keep lists live with the observable client"},"905":{"id":"/frameworks/vue-9","page_id":"/frameworks/vue","type":"heading","tags":[],"url":"/frameworks/vue#deploy","content":"Deploy"},"906":{"id":"/frameworks/vue-10","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue","content":"Use `@osdk/client` directly from Vue components: there is no Vue-specific OSDK package. The `vue` template of `@osdk/create-app` gives you a Vite app with sign-in, routing, and a configured client."},"907":{"id":"/frameworks/vue-11","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#create-a-vue-app","content":"Run `@osdk/create-app` with the `vue` template:"},"908":{"id":"/frameworks/vue-12","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#create-a-vue-app","content":"The CLI asks for your Foundry URL, application RID, OAuth client ID, and SDK package, the same prompts as the React template. Quickstart lists every prompt and its flag. The template uses SDK version 2.x unless you pass `--sdkVersion 1.x`."},"909":{"id":"/frameworks/vue-13","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#create-a-vue-app","content":"Then install and start the dev server:"},"910":{"id":"/frameworks/vue-14","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#create-a-vue-app","content":"Open `http://localhost:8080`. `FOUNDRY_TOKEN` must be able to read your SDK's npm registry; see Installation."},"911":{"id":"/frameworks/vue-15","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\".env.development\" />"},"912":{"id":"/frameworks/vue-16","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\".env.production\" />"},"913":{"id":"/frameworks/vue-17","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\".npmrc\" />"},"914":{"id":"/frameworks/vue-18","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"foundry.config.json\" />"},"915":{"id":"/frameworks/vue-19","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"index.html\" />"},"916":{"id":"/frameworks/vue-20","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"package.json\" />"},"917":{"id":"/frameworks/vue-21","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"vite.config.ts\" />"},"918":{"id":"/frameworks/vue-22","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"AuthCallback.vue\" />"},"919":{"id":"/frameworks/vue-23","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"client.ts\" />"},"920":{"id":"/frameworks/vue-24","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"env.test.ts\" />"},"921":{"id":"/frameworks/vue-25","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"Home.vue\" />"},"922":{"id":"/frameworks/vue-26","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"main.ts\" />"},"923":{"id":"/frameworks/vue-27","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"router.ts\" />"},"924":{"id":"/frameworks/vue-28","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"Header.vue\" />"},"925":{"id":"/frameworks/vue-29","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"NextSteps.vue\" />"},"926":{"id":"/frameworks/vue-30","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"<File name=\"Osdk.vue\" />"},"927":{"id":"/frameworks/vue-31","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File                                  | Purpose                                                                                                                       |\n| ------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------- |\n| `.env.development`, `.env.production` | `VITE_FOUNDRY_API_URL`, `VITE_FOUNDRY_CLIENT_ID`, `VITE_FOUNDRY_REDIRECT_URL`, and `VITE_FOUNDRY_ONTOLOGY_RID` for each mode. |","table":"table-0"},"928":{"id":"/frameworks/vue-32","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File         | Purpose                                                                                 |\n| ------------ | --------------------------------------------------------------------------------------- |\n| `index.html` | Copies the env values into `<meta>` tags such as `osdk-foundryUrl` and `osdk-clientId`. |","table":"table-0"},"929":{"id":"/frameworks/vue-33","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File            | Purpose                                                                                                       |\n| --------------- | ------------------------------------------------------------------------------------------------------------- |\n| `src/client.ts` | Reads the meta tags, creates `auth` with `createPublicOauthClient`, and exports `client` from `createClient`. |","table":"table-0"},"930":{"id":"/frameworks/vue-34","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File            | Purpose                                                                 |\n| --------------- | ----------------------------------------------------------------------- |\n| `src/router.ts` | A `vue-router` router with `/` and the redirect route `/auth/callback`. |","table":"table-0"},"931":{"id":"/frameworks/vue-35","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File                   | Purpose                                        |\n| ---------------------- | ---------------------------------------------- |\n| `src/AuthCallback.vue` | Completes sign-in when Foundry redirects back. |","table":"table-0"},"932":{"id":"/frameworks/vue-36","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File              | Purpose                                                                                                                                      |\n| ----------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `src/env.test.ts` | Fails the test run when `.env.production` is missing a value or still has a `<placeholder>`. It runs only when `VERIFY_ENV_PRODUCTION=true`. |","table":"table-0"},"933":{"id":"/frameworks/vue-37","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File             | Purpose                                                                                  |\n| ---------------- | ---------------------------------------------------------------------------------------- |\n| `vite.config.ts` | Serves on port `8080`, defines `process.env.NODE_ENV`, and adds the optional CORS proxy. |","table":"table-0"},"934":{"id":"/frameworks/vue-38","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| File                  | Purpose                                         |\n| --------------------- | ----------------------------------------------- |\n| `foundry.config.json` | Settings for deploying to Foundry. See Hosting. |","table":"table-0"},"935":{"id":"/frameworks/vue-39","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"The generated `package.json` depends on `@osdk/client`, `@osdk/oauth`, `@osdk/foundry`, your SDK, `vue`, and `vue-router`, and has these scripts:"},"936":{"id":"/frameworks/vue-40","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| Script | Runs   |\n| ------ | ------ |\n| `dev`  | `vite` |","table":"table-1"},"937":{"id":"/frameworks/vue-41","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| Script  | Runs                                                                          |\n| ------- | ----------------------------------------------------------------------------- |\n| `build` | `vue-tsc && vite build`, which type-checks `.vue` files, then writes `dist/`. |","table":"table-1"},"938":{"id":"/frameworks/vue-42","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| Script | Runs         |\n| ------ | ------------ |\n| `test` | `vitest run` |","table":"table-1"},"939":{"id":"/frameworks/vue-43","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"| Script    | Runs           |\n| --------- | -------------- |\n| `preview` | `vite preview` |","table":"table-1"},"940":{"id":"/frameworks/vue-44","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#what-the-template-generates","content":"`vite.config.ts` aliases `vue` to `vue/dist/vue.esm-bundler`, the build that includes the template compiler, because `src/main.ts` mounts the root component from a template string (`\"<router-view />\"`). Keep the alias, or change `main.ts` to mount a compiled `.vue` component instead."},"941":{"id":"/frameworks/vue-45","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#set-up-the-client-and-sign-in","content":"`src/client.ts` exports one `auth` and one `client` for the whole app. It reads its configuration from the `<meta>` tags in `index.html`, so you can change values per environment without touching code:"},"942":{"id":"/frameworks/vue-46","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#set-up-the-client-and-sign-in","content":"The generated file also throws when a tag still holds an unreplaced `%VITE_...%` value, which means the variable is missing from your `.env` file."},"943":{"id":"/frameworks/vue-47","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#set-up-the-client-and-sign-in","content":"The first request starts sign-in. Foundry redirects back to `/auth/callback`, where `AuthCallback.vue` exchanges the code and returns to `/`:"},"944":{"id":"/frameworks/vue-48","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#set-up-the-client-and-sign-in","content":"`VITE_FOUNDRY_REDIRECT_URL` must exactly match a redirect URL on **OAuth & scopes** in Developer Console. Authentication covers scopes, token storage, and sign-out, all of which work the same in Vue."},"945":{"id":"/frameworks/vue-49","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#query-objects-in-a-component","content":"Call the client from `<script setup>` and keep the result in a `shallowRef`. This component loads the first page of engineers and keeps the list on screen while it reloads:"},"946":{"id":"/frameworks/vue-50","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#query-objects-in-a-component","content":"Every method on the client, including `fetchOne`, `asyncIter`, `aggregate`, and `$link`, works the same in Vue. See Use the client without React for the full API."},"947":{"id":"/frameworks/vue-51","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#refetch-when-inputs-change","content":"Use `watch` with `immediate: true` to load data from reactive inputs, such as a filter bound to a `<select>`. Mark each run as stale in `onCleanup`, so a slow response for an old value cannot overwrite a newer one:"},"948":{"id":"/frameworks/vue-52","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#apply-an-action","content":"Put the action in its own component. Await `applyAction` inside `try`/`catch`, and emit an event on success so the parent reloads; the client does not update objects you already fetched:"},"949":{"id":"/frameworks/vue-53","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#apply-an-action","content":"In `EmployeeList.vue`, render `<PromoteButton :employee=\"employee\" @promoted=\"load\" />` inside each `<li>`. Validation failures throw `ActionValidationError`; Apply an action shows how to read them."},"950":{"id":"/frameworks/vue-54","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#reactivity-tips","content":"**Store results in `shallowRef`.** OSDK objects are frozen. Vue does not wrap frozen objects in reactive proxies, so changes are never detected inside them anyway. Replace the whole value when new data arrives."},"951":{"id":"/frameworks/vue-55","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#reactivity-tips","content":"**Never mutate an object to update the UI.** Assigning to `employee.jobTitle` throws in strict mode. Apply an action, then fetch again."},"952":{"id":"/frameworks/vue-56","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#reactivity-tips","content":"**Key lists by `$primaryKey`.** It is unique within an object type and stable across fetches."},"953":{"id":"/frameworks/vue-57","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#reactivity-tips","content":"**Create the client once.** Import `client` from `src/client.ts` in every component. Do not call `createClient` inside `setup`."},"954":{"id":"/frameworks/vue-58","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#reactivity-tips","content":"**Do not reach for `@osdk/react`.** Its hooks need React. For a shared cache in Vue, use the observable client below."},"955":{"id":"/frameworks/vue-59","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#keep-lists-live-with-the-observable-client","content":"`createObservableClient` from `@osdk/client/observable` is the cache that powers `@osdk/react`. It deduplicates requests, shares objects between subscribers, and refetches affected lists after an action you apply through it. Wrap it in a composable:"},"956":{"id":"/frameworks/vue-60","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#keep-lists-live-with-the-observable-client","content":"`watchEffect` resubscribes when `department()` changes and unsubscribes when the component unmounts. Call `useEmployees(() => props.department)` from `<script setup>`."},"957":{"id":"/frameworks/vue-61","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#keep-lists-live-with-the-observable-client","content":"Apply actions through `observableClient.applyAction(modifyEmployee, { ... })` instead of `client(modifyEmployee).applyAction(...)`. When it resolves, every subscribed list and object of the edited types refetches, so the component updates without a manual reload. It throws like `applyAction`, so await it in `try`/`catch`."},"958":{"id":"/frameworks/vue-62","page_id":"/frameworks/vue","tags":[],"type":"text","url":"/frameworks/vue#deploy","content":"`npm run build` writes the app to `dist/`, which `foundry.config.json` already points at. Before you build for production, set `VITE_FOUNDRY_REDIRECT_URL` in `.env.production` to your hosted app's `/auth/callback` and add that URL on **OAuth & scopes**. Hosting covers uploading the build to Foundry."},"959":{"id":"/guides/vite","page_id":"/guides/vite","type":"page","content":"Use OSDK with Vite","breadcrumbs":["OSDK TypeScript","Guides","Tools"],"tags":[],"url":"/guides/vite"},"960":{"id":"/guides/vite-0","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite","content":"Configure Vite for OSDK apps, including the process.env fix, a local CORS proxy to Foundry, and the OSDK Devtools plugin."},"961":{"id":"/guides/vite-1","page_id":"/guides/vite","type":"heading","tags":[],"url":"/guides/vite#define-processenvnode_env","content":"Define `process.env.NODE_ENV`"},"962":{"id":"/guides/vite-2","page_id":"/guides/vite","type":"heading","tags":[],"url":"/guides/vite#proxy-foundry-requests-in-development","content":"Proxy Foundry requests in development"},"963":{"id":"/guides/vite-3","page_id":"/guides/vite","type":"heading","tags":[],"url":"/guides/vite#proxy-the-api-paths","content":"Proxy the API paths"},"964":{"id":"/guides/vite-4","page_id":"/guides/vite","type":"heading","tags":[],"url":"/guides/vite#point-the-client-at-the-dev-server","content":"Point the client at the dev server"},"965":{"id":"/guides/vite-5","page_id":"/guides/vite","type":"heading","tags":[],"url":"/guides/vite#allow-the-redirect-url","content":"Allow the redirect URL"},"966":{"id":"/guides/vite-6","page_id":"/guides/vite","type":"heading","tags":[],"url":"/guides/vite#add-osdk-devtools","content":"Add OSDK Devtools"},"967":{"id":"/guides/vite-7","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite","content":"Vite is the default bundler for apps created with `@osdk/create-app`. This page covers the Vite settings an OSDK app needs and why."},"968":{"id":"/guides/vite-8","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite","content":"The React template in `@osdk/create-app` already includes these settings in its generated `vite.config.ts`. Read on if you add OSDK to an existing Vite app or want to know what the generated config does."},"969":{"id":"/guides/vite-9","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#define-processenvnode_env","content":"OSDK packages read `process.env.NODE_ENV` to decide how much to log and to strip development-only code from production builds. Vite does not replace `process.env` by default, so the browser throws:"},"970":{"id":"/guides/vite-10","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#define-processenvnode_env","content":"Tell Vite to replace `process.env.NODE_ENV` with the current mode:"},"971":{"id":"/guides/vite-11","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#define-processenvnode_env","content":"`vite dev` runs in `development` mode and `vite build` in `production` mode, so production bundles get `\"production\"`."},"972":{"id":"/guides/vite-12","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#proxy-foundry-requests-in-development","content":"The browser blocks requests from `http://localhost:8080` to your Foundry stack unless the stack allows that origin for CORS. If you cannot get localhost allowed, proxy the requests through the Vite dev server instead. `@osdk/create-app` generates this setup when you answer yes to the CORS proxy prompt or pass `--corsProxy true`:"},"973":{"id":"/guides/vite-13","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#proxy-the-api-paths","content":"Forward `/api` and `/multipass/api` to your Foundry URL:"},"974":{"id":"/guides/vite-14","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#point-the-client-at-the-dev-server","content":"Set the Foundry URL that the client uses to the dev server's origin, so requests go through the proxy:"},"975":{"id":"/guides/vite-15","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#point-the-client-at-the-dev-server","content":"Pass that URL to both `createPublicOauthClient` and `createClient`. The OAuth calls under `/multipass/api` and the data calls under `/api` then reach Foundry through the proxy."},"976":{"id":"/guides/vite-16","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#allow-the-redirect-url","content":"Add `http://localhost:8080/auth/callback` as a redirect URL on the OAuth client in Developer Console."},"977":{"id":"/guides/vite-17","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#allow-the-redirect-url","content":"The proxy runs only under `vite dev`. Production builds call Foundry directly, so keep the real Foundry URL in `.env.production`. Once your stack allows `http://localhost:8080` for CORS, you can remove the proxy and set `VITE_FOUNDRY_API_URL` back to the Foundry URL."},"978":{"id":"/guides/vite-18","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#add-osdk-devtools","content":"`@osdk/react-devtools` ships a Vite plugin that injects an inspection panel into your app during `vite dev` and does nothing in production builds:"},"979":{"id":"/guides/vite-19","page_id":"/guides/vite","tags":[],"type":"text","url":"/guides/vite#add-osdk-devtools","content":"See OSDK Devtools for installation, options, and the panel tabs."},"980":{"id":"/installation","page_id":"/installation","type":"page","content":"Installation","breadcrumbs":["OSDK TypeScript","Guides","Get started"],"tags":[],"url":"/installation"},"981":{"id":"/installation-0","page_id":"/installation","tags":[],"type":"text","url":"/installation","content":"Add @osdk/client, @osdk/oauth, @osdk/react, and your generated SDK to an existing app, with the npm registry setup and version rules they need."},"982":{"id":"/installation-1","page_id":"/installation","type":"heading","tags":[],"url":"/installation#before-you-start","content":"Before you start"},"983":{"id":"/installation-2","page_id":"/installation","type":"heading","tags":[],"url":"/installation#install","content":"Install"},"984":{"id":"/installation-3","page_id":"/installation","type":"heading","tags":[],"url":"/installation#point-your-sdks-scope-at-the-foundry-registry","content":"Point your SDK's scope at the Foundry registry"},"985":{"id":"/installation-4","page_id":"/installation","type":"heading","tags":[],"url":"/installation#install-the-client-packages-and-your-sdk","content":"Install the client packages and your SDK"},"986":{"id":"/installation-5","page_id":"/installation","type":"heading","tags":[],"url":"/installation#add-the-react-packages","content":"Add the React packages"},"987":{"id":"/installation-6","page_id":"/installation","type":"heading","tags":[],"url":"/installation#create-the-client","content":"Create the client"},"988":{"id":"/installation-7","page_id":"/installation","type":"heading","tags":[],"url":"/installation#version-compatibility","content":"Version compatibility"},"989":{"id":"/installation-8","page_id":"/installation","type":"heading","tags":[],"url":"/installation#optional-peers-for-platform-apis","content":"Optional peers for Platform APIs"},"990":{"id":"/installation-9","page_id":"/installation","type":"heading","tags":[],"url":"/installation#bundler-setup","content":"Bundler setup"},"991":{"id":"/installation-10","page_id":"/installation","tags":[],"type":"text","url":"/installation","content":"Add OSDK to an app you already have by installing the client packages and your generated SDK from your Foundry npm registry. To start from a new project with everything configured, use the Quickstart instead."},"992":{"id":"/installation-11","page_id":"/installation","tags":[],"type":"text","url":"/installation#before-you-start","content":"Generate an SDK for your application in Developer Console with the **npm** package type, and note three values from its install instructions:"},"993":{"id":"/installation-12","page_id":"/installation","tags":[],"type":"text","url":"/installation#before-you-start","content":"| Value            | Example       |\n| ---------------- | ------------- |\n| SDK package name | `@my-app/sdk` |","table":"table-0"},"994":{"id":"/installation-13","page_id":"/installation","tags":[],"type":"text","url":"/installation#before-you-start","content":"| Value            | Example                                                                                                                 |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| npm registry URL | `https://example.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.<id>/contents/release/npm` |","table":"table-0"},"995":{"id":"/installation-14","page_id":"/installation","tags":[],"type":"text","url":"/installation#before-you-start","content":"| Value         | Example                                                             |\n| ------------- | ------------------------------------------------------------------- |\n| Foundry token | A token that can read that registry. Keep it out of source control. |","table":"table-0"},"996":{"id":"/installation-15","page_id":"/installation","tags":[],"type":"text","url":"/installation#point-your-sdks-scope-at-the-foundry-registry","content":"The generated SDK is not on the public npm registry. Add two lines to `.npmrc` in your project root: one maps your SDK's scope to the Foundry registry, and one authenticates every request to Foundry's artifacts API with a token from the environment."},"997":{"id":"/installation-16","page_id":"/installation","tags":[],"type":"text","url":"/installation#point-your-sdks-scope-at-the-foundry-registry","content":"Replace `example.palantirfoundry.com` with your Foundry host, `@my-app` with your SDK's scope, and the registry URL with yours. Keep the trailing `/` on the registry URL, which pnpm requires. This is the same file `@osdk/create-app` writes."},"998":{"id":"/installation-17","page_id":"/installation","tags":[],"type":"text","url":"/installation#point-your-sdks-scope-at-the-foundry-registry","content":"Export the token before you install, and set it as a secret in CI:"},"999":{"id":"/installation-18","page_id":"/installation","tags":[],"type":"text","url":"/installation#install-the-client-packages-and-your-sdk","content":"| Package        | Why you need it                                               |\n| -------------- | ------------------------------------------------------------- |\n| `@osdk/client` | `createClient` and the runtime that runs queries and actions. |","table":"table-1"},"1000":{"id":"/installation-19","page_id":"/installation","tags":[],"type":"text","url":"/installation#install-the-client-packages-and-your-sdk","content":"| Package     | Why you need it                          |\n| ----------- | ---------------------------------------- |\n| `@osdk/api` | Types shared by the client and your SDK. |","table":"table-1"},"1001":{"id":"/installation-20","page_id":"/installation","tags":[],"type":"text","url":"/installation#install-the-client-packages-and-your-sdk","content":"| Package       | Why you need it                                           |\n| ------------- | --------------------------------------------------------- |\n| `@osdk/oauth` | Token providers for signing users in. See Authentication. |","table":"table-1"},"1002":{"id":"/installation-21","page_id":"/installation","tags":[],"type":"text","url":"/installation#install-the-client-packages-and-your-sdk","content":"| Package       | Why you need it                        |\n| ------------- | -------------------------------------- |\n| `@my-app/sdk` | Your Ontology's generated definitions. |","table":"table-1"},"1003":{"id":"/installation-22","page_id":"/installation","tags":[],"type":"text","url":"/installation#add-the-react-packages","content":"Skip this step if you do not use React."},"1004":{"id":"/installation-23","page_id":"/installation","tags":[],"type":"text","url":"/installation#add-the-react-packages","content":"`@osdk/react` supports React 17, 18, and 19. For prebuilt components, also install `@osdk/react-components`; its setup is on Components prerequisites."},"1005":{"id":"/installation-24","page_id":"/installation","tags":[],"type":"text","url":"/installation#create-the-client","content":"Create one client for your app and wrap your React tree in `OsdkProvider`. Create a client walks through both."},"1006":{"id":"/installation-25","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"`@osdk/client`, `@osdk/api`, and `@osdk/react` are released together and share a version number. `@osdk/react` imports its cache runtime from `@osdk/client/observable`, which is tied to the exact release line, so a mismatch fails at build time even when npm's peer ranges are satisfied."},"1007":{"id":"/installation-26","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"**Install the same version of all three.** If `@osdk/react` is `2.83.0`, use `@osdk/client@2.83.0` and `@osdk/api@2.83.0`."},"1008":{"id":"/installation-27","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"**Keep prereleases together.** A prerelease `@osdk/react`, such as `-beta.3`, needs the same prerelease of `@osdk/client` and `@osdk/api`. Pairing it with stable releases breaks."},"1009":{"id":"/installation-28","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"**Upgrade them in one command.** Bump the three packages together, and include `@osdk/react-components` if you use it:"},"1010":{"id":"/installation-29","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"**Your generated SDK has a peer dependency on `@osdk/client`.** It is set to the client version that generated it, so install an `@osdk/client` that satisfies the SDK's peer range. When you upgrade the client across many versions, generate a new SDK version too."},"1011":{"id":"/installation-30","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"A version mismatch usually shows up as one of these errors:"},"1012":{"id":"/installation-31","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"| Error                                                                             | Cause                                                                                                                            | Fix                                                                                 |\n| --------------------------------------------------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------- |\n| `\"<name>\" is not exported by @osdk/client/.../observable.js` (or `@osdk/api/...`) | `@osdk/client` or `@osdk/api` is on a different release line than `@osdk/react`, often a prerelease paired with stable versions. | Install the exact `@osdk/client` and `@osdk/api` versions that match `@osdk/react`. |","table":"table-2"},"1013":{"id":"/installation-32","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"| Error                                                      | Cause                                                                                                                                                    | Fix                                                        |\n| ---------------------------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------------------- |\n| npm or pnpm peer warning for `@osdk/client` or `@osdk/api` | The declared peer ranges allow newer `@osdk/client` and `@osdk/api` releases than `@osdk/react` was built with, and, since `2.87.0`, warn on older ones. | Pin the matching versions instead of ignoring the warning. |","table":"table-2"},"1014":{"id":"/installation-33","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"Before `2.15.0`, `@osdk/react` was versioned separately (`0.x`). To find the `@osdk/client` and `@osdk/api` versions it was built against:"},"1015":{"id":"/installation-34","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"Open `node_modules/@osdk/react/CHANGELOG.md`."},"1016":{"id":"/installation-35","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"Find the heading for your installed `@osdk/react` version."},"1017":{"id":"/installation-36","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"If that entry has an **Updated dependencies** section, install the exact `@osdk/client` and `@osdk/api` versions it lists."},"1018":{"id":"/installation-37","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"If it does not, walk back to the closest earlier entry that does, and use those versions."},"1019":{"id":"/installation-38","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"Upgrading to `2.15.0` or later is simpler: from then on the three versions match."},"1020":{"id":"/installation-39","page_id":"/installation","tags":[],"type":"text","url":"/installation#version-compatibility","content":"If npm reports a peer conflict for OSDK packages after you have aligned versions, tell it to reuse your direct dependency versions with `overrides`:"},"1021":{"id":"/installation-40","page_id":"/installation","tags":[],"type":"text","url":"/installation#optional-peers-for-platform-apis","content":"Hooks from `@osdk/react/platform-apis`, such as `useCurrentFoundryUser`, `useFoundryUser`, and `useMarkings`, call Foundry Platform APIs through two optional peer dependencies. Install them only if you import from that entry point:"},"1022":{"id":"/installation-41","page_id":"/installation","tags":[],"type":"text","url":"/installation#optional-peers-for-platform-apis","content":"Without them, a build that imports `@osdk/react/platform-apis` fails with `Rollup failed to resolve import \"@osdk/foundry.admin\"` (or `@osdk/foundry.core`). See Platform APIs."},"1023":{"id":"/installation-42","page_id":"/installation","tags":[],"type":"text","url":"/installation#bundler-setup","content":"OSDK packages read `process.env.NODE_ENV`, which Vite does not define by default. Without it the browser throws `ReferenceError: process is not defined`. Use OSDK with Vite shows the `define` setting and a local CORS proxy to Foundry."},"1024":{"id":"/ontology-as-code/import","page_id":"/ontology-as-code/import","type":"page","content":"Import existing types","breadcrumbs":["OSDK TypeScript","Guides","Ontology as code"],"tags":[],"url":"/ontology-as-code/import"},"1025":{"id":"/ontology-as-code/import-0","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import","content":"Convert an existing Foundry ontology's metadata into TypeScript with @osdk/maker-import, and reference those types from your ontology-as-code definitions."},"1026":{"id":"/ontology-as-code/import-1","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#install","content":"Install"},"1027":{"id":"/ontology-as-code/import-2","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#get-the-ontology-metadata","content":"Get the ontology metadata"},"1028":{"id":"/ontology-as-code/import-3","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#generate-the-modules","content":"Generate the modules"},"1029":{"id":"/ontology-as-code/import-4","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#use-imported-types","content":"Use imported types"},"1030":{"id":"/ontology-as-code/import-5","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#what-is-converted","content":"What is converted"},"1031":{"id":"/ontology-as-code/import-6","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#use-it-from-code","content":"Use it from code"},"1032":{"id":"/ontology-as-code/import-7","page_id":"/ontology-as-code/import","type":"heading","tags":[],"url":"/ontology-as-code/import#share-types-between-ontology-as-code-projects","content":"Share types between ontology-as-code projects"},"1033":{"id":"/ontology-as-code/import-8","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import","content":"`@osdk/maker-import` turns the metadata of an ontology that already exists in Foundry into TypeScript modules. Import those modules into your `.ontology/ontology.mts` file to link to, implement, or reuse existing types without redefining them."},"1034":{"id":"/ontology-as-code/import-9","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import","content":"Imported types are references, not definitions: maker writes them to the IR's `importedOntology` section, and your ontology does not create or change them."},"1035":{"id":"/ontology-as-code/import-10","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#get-the-ontology-metadata","content":"`maker-import` reads an `OntologyFullMetadata` JSON file, the response of the Foundry endpoint `GET /api/v2/ontologies/{ontology}/fullMetadata`. Two ways to get it:"},"1036":{"id":"/ontology-as-code/import-11","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#get-the-ontology-metadata","content":"**From the OSDK CLI.** `osdk unstable typescript generate` with `--foundryUrl`, `--clientId`, and `--ontologyWritePath ontology-full-metadata.json` signs you in, fetches the metadata, and writes it to that path while it generates an SDK."},"1037":{"id":"/ontology-as-code/import-12","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#get-the-ontology-metadata","content":"**From the API.** Call the endpoint with a token that can read the ontology, and save the response."},"1038":{"id":"/ontology-as-code/import-13","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#generate-the-modules","content":"| Option          | Type     | Default | Description                                     |\n| --------------- | -------- | ------- | ----------------------------------------------- |\n| `-i`, `--input` | `string` |         | Required. The `OntologyFullMetadata` JSON file. |","table":"table-0"},"1039":{"id":"/ontology-as-code/import-14","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#generate-the-modules","content":"| Option           | Type     | Default               | Description           |\n| ---------------- | -------- | --------------------- | --------------------- |\n| `-o`, `--output` | `string` | `./generated-imports` | The output directory. |","table":"table-0"},"1040":{"id":"/ontology-as-code/import-15","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#generate-the-modules","content":"The output has one module per type and an `index.ts` that re-exports them all:"},"1041":{"id":"/ontology-as-code/import-16","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#generate-the-modules","content":"<File name=\"index.ts\" />"},"1042":{"id":"/ontology-as-code/import-17","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#generate-the-modules","content":"Each export is named after the type's API name, without its namespace, in camelCase: `Employee` becomes `employee` and `modify-employee` becomes `modifyEmployee`. When two types share a short name, both use the full API name instead, such as `comExampleEmployee`, and any remaining clash gets a numeric suffix. Each run deletes and rewrites the four `codegen` folders."},"1043":{"id":"/ontology-as-code/import-18","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#use-imported-types","content":"Each export is a proxy. The first time your ontology reads one of its properties, maker records the type as imported, along with the shared property types its properties use. Exports you never touch stay out of the IR."},"1044":{"id":"/ontology-as-code/import-19","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#use-imported-types","content":"The generated modules are TypeScript files that import each other with `.js` extensions, so Node cannot load them as they are. Compile the output directory with `tsc` as an ES module project before you run maker, or publish it as a compiled package. The example above imports the compiled `./imports/index.js`."},"1045":{"id":"/ontology-as-code/import-20","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#use-imported-types","content":"An interface link constraint or an interface action type constraint cannot start from an imported interface. Define them only on interfaces in your own ontology."},"1046":{"id":"/ontology-as-code/import-21","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"| Metadata              | Converted to         | Notes                                          |\n| --------------------- | -------------------- | ---------------------------------------------- |\n| Shared property types | `SharedPropertyType` | API name, display name, description, and type. |","table":"table-1"},"1047":{"id":"/ontology-as-code/import-22","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"| Metadata   | Converted to    | Notes                                                                                                                                                             |\n| ---------- | --------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Interfaces | `InterfaceType` | Properties, including interface-defined properties, links, and the interfaces they extend. Status is always active, and action type constraints are not included. |","table":"table-1"},"1048":{"id":"/ontology-as-code/import-23","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"| Metadata     | Converted to | Notes                                                                                                                                                                         |\n| ------------ | ------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Object types | `ObjectType` | Properties, primary key, title, description, visibility, and shared property types. Status is active or experimental. `pluralDisplayName` is the display name with `s` added. |","table":"table-1"},"1049":{"id":"/ontology-as-code/import-24","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"| Metadata     | Converted to | Notes                                                                   |\n| ------------ | ------------ | ----------------------------------------------------------------------- |\n| Action types | `ActionType` | Parameters only, with no logic rules. Status is active or experimental. |","table":"table-1"},"1050":{"id":"/ontology-as-code/import-25","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"| Metadata   | Converted to  | Notes                                                     |\n| ---------- | ------------- | --------------------------------------------------------- |\n| Link types | Not converted | Define links to imported object types yourself, as above. |","table":"table-1"},"1051":{"id":"/ontology-as-code/import-26","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"Marking properties are imported with the marking input name `not-applicable`, because the existing type already owns its marking configuration."},"1052":{"id":"/ontology-as-code/import-27","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"`maker-import` throws on types it cannot represent, naming the type:"},"1053":{"id":"/ontology-as-code/import-28","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"Property types other than the primitive, geospatial, media, attachment, marking, struct, array, vector, and geotime series types. A marking property must have a `markingType`."},"1054":{"id":"/ontology-as-code/import-29","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"Struct fields that are arrays or structs, and struct main values that are arrays."},"1055":{"id":"/ontology-as-code/import-30","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"Vector properties that support more than one search similarity function, or whose embedding model is missing settings."},"1056":{"id":"/ontology-as-code/import-31","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#what-is-converted","content":"Vector action parameters, and action parameter types with no maker equivalent."},"1057":{"id":"/ontology-as-code/import-32","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#use-it-from-code","content":"The package also exports the conversion functions:"},"1058":{"id":"/ontology-as-code/import-33","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#use-it-from-code","content":"| Function                                | Returns              | Description                                                                                                |\n| --------------------------------------- | -------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `convertOntologyFullMetadata(metadata)` | `OntologyDefinition` | Converts the metadata to maker's in-memory form, keyed by entity kind and API name, without writing files. |","table":"table-2"},"1059":{"id":"/ontology-as-code/import-34","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#use-it-from-code","content":"| Function                                     | Returns | Description                                                    |\n| -------------------------------------------- | ------- | -------------------------------------------------------------- |\n| `writeImportedOntology(metadata, outputDir)` | `void`  | Converts the metadata and writes the modules, as the CLI does. |","table":"table-2"},"1060":{"id":"/ontology-as-code/import-35","page_id":"/ontology-as-code/import","tags":[],"type":"text","url":"/ontology-as-code/import#share-types-between-ontology-as-code-projects","content":"To reuse types from another ontology-as-code project instead of from Foundry, compile that project with `maker --outputDir`. Maker writes the same module layout, plus `link-types` and `value-types` folders, and its `index.ts` records the package's namespace and version when it loads, so a consuming project can list it with `maker --dependencies <file>`. As with `maker-import` output, compile or publish the modules before you import them."},"1061":{"id":"/ontology-as-code","page_id":"/ontology-as-code","type":"page","content":"Ontology as code","breadcrumbs":["OSDK TypeScript","Guides","Ontology as code"],"tags":[],"url":"/ontology-as-code"},"1062":{"id":"/ontology-as-code-0","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code","content":"Define object types, links, actions, and interfaces in TypeScript with @osdk/maker, compile them to Ontology IR, and develop against them locally."},"1063":{"id":"/ontology-as-code-1","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#packages","content":"Packages"},"1064":{"id":"/ontology-as-code-2","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#how-it-works","content":"How it works"},"1065":{"id":"/ontology-as-code-3","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#install","content":"Install"},"1066":{"id":"/ontology-as-code-4","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#project-layout","content":"Project layout"},"1067":{"id":"/ontology-as-code-5","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#write-an-ontology","content":"Write an ontology"},"1068":{"id":"/ontology-as-code-6","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#api-names-and-namespaces","content":"API names and namespaces"},"1069":{"id":"/ontology-as-code-7","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#maker-cli","content":"`maker` CLI"},"1070":{"id":"/ontology-as-code-8","page_id":"/ontology-as-code","type":"heading","tags":[],"url":"/ontology-as-code#next-steps","content":"Next steps"},"1071":{"id":"/ontology-as-code-9","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code","content":"Ontology as code lets you define Ontology types in TypeScript files that live next to your app. `@osdk/maker` validates the definitions and compiles them into an Ontology intermediate representation (IR) file, and `@osdk/vite-plugin-oac` turns that IR into a generated SDK and a mock Foundry server for local development."},"1072":{"id":"/ontology-as-code-10","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code","content":"Every ontology-as-code package is pre-1.0 (`@osdk/maker` 0.82, `@osdk/vite-plugin-oac` 0.85, `@osdk/maker-import` 0.48) and treated as experimental. Definitions, CLI flags, and the IR format can change in any release. Pin exact versions and read the changelog before you upgrade."},"1073":{"id":"/ontology-as-code-11","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#packages","content":"| Package       | What it does                                                                                      |\n| ------------- | ------------------------------------------------------------------------------------------------- |\n| `@osdk/maker` | The `define*` functions you write your ontology with, and the `maker` CLI that compiles it to IR. |","table":"table-0"},"1074":{"id":"/ontology-as-code-12","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#packages","content":"| Package                 | What it does                                                                                                                                                  |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `@osdk/vite-plugin-oac` | A Vite plugin that compiles the ontology on every change, generates an SDK from it, and serves a mock Foundry API from the dev server. See Local development. |","table":"table-0"},"1075":{"id":"/ontology-as-code-13","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#packages","content":"| Package              | What it does                                                                                                                                    |\n| -------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------- |\n| `@osdk/maker-import` | Converts the metadata of an existing Foundry ontology into TypeScript files you can reference from your definitions. See Import existing types. |","table":"table-0"},"1076":{"id":"/ontology-as-code-14","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#packages","content":"| Package                                     | What it does                                                                       |\n| ------------------------------------------- | ---------------------------------------------------------------------------------- |\n| `@osdk/seed-helpers`, `@osdk/seed-compiler` | Build seed objects and links for the local Ontology server. See Local development. |","table":"table-0"},"1077":{"id":"/ontology-as-code-15","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#how-it-works","content":"**Define.** You write object types, links, actions, interfaces, shared property types, and value types in `.ontology/ontology.mts`. Each `define*` call validates its input and registers the type."},"1078":{"id":"/ontology-as-code-16","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#how-it-works","content":"**Compile.** The `maker` CLI imports that file and writes the IR to `ontology.json`, plus `value-types.json` when you define value types."},"1079":{"id":"/ontology-as-code-17","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#how-it-works","content":"**Develop locally.** In a Vite app, `@osdk/vite-plugin-oac` runs `maker` on every change, converts the IR to Ontology metadata, generates an SDK into `.osdk/src`, and answers OSDK requests from the dev server with seeded data."},"1080":{"id":"/ontology-as-code-18","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#how-it-works","content":"**Ship.** The IR file is the artifact. None of these packages uploads or installs it into a Foundry stack."},"1081":{"id":"/ontology-as-code-19","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#install","content":"`@osdk/maker` installs a `maker` binary. For local development, also install the Vite plugin; see Local development."},"1082":{"id":"/ontology-as-code-20","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#install","content":"The CLI loads your ontology file with Node's own `import()`, so a `.mts` or `.ts` entry file needs a Node.js version that strips TypeScript types natively: 22.18 or later, or 23.6 or later. On older versions, write the file as `.mjs`."},"1083":{"id":"/ontology-as-code-21","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"<File name=\"ontology.mts\" />"},"1084":{"id":"/ontology-as-code-22","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"<File name=\"seed.ts\" />"},"1085":{"id":"/ontology-as-code-23","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"<File name=\"ontology-schema-lock.json\" />"},"1086":{"id":"/ontology-as-code-24","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"<File name=\"package.json\" />"},"1087":{"id":"/ontology-as-code-25","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"<File name=\"vite.config.ts\" />"},"1088":{"id":"/ontology-as-code-26","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"| Path                     | Purpose                                                         |\n| ------------------------ | --------------------------------------------------------------- |\n| `.ontology/ontology.mts` | Your definitions. The Vite plugin reads exactly this file name. |","table":"table-1"},"1089":{"id":"/ontology-as-code-27","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"| Path                | Purpose                                       |\n| ------------------- | --------------------------------------------- |\n| `.ontology/seed.ts` | Mock data for the Vite plugin's local server. |","table":"table-1"},"1090":{"id":"/ontology-as-code-28","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"| Path                                  | Purpose                                                                                    |\n| ------------------------------------- | ------------------------------------------------------------------------------------------ |\n| `.ontology/ontology-schema-lock.json` | Written by `maker --write-locks` once an interface opts into schema migrations. Commit it. |","table":"table-1"},"1091":{"id":"/ontology-as-code-29","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#project-layout","content":"| Path        | Purpose                                                    |\n| ----------- | ---------------------------------------------------------- |\n| `.osdk/src` | The SDK the Vite plugin generates. Do not edit it by hand. |","table":"table-1"},"1092":{"id":"/ontology-as-code-30","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#write-an-ontology","content":"The ontology file is a module whose top-level `define*` calls register types as they run. Export each result so other files, such as a seed file or another ontology, can import it."},"1093":{"id":"/ontology-as-code-31","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#write-an-ontology","content":"This file defines the `Employee` and `Office` object types, the links between them, a `Worker` interface, and a `modifyEmployee` action:"},"1094":{"id":"/ontology-as-code-32","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#write-an-ontology","content":"In the SDK generated from this file, `Employee` has the links `office` and `lead` (one object each) and `reports` (many), `Office` has `occupants`, and the action is `modifyEmployee`: action API names must be lowercase and hyphenated, and the SDK generator converts them to camelCase. The `leadId` and `officeId` properties are the foreign keys the links join on."},"1095":{"id":"/ontology-as-code-33","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#write-an-ontology","content":"Compile it:"},"1096":{"id":"/ontology-as-code-34","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#write-an-ontology","content":"Each `define*` function throws when its input is invalid, for example when a title or primary key property is missing, an API name breaks the naming rules, or two types share an API name. `maker` reports the first error and exits with code 1; run it with `-v` to print the stack trace."},"1097":{"id":"/ontology-as-code-35","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#api-names-and-namespaces","content":"`--apiNamespace com.example` prefixes the API names of the object types, interfaces, shared property types, and action types you define, so `Employee` becomes `com.example.Employee`. Pass names without the prefix in your definitions. Link type API names are not prefixed, and value types are prefixed only when you set `namespacePrefix: true`."},"1098":{"id":"/ontology-as-code-36","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#api-names-and-namespaces","content":"| Name        | Rule                                                                                                         |\n| ----------- | ------------------------------------------------------------------------------------------------------------ |\n| Object type | Starts with a letter, then letters and digits, with optional `.`-separated segments, at most 100 characters. |","table":"table-2"},"1099":{"id":"/ontology-as-code-37","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#api-names-and-namespaces","content":"| Name                | Rule                                                                         |\n| ------------------- | ---------------------------------------------------------------------------- |\n| Property, link side | Starts with a letter, then letters, digits, and `_`, at most 100 characters. |","table":"table-2"},"1100":{"id":"/ontology-as-code-38","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#api-names-and-namespaces","content":"| Name        | Rule                                                               |\n| ----------- | ------------------------------------------------------------------ |\n| Action type | Lowercase letters and digits, in segments separated by `-` or `.`. |","table":"table-2"},"1101":{"id":"/ontology-as-code-39","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#api-names-and-namespaces","content":"| Name      | Rule                                                                                                                                               |\n| --------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Link type | Converted to a lowercase, hyphenated ID (`officeOccupants` and `office_occupants` both become `office-occupants`), which must start with a letter. |","table":"table-2"},"1102":{"id":"/ontology-as-code-40","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#api-names-and-namespaces","content":"| Name | Rule                                                                                                                                              |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------- |\n| All  | Cannot be a reserved word: `ontology`, `object`, `property`, `link`, `relation`, `rid`, `primaryKey`, `typeId`, or `ontologyObject`, in any case. |","table":"table-2"},"1103":{"id":"/ontology-as-code-41","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option          | Type     | Default                 | Description                |\n| --------------- | -------- | ----------------------- | -------------------------- |\n| `-i`, `--input` | `string` | `.ontology/ontology.ts` | The ontology file to load. |","table":"table-3"},"1104":{"id":"/ontology-as-code-42","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option           | Type     | Default         | Description            |\n| ---------------- | -------- | --------------- | ---------------------- |\n| `-o`, `--output` | `string` | `ontology.json` | Where to write the IR. |","table":"table-3"},"1105":{"id":"/ontology-as-code-43","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option               | Type     | Default            | Description                                                                                |\n| -------------------- | -------- | ------------------ | ------------------------------------------------------------------------------------------ |\n| `--valueTypesOutput` | `string` | `value-types.json` | Where to write value types. Written only when the ontology defines or imports value types. |","table":"table-3"},"1106":{"id":"/ontology-as-code-44","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option           | Type     | Default | Description                                                                                                               |\n| ---------------- | -------- | ------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `--apiNamespace` | `string` | `\"\"`    | Prefix for API names, such as `com.example`. A trailing `.` is added for you. Must match `^[a-z0-9-]+(\\.[a-z0-9-]+)*\\.$`. |","table":"table-3"},"1107":{"id":"/ontology-as-code-45","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option              | Type     | Default | Description                                                                                                                                                                             |\n| ------------------- | -------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `-d`, `--outputDir` | `string` |         | Also write each defined type as a TypeScript module under `<dir>/codegen`, with an `index.ts` that re-exports them. Other ontologies can import this output; see Import existing types. |","table":"table-3"},"1108":{"id":"/ontology-as-code-46","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option           | Type     | Default | Description                                                                        |\n| ---------------- | -------- | ------- | ---------------------------------------------------------------------------------- |\n| `--dependencies` | `string` |         | Write the namespaces and versions of imported ontology packages to this JSON file. |","table":"table-3"},"1109":{"id":"/ontology-as-code-47","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option                   | Type      | Default | Description                                                                 |\n| ------------------------ | --------- | ------- | --------------------------------------------------------------------------- |\n| `--generateCodeSnippets` | `boolean` | `false` | Write OSDK usage snippets for each object type, action type, and interface. |","table":"table-3"},"1110":{"id":"/ontology-as-code-48","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option                     | Type     | Default | Description                                 |\n| -------------------------- | -------- | ------- | ------------------------------------------- |\n| `--codeSnippetPackageName` | `string` | `\"\"`    | The SDK package name shown in the snippets. |","table":"table-3"},"1111":{"id":"/ontology-as-code-49","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option             | Type     | Default | Description                  |\n| ------------------ | -------- | ------- | ---------------------------- |\n| `--codeSnippetDir` | `string` | `./`    | Where to write the snippets. |","table":"table-3"},"1112":{"id":"/ontology-as-code-50","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option            | Type     | Default | Description                                                                                |\n| ----------------- | -------- | ------- | ------------------------------------------------------------------------------------------ |\n| `--randomnessKey` | `string` |         | A UUID recorded in the IR to keep generated entities unique. Rejected if it is not a UUID. |","table":"table-3"},"1113":{"id":"/ontology-as-code-51","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option       | Type     | Default                                       | Description                    |\n| ------------ | -------- | --------------------------------------------- | ------------------------------ |\n| `--lockfile` | `string` | `ontology-schema-lock.json` next to the input | The interface schema lockfile. |","table":"table-3"},"1114":{"id":"/ontology-as-code-52","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option         | Type      | Default | Description                                                    |\n| -------------- | --------- | ------- | -------------------------------------------------------------- |\n| `--writeLocks` | `boolean` |         | Update the lockfile instead of failing when it is out of date. |","table":"table-3"},"1115":{"id":"/ontology-as-code-53","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option        | Type      | Default | Description                                                                                             |\n| ------------- | --------- | ------- | ------------------------------------------------------------------------------------------------------- |\n| `-y`, `--yes` | `boolean` |         | Accept detected schema migration finalizations and deletions without a prompt. Requires `--writeLocks`. |","table":"table-3"},"1116":{"id":"/ontology-as-code-54","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#maker-cli","content":"| Option            | Type    | Default | Description                                                       |\n| ----------------- | ------- | ------- | ----------------------------------------------------------------- |\n| `-v`, `--verbose` | `count` |         | `-v` logs debug output and stack traces; `-vv` logs trace output. |","table":"table-3"},"1117":{"id":"/ontology-as-code-55","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#next-steps","content":"Properties, primary keys, value types, and datasources."},"1118":{"id":"/ontology-as-code-56","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#next-steps","content":"Relate object types and define the actions that edit them."},"1119":{"id":"/ontology-as-code-57","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#next-steps","content":"Share properties and contracts across object types."},"1120":{"id":"/ontology-as-code-58","page_id":"/ontology-as-code","tags":[],"type":"text","url":"/ontology-as-code#next-steps","content":"Generate an SDK and run a mock Foundry API with Vite."},"1121":{"id":"/ontology-as-code/interfaces","page_id":"/ontology-as-code/interfaces","type":"page","content":"Interfaces and shared properties","breadcrumbs":["OSDK TypeScript","Guides","Ontology as code"],"tags":[],"url":"/ontology-as-code/interfaces"},"1122":{"id":"/ontology-as-code/interfaces-0","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces","content":"Define shared property types and interfaces with @osdk/maker, implement them on object types, and add interface links, actions, and schema migrations."},"1123":{"id":"/ontology-as-code/interfaces-1","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#shared-property-types","content":"Shared property types"},"1124":{"id":"/ontology-as-code/interfaces-2","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#refer-to-a-shared-property-type-defined-elsewhere","content":"Refer to a shared property type defined elsewhere"},"1125":{"id":"/ontology-as-code/interfaces-3","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#define-an-interface","content":"Define an interface"},"1126":{"id":"/ontology-as-code/interfaces-4","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#implement-an-interface","content":"Implement an interface"},"1127":{"id":"/ontology-as-code/interfaces-5","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#interface-links","content":"Interface links"},"1128":{"id":"/ontology-as-code/interfaces-6","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#interface-actions","content":"Interface actions"},"1129":{"id":"/ontology-as-code/interfaces-7","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#action-type-constraints","content":"Action type constraints"},"1130":{"id":"/ontology-as-code/interfaces-8","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#schema-migrations","content":"Schema migrations"},"1131":{"id":"/ontology-as-code/interfaces-9","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#the-lockfile","content":"The lockfile"},"1132":{"id":"/ontology-as-code/interfaces-10","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#create-the-lockfile","content":"Create the lockfile"},"1133":{"id":"/ontology-as-code/interfaces-11","page_id":"/ontology-as-code/interfaces","type":"heading","tags":[],"url":"/ontology-as-code/interfaces#end-a-transition","content":"End a transition"},"1134":{"id":"/ontology-as-code/interfaces-12","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces","content":"A shared property type is a property definition that several object types reuse. An interface is a contract of properties and links that object types implement, so code can work with any object that is a `Worker` without knowing its concrete type. Define both with `@osdk/maker` in your `.ontology/ontology.mts` file."},"1135":{"id":"/ontology-as-code/interfaces-13","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"`type`, `array`, `reducers`, `description`, `visibility`, `nullability`, `typeClasses`, and `baseFormatter` work as they do on object type properties. The other options:"},"1136":{"id":"/ontology-as-code/interfaces-14","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"| Option    | Type     | Default | Description                                    |\n| --------- | -------- | ------- | ---------------------------------------------- |\n| `apiName` | `string` |         | Required. The API name, without the namespace. |","table":"table-0"},"1137":{"id":"/ontology-as-code/interfaces-15","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"| Option        | Type     | Default   | Description                |\n| ------------- | -------- | --------- | -------------------------- |\n| `displayName` | `string` | `apiName` | The name shown in Foundry. |","table":"table-0"},"1138":{"id":"/ontology-as-code/interfaces-16","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"| Option    | Type            | Default | Description                                    |\n| --------- | --------------- | ------- | ---------------------------------------------- |\n| `aliases` | `Array<string>` |         | Other names to find the property by in search. |","table":"table-0"},"1139":{"id":"/ontology-as-code/interfaces-17","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"| Option      | Type                                       | Default | Description                             |\n| ----------- | ------------------------------------------ | ------- | --------------------------------------- |\n| `valueType` | `OntologyIrValueTypeReferenceWithMetadata` |         | A reference to an installed value type. |","table":"table-0"},"1140":{"id":"/ontology-as-code/interfaces-18","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"| Option          | Type                              | Default | Description                     |\n| --------------- | --------------------------------- | ------- | ------------------------------- |\n| `gothamMapping` | `SharedPropertyTypeGothamMapping` |         | A mapping to a Gotham property. |","table":"table-0"},"1141":{"id":"/ontology-as-code/interfaces-19","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"| Option       | Type                                                                                    | Default | Description           |\n| ------------ | --------------------------------------------------------------------------------------- | ------- | --------------------- |\n| `permission` | `\"roles\" \\| \"publicProject\" \\| { type: \"ontologyPackage\"; ontologyPackageRid: string }` |         | The permission model. |","table":"table-0"},"1142":{"id":"/ontology-as-code/interfaces-20","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#shared-property-types","content":"To back an object type's property with a shared property type, set `sharedPropertyType` on the property and keep `type` and `array` the same as the shared property type's:"},"1143":{"id":"/ontology-as-code/interfaces-21","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#refer-to-a-shared-property-type-defined-elsewhere","content":"`importSharedPropertyType` refers to a shared property type that another ontology defines. Maker records it as an imported type, and `typeHint` tells the SDK generator its type:"},"1144":{"id":"/ontology-as-code/interfaces-22","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#refer-to-a-shared-property-type-defined-elsewhere","content":"The full API name is `<packageName>.<apiName>`, here `com.example.finance.costCenter`. `packageName` must be lowercase and cannot end with `.`. To import many types from an existing ontology at once, use `@osdk/maker-import`."},"1145":{"id":"/ontology-as-code/interfaces-23","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"`Worker` inherits `name` from `Party`, so an object type that implements `Worker` must provide `name` and `jobTitle`, and may provide `email` and `hourlyRate`."},"1146":{"id":"/ontology-as-code/interfaces-24","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option    | Type     | Default | Description                                    |\n| --------- | -------- | ------- | ---------------------------------------------- |\n| `apiName` | `string` |         | Required. The API name, without the namespace. |","table":"table-1"},"1147":{"id":"/ontology-as-code/interfaces-25","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option        | Type     | Default   | Description                |\n| ------------- | -------- | --------- | -------------------------- |\n| `displayName` | `string` | `apiName` | The name shown in Foundry. |","table":"table-1"},"1148":{"id":"/ontology-as-code/interfaces-26","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option        | Type     | Default       | Description                     |\n| ------------- | -------- | ------------- | ------------------------------- |\n| `description` | `string` | `displayName` | A description shown in Foundry. |","table":"table-1"},"1149":{"id":"/ontology-as-code/interfaces-27","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option | Type                                        | Default | Description                            |\n| ------ | ------------------------------------------- | ------- | -------------------------------------- |\n| `icon` | `{ locator: BlueprintIcon; color: string }` |         | A Blueprint icon name and a hex color. |","table":"table-1"},"1150":{"id":"/ontology-as-code/interfaces-28","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option       | Type                                | Default | Description                                   |\n| ------------ | ----------------------------------- | ------- | --------------------------------------------- |\n| `properties` | `Record<string, InterfaceProperty>` |         | The properties, keyed by API name. See below. |","table":"table-1"},"1151":{"id":"/ontology-as-code/interfaces-29","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option    | Type                                    | Default | Description                                                                                      |\n| --------- | --------------------------------------- | ------- | ------------------------------------------------------------------------------------------------ |\n| `extends` | `InterfaceType \\| Array<InterfaceType>` |         | Interfaces whose properties this interface inherits. Pass the values `defineInterface` returned. |","table":"table-1"},"1152":{"id":"/ontology-as-code/interfaces-30","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option   | Type                                                                                                                                 | Default              | Description             |\n| -------- | ------------------------------------------------------------------------------------------------------------------------------------ | -------------------- | ----------------------- |\n| `status` | `{ type: \"active\" } \\| { type: \"experimental\" } \\| { type: \"example\" } \\| { type: \"deprecated\"; message: string; deadline: string }` | `{ type: \"active\" }` | The interface's status. |","table":"table-1"},"1153":{"id":"/ontology-as-code/interfaces-31","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option       | Type      | Default | Description                              |\n| ------------ | --------- | ------- | ---------------------------------------- |\n| `searchable` | `boolean` | `true`  | Whether the interface appears in search. |","table":"table-1"},"1154":{"id":"/ontology-as-code/interfaces-32","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option       | Type                                                                                    | Default | Description           |\n| ------------ | --------------------------------------------------------------------------------------- | ------- | --------------------- |\n| `permission` | `\"roles\" \\| \"publicProject\" \\| { type: \"ontologyPackage\"; ontologyPackageRid: string }` |         | The permission model. |","table":"table-1"},"1155":{"id":"/ontology-as-code/interfaces-33","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Option             | Type                                 | Default | Description                                         |\n| ------------------ | ------------------------------------ | ------- | --------------------------------------------------- |\n| `schemaMigrations` | `{ transitions: Array<Transition> }` |         | Opts into schema migrations. See Schema migrations. |","table":"table-1"},"1156":{"id":"/ontology-as-code/interfaces-34","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"Each entry in `properties` takes one of three forms:"},"1157":{"id":"/ontology-as-code/interfaces-35","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Form                   | Example | Required to implement |\n| ---------------------- | ------- | --------------------- |\n| A shared property type | `name`  | Yes                   |","table":"table-2"},"1158":{"id":"/ontology-as-code/interfaces-36","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Form                               | Example                                          | Required to implement |\n| ---------------------------------- | ------------------------------------------------ | --------------------- |\n| A shared property type with a flag | `{ sharedPropertyType: email, required: false }` | As set                |","table":"table-2"},"1159":{"id":"/ontology-as-code/interfaces-37","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"| Form                          | Example                                                                                             | Required to implement      |\n| ----------------------------- | --------------------------------------------------------------------------------------------------- | -------------------------- |\n| An interface-defined property | `{ type: \"string\", required?: boolean, displayName?, description?, array?, primaryKeyConstraint? }` | `required`, default `true` |","table":"table-2"},"1160":{"id":"/ontology-as-code/interfaces-38","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"When you use a shared property type, its key must be the shared property type's API name: `properties: { name }` works, and `properties: { fullName: name }` throws. `primaryKeyConstraint` is `\"MUST_BE_PK\"`, `\"CANNOT_BE_PK\"`, or `\"NO_RESTRICTION\"`."},"1161":{"id":"/ontology-as-code/interfaces-39","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#define-an-interface","content":"Locally generated SDKs include only the shared-property-type properties of an interface. Interface-defined properties are in the IR but not in the SDK that `@osdk/vite-plugin-oac` generates. See Local development."},"1162":{"id":"/ontology-as-code/interfaces-40","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#implement-an-interface","content":"List the interface in the object type's `implementsInterfaces`, and map each interface property to one of the object's properties:"},"1163":{"id":"/ontology-as-code/interfaces-41","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#implement-an-interface","content":"`defineObject` throws if a required interface property, including one inherited through `extends`, is not mapped, if a mapping names an interface property that does not exist, or if the object property's type differs from the interface property's type."},"1164":{"id":"/ontology-as-code/interfaces-42","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"`defineInterfaceLinkConstraint` adds a link to an interface. Every object type that implements the interface must provide the link when `required` is `true`."},"1165":{"id":"/ontology-as-code/interfaces-43","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"| Option    | Type     | Default | Description                                            |\n| --------- | -------- | ------- | ------------------------------------------------------ |\n| `apiName` | `string` |         | Required. The link's API name on the `from` interface. |","table":"table-3"},"1166":{"id":"/ontology-as-code/interfaces-44","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"| Option | Type            | Default | Description                                                                                     |\n| ------ | --------------- | ------- | ----------------------------------------------------------------------------------------------- |\n| `from` | `InterfaceType` |         | Required. The interface the link belongs to. It must be defined in this ontology, not imported. |","table":"table-3"},"1167":{"id":"/ontology-as-code/interfaces-45","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"| Option              | Type                      | Default | Description                                                   |\n| ------------------- | ------------------------- | ------- | ------------------------------------------------------------- |\n| `toOne` or `toMany` | `InterfaceType \\| string` |         | Required, exactly one. The target interface, or its API name. |","table":"table-3"},"1168":{"id":"/ontology-as-code/interfaces-46","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"| Option        | Type     | Default   | Description                |\n| ------------- | -------- | --------- | -------------------------- |\n| `displayName` | `string` | `apiName` | The name shown in Foundry. |","table":"table-3"},"1169":{"id":"/ontology-as-code/interfaces-47","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"| Option        | Type     | Default       | Description                     |\n| ------------- | -------- | ------------- | ------------------------------- |\n| `description` | `string` | `displayName` | A description shown in Foundry. |","table":"table-3"},"1170":{"id":"/ontology-as-code/interfaces-48","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-links","content":"| Option     | Type      | Default | Description                                              |\n| ---------- | --------- | ------- | -------------------------------------------------------- |\n| `required` | `boolean` | `true`  | Whether implementing object types must provide the link. |","table":"table-3"},"1171":{"id":"/ontology-as-code/interfaces-49","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"These helpers generate action types that work on any object that implements an interface. Their options match the object action helpers, with `interfaceType` in place of `objectType`."},"1172":{"id":"/ontology-as-code/interfaces-50","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"| Helper                              | Default API name                                                         | What it does                                                                                                                                 |\n| ----------------------------------- | ------------------------------------------------------------------------ | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `defineCreateInterfaceObjectAction` | `create-<interface>`, or `create-<interface>-<object>` with `objectType` | Creates an object that implements the interface. Without `objectType`, the user picks the object type in an `objectTypeParameter` parameter. |","table":"table-4"},"1173":{"id":"/ontology-as-code/interfaces-51","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"| Helper                              | Default API name                                                         | What it does                                           |\n| ----------------------------------- | ------------------------------------------------------------------------ | ------------------------------------------------------ |\n| `defineModifyInterfaceObjectAction` | `modify-<interface>`, or `modify-<interface>-<object>` with `objectType` | Modifies an object through the interface's properties. |","table":"table-4"},"1174":{"id":"/ontology-as-code/interfaces-52","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"| Helper                              | Default API name                      | What it does                                     |\n| ----------------------------------- | ------------------------------------- | ------------------------------------------------ |\n| `defineDeleteInterfaceObjectAction` | `delete-interface-object-<interface>` | Deletes an object that implements the interface. |","table":"table-4"},"1175":{"id":"/ontology-as-code/interfaces-53","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"| Helper                            | Default API name                          | What it does                                |\n| --------------------------------- | ----------------------------------------- | ------------------------------------------- |\n| `defineCreateInterfaceLinkAction` | Derived from the interface and link names | Adds an interface link between two objects. |","table":"table-4"},"1176":{"id":"/ontology-as-code/interfaces-54","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"| Helper                            | Default API name                          | What it does               |\n| --------------------------------- | ----------------------------------------- | -------------------------- |\n| `defineDeleteInterfaceLinkAction` | Derived from the interface and link names | Removes an interface link. |","table":"table-4"},"1177":{"id":"/ontology-as-code/interfaces-55","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#interface-actions","content":"The link actions take the value `defineInterfaceLinkConstraint` returned as `interfaceLink`, or the link's API name together with `from`. Use `sourceParameter` and `targetParameter` to rename their two parameters."},"1178":{"id":"/ontology-as-code/interfaces-56","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#action-type-constraints","content":"`defineInterfaceActionTypeConstraint` declares an action that implementing object types provide, with the parameters it must accept:"},"1179":{"id":"/ontology-as-code/interfaces-57","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#action-type-constraints","content":"The interface must be defined in this ontology, and the constraint's API name must be unique on it."},"1180":{"id":"/ontology-as-code/interfaces-58","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"Interface schema migrations are in beta in Foundry and may not be available on your enrollment."},"1181":{"id":"/ontology-as-code/interfaces-59","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"Changing a published interface can break the object types that implement it. A schema migration announces a change and gives implementers a grace period before it is enforced. Adding `schemaMigrations` to an interface also turns on compatibility checks, so maker rejects breaking changes that are not staged as a migration."},"1182":{"id":"/ontology-as-code/interfaces-60","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"The only migration is `addRequiredProperty`, which makes an optional property required. While the migration is active, the property stays `required: false`:"},"1183":{"id":"/ontology-as-code/interfaces-61","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"A transition groups migrations that are finalized or deleted together:"},"1184":{"id":"/ontology-as-code/interfaces-62","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"| Field | Type     | Description                                                                                                      |\n| ----- | -------- | ---------------------------------------------------------------------------------------------------------------- |\n| `id`  | `string` | A stable ID, unique on the interface. 1 to 150 characters: a letter or digit, then letters, digits, `_`, or `-`. |","table":"table-5"},"1185":{"id":"/ontology-as-code/interfaces-63","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"| Field   | Type     | Description              |\n| ------- | -------- | ------------------------ |\n| `title` | `string` | A summary of the change. |","table":"table-5"},"1186":{"id":"/ontology-as-code/interfaces-64","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"| Field         | Type     | Description       |\n| ------------- | -------- | ----------------- |\n| `description` | `string` | Optional details. |","table":"table-5"},"1187":{"id":"/ontology-as-code/interfaces-65","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"| Field         | Type                                                                               | Description                                                                                                                                                                                     |\n| ------------- | ---------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `gracePeriod` | `{ type: \"afterInstall\"; days: number } \\| { type: \"deadline\"; deadline: string }` | How long implementers have to comply. `afterInstall` allows 7 to 180 days and suits Marketplace-distributed ontologies. `deadline` is an ISO 8601 UTC date-time, and installing after it fails. |","table":"table-5"},"1188":{"id":"/ontology-as-code/interfaces-66","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"| Field          | Type                                                       | Description                       |\n| -------------- | ---------------------------------------------------------- | --------------------------------- |\n| `instructions` | `Array<{ type: \"addRequiredProperty\"; property: string }>` | The migrations in the transition. |","table":"table-5"},"1189":{"id":"/ontology-as-code/interfaces-67","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#schema-migrations","content":"Use `schemaMigrations: { transitions: [] }` to turn on compatibility checks without a migration."},"1190":{"id":"/ontology-as-code/interfaces-68","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#the-lockfile","content":"Maker tracks opted-in interfaces in `ontology-schema-lock.json`, next to the ontology file. Commit it."},"1191":{"id":"/ontology-as-code/interfaces-69","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#create-the-lockfile","content":"Without `--write-locks`, maker fails when an interface has opted in and no lockfile exists, or when the lockfile is out of date."},"1192":{"id":"/ontology-as-code/interfaces-70","page_id":"/ontology-as-code/interfaces","tags":[],"type":"text","url":"/ontology-as-code/interfaces#end-a-transition","content":"After the grace period, remove the transition and update the schema in the same change: set the property to `required: true` to **finalize**, or leave it optional to **delete** the transition. Then run `maker --write-locks` again. Maker compares the schema with the lockfile, asks you to confirm `FINALIZE` or `DELETE`, and rejects a schema that matches neither. Pass `--yes` to confirm without a prompt."},"1193":{"id":"/ontology-as-code/links-and-actions","page_id":"/ontology-as-code/links-and-actions","type":"page","content":"Links and actions","breadcrumbs":["OSDK TypeScript","Guides","Ontology as code"],"tags":[],"url":"/ontology-as-code/links-and-actions"},"1194":{"id":"/ontology-as-code/links-and-actions-0","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions","content":"Relate object types with defineLink and define action types with the create, modify, and delete helpers from @osdk/maker."},"1195":{"id":"/ontology-as-code/links-and-actions-1","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#link-types","content":"Link types"},"1196":{"id":"/ontology-as-code/links-and-actions-2","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#one-to-many","content":"One-to-many"},"1197":{"id":"/ontology-as-code/links-and-actions-3","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#many-to-many","content":"Many-to-many"},"1198":{"id":"/ontology-as-code/links-and-actions-4","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#intermediary","content":"Intermediary"},"1199":{"id":"/ontology-as-code/links-and-actions-5","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#link-options","content":"Link options"},"1200":{"id":"/ontology-as-code/links-and-actions-6","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#status","content":"Status"},"1201":{"id":"/ontology-as-code/links-and-actions-7","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#action-types","content":"Action types"},"1202":{"id":"/ontology-as-code/links-and-actions-8","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#helper-options","content":"Helper options"},"1203":{"id":"/ontology-as-code/links-and-actions-9","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#configure-parameters","content":"Configure parameters"},"1204":{"id":"/ontology-as-code/links-and-actions-10","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#conditions","content":"Conditions"},"1205":{"id":"/ontology-as-code/links-and-actions-11","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#who-can-submit","content":"Who can submit"},"1206":{"id":"/ontology-as-code/links-and-actions-12","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#set-properties-without-a-parameter","content":"Set properties without a parameter"},"1207":{"id":"/ontology-as-code/links-and-actions-13","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#form-sections","content":"Form sections"},"1208":{"id":"/ontology-as-code/links-and-actions-14","page_id":"/ontology-as-code/links-and-actions","type":"heading","tags":[],"url":"/ontology-as-code/links-and-actions#define-an-action-from-rules","content":"Define an action from rules"},"1209":{"id":"/ontology-as-code/links-and-actions-15","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions","content":"Link types connect object types, so that an `Employee` can reach its `Office`. Action types describe the edits users can make, such as changing an employee's job title. Define both with `@osdk/maker` in your `.ontology/ontology.mts` file."},"1210":{"id":"/ontology-as-code/links-and-actions-16","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-types","content":"`defineLink` supports three kinds of link, chosen by the keys you pass:"},"1211":{"id":"/ontology-as-code/links-and-actions-17","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-types","content":"| Kind        | Keys                                      | Joined on                                         |\n| ----------- | ----------------------------------------- | ------------------------------------------------- |\n| One-to-many | `one`, `toMany`, `manyForeignKeyProperty` | A foreign key property on the \"many\" object type. |","table":"table-0"},"1212":{"id":"/ontology-as-code/links-and-actions-18","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-types","content":"| Kind         | Keys             | Joined on                            |\n| ------------ | ---------------- | ------------------------------------ |\n| Many-to-many | `many`, `toMany` | A link dataset of primary key pairs. |","table":"table-0"},"1213":{"id":"/ontology-as-code/links-and-actions-19","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-types","content":"| Kind         | Keys                                       | Joined on                                                                  |\n| ------------ | ------------------------------------------ | -------------------------------------------------------------------------- |\n| Intermediary | `many`, `toMany`, `intermediaryObjectType` | An object type that sits between the two, joined by two one-to-many links. |","table":"table-0"},"1214":{"id":"/ontology-as-code/links-and-actions-20","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-types","content":"`defineLink` records the link without looking up its object types, so a link can refer to an object type that is defined later in the file. Maker checks the link when it compiles the ontology."},"1215":{"id":"/ontology-as-code/links-and-actions-21","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"Each side's `metadata.apiName` is the name of the link as seen from that side's object type. The `one` side's name leads to many objects, and the `toMany` side's name leads to one:"},"1216":{"id":"/ontology-as-code/links-and-actions-22","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"These two links give the generated SDK the following link names:"},"1217":{"id":"/ontology-as-code/links-and-actions-23","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"| Object type | Link        | Leads to                                                              |\n| ----------- | ----------- | --------------------------------------------------------------------- |\n| `Office`    | `occupants` | Many `Employee` objects whose `officeId` is the office's primary key. |","table":"table-1"},"1218":{"id":"/ontology-as-code/links-and-actions-24","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"| Object type | Link     | Leads to                              |\n| ----------- | -------- | ------------------------------------- |\n| `Employee`  | `office` | The one `Office` named by `officeId`. |","table":"table-1"},"1219":{"id":"/ontology-as-code/links-and-actions-25","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"| Object type | Link      | Leads to                                                               |\n| ----------- | --------- | ---------------------------------------------------------------------- |\n| `Employee`  | `reports` | Many `Employee` objects whose `leadId` is this employee's primary key. |","table":"table-1"},"1220":{"id":"/ontology-as-code/links-and-actions-26","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"| Object type | Link   | Leads to                              |\n| ----------- | ------ | ------------------------------------- |\n| `Employee`  | `lead` | The one `Employee` named by `leadId`. |","table":"table-1"},"1221":{"id":"/ontology-as-code/links-and-actions-27","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#one-to-many","content":"`manyForeignKeyProperty` must be a property of the `toMany` object type, with the same type as the `one` object type's primary key. Set `cardinality: \"OneToOne\"` when each object on the `one` side links to at most one object on the `toMany` side; the default is `\"OneToMany\"`."},"1222":{"id":"/ontology-as-code/links-and-actions-28","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#many-to-many","content":"Maker backs a many-to-many link with a dataset named `link-<apiName>` that has one column per primary key. When both object types use the same primary key name, the columns get `_from` and `_to` suffixes."},"1223":{"id":"/ontology-as-code/links-and-actions-29","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#intermediary","content":"An intermediary link connects two object types through a third. Define the intermediary object type and a one-to-many link from each side to it, then pass those links as `linkToIntermediary`:"},"1224":{"id":"/ontology-as-code/links-and-actions-30","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option    | Type     | Default | Description                                                                                    |\n| --------- | -------- | ------- | ---------------------------------------------------------------------------------------------- |\n| `apiName` | `string` |         | Required. Converted to a lowercase, hyphenated link type ID. Not prefixed by `--apiNamespace`. |","table":"table-2"},"1225":{"id":"/ontology-as-code/links-and-actions-31","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option                  | Type                   | Default | Description                                                                                                       |\n| ----------------------- | ---------------------- | ------- | ----------------------------------------------------------------------------------------------------------------- |\n| `one`, `many`, `toMany` | `{ object, metadata }` |         | The two sides. `object` is a definition from `defineObject`, an imported object type, or an object type API name. |","table":"table-2"},"1226":{"id":"/ontology-as-code/links-and-actions-32","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option                   | Type     | Default | Description                                                             |\n| ------------------------ | -------- | ------- | ----------------------------------------------------------------------- |\n| `manyForeignKeyProperty` | `string` |         | One-to-many only. The foreign key property on the `toMany` object type. |","table":"table-2"},"1227":{"id":"/ontology-as-code/links-and-actions-33","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option        | Type                        | Default       | Description       |\n| ------------- | --------------------------- | ------------- | ----------------- |\n| `cardinality` | `\"OneToMany\" \\| \"OneToOne\"` | `\"OneToMany\"` | One-to-many only. |","table":"table-2"},"1228":{"id":"/ontology-as-code/links-and-actions-34","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option                   | Type                             | Default | Description        |\n| ------------------------ | -------------------------------- | ------- | ------------------ |\n| `intermediaryObjectType` | `ObjectTypeDefinition \\| string` |         | Intermediary only. |","table":"table-2"},"1229":{"id":"/ontology-as-code/links-and-actions-35","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option        | Type     | Default | Description                     |\n| ------------- | -------- | ------- | ------------------------------- |\n| `description` | `string` |         | A description shown in Foundry. |","table":"table-2"},"1230":{"id":"/ontology-as-code/links-and-actions-36","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option   | Type         | Default    | Description |\n| -------- | ------------ | ---------- | ----------- |\n| `status` | `LinkStatus` | `\"active\"` | See Status. |","table":"table-2"},"1231":{"id":"/ontology-as-code/links-and-actions-37","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option         | Type      | Default | Description                      |\n| -------------- | --------- | ------- | -------------------------------- |\n| `editsEnabled` | `boolean` | `false` | Whether users can edit the link. |","table":"table-2"},"1232":{"id":"/ontology-as-code/links-and-actions-38","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option       | Type                                                                                    | Default | Description                        |\n| ------------ | --------------------------------------------------------------------------------------- | ------- | ---------------------------------- |\n| `permission` | `\"roles\" \\| \"publicProject\" \\| { type: \"ontologyPackage\"; ontologyPackageRid: string }` |         | The permission model for the link. |","table":"table-2"},"1233":{"id":"/ontology-as-code/links-and-actions-39","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"Each side's `metadata`:"},"1234":{"id":"/ontology-as-code/links-and-actions-40","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option    | Type     | Default | Description                                                                                              |\n| --------- | -------- | ------- | -------------------------------------------------------------------------------------------------------- |\n| `apiName` | `string` |         | Required. The link name on this side's object type. Starts with a letter, then letters, digits, and `_`. |","table":"table-3"},"1235":{"id":"/ontology-as-code/links-and-actions-41","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option        | Type     | Default                                     | Description                         |\n| ------------- | -------- | ------------------------------------------- | ----------------------------------- |\n| `displayName` | `string` | `apiName` with its first letter capitalized | The singular name shown in Foundry. |","table":"table-3"},"1236":{"id":"/ontology-as-code/links-and-actions-42","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option              | Type     | Default                                                        | Description                       |\n| ------------------- | -------- | -------------------------------------------------------------- | --------------------------------- |\n| `pluralDisplayName` | `string` | `apiName` capitalized, with an `s` added unless it ends in `s` | The plural name shown in Foundry. |","table":"table-3"},"1237":{"id":"/ontology-as-code/links-and-actions-43","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option       | Type                                  | Default    | Description                             |\n| ------------ | ------------------------------------- | ---------- | --------------------------------------- |\n| `visibility` | `\"PROMINENT\" \\| \"NORMAL\" \\| \"HIDDEN\"` | `\"NORMAL\"` | How prominently Foundry shows the link. |","table":"table-3"},"1238":{"id":"/ontology-as-code/links-and-actions-44","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option             | Type     | Default | Description                     |\n| ------------------ | -------- | ------- | ------------------------------- |\n| `groupDisplayName` | `string` | `\"\"`    | A group to show the link under. |","table":"table-3"},"1239":{"id":"/ontology-as-code/links-and-actions-45","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#link-options","content":"| Option        | Type                                    | Default | Description   |\n| ------------- | --------------------------------------- | ------- | ------------- |\n| `typeClasses` | `Array<{ kind: string; name: string }>` | `[]`    | Type classes. |","table":"table-3"},"1240":{"id":"/ontology-as-code/links-and-actions-46","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#status","content":"A link's `status` is `\"active\"`, `\"experimental\"`, `\"example\"`, or `{ type: \"deprecated\", message, deadline, replacedBy? }`. It must agree with the object types it connects: if either side is deprecated, the link must be deprecated, and if either side is experimental or example, the link must be experimental or example."},"1241":{"id":"/ontology-as-code/links-and-actions-47","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"Most actions create, change, or delete one object. The helpers below generate an action type from an object type: one parameter per property, the logic rule, and a default parameter order."},"1242":{"id":"/ontology-as-code/links-and-actions-48","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Helper                     | Default API name         | Parameters                                | Rule            |\n| -------------------------- | ------------------------ | ----------------------------------------- | --------------- |\n| `defineCreateObjectAction` | `create-object-<object>` | Every property, including the primary key | Adds an object. |","table":"table-4"},"1243":{"id":"/ontology-as-code/links-and-actions-49","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Helper                     | Default API name         | Parameters                                                            | Rule                                                                               |\n| -------------------------- | ------------------------ | --------------------------------------------------------------------- | ---------------------------------------------------------------------------------- |\n| `defineModifyObjectAction` | `modify-object-<object>` | `objectToModifyParameter`, then every property except the primary key | Modifies the chosen object. Each parameter defaults to the object's current value. |","table":"table-4"},"1244":{"id":"/ontology-as-code/links-and-actions-50","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Helper                             | Default API name            | Parameters                                                                    | Rule                                                                                               |\n| ---------------------------------- | --------------------------- | ----------------------------------------------------------------------------- | -------------------------------------------------------------------------------------------------- |\n| `defineCreateOrModifyObjectAction` | `create-or-modify-<object>` | `objectToCreateOrModifyParameter`, then every property except the primary key | Modifies the chosen object, or creates one. Each parameter defaults to the object's current value. |","table":"table-4"},"1245":{"id":"/ontology-as-code/links-and-actions-51","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Helper                     | Default API name         | Parameters                | Rule                       |\n| -------------------------- | ------------------------ | ------------------------- | -------------------------- |\n| `defineDeleteObjectAction` | `delete-object-<object>` | `objectToDeleteParameter` | Deletes the chosen object. |","table":"table-4"},"1246":{"id":"/ontology-as-code/links-and-actions-52","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"`<object>` is the object type's API name in lowercase with hyphens, so `Employee` gives `modify-object-employee`. Parameters skip vector properties, properties in `excludedProperties`, and properties set by `nonParameterMappings`; create and create-or-modify also skip derived properties. For interfaces, see Interface actions."},"1247":{"id":"/ontology-as-code/links-and-actions-53","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"Action API names must contain lowercase letters and digits in segments separated by `-` or `.`. The SDK generator converts them to camelCase, so `modify-employee` is `modifyEmployee` in your generated SDK."},"1248":{"id":"/ontology-as-code/links-and-actions-54","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"The parameter IDs of the chosen object are exported as constants:"},"1249":{"id":"/ontology-as-code/links-and-actions-55","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Constant                  | Value                       |\n| ------------------------- | --------------------------- |\n| `MODIFY_OBJECT_PARAMETER` | `\"objectToModifyParameter\"` |","table":"table-5"},"1250":{"id":"/ontology-as-code/links-and-actions-56","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Constant                            | Value                               |\n| ----------------------------------- | ----------------------------------- |\n| `CREATE_OR_MODIFY_OBJECT_PARAMETER` | `\"objectToCreateOrModifyParameter\"` |","table":"table-5"},"1251":{"id":"/ontology-as-code/links-and-actions-57","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Constant                  | Value                       |\n| ------------------------- | --------------------------- |\n| `DELETE_OBJECT_PARAMETER` | `\"objectToDeleteParameter\"` |","table":"table-5"},"1252":{"id":"/ontology-as-code/links-and-actions-58","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Constant                            | Value                   |\n| ----------------------------------- | ----------------------- |\n| `CREATE_INTERFACE_OBJECT_PARAMETER` | `\"objectTypeParameter\"` |","table":"table-5"},"1253":{"id":"/ontology-as-code/links-and-actions-59","page_id":"/ontology-as-code/links-and-actions","tags":[],"type":"text","url":"/ontology-as-code/links-and-actions#action-types","content":"| Constant                            | Value                                |\n| ----------------------------------- | ------------------------------------ |\n| `MODIFY_INTERFACE_OBJECT_PARAMETER` | `\"interfaceObjectToModifyParameter\"` |","table":"table-5"},"1254":{"id"